# Blog: API de Notion (se usan en build time para generar las páginas del blog)
NOTION_API_KEY=secret_xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Endpoints de formularios (se incrustan en el HTML durante el build)
PUBLIC_CHANCHA_ENDPOINT=https://...
PUBLIC_FORM_ENDPOINT=https://...

# PostHog (Settings → Project → Project API Key)
PUBLIC_POSTHOG_KEY=phc_xxx
PUBLIC_POSTHOG_HOST=https://ph.usapablo.app

# Pixels de anuncios. DEJARLOS VACÍOS EN LOCAL: sin valor no se carga el pixel,
# y así el desarrollo no manda compras falsas a Meta/TikTok. En producción se
# definen como build args en EasyPanel.
#   PUBLIC_META_PIXEL_ID   → 1723759659073430 ("Pablo Pixel")
#   PUBLIC_TIKTOK_PIXEL_ID → D7C1JVBC77UFLDKDR4JG
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=
