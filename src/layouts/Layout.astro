---
import "../styles/global.css";
import SubscribeModal from "../components/SubscribeModal.astro";
import CountdownBanner from "../components/CountdownBanner.astro";
import MonedaPopup from "../components/MonedaPopup.astro";
import PostHogSnippet from "../components/PostHogSnippet.astro";
import AbTests from "../components/AbTests.astro";
import Atribucion from "../components/Atribucion.astro";
import MetaPixel from "../components/MetaPixel.astro";
import TikTokPixel from "../components/TikTokPixel.astro";
import { IS_LIVE } from "../siteConfig";

interface Props {
  title?: string;
  description?: string;
  /** Oculta el CountdownBanner global (default false — solo landings de campaña como /webinardespues). */
  hideBanner?: boolean;
  /** Oculta el MonedaPopup global (default false — solo landings de campaña como /webinardespues). */
  hideMoneda?: boolean;
  /** Marca la página como noindex/nofollow (default false — solo landings escondidas de campaña). */
  noindex?: boolean;
}

const {
  title = "Pablo — Tu asistente financiero en WhatsApp",
  description = "Manejar tu dinero nunca fue tan fácil. Conoce a Pablo, tu asistente financiero en WhatsApp que te ayuda a ahorrar y controlar tus gastos con IA y sin estrés.",
  hideBanner = false,
  hideMoneda = false,
  noindex = false,
} = Astro.props;

const siteUrl = "https://www.usapablo.com";
const ogImage = `${siteUrl}/Logo.png`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <!-- Modo pauta (Sandra 10-ago-2026): con utm_medium=paid el mensual es el
         único plan visible en #planes (las reglas CSS viven en Pricing.astro).
         EN LÍNEA y ANTES de los estilos a propósito: si la clase llega después
         del primer render, todos ven los S/.200 por un instante — justo lo que
         se quiere evitar. sessionStorage (no localStorage): sobrevive la
         navegación interna y muere al cerrar la pestaña. No cambia URLs: los
         anuncios siguen apuntando a https://www.usapablo.com/. -->
    <script is:inline>
      (function () {
        try {
          var esPauta =
            new URLSearchParams(location.search).get("utm_medium") === "paid" ||
            sessionStorage.getItem("pablo_pauta") === "1";
          if (!esPauta) return;
          sessionStorage.setItem("pablo_pauta", "1");
          document.documentElement.classList.add("pauta");
        } catch (e) {
          /* sin storage no hay modo pauta: se ven los tres planes */
        }
      })();
    </script>

    <!-- Diferir terceros que no escriben la _fbc (Sandra 10-ago-2026): GTM,
         TikTok y PostHog cargan tras el load + requestIdleCallback. El pixel
         de Meta NO se difiere: escribe la cookie _fbc y de él depende toda la
         atribución. Los stubs quedan en línea, así lo que se dispare antes de
         la carga real se encola y no se pierde. -->
    <script is:inline>
      window.pabloDiferir = function (fn) {
        var idle = function () {
          if ("requestIdleCallback" in window) {
            requestIdleCallback(fn, { timeout: 2000 });
          } else {
            setTimeout(fn, 200);
          }
        };
        if (document.readyState === "complete") idle();
        else window.addEventListener("load", idle);
      };
    </script>

    <!-- Nuevo visitante → los CTAs llevan al primer onboarding.
         El onboarding marca localStorage.pablo_intro_vista cuando el usuario
         ya vio el intro (pregunta inicial + saludo + primer gasto); comparte
         dominio con la landing, así que el flag es visible desde aquí. -->
    <script is:inline>
      (function () {
        try {
          var esNuevo = localStorage.getItem("pablo_intro_vista") !== "1";
          if (!esNuevo) return;
          document.addEventListener("DOMContentLoaded", function () {
            ["hero-cta-btn", "finalcta-btn", "navbar-cta-btn", "navbar-mobile-cta-btn"].forEach(
              function (id) {
                var el = document.getElementById(id);
                if (el && el.tagName === "A") el.setAttribute("href", "/onboarding");
              }
            );
          });
        } catch (e) {
          // si localStorage falla, los CTAs mantienen su destino normal
        }
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primer toque de marketing → localStorage (viaja en el signup) -->
    <Atribucion />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Preconnect para imágenes de Notion -->
    <link rel="preconnect" href="https://prod-files-secure.s3.us-west-2.amazonaws.com" />
    <link rel="preconnect" href="https://www.notion.so" />

    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />

    <!-- Open Graph (Facebook, WhatsApp, Telegram, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content="Pablo — Tu asistente financiero en WhatsApp"
    />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Pablo" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={siteUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- SEO -->
    <link rel="canonical" href={siteUrl} />

    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@700&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Google tag (gtag.js) — diferido: el stub encola y el script externo
         entra tras el primer render (pabloDiferir). -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-F36V5SDW1T");

      window.pabloDiferir(function () {
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=G-F36V5SDW1T";
        document.head.appendChild(s);
      });
    </script>
    <!-- End Google tag -->

    <!-- Meta Pixel (Facebook/Instagram Ads) -->
    <MetaPixel />

    <!-- TikTok Pixel (TikTok Ads) -->
    <TikTokPixel />

    <!-- PostHog (diferido: init tras el primer render, ver PostHogSnippet) -->
    <PostHogSnippet defer />

    <!-- A/B tests (experimentos de PostHog, markup data-ab-*): en el head para
         aplicar la variante cacheada ANTES del primer pintado. -->
    <AbTests />
  </head>
  <body>
    {!hideBanner && <CountdownBanner />}
    <slot />
    {IS_LIVE && <SubscribeModal />}
    {
      /* Pop-up de la moneda: solo se activa en / y /blog/<post> (se
         auto-guarda por pathname dentro de su script) */
    }
    {!hideMoneda && <MonedaPopup />}
  </body>
</html>
