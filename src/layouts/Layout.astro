---
import "../styles/global.css";
import IosInstallPrompt from "../components/IosInstallPrompt.astro";
import SubscribeModal from "../components/SubscribeModal.astro";
import CountdownBanner from "../components/CountdownBanner.astro";
import PostHogSnippet from "../components/PostHogSnippet.astro";
import AbTests from "../components/AbTests.astro";
import IconExperiment from "../components/IconExperiment.astro";
import Atribucion from "../components/Atribucion.astro";
import Afiliado from "../components/Afiliado.astro";
import MetaPixel from "../components/MetaPixel.astro";
import TikTokPixel from "../components/TikTokPixel.astro";
import { IS_LIVE } from "../siteConfig";

interface Props {
  title?: string;
  description?: string;
  /** Oculta el CountdownBanner global (default false — solo landings de campaña como /webinardespues). */
  hideBanner?: boolean;
  /** Propiedad conservada para las páginas de campaña; la promoción terminó. */
  hideMoneda?: boolean;
  /** Marca la página como noindex/nofollow (default false — solo landings escondidas de campaña). */
  noindex?: boolean;
  /** Imagen para compartir (og:image / twitter:image). Default: el logo de Pablo. */
  ogImage?: string;
  /** Tarjeta de X/Twitter: "summary" (default) o "summary_large_image" cuando la
   *  página trae su propia imagen de 1200x630. */
  twitterCard?: string;
}

const {
  title = "Pablo — Tu compañero financiero en web, iPhone y Android",
  description = "Manejar tu dinero nunca fue tan fácil. Conoce a Pablo, tu asistente financiero en web, iPhone y Android que te ayuda a ahorrar y controlar tus gastos con IA y sin estrés.",
  hideBanner = false,
  noindex = false,
  ogImage: ogImagePropia,
  twitterCard = "summary",
} = Astro.props;

const siteUrl = "https://www.usapablo.com";
const ogImage = ogImagePropia ?? `${siteUrl}/Logo.png`;
// URL propia de cada página (sin query). Antes TODAS declaraban la raíz como
// canonical/og:url: para Google y Meta cada página "era" el home.
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <!-- Modo pauta (Sandra 10-ago-2026): con utm_medium=paid el mensual es el
         único plan visible en #planes (las reglas CSS viven en Pricing.astro).
         EN LÍNEA y ANTES de los estilos a propósito: si la clase llega después
         del primer render, todos ven los S/.200 por un instante — justo lo que
         se quiere evitar. sessionStorage (no localStorage): sobrevive la
         navegación interna y muere al cerrar la pestaña. No cambia URLs: los
         anuncios siguen apuntando a https://www.usapablo.com/. -->
    <script is:inline>
      (function () {
        try {
          // Link de afiliado (?a= o guardado vigente, ver lib/afiliado.ts): mismo
          // modo sin Gratis, pero sin marcar la sesión como tráfico pagado.
          var formato = /^[A-Za-z0-9_.-]{2,40}$/;
          var a = new URLSearchParams(location.search).get("a");
          var guardado = null;
          try { guardado = JSON.parse(localStorage.getItem("pablo_afiliado") || "null"); } catch (e) {}
          if ((a && formato.test(a)) || (guardado && formato.test(guardado.codigo) && Date.now() - guardado.ts < 2592000000)) {
            document.documentElement.classList.add("pauta", "afiliado");
          }
          var esPauta =
            new URLSearchParams(location.search).get("utm_medium") === "paid" ||
            sessionStorage.getItem("pablo_pauta") === "1";
          if (!esPauta) return;
          sessionStorage.setItem("pablo_pauta", "1");
          document.documentElement.classList.add("pauta");
        } catch (e) {
          /* sin storage no hay modo pauta: se ven los tres planes */
        }
      })();
    </script>
    <!-- Modo pauta (Sandra 07-oct-2026): al tráfico pagado no se le ofrece el
         plan Gratis. `.solo-organico` desaparece en pauta y `.solo-pauta`
         solo existe en pauta. El orgánico no cambia. -->
    <style is:global>
      html.pauta .solo-organico { display: none !important; }
      html:not(.pauta) .solo-pauta { display: none !important; }
    </style>

    <!-- Diferir terceros que no escriben la _fbc (Sandra 10-ago-2026): GTM,
         TikTok carga tras el load + requestIdleCallback. PostHog inicia antes para el A/B. El pixel
         de Meta NO se difiere: escribe la cookie _fbc y de él depende toda la
         atribución. Los stubs quedan en línea, así lo que se dispare antes de
         la carga real se encola y no se pierde. -->
    <script is:inline>
      window.pabloDiferir = function (fn) {
        var idle = function () {
          if ("requestIdleCallback" in window) {
            requestIdleCallback(fn, { timeout: 2000 });
          } else {
            setTimeout(fn, 200);
          }
        };
        if (document.readyState === "complete") idle();
        else window.addEventListener("load", idle);
      };
    </script>

    <!-- Destino de pauta + recorrido de nuevos visitantes.

         En anuncios, utm_content separa las dos variables que estamos
         midiendo sin agregar parámetros fuera del estándar UTM:
           estatico-titulo1-onboarding | estatico-titulo2-onboarding
           estatico-titulo1-pago      | estatico-titulo2-pago

         `-pago` lleva el CTA al mensual dentro de la app; `-onboarding`, al
         onboarding conversacional. Los UTM viajan al siguiente dominio para
         que el registro y el checkout conserven la atribución.

         Fuera de pauta se conserva el comportamiento anterior: un visitante
         nuevo entra al onboarding. -->
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(location.search);
          var contenido = (params.get("utm_content") || "").toLowerCase();
          // Un link de afiliado recorre igual que la pauta: CTAs a /planes.
          var esPauta =
            params.get("utm_medium") === "paid" ||
            sessionStorage.getItem("pablo_pauta") === "1" ||
            document.documentElement.classList.contains("afiliado");
          var esNuevo = localStorage.getItem("pablo_intro_vista") !== "1";
          var recorridoPauta =
            esPauta && /(?:^|-)titulo[12]-(?:onboarding|pago)$/.test(contenido);
          if (!esNuevo && !recorridoPauta && !esPauta) return;

          // En pauta, sin recorrido explícito en utm_content, los CTAs van a
          // /planes (solo el mensual), nunca al plan Gratis del onboarding.
          var base = contenido.endsWith("-pago")
            ? "https://usapablo.app/pricing?plan=mensual&continuar=1"
            : esPauta && !recorridoPauta
              ? "/planes"
              : "/onboarding";

          function conUtms(destino) {
            var url = new URL(destino, location.origin);
            ["utm_source", "utm_medium", "utm_campaign", "utm_content"].forEach(
              function (key) {
                var value = params.get(key);
                if (value) url.searchParams.set(key, value);
              }
            );
            return url.origin === location.origin
              ? url.pathname + url.search + url.hash
              : url.toString();
          }

          var href = conUtms(base);
          document.addEventListener("DOMContentLoaded", function () {
            [
              document.getElementById("hero-cta-btn"),
              document.getElementById("finalcta-btn"),
              document.querySelector("[data-cta-banner]"),
              document.getElementById("footer-cta-btn"),
              document.getElementById("navbar-cta-btn"),
              document.getElementById("navbar-mobile-cta-btn"),
            ].forEach(function (el) {
              if (el && el.tagName === "A") el.setAttribute("href", href);
            });
          });
        } catch (e) {
          // si localStorage falla, los CTAs mantienen su destino normal
        }
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primer toque de marketing → localStorage (viaja en el signup) -->
    <Atribucion />
    <Afiliado />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- Preconnect para imágenes de Notion -->
    <link rel="preconnect" href="https://prod-files-secure.s3.us-west-2.amazonaws.com" />
    <link rel="preconnect" href="https://www.notion.so" />

    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="description" content={description} />

    <!-- Open Graph (Facebook, WhatsApp, Telegram, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:alt"
      content="Pablo — Tu asistente financiero en WhatsApp"
    />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Pablo" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- SEO -->
    <link rel="canonical" href={pageUrl} />

    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@700;800&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Google tag (gtag.js) — diferido: el stub encola y el script externo
         entra tras el primer render (pabloDiferir). -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-F36V5SDW1T");

      window.pabloDiferir(function () {
        var s = document.createElement("script");
        s.async = true;
        s.src = "https://www.googletagmanager.com/gtag/js?id=G-F36V5SDW1T";
        document.head.appendChild(s);
      });
    </script>
    <!-- End Google tag -->

    <!-- Meta Pixel (Facebook/Instagram Ads) -->
    <MetaPixel />

    <!-- TikTok Pixel (TikTok Ads) -->
    <TikTokPixel />

    <!-- PostHog inicia pronto para resolver el experimento visual antes de interactuar. -->
    <PostHogSnippet />

    <!-- A/B tests (experimentos de PostHog, markup data-ab-*): en el head para
         aplicar la variante cacheada ANTES del primer pintado. -->
    <AbTests />
    <IconExperiment />
  </head>
  <body>
    {!hideBanner && <CountdownBanner />}
    <slot />
    <IosInstallPrompt />
    {IS_LIVE && <SubscribeModal />}
    {/* La promoción de la moneda terminó; no se generan nuevos códigos. */}
  </body>
</html>
