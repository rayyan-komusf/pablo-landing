---
// Layout del onboarding interactivo (página /onboarding).
// Independiente de Layout.astro: el onboarding trae su propio CSS
// (public/onboarding/styles) y no comparte estilos con la landing.
import PostHogSnippet from "../components/PostHogSnippet.astro";
import AbTests from "../components/AbTests.astro";
import IconExperiment from "../components/IconExperiment.astro";
import Atribucion from "../components/Atribucion.astro";
import Afiliado from "../components/Afiliado.astro";
import PabloActor from "../components/onboarding/PabloActor.astro";
import MetaPixel from "../components/MetaPixel.astro";
import TikTokPixel from "../components/TikTokPixel.astro";
const base = "/onboarding";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <!-- Modo pauta (Sandra 07-oct-2026): mismo criterio que Layout.astro. Al
         tráfico pagado no se le ofrece el plan Gratis (.solo-organico). -->
    <script is:inline>
      (function () {
        try {
          // Link de afiliado (?a= o guardado vigente, ver lib/afiliado.ts): mismo
          // modo sin Gratis, pero sin marcar la sesión como tráfico pagado.
          var formato = /^[A-Za-z0-9_.-]{2,40}$/;
          var a = new URLSearchParams(location.search).get("a");
          var guardado = null;
          try { guardado = JSON.parse(localStorage.getItem("pablo_afiliado") || "null"); } catch (e) {}
          if ((a && formato.test(a)) || (guardado && formato.test(guardado.codigo) && Date.now() - guardado.ts < 2592000000)) {
            document.documentElement.classList.add("pauta", "afiliado");
          }
          var esPauta =
            new URLSearchParams(location.search).get("utm_medium") === "paid" ||
            sessionStorage.getItem("pablo_pauta") === "1";
          if (!esPauta) return;
          sessionStorage.setItem("pablo_pauta", "1");
          document.documentElement.classList.add("pauta");
        } catch (e) {}
      })();
    </script>
    <style is:global>
      html.pauta .solo-organico { display: none !important; }
      html:not(.pauta) .solo-pauta { display: none !important; }
    </style>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <!-- SEO -->
    <title>Pablo · Tu asistente financiero</title>
    <meta
      name="description"
      content="Libérate del estrés financiero con Pablo, tu asistente de finanzas personales por WhatsApp."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://usapablo.com/onboarding" />
    <!-- Open Graph -->
    <meta property="og:title" content="Pablo · Tu asistente financiero" />
    <meta
      property="og:description"
      content="Libérate del estrés financiero con Pablo, tu asistente de finanzas personales por WhatsApp."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}/images/pablo/pablo-wave.png`} />
    <!-- Favicon -->
    <link rel="icon" type="image/png" href={`${base}/images/pablo/pablo-logo.png`} />
    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Estilos: base (reconstruido del deploy original) + overrides.
         ?v= : cache-busting manual — subirlo al cambiar custom.css para que
         producción no sirva una versión cacheada con markup nuevo. -->
    <link rel="stylesheet" href={`${base}/styles/base.css`} />
    <link rel="stylesheet" href={`${base}/styles/custom.css?v=47`} />
    <!-- Primer toque de marketing → localStorage (viaja en el signup) -->
    <Atribucion />
    <Afiliado />
    <!-- Meta Pixel (Facebook/Instagram Ads) -->
    <MetaPixel />
    <!-- TikTok Pixel: acá dispara CompleteRegistration antes de continuar al pago,
         sin él no habría cookie _ttp ni eventos del onboarding -->
    <TikTokPixel />

    <!-- PostHog (pageviews manuales: cada pantalla emite onboarding_screen_viewed) -->
    <PostHogSnippet capturePageview={false} />
    <AbTests />
    <IconExperiment />
  </head>
  <body>
    <div class="app-shell" id="appShell">
      <header class="topbar hidden" id="topbar" role="banner">
        <!-- Una sola fila estilo Duolingo: ← (atrás/salir) + barra de progreso -->
        <div class="w-full max-w-[560px] mx-auto flex items-center gap-2 px-1 mt-4">
          <button
            class="btn-back"
            onclick="pabloPrev()"
            aria-label="Volver al paso anterior o salir"
            title="Atrás"
          >
            ←
          </button>
          <div
            class="progress-track"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            id="progressTrack"
          >
            <div class="progress-fill" id="progressFill"></div>
          </div>
          <button
            class="btn-topbar-skip"
            id="topbarSkip"
            onclick="pabloSkip()"
            aria-label="Saltar este paso"
          >
            Saltar
          </button>
        </div>
      </header>

      <slot />

      <!-- Pablo persistente: vive FUERA de los steps para no desmontarse nunca. -->
      <PabloActor />
    </div>

    <!-- Motor de navegación -->
    <script src="../scripts/onboarding.js"></script>
  </body>
</html>
