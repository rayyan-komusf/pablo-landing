---
// Los dos lead magnets del final (Rodrigo, 19-ago): para quien llegó hasta acá
// pero todavía no está listo para comprar. El paso siguiente tiene que ser
// obvio y verse profesional, como la sección del English Test al final de la
// home de Duolingo. Van después del CTA final y antes de las preguntas.
//
//  1. La plantilla de presupuesto gratis → al blog donde se descarga
//     (/blog/plantilla-detox-financiero, el post del detox financiero).
//  2. El curso "Finanzas de un Futuro Millonario" → /cursos/camino-al-millon
//     (viene incluido con el plan de Pablo; la primera clase se puede ver
//     dejando el correo — ese gate vive en la página del curso).
const PABLO = "/onboarding/images/pablo/2d";
const ICONOS = "/onboarding/images/iconos";
---

<section class="lm" aria-label="Recursos gratis para empezar">
  <!-- ── Plantilla gratis (blanco) ── -->
  <div class="lm__bloque lm__bloque--blanco" id="plantilla-gratis">
    <div class="lm__escena" aria-hidden="true">
      <!-- Mini-réplica animada de la plantilla real "Reparte tu ingreso del
           mes": donut de 3 grupos + tablas Esenciales/Futuro/Estilo de vida,
           con las barras llenándose en loop. -->
      <div class="lm-plantilla">
        <div class="lm-plantilla__head">
          <img src="/onboarding/images/pablo/pablo-logo.png" alt="" width="18" height="18" />
          <span class="lm-plantilla__marca">Pablo</span>
        </div>
        <div class="lm-plantilla__cuerpo">
          <span class="lm-plantilla__donut"></span>
          <div class="lm-plantilla__tablas">
            <span class="lm-tabla" style="--c:#e8837a"><i style="--w:78%"></i><i style="--w:56%"></i><i style="--w:64%"></i></span>
            <span class="lm-tabla" style="--c:#7b92ef"><i style="--w:52%"></i><i style="--w:38%"></i></span>
            <span class="lm-tabla" style="--c:#4aa85c"><i style="--w:66%"></i><i style="--w:44%"></i><i style="--w:30%"></i></span>
          </div>
        </div>
      </div>
      <img class="lm__pablo" src={`${PABLO}/pablo-senalando.webp`} alt="" width="343" height="420" loading="lazy" />
    </div>
    <div class="lm__texto">
      <h2 class="lm__titulo">¿Todavía no estás listo?</h2>
      <p class="lm__desc">
        Empieza por tu cuenta con la plantilla de presupuesto <span class="highlight">gratis</span> de Pablo.
        Te la llevas hoy, y cuando quieras que él la llene por ti, ya sabes
        dónde encontrarlo.
      </p>
      <a class="lm__cta" href="/blog/plantilla-detox-financiero" onclick="window.posthog?.capture?.('lm_plantilla_clicked')">
        Leer el blog
      </a>
    </div>
  </div>

  <div class="lm-ola" aria-hidden="true"><svg viewBox="0 0 1440 90" preserveAspectRatio="none"><path fill="#ffffff" d="M0,46 C250,82 510,20 770,52 C1020,82 1250,28 1440,56 L1440,0 L0,0 Z"/></svg></div>

  <!-- ── El curso (lila) ── -->
  <div class="lm__bloque lm__bloque--lila" id="camino-al-millon">
    <div class="lm__escena" aria-hidden="true">
      <!-- Portada real del curso (el mapa "Camino al Millón") con marco
           cerámico y botón de play encima, como una clase esperándote. -->
      <div class="lm-clase">
        <img src="/cursos/camino-al-millon.webp" alt="" width="480" height="270" loading="lazy" />
        <span class="lm-clase__play" aria-hidden="true"></span>
      </div>
      <img class="lm__pablo lm__pablo--curso" src={`${PABLO}/pablo-explicando.webp`} alt="" width="316" height="420" loading="lazy" />
    </div>
    <div class="lm__texto">
      <h2 class="lm__titulo lm__titulo--navy">Empieza tu camino al <span class="lm__oro">primer millón</span></h2>
      <p class="lm__desc">
        El curso «Finanzas de un Futuro Millonario» viene <span class="highlight">incluido con tu plan</span>
        de Pablo. Mira la primera clase gratis dejando tu correo y decide con
        calma.
      </p>
      <a class="lm__cta" href="/cursos/camino-al-millon" onclick="window.posthog?.capture?.('lm_curso_clicked')">
        Ver la primera clase
      </a>
    </div>
  </div>
</section>

<style>
  .lm__bloque {
    padding: 72px 24px 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  .lm__bloque--blanco { background: #ffffff; }
  .lm__bloque--lila { background: #f5f3ff; }

  .lm-ola { line-height: 0; margin-top: -1px; background: #f5f3ff; }
  .lm-ola svg { width: 100%; height: 76px; display: block; }

  .lm__texto {
    max-width: 560px;
    text-align: center;
  }

  .lm__titulo {
    font-family: var(--font-display, "Outfit"), sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #f5a623;
  }

  /* El titular del curso va en azul oscuro y solo "primer millón" en
     amarillo (Rodrigo, 24-ago). */
  .lm__titulo--navy { color: #2b2c64; }
  .lm__oro { color: #f5a623; }

  .lm__desc {
    margin: 13px auto 22px;
    font-size: 16.5px;
    line-height: 1.6;
    color: #56578f;
    max-width: 52ch;
  }

  /* Botón de juguete navy: mismo lenguaje que los badges de descarga. */
  .lm__cta {
    display: inline-flex;
    align-items: center;
    min-height: 50px;
    padding: 13px 26px;
    border-radius: 16px;
    background: #2b2c64;
    color: #fff;
    font-family: var(--font-display, "Outfit"), sans-serif;
    font-weight: 700;
    font-size: 15.5px;
    text-decoration: none;
    box-shadow: 0 4px 0 0 #191a44, 0 6px 10px -6px rgba(43, 44, 100, 0.4);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  @media (hover: hover) {
    .lm__cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 5px 0 0 #191a44, 0 8px 12px -6px rgba(43, 44, 100, 0.42);
    }
  }

  .lm__cta:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 0 #191a44;
  }

  /* ── Escenas: Pablo con su prop, mismo lenguaje que el resto ── */
  .lm__escena {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 14px;
    min-height: 200px;
  }

  .lm__pablo {
    width: 150px;
    height: auto;
    animation: lmFlota 4.4s ease-in-out infinite;
    transform-origin: 50% 100%;
  }

  @keyframes lmFlota {
    0%, 100% { transform: translateY(0) rotate(-1deg); }
    50%      { transform: translateY(-7px) rotate(1deg); }
  }

  /* Mini-plantilla animada: réplica del template real en chiquito. */
  .lm-plantilla {
    width: 230px;
    background: #fff;
    border-radius: 18px;
    padding: 12px;
    box-shadow: 0 5px 0 0 #d9d4ec, 0 14px 20px -14px rgba(43, 44, 100, 0.35);
    transform: rotate(-3deg);
    margin-bottom: 22px;
  }

  .lm-plantilla__head {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 9px;
  }

  .lm-plantilla__head img { border-radius: 5px; }

  .lm-plantilla__marca {
    font-family: var(--font-display, "Outfit"), sans-serif;
    font-weight: 700;
    font-size: 12px;
    color: #2b2c64;
  }

  .lm-plantilla__cuerpo {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  /* Donut de 3 grupos (esenciales/futuro/estilo de vida) girando suave. */
  .lm-plantilla__donut {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    flex-shrink: 0;
    background: conic-gradient(#e8837a 0 52%, #7b92ef 52% 71%, #4aa85c 71% 100%);
    -webkit-mask: radial-gradient(circle, transparent 0 17px, #000 18px);
    mask: radial-gradient(circle, transparent 0 17px, #000 18px);
    animation: lmGira 9s linear infinite;
  }

  @keyframes lmGira { to { transform: rotate(360deg); } }

  .lm-plantilla__tablas {
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
  }

  .lm-tabla {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-left: 3px solid var(--c);
    padding-left: 6px;
  }

  .lm-tabla i {
    display: block;
    height: 7px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--c) 28%, #fff);
    width: 0;
    animation: lmLlena 5.5s cubic-bezier(0.3, 1.2, 0.5, 1) infinite;
  }

  .lm-tabla i:nth-child(2) { animation-delay: 0.35s; }
  .lm-tabla i:nth-child(3) { animation-delay: 0.7s; }

  @keyframes lmLlena {
    0%, 6%    { width: 0; }
    34%, 82%  { width: var(--w); }
    96%, 100% { width: 0; }
  }

  /* La clase: portada real con marco cerámico y play encima. */
  .lm-clase {
    position: relative;
    width: 250px;
    /* La caja sigue el ratio real de la portada (1460×752): con alturas
       fijas la imagen se estiraba o se recortaba (visible en tablet). */
    aspect-ratio: 1460 / 752;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 5px 0 0 #191a44, 0 14px 20px -14px rgba(43, 44, 100, 0.45);
    transform: rotate(2.5deg);
    margin-bottom: 26px;
    border: 3px solid #2b2c64;
  }

  .lm-clase img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lm-clase__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: rgba(43, 44, 100, 0.85);
    animation: lmLate 2.4s ease-in-out infinite;
  }

  .lm-clase__play::after {
    content: "";
    position: absolute;
    left: 55%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-top: 9px solid transparent;
    border-bottom: 9px solid transparent;
    border-left: 14px solid #f5a623;
  }

  @keyframes lmLate {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.09); }
  }

  @media (max-width: 640px) {
    .lm__bloque { padding: 50px 18px 58px; }
    .lm-ola svg { height: 44px; }
    .lm__pablo { width: 124px; }
    .lm-plantilla { width: 146px; }
    .lm-clase { width: 186px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lm__pablo { animation: none; }
  }
</style>
