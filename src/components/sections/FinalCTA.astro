---
import { Image } from 'astro:assets';
import logoImg from '../../assets/Logo.png';
import { IS_LIVE, CTA } from '../../siteConfig';
// src/components/sections/FinalCTA.astro
---

<section class="fcta">
  <!-- Íconos 3D de Pablo flotando sobre el navy: el cierre se siente vivo. -->
  <img class="icono-flota icono-flota--oscuro fcta__icono fcta__icono--alcancia" src="/landing/iconos/alcancia.webp" alt="" aria-hidden="true" width="240" height="240" loading="lazy" decoding="async" />
  <img class="icono-flota icono-flota--oscuro fcta__icono fcta__icono--cohete" src="/landing/iconos/cohete.webp" alt="" aria-hidden="true" width="240" height="240" loading="lazy" decoding="async" />
  <img class="icono-flota icono-flota--oscuro fcta__icono fcta__icono--estrella" src="/landing/iconos/estrella.webp" alt="" aria-hidden="true" width="240" height="240" loading="lazy" decoding="async" />
  <div class="container fcta__inner">
    <div class="fcta-logo">
      <Image src={logoImg} alt="Pablo" width={56} height={56} class="fcta-logo-img" />
    </div>
    <h2 class="fcta__title">¿Buscas tranquilidad<br />al manejar tu dinero?</h2>
    <p class="fcta__desc">
      Pablo te ayuda a entender tus gastos, ahorrar mejor y <span class="highlight highlight--navy">dejar atrás el estrés</span> financiero.
      <strong>Empieza gratis en web o iOS. WhatsApp con Premium.</strong>
    </p>
    {IS_LIVE
      ? <a href={CTA.href!} class="btn-primary fcta__cta" id="finalcta-btn">{CTA.label} <span class="btn-arrow">→</span></a>
      : <button onclick="window.openWaitlistModal()" class="btn-primary fcta__cta" id="finalcta-btn">{CTA.label} <span class="btn-arrow">→</span></button>
    }
  </div>
</section>

<style>
  /* Fondo navy de Pablo (Rodrigo, 20-ago) — el CTA final y la descarga son
   * los dos momentos oscuros de la página. */
  .fcta {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 80% at 50% 0%, rgba(245, 166, 35, 0.14), transparent 70%),
      #2b2c64;
    padding: var(--section-py) 0;
  }

  .fcta__inner { position: relative; z-index: 3; }

  .fcta__icono--alcancia { --s: 120px; --dur: 7s; top: 22%; left: max(2%, calc(50% - 540px)); }
  .fcta__icono--cohete { --s: 110px; --dur: 6s; --delay: -2.5s; --r0: 10deg; --r1: 18deg; bottom: 14%; right: max(2%, calc(50% - 540px)); }
  .fcta__icono--estrella { --s: 54px; --dur: 5s; --delay: -1s; top: 14%; right: max(10%, calc(50% - 420px)); }

  @media (max-width: 900px) {
    .fcta__icono--alcancia { --s: 64px; top: 34px; left: 12px; }
    .fcta__icono--cohete { --s: 60px; bottom: 18px; right: 12px; }
    .fcta__icono--estrella { display: none; }
  }

  .fcta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
    max-width: 640px;
    margin: 0 auto;
  }

  .fcta-logo {
    width: 80px;
    height: 80px;
    background: var(--color-amber);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(245, 166, 35, 0.35);
    overflow: hidden;
  }

  .fcta-logo-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .fcta__title {
    font-family: var(--font-display, "Outfit"), sans-serif;
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    /* Sobre navy el titular va en blanco (Rodrigo, 24-ago). */
    color: #ffffff;
  }

  .fcta__desc {
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    max-width: 52ch;
  }

  .fcta__cta {
    margin-top: 8px;
    font-size: 17px;
    padding: 16px 36px;
  }

  @media (max-width: 768px) {
    .fcta__title {
      font-size: 28px;
    }

    .fcta__desc {
      font-size: 15px;
    }
  }
</style>
