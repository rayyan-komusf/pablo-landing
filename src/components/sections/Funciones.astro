---
import { APP_STORE_URL } from '../../siteConfig';
// Recorrido de beneficios.
//
// Estructura (Rodrigo, 19-ago): título + descripción CENTRADOS, sin eyebrows;
// bloques que alternan lila/blanco separados por olas, nunca por una línea
// recta; y la descarga centrada al final del mismo flujo.
//
// ⚠️ LAS ESCENAS SON UN SLOT ÚNICO. Se intentó armarlas con primitivas CSS
// (una cama de divs, soldaditos marchando, una pista de carrera) y el
// resultado eran "piezas juntadas", no una animación: cada elemento se movía
// por su cuenta y nada se leía como una sola pieza. Cada bloque declara ahora
// UN solo hueco `[data-escena]` que espera UN video WebM con alfa — la escena
// completa, animada de una sola pieza. Mientras ese video no exista, cae al
// clip actual de Pablo solo, que sí se ve bien.
//
// El brief para producir esos cinco videos está en
// `docs/brief-animaciones-landing.md`.
const PABLO = "/onboarding/images/pablo/2d";

const BLOQUES = [
  {
    id: "companero",
    tono: "lila",
    titulo: "Un amigo que sabe de plata, no otra app de banco",
    texto:
      "Pablo te responde al toque y en cristiano, como un pata que sabe del tema. Sin jerga financiera, sin sermones y sin hacerte sentir mal por un gasto.",
    escena: "cama",      // pendiente: Pablo echado en su cama con el celular
    respaldo: "saludando",
  },
  {
    id: "sin-esfuerzo",
    tono: "blanco",
    titulo: "Tú vive tu vida, Pablo lleva las cuentas",
    texto:
      "Cada gasto que le cuentas mueve tu presupuesto al instante. Nada de planillas, ni de fuerza de voluntad, ni de acordarte a fin de mes.",
    escena: "presupuesto", // pendiente: presupuesto 3D flotante moviéndose
    respaldo: "anotando",
  },
  {
    id: "motivacion",
    tono: "lila",
    titulo: "Cuidar tu plata por fin se siente bien",
    texto:
      "Cada día que registras suma racha, y cada sol que ordenas te acerca. Pablo corre contigo hacia tu libertad financiera, un día a la vez.",
    escena: "corriendo",   // pendiente: corriendo hacia la meta inalcanzable
    respaldo: "emocionado",
  },
  {
    id: "claridad",
    tono: "blanco",
    titulo: "Cada sol encuentra su lugar",
    texto:
      "Mientras le escribes por WhatsApp, Pablo pasa lista: caza los gastos hormiga que se te escapan y te muestra a dónde va tu sueldo de verdad.",
    escena: "soles",       // pendiente: soldaditos-moneda marchando
    respaldo: "anotando",
  },
];
---


<section class="fx" id="funciones" aria-label="Por qué Pablo">
  {
    BLOQUES.map((b, i) => (
      <>
        <div class:list={["fx__bloque", `fx__bloque--${b.tono}`]} id={b.id}>
          <div class="fx__texto">
            <h2 class="fx__titulo">{b.titulo}</h2>
            <p class="fx__desc">{b.texto}</p>
          </div>

          {/* Slot de escena: un solo video con alfa cuando exista. */}
          <div class="fx-escena" data-escena={b.escena} aria-hidden="true">
            <div class="fx-pablo">
              <img src={`${PABLO}/pablo-${b.respaldo}.webp`} alt="" width="445" height="420" loading={i === 0 ? "eager" : "lazy"} />
              <video data-src={`${PABLO}/pablo-${b.respaldo}.webm`} muted loop playsinline preload="none" width="445" height="420"></video>
              <span class="fx-sombra"></span>
            </div>
          </div>
        </div>

        <div class="fx-ola" data-desde={b.tono} aria-hidden="true">
          <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
            <path d="M0,46 C240,80 500,16 760,50 C1010,82 1240,26 1440,54 L1440,0 L0,0 Z" />
          </svg>
        </div>
      </>
    ))
  }

  {/* ── Descarga: todo centrado ── */}
  <div class="fx__bloque fx__bloque--lila" id="descarga">
    <div class="fx__texto">
      <h2 class="fx__titulo">Pablo va donde tú vas</h2>
      <p class="fx__desc">
        En WhatsApp, en la web y ahora también en tu iPhone. Descarga la app y
        ten tu plata clara en el bolsillo, estés donde estés.
      </p>
    </div>

    <div class="fx-escena" data-escena="celular" aria-hidden="true">
      <div class="fx-pablo">
        <img src={`${PABLO}/pablo-saludando.webp`} alt="" width="445" height="420" loading="lazy" />
        <video data-src={`${PABLO}/pablo-saludando.webm`} muted loop playsinline preload="none" width="445" height="420"></video>
        <span class="fx-sombra"></span>
      </div>
    </div>

    <div class="fx__badges">
      <a
        class="fx-badge"
        href={APP_STORE_URL}
        target="_blank"
        rel="noopener"
        onclick="window.posthog?.capture?.('descarga_appstore_clicked')"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
          <path d="M17.05 12.54c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.72-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.87-.76-1.48.02-2.84.86-3.6 2.18-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.25 2.74 2.2 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.7.71 2.87.69 1.18-.02 1.93-1.08 2.65-2.14.83-1.22 1.18-2.41 1.2-2.47-.03-.01-2.3-.88-2.32-3.5zM14.9 5.9c.6-.74 1.01-1.76.9-2.78-.87.04-1.93.58-2.56 1.31-.56.65-1.06 1.7-.93 2.7.97.08 1.97-.5 2.59-1.23z"/>
        </svg>
        <span>
          <small>Descárgala en el</small>
          <strong>App Store</strong>
        </span>
      </a>
      <span class="fx-badge fx-badge--pronto">
        <svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" aria-hidden="true">
          <path d="M17.6 9.48l1.84-3.18a.4.4 0 0 0-.7-.4L16.87 9.1a11.4 11.4 0 0 0-9.75 0L5.25 5.9a.4.4 0 1 0-.7.4L6.4 9.48A10.8 10.8 0 0 0 1 17.9h22a10.8 10.8 0 0 0-5.4-8.42zM7 14.6a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8zm10 0a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8z"/>
        </svg>
        <span>
          <small>Android</small>
          <strong>Viene pronto</strong>
        </span>
      </span>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const suave = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const probe = document.createElement("video");
    const hayAlfa = !!probe.canPlayType && probe.canPlayType('video/webm; codecs="vp9"') !== "";
    if (!hayAlfa || suave) return;

    // Cada escena reproduce solo cuando está a la vista: cinco videos
    // corriendo fuera de pantalla es batería quemada al cohete.
    document.querySelectorAll(".fx-pablo video[data-src]").forEach((v) => {
      v.src = v.dataset.src;
      v.closest(".fx-pablo").classList.add("fx-pablo--video");
      new IntersectionObserver(
        ([e]) => (e.isIntersecting ? v.play?.().catch(() => {}) : v.pause?.()),
        { rootMargin: "120px" }
      ).observe(v);
    });
  })();
</script>

<style>
  /* Bloques centrados, alternando lila/blanco. */
  .fx__bloque {
    padding: 76px 24px 84px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .fx__bloque--lila { background: #f5f3ff; }
  .fx__bloque--blanco { background: #ffffff; }

  .fx__texto {
    max-width: 620px;
    text-align: center;
  }

  .fx__titulo {
    font-family: var(--font-display, "Outfit"), sans-serif;
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: #2b2c64;
  }

  .fx__desc {
    margin: 14px auto 0;
    font-size: 17px;
    line-height: 1.6;
    color: #56578f;
    max-width: 52ch;
  }

  /* Ola entre bloques: el corte de color nunca es una línea recta.
     El path se pinta del color del bloque de ARRIBA y el contenedor toma el
     del bloque de abajo, así la curva "muerde" hacia la sección siguiente. */
  .fx-ola { line-height: 0; margin-top: -1px; }
  .fx-ola svg { width: 100%; height: 72px; display: block; }

  /* El <path> hereda el color del bloque de ARRIBA vía currentColor y el
     contenedor pinta el de abajo, así la curva muerde hacia la sección
     siguiente. Se usa `color` en vez de `fill` porque Astro scopea el
     selector y `path { fill }` no siempre gana contra el atributo. */
  .fx-ola svg path { fill: currentColor; }
  .fx-ola[data-desde="lila"] { background: #ffffff; color: #f5f3ff; }
  .fx-ola[data-desde="blanco"] { background: #f5f3ff; color: #ffffff; }

  /* Slot de escena: hoy un Pablo animado; mañana el video de la escena
     completa, que ocupa este mismo hueco sin tocar el layout. */
  .fx-escena {
    position: relative;
    width: min(560px, 100%);
    display: flex;
    justify-content: center;
  }

  .fx-pablo {
    position: relative;
    width: 210px;
  }

  .fx-pablo img,
  .fx-pablo video { width: 100%; height: auto; display: block; }
  .fx-pablo video { position: absolute; inset: 0; opacity: 0; }
  .fx-pablo--video video { opacity: 1; }
  .fx-pablo--video img { opacity: 0; }

  /* Sombra de contacto pegada a los pies. Los WebM se recortan anclados al
     píxel más bajo del personaje, así que el borde inferior del video ES el
     suelo: sin ese recorte la sombra flotaba lejos de Pablo. */
  .fx-sombra {
    position: absolute;
    bottom: -4px;
    left: 50%;
    width: 50%;
    height: 10px;
    transform: translateX(-50%);
    background: rgba(43, 44, 100, 0.15);
    border-radius: 50%;
    filter: blur(4px);
  }

  /* ── Badges de descarga (centrados) ── */
  .fx__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .fx-badge {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-height: 56px;
    padding: 10px 20px;
    border-radius: 16px;
    text-decoration: none;
    background: #2b2c64;
    color: #fff;
    box-shadow: 0 4px 0 0 #191a44, 0 6px 10px -6px rgba(43, 44, 100, 0.4);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }

  @media (hover: hover) {
    a.fx-badge:hover {
      transform: translateY(-1px);
      box-shadow: 0 5px 0 0 #191a44, 0 8px 12px -6px rgba(43, 44, 100, 0.42);
    }
  }

  a.fx-badge:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 0 #191a44;
  }

  .fx-badge--pronto {
    background: transparent;
    border: 2px dashed rgba(43, 44, 100, 0.35);
    color: #56578f;
    box-shadow: none;
    cursor: default;
  }

  .fx-badge small {
    display: block;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .fx-badge strong {
    display: block;
    font-family: var(--font-display, "Outfit"), sans-serif;
    font-size: 16px;
    line-height: 1.15;
  }

  @media (max-width: 640px) {
    .fx__bloque { padding: 52px 18px 60px; gap: 26px; }
    .fx__desc { font-size: 16px; }
    .fx-ola svg { height: 44px; }
    .fx-pablo { width: 176px; }
  }
</style>
