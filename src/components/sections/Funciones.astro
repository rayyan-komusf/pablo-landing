---
// Recorrido largo de funciones, estructura de la home de Duolingo: una función
// por sección, a pantalla ancha, alternando el lado de la ilustración, con
// titular corto + un párrafo + la escena animada.
//
// Las animaciones son CSS puro, hechas a mano, en loop infinito: nunca se
// detienen, así que la página se siente viva mientras se lee. Nada generado con
// IA — son las piezas reales de la interfaz de Pablo moviéndose (burbujas de
// WhatsApp que se escriben solas, barras de presupuesto que se llenan, la racha
// que se enciende día por día, la notificación que entra, las barras del
// reporte que crecen).
//
// Los tiempos son deliberadamente distintos entre secciones (7.5s, 6s, 8s, 9s,
// 7s) para que al hacer scroll nunca se vean dos animaciones en sincronía: eso
// es lo que delata un loop mecánico.

const FUNCIONES = [
  {
    id: "whatsapp",
    eyebrow: "Sin apps nuevas",
    titulo: "Registra un gasto como le escribes a un amigo",
    texto:
      "Mándale un mensaje, un audio o la foto de tu boleta. Pablo entiende, lo categoriza y te responde en segundos. Todo dentro de WhatsApp, donde ya pasas el día.",
    escena: "chat",
  },
  {
    id: "presupuesto",
    eyebrow: "Presupuestos",
    titulo: "Tu presupuesto se actualiza solo",
    texto:
      "No tienes que abrir una hoja de cálculo ni cuadrar nada a fin de mes. Cada gasto que registras mueve tus categorías al instante, y ves cuánto te queda de verdad.",
    escena: "presupuesto",
  },
  {
    id: "racha",
    eyebrow: "Racha",
    titulo: "Un día a la vez, hasta que se vuelve costumbre",
    texto:
      "Registrar tus gastos es un hábito, no una tarea. Pablo te lleva la cuenta de los días seguidos y celebra contigo cada vez que sumas uno más.",
    escena: "racha",
  },
  {
    id: "recordatorios",
    eyebrow: "Recordatorios",
    titulo: "Pablo te escribe primero",
    texto:
      "Antes de que venza tu tarjeta, cuando se te está yendo la mano en una categoría, o si llevas días sin registrar. Te avisa a tiempo y sin sermones.",
    escena: "recordatorio",
  },
  {
    id: "reportes",
    eyebrow: "Reportes",
    titulo: "Por fin sabes a dónde se fue tu plata",
    texto:
      "Cada semana te llega el resumen: en qué gastaste, qué subió respecto al mes pasado y dónde están tus gastos hormiga. En cristiano, sin tecnicismos de banco.",
    escena: "reporte",
  },
];
---

<section class="fx" id="funciones" aria-label="Qué hace Pablo">
  {
    FUNCIONES.map((f, i) => (
      <div class:list={["fx__bloque", i % 2 === 1 && "fx__bloque--invertido"]} id={f.id}>
        <div class="fx__texto">
          <span class="fx__eyebrow">{f.eyebrow}</span>
          <h2 class="fx__titulo">{f.titulo}</h2>
          <p class="fx__desc">{f.texto}</p>
        </div>

        <div class="fx__escena" aria-hidden="true">
          {/* ── Chat de WhatsApp que se escribe solo ── */}
          {f.escena === "chat" && (
            <div class="esc esc--chat">
              <div class="chat-burbuja chat-burbuja--yo">Gasté 18 lucas en el almuerzo</div>
              <div class="chat-burbuja chat-burbuja--pablo chat-burbuja--tecleando">
                <i /><i /><i />
              </div>
              <div class="chat-burbuja chat-burbuja--pablo chat-burbuja--r1">
                Listo, lo puse en <b>Comida</b> · S/.18
              </div>
              <div class="chat-burbuja chat-burbuja--pablo chat-burbuja--r2">
                Llevas S/.212 este mes ahí. Te queda S/.88
              </div>
            </div>
          )}

          {/* ── Barras de presupuesto que se llenan ── */}
          {f.escena === "presupuesto" && (
            <div class="esc esc--pres">
              {[
                { n: "Comida", p: 71, c: "#e8a87c" },
                { n: "Transporte", p: 44, c: "#3fa643" },
                { n: "Casa", p: 88, c: "#d4a853" },
                { n: "Ahorro", p: 32, c: "#9b8ec4" },
              ].map((b, k) => (
                <div class="pres-fila" style={`--i:${k}`}>
                  <span class="pres-nombre">{b.n}</span>
                  <span class="pres-pista">
                    <i style={`--p:${b.p}%;--c:${b.c}`} />
                  </span>
                </div>
              ))}
            </div>
          )}

          {/* ── Racha: la semana se enciende día por día ── */}
          {f.escena === "racha" && (
            <div class="esc esc--racha">
              <div class="racha-dias">
                {["L", "M", "M", "J", "V", "S", "D"].map((d, k) => (
                  <span class="racha-dia" style={`--i:${k}`}>
                    <i />
                    <em>{d}</em>
                  </span>
                ))}
              </div>
              <p class="racha-cifra"><b>7</b> días seguidos</p>
            </div>
          )}

          {/* ── Notificación que entra y se va ── */}
          {f.escena === "recordatorio" && (
            <div class="esc esc--aviso">
              <div class="aviso aviso--1">
                <img src="/onboarding/images/pablo/pablo-logo.png" alt="" width="34" height="34" />
                <div>
                  <b>Pablo</b>
                  <span>Tu tarjeta vence el viernes. ¿La programamos?</span>
                </div>
              </div>
              <div class="aviso aviso--2">
                <img src="/onboarding/images/pablo/pablo-logo.png" alt="" width="34" height="34" />
                <div>
                  <b>Pablo</b>
                  <span>Vas 80% de tu presupuesto de comida y falta media semana</span>
                </div>
              </div>
            </div>
          )}

          {/* ── Reporte: barras que crecen ── */}
          {f.escena === "reporte" && (
            <div class="esc esc--reporte">
              <div class="rep-barras">
                {[38, 62, 45, 88, 54, 71, 30].map((h, k) => (
                  <i style={`--h:${h}%;--i:${k}`} />
                ))}
              </div>
              <div class="rep-pie">
                <span class="rep-chip">Comida <b>+12%</b></span>
                <span class="rep-chip rep-chip--baja">Delivery <b>−31%</b></span>
              </div>
            </div>
          )}
        </div>
      </div>
    ))
  }
</section>

<style>
  .fx {
    background: var(--bg-page, #f5f3ff);
  }

  /* Cada función ocupa su propio bloque generoso, como en la home de Duolingo:
     el contenido respira y el scroll tiene ritmo. */
  .fx__bloque {
    max-width: 1080px;
    margin-inline: auto;
    padding: 84px 24px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
    border-bottom: 2px solid rgba(43, 44, 100, 0.07);
  }

  .fx__bloque:last-child {
    border-bottom: 0;
  }

  /* Se alterna el lado sin reordenar el DOM: el texto siempre va primero para
     lectores de pantalla, la ilustración solo cambia de columna. */
  .fx__bloque--invertido .fx__texto {
    order: 2;
  }

  .fx__eyebrow {
    display: inline-block;
    font-family: var(--font-display, "Outfit"), sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a6410;
    margin-bottom: 10px;
  }

  .fx__titulo {
    font-family: var(--font-display, "Outfit"), sans-serif;
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: #2b2c64;
  }

  .fx__desc {
    margin-top: 14px;
    font-size: 17px;
    line-height: 1.6;
    color: #56578f;
    max-width: 46ch;
  }

  /* --- Lienzo común de las escenas --- */
  .esc {
    background: #fff;
    border-radius: 24px;
    padding: 22px;
    box-shadow: 0 5px 0 0 rgba(43, 44, 100, 0.1), 0 14px 26px -14px rgba(43, 44, 100, 0.3);
    min-height: 268px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  /* ══ Chat ══ */
  .chat-burbuja {
    max-width: 82%;
    padding: 11px 14px;
    border-radius: 16px;
    font-size: 14.5px;
    line-height: 1.4;
    color: #2b2c64;
    opacity: 0;
  }

  .chat-burbuja--yo {
    align-self: flex-end;
    background: #d9fdd3;
    border-bottom-right-radius: 5px;
    animation: burbujaEntra 7.5s var(--ease-clay, cubic-bezier(0.34, 1.4, 0.64, 1)) infinite;
  }

  .chat-burbuja--pablo {
    align-self: flex-start;
    background: #f1eefb;
    border-bottom-left-radius: 5px;
    animation: burbujaEntra 7.5s var(--ease-clay, cubic-bezier(0.34, 1.4, 0.64, 1)) infinite;
  }

  .chat-burbuja--tecleando {
    display: flex;
    gap: 4px;
    padding: 14px;
    animation-name: burbujaTeclea;
  }

  .chat-burbuja--tecleando i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #a9a5c4;
    animation: teclea 1.2s ease-in-out infinite;
  }
  .chat-burbuja--tecleando i:nth-child(2) { animation-delay: 0.15s; }
  .chat-burbuja--tecleando i:nth-child(3) { animation-delay: 0.3s; }

  .chat-burbuja--yo { animation-delay: 0s; }
  .chat-burbuja--tecleando { animation-delay: 1.1s; }
  .chat-burbuja--r1 { animation-delay: 2.4s; }
  .chat-burbuja--r2 { animation-delay: 3.4s; }

  @keyframes burbujaEntra {
    0%, 4%     { opacity: 0; transform: translateY(9px) scale(0.96); }
    9%, 88%    { opacity: 1; transform: none; }
    96%, 100%  { opacity: 0; transform: translateY(-4px); }
  }

  @keyframes burbujaTeclea {
    0%, 12%   { opacity: 0; }
    16%, 30%  { opacity: 1; }
    34%, 100% { opacity: 0; }
  }

  @keyframes teclea {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
    30%           { transform: translateY(-4px); opacity: 1; }
  }

  /* ══ Presupuesto ══ */
  .pres-fila {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pres-nombre {
    flex: 0 0 92px;
    font-size: 14px;
    font-weight: 600;
    color: #2b2c64;
  }

  .pres-pista {
    flex: 1;
    height: 15px;
    border-radius: 999px;
    background: rgba(43, 44, 100, 0.08);
    overflow: hidden;
  }

  .pres-pista i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--c);
    animation: llenar 6s cubic-bezier(0.3, 1.2, 0.5, 1) infinite;
    animation-delay: calc(var(--i) * 0.16s);
  }

  @keyframes llenar {
    0%, 3%    { width: 0; }
    32%, 76%  { width: var(--p); }
    92%, 100% { width: 0; }
  }

  /* ══ Racha ══ */
  .racha-dias {
    display: flex;
    justify-content: space-between;
    gap: 6px;
  }

  .racha-dia {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    flex: 1;
  }

  .racha-dia i {
    width: 100%;
    aspect-ratio: 1;
    max-width: 42px;
    border-radius: 14px;
    background: rgba(43, 44, 100, 0.07);
    box-shadow: inset 0 -3px 0 0 rgba(43, 44, 100, 0.05);
    animation: enciende 8s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.42s);
  }

  /* #8b8aa8 daba 3.33:1 sobre blanco y AA exige 4.5:1 en texto normal.
     Medido, no estimado — #6a6990 da 5.20:1. */
  .racha-dia em {
    font-size: 12px;
    font-style: normal;
    font-weight: 700;
    color: #6a6990;
  }

  @keyframes enciende {
    0%, 6%    { background: rgba(43, 44, 100, 0.07); box-shadow: inset 0 -3px 0 0 rgba(43, 44, 100, 0.05); transform: scale(1); }
    14%       { transform: scale(1.16); }
    20%, 80%  { background: #f5a623; box-shadow: inset 0 -3px 0 0 #c97f0c; transform: scale(1); }
    94%, 100% { background: rgba(43, 44, 100, 0.07); box-shadow: inset 0 -3px 0 0 rgba(43, 44, 100, 0.05); }
  }

  .racha-cifra {
    text-align: center;
    margin-top: 6px;
    font-family: var(--font-display, "Outfit"), sans-serif;
    font-size: 17px;
    color: #56578f;
  }

  .racha-cifra b {
    font-size: 30px;
    color: #2b2c64;
  }

  /* ══ Recordatorio ══ */
  .esc--aviso {
    justify-content: flex-start;
    gap: 10px;
  }

  .aviso {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 13px;
    border-radius: 18px;
    background: #fff;
    border: 2px solid rgba(43, 44, 100, 0.09);
    box-shadow: 0 4px 0 0 rgba(43, 44, 100, 0.07);
    opacity: 0;
    animation: avisoEntra 9s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  .aviso--2 { animation-delay: 4.5s; }

  .aviso img { border-radius: 10px; flex-shrink: 0; }
  .aviso b { display: block; font-size: 13.5px; color: #2b2c64; }
  .aviso span { font-size: 13.5px; line-height: 1.4; color: #56578f; }

  @keyframes avisoEntra {
    0%, 2%    { opacity: 0; transform: translateY(-16px) scale(0.97); }
    8%, 44%   { opacity: 1; transform: none; }
    52%, 100% { opacity: 0; transform: translateY(-8px); }
  }

  /* ══ Reporte ══ */
  .rep-barras {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 9px;
    height: 150px;
  }

  .rep-barras i {
    flex: 1;
    height: 0;
    border-radius: 10px 10px 4px 4px;
    background: linear-gradient(180deg, #7d78b8, #2b2c64);
    animation: crece 7s cubic-bezier(0.3, 1.2, 0.5, 1) infinite;
    animation-delay: calc(var(--i) * 0.09s);
  }

  @keyframes crece {
    0%, 4%    { height: 0; }
    30%, 78%  { height: var(--h); }
    94%, 100% { height: 0; }
  }

  .rep-pie {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .rep-chip {
    font-size: 12.5px;
    font-weight: 600;
    color: #56578f;
    background: rgba(43, 44, 100, 0.06);
    padding: 6px 11px;
    border-radius: 999px;
  }

  .rep-chip b { color: #a33b3b; }
  .rep-chip--baja b { color: #2c7a3f; }

  /* --- Responsive --- */
  @media (max-width: 860px) {
    .fx__bloque {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 54px 20px;
    }
    /* En una sola columna la ilustración va SIEMPRE debajo del texto: el
       alternado de escritorio dejaría bloques donde la imagen llega antes que
       su explicación. */
    .fx__bloque--invertido .fx__texto {
      order: 0;
    }
    .fx__desc {
      font-size: 16px;
    }
    .esc {
      min-height: 232px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat-burbuja,
    .chat-burbuja--tecleando i,
    .pres-pista i,
    .racha-dia i,
    .aviso,
    .rep-barras i {
      animation: none;
      opacity: 1;
    }
    /* Sin movimiento, las barras se quedan en su valor final en vez de en cero */
    .pres-pista i { width: var(--p); }
    .rep-barras i { height: var(--h); }
    .racha-dia i { background: #f5a623; box-shadow: inset 0 -3px 0 0 #c97f0c; }
  }
</style>
