---
// src/components/sections/FAQ.astro

const faqs = [
  {
    question: "¿Pablo es gratis?",
    answer:
      "Sí. Gratis incluye 5 mensajes al día, hasta 3 cuentas, una moneda, una meta, una transacción recurrente y presupuestos y categorías predeterminados. WhatsApp, email, importaciones, exportaciones y personalización son Premium.",
  },
  {
    question: "¿Cómo protege Pablo mis datos?",
    answer:
      "Tus datos están protegidos con encriptación. No compartimos tu información con terceros.",
  },
  {
    question: "¿Necesito instalar algo?",
    answer:
      "Puedes empezar en la web sin instalar nada o descargar la app para iPhone. Android estará disponible próximamente.",
  },
  {
    question: "¿Cómo empiezo?",
    answer:
      "Haz clic en Empieza gratis, crea tu cuenta y elige Seguir con Gratis. No necesitas tarjeta de crédito.",
  },
  // Las 5 de abajo salen de preguntas REALES medidas en los DMs de Pablo
  // (21.230 mensajes analizados): pago con Yape (15 personas lo pidieron),
  // confusión de moneda (18 casos), Android, cancelación y qué pasa tras pagar.
  {
    question: "¿Puedo pagar con Yape o Plin?",
    answer:
      "Por ahora los planes se pagan con tarjeta de débito o crédito. El pago lo procesa Flow, una pasarela segura: Pablo nunca ve los datos de tu tarjeta.",
  },
  {
    question: "¿Los precios son en soles o en dólares?",
    answer:
      "En soles peruanos, siempre. Pablo está hecho en Perú y para el Perú: nada de sorpresas por tipo de cambio.",
  },
  {
    question: "¿Funciona en Android?",
    answer:
      "La app de Android estará disponible próximamente. Mientras tanto, puedes usar la web desde tu celular. La app para iPhone ya está en App Store.",
  },
  {
    question: "¿Puedo cancelar cuando quiera?",
    answer:
      "Sí, desde tu perfil en la app, en dos toques y sin preguntas. Y si cancelas durante tu prueba gratis, no se te cobra nada.",
  },
  {
    question: "Ya pagué, ¿y ahora qué?",
    answer:
      "Entras directo a tu cuenta y Pablo te guía para registrar tu primer gasto por WhatsApp. En menos de un minuto ya está trabajando contigo.",
  },
];
---

<section class="faq" id="faq">
  <div class="container faq__inner">
    <div class="faq__header">
      <h2 class="section-title faq__title">
        ¿Tienes preguntas? Tenemos las respuestas
      </h2>
      <p class="faq__subtitle"><span class="highlight">Todo</span> lo que necesitas saber sobre Pablo</p>
    </div>

    <div class="faq__list" role="list">
      {
        faqs.map((faq, i) => (
          <div class="faq-item" role="listitem">
            <button
              class="faq-question"
              aria-expanded="false"
              aria-controls={`faq-answer-${i}`}
              id={`faq-btn-${i}`}
            >
              <span>{faq.question}</span>
              <svg
                class="faq-chevron"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </button>
            <div
              class="faq-answer"
              id={`faq-answer-${i}`}
              role="region"
              aria-labelledby={`faq-btn-${i}`}
              hidden
            >
              <p>{faq.answer}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--bg-faq);
    padding: var(--section-py) 0;
  }

  .faq__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  .faq__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq__title {
    font-size: 40px;
    line-height: 1.15;
    max-width: 600px;
  }

  .faq__subtitle {
    font-size: 16px;
    color: var(--color-body);
  }

  .faq__list {
    width: 100%;
    max-width: 780px;
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid rgba(43, 44, 100, 0.1);
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 4px;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-heading);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: color 0.15s;
  }

  .faq-question:hover {
    color: var(--color-purple);
  }

  .faq-chevron {
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: var(--color-heading);
  }

  .faq-question[aria-expanded="true"] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-question[aria-expanded="true"] {
    color: var(--color-purple);
  }

  .faq-answer {
    overflow: hidden;
  }

  .faq-answer p {
    padding: 0 4px 22px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-body);
    animation: fadeIn 0.25s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .faq__title {
      font-size: 28px;
    }

    .faq-question {
      font-size: 15px;
    }
  }
</style>

<script>
  document.querySelectorAll(".faq-question").forEach((button) => {
    button.addEventListener("click", () => {
      const isExpanded = button.getAttribute("aria-expanded") === "true";
      const answerId = button.getAttribute("aria-controls")!;
      const answer = document.getElementById(answerId);

      // Close all others
      document.querySelectorAll(".faq-question").forEach((b) => {
        b.setAttribute("aria-expanded", "false");
        const id = b.getAttribute("aria-controls")!;
        const a = document.getElementById(id);
        if (a) a.hidden = true;
      });

      // Toggle current
      if (!isExpanded) {
        button.setAttribute("aria-expanded", "true");
        if (answer) answer.hidden = false;
      }
    });
  });
</script>
