---
// src/components/sections/Features.astro
//
// Íconos 3D de la marca Pablo (Higgsfield, 30-sep), exportados a WebP
// 240px con alfa real. Cada uno va en un tile tintado con su propio color
// dominante; la tinta del tile y la del halo salen de la misma variable.
const ICONOS = "/landing/iconos";
---

<section class="features">
  <div class="container features__grid">

    <!-- Card 1: WhatsApp Registration -->
    <div class="feat-card">
      <div class="feat-icon feat-icon--green" aria-hidden="true">
        <img src={`${ICONOS}/chat-whatsapp.webp`} alt="" width="240" height="240" loading="lazy" decoding="async" />
      </div>
      <h3 class="feat-title">WhatsApp con Premium</h3>
      <p class="feat-desc">
        Anota tus gastos e ingresos con un mensaje, una nota de voz, o una foto
        de tu factura. Pablo lo entiende y registra todo.
      </p>
    </div>

    <!-- Card 2: Visual Reports -->
    <div class="feat-card">
      <div class="feat-icon feat-icon--blue" aria-hidden="true">
        <img src={`${ICONOS}/reportes-lupa.webp`} alt="" width="240" height="240" loading="lazy" decoding="async" />
      </div>
      <h3 class="feat-title">Reportes visuales de gastos</h3>
      <p class="feat-desc">
        Entiende qué sucede con tu dinero con gráficas y balances simples.
        Detecta tus gastos hormiga al instante.
      </p>
    </div>

    <!-- Card 3: Reminders -->
    <div class="feat-card">
      <div class="feat-icon feat-icon--amber" aria-hidden="true">
        <img src={`${ICONOS}/campana-recordatorio.webp`} alt="" width="240" height="240" loading="lazy" decoding="async" />
      </div>
      <h3 class="feat-title">Recordatorios amigables</h3>
      <p class="feat-desc">
        Pablo te envía recordatorios motivadores (no regaños) para que
        ahorres y tengas siempre el control de tu dinero.
      </p>
    </div>

    <!-- Card 4: Tips & Goals -->
    <div class="feat-card">
      <div class="feat-icon feat-icon--coral" aria-hidden="true">
        <img src={`${ICONOS}/diana-metas.webp`} alt="" width="240" height="240" loading="lazy" decoding="async" />
      </div>
      <h3 class="feat-title">Tips y metas financieras</h3>
      <p class="feat-desc">
        Define objetivos (ej. "ahorrar para un viaje"). Pablo te anima y
        comparte tips personalizados para ahorrar y alcanzar tus metas.
      </p>
    </div>

  </div>
</section>

<style>
  .features {
    background: var(--bg-how);
    padding: var(--section-py) 0;
  }

  .features__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .feat-card {
    background: white;
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    box-shadow: var(--card-shadow);
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    isolation: isolate;
  }

  .feat-card:hover {
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-3px);
  }

  /* Tile del ícono: vidrio tintado con luz arriba a la izquierda y un halo
     del mismo color debajo. --tinta es el color dominante del ícono. */
  .feat-icon {
    --tinta: 90, 79, 207;
    position: relative;
    width: 104px;
    height: 104px;
    border-radius: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: 6px;
    background:
      radial-gradient(120% 120% at 28% 18%, #ffffff 0%, rgba(var(--tinta), 0.10) 55%, rgba(var(--tinta), 0.20) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 0 0 1px rgba(var(--tinta), 0.16),
      0 14px 28px -14px rgba(var(--tinta), 0.55);
    transition: box-shadow 0.35s ease;
  }

  /* Halo difuso detrás del tile: se enciende al pasar el mouse. */
  .feat-icon::before {
    content: "";
    position: absolute;
    inset: 10px;
    border-radius: inherit;
    background: rgba(var(--tinta), 0.35);
    filter: blur(22px);
    opacity: 0.35;
    z-index: -1;
    transition: opacity 0.35s ease;
  }

  .feat-icon img {
    width: 80px;
    height: 80px;
    object-fit: contain;
    filter: drop-shadow(0 8px 10px rgba(43, 44, 100, 0.18));
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .feat-icon--green { --tinta: 63, 166, 67; }
  .feat-icon--blue  { --tinta: 58, 102, 232; }
  .feat-icon--amber { --tinta: 245, 166, 35; }
  .feat-icon--coral { --tinta: 232, 90, 79; }

  @media (hover: hover) {
    .feat-card:hover .feat-icon img {
      transform: translateY(-5px) rotate(-5deg) scale(1.05);
    }
    .feat-card:hover .feat-icon::before { opacity: 0.8; }
  }

  @media (prefers-reduced-motion: reduce) {
    .feat-icon img,
    .feat-icon::before { transition: none; }
    .feat-card:hover .feat-icon img { transform: none; }
  }

  .feat-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-heading);
    line-height: 1.3;
  }

  .feat-desc {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-body);
  }

  @media (max-width: 1024px) {
    .features__grid {
      grid-template-columns: 1fr 1fr;
      column-gap: 24px;
      row-gap: 48px;
    }

    .feat-card {
      padding: 28px 24px;
    }
  }

  @media (max-width: 768px) {
    .features__grid {
      grid-template-columns: 1fr;
    }

    .feat-card {
      padding: 28px 24px;
    }
  }

  @media (max-width: 390px) {
    .feat-card {
      padding: 24px 20px;
    }

    .feat-icon {
      width: 88px;
      height: 88px;
      border-radius: 26px;
    }

    .feat-icon img {
      width: 68px;
      height: 68px;
    }

    .feat-title {
      font-size: 16px;
    }

    .feat-desc {
      font-size: 14px;
    }
  }
</style>
