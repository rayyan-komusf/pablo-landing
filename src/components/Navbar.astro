---
import { Image } from 'astro:assets';
import logoImg from '../assets/Logo.png';
---

<header class="navbar">
  <div class="container navbar__inner">

    <!-- Logo -->
    <a href="/" class="navbar__logo">
      <Image src={logoImg} alt="Pablo logo" class="logo-img" width={36} height={36} />
      <span class="logo-text">Pablo</span>
    </a>

    <!-- Sin navegación arriba (19-ago, patrón Duolingo).
         La primera pantalla tiene UNA sola cosa que hacer. Todos los links de
         sección viven en el footer, y el CTA reaparece en la barra que baja al
         hacer scroll (BannerSticky.astro). El menú móvil se conserva para no
         dejar sin salida a quien busca términos o su cuenta. -->
</header>

<style>
  /* Estático, no sticky (19-ago): la cabecera se va con el scroll y su lugar lo
     toma la barra que baja (BannerSticky). Pegadas las dos, se apilaban dos
     franjas haciendo lo mismo y la primera pantalla dejaba de tener una sola
     cosa que hacer. */
  .navbar {
    position: relative;
    z-index: 100;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom: none;
    transition: background 0.25s ease, backdrop-filter 0.25s ease;
  }

  .navbar.scrolled {
    background: var(--bg-header);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 rgba(43, 44, 100, 0.07);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    height: 72px;
    gap: 16px;
  }

  /* La navegación se lleva el espacio restante del logo y ancla a la derecha
   * (patrón Duolingo: logo a la izquierda, opciones alineadas a la derecha) */
  .navbar__nav {
    margin-left: auto;
  }

  /* Logo */
  .navbar__logo {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    position: relative;
  }

  .navbar__logo::before {
    content: "";
    position: absolute;
    inset: -4px 0;
  }

  .logo-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
    border-radius: 8px;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    color: var(--color-heading);
  }

  /* Desktop Nav */
  .navbar__nav {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }

  .nav-link {
    font-weight: 500;
    font-size: 14px;
    color: var(--color-heading);
    transition: color 0.15s;
    white-space: nowrap;
    padding: 8px 12px;
  }

  .nav-link:hover {
    color: var(--color-amber);
  }

  /* Nav item with dropdown */
  .nav-item {
    position: relative;
  }

  .nav-trigger {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 500;
    font-family: var(--font-body);
    color: var(--color-heading);
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    border-radius: 8px;
    transition: color 0.15s, background 0.15s;
  }

  .nav-trigger:hover {
    color: var(--color-amber);
    background: rgba(43, 44, 100, 0.04);
  }

  .nav-arrow {
    font-size: 10px;
    transition: transform 0.2s ease;
    display: inline-block;
    opacity: 0.6;
  }

  .nav-item:hover .nav-arrow {
    transform: rotate(-180deg);
  }

  /* Dropdown panel */
  .dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%) translateY(-6px);
    min-width: 240px;
    background: white;
    border: 1px solid rgba(43, 44, 100, 0.1);
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(43, 44, 100, 0.12);
    padding: 8px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 200;
  }

  /* El dropdown del último ítem se salía del viewport a 1280px. `overflow-x:
   * clip` ya impide que la página scrollee, pero al abrirse quedaría cortado
   * contra el borde: los de la derecha se anclan a su propio borde derecho en
   * vez de centrarse. */
  .nav-item:nth-last-child(-n + 2) .dropdown {
    left: auto;
    right: 0;
    transform: translateX(0) translateY(-6px);
  }

  .nav-item:nth-last-child(-n + 2):hover .dropdown {
    transform: translateX(0) translateY(0);
  }

  .nav-item:hover .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  /* Wide dropdown for Recursos */
  .dropdown--wide {
    min-width: 480px;
    display: flex;
    gap: 0;
    left: auto;
    right: 0;
    transform: translateY(-6px);
  }

  .nav-item:hover .dropdown--wide {
    transform: translateY(0);
  }

  .dropdown-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 4px;
  }

  .dropdown-col--border {
    border-left: 1px solid rgba(43, 44, 100, 0.08);
  }

  .dropdown-col-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-secondary);
    padding: 6px 10px 4px;
  }

  .dropdown-col-label--mt {
    margin-top: 8px;
  }

  /* Dropdown items */
  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s;
    cursor: pointer;
  }

  a.dropdown-item:hover {
    background: rgba(43, 44, 100, 0.05);
  }

  .dropdown-item--disabled {
    opacity: 0.5;
    cursor: default;
  }

  .dropdown-item--compact {
    padding: 6px 10px;
  }

  .di-label {
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-heading);
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .di-desc {
    font-size: 12px;
    color: var(--color-secondary);
    line-height: 1.4;
  }

  .di-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 20px;
    background: rgba(43, 44, 100, 0.07);
    color: var(--color-heading);
  }

  .di-badge--featured {
    background: #FEF3DA;
    color: #875A00;
    border: 1px solid #F5C970;
  }

  .di-badge--soon {
    background: rgba(43, 44, 100, 0.06);
    color: var(--color-secondary);
  }

  .dropdown-viewall {
    display: inline-block;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-amber);
    padding: 6px 10px;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .dropdown-viewall:hover {
    opacity: 0.75;
  }

  /* CTA */
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .btn-sm {
    padding: 9px 20px !important;
    font-size: 14px !important;
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding: 6px;
    margin-left: auto;
    cursor: pointer;
    background: none;
    border: none;
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-heading);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .hamburger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile menu */
  .navbar__mobile-menu {
    display: none;
    flex-direction: column;
    padding: 8px 16px 20px;
    background: var(--bg-header);
    border-top: 1px solid rgba(43, 44, 100, 0.06);
    gap: 2px;
  }

  .navbar__mobile-menu.is-open {
    display: flex;
  }

  /* Mobile accordion section */
  .mob-section {
    border-bottom: 1px solid rgba(43, 44, 100, 0.06);
  }

  .mob-section__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 12px 4px;
    font-size: 15px;
    font-weight: 600;
    font-family: var(--font-body);
    color: var(--color-heading);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .mob-arrow {
    font-size: 11px;
    transition: transform 0.2s;
    opacity: 0.5;
  }

  .mob-section.is-open .mob-arrow {
    transform: rotate(-180deg);
  }

  .mob-section__body {
    display: none;
    flex-direction: column;
    padding: 0 4px 10px 12px;
    gap: 2px;
  }

  .mob-section.is-open .mob-section__body {
    display: flex;
  }

  .mob-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 4px;
    font-size: 14px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s;
  }

  a.mob-link:hover {
    color: var(--color-heading);
  }

  .mob-link--disabled {
    opacity: 0.5;
    cursor: default;
  }

  .mob-link--sub {
    font-size: 13px;
    padding-left: 0;
  }

  .mob-link--viewall {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-amber);
  }

  .mob-link--standalone {
    padding: 12px 4px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-heading);
    border-top: 1px solid rgba(43, 44, 100, 0.06);
    margin-top: 4px;
  }

  .mob-section-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-secondary);
    padding: 8px 4px 2px;
  }

  .mob-badge {
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: 20px;
    background: rgba(43, 44, 100, 0.07);
    color: var(--color-heading);
  }

  .mob-badge--featured {
    background: #FEF3DA;
    color: #875A00;
  }

  .mob-badge--soon {
    background: rgba(43, 44, 100, 0.06);
    color: var(--color-secondary);
  }

  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 12px;
  }

  .mobile-actions .btn-primary {
    text-align: center;
    justify-content: center;
    width: 100%;
    padding: 12px 20px;
    font-size: 15px;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .navbar__nav { gap: 2px; }
    .nav-trigger, .nav-link { font-size: 13px; padding: 8px 8px; }
    .btn-sm { padding: 9px 14px !important; font-size: 13px !important; }
  }

  @media (max-width: 860px) {
    .navbar__nav,
    .navbar__actions {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>

<script>
  // Scroll behavior
  const navbar = document.querySelector('.navbar');
  function updateNavbar() {
    navbar?.classList.toggle('scrolled', window.scrollY > 10);
  }
  window.addEventListener('scroll', updateNavbar, { passive: true });
  updateNavbar();

  // Hamburger
  const hamburger = document.getElementById('hamburger-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  hamburger?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('is-open');
    hamburger.classList.toggle('is-open');
    hamburger.setAttribute('aria-expanded', String(isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(!isOpen));
  });

  // Mobile accordion
  document.querySelectorAll('.mob-section__trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const section = trigger.closest('.mob-section');
      section?.classList.toggle('is-open');
    });
  });

  // Close mobile menu when a link is clicked
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.remove('is-open');
      hamburger?.classList.remove('is-open');
      hamburger?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
