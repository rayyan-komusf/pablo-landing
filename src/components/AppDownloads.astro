---
import { APP_STORE_URL } from '../siteConfig';
---
<div class="app-downloads" aria-label="Aplicaciones de Pablo">
  <a class="store-badge" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer" aria-label="Descargar para iOS en App Store">
    <svg class="store-badge__icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M17.05 12.54c.03 3.2 2.81 4.26 2.84 4.28-.02.08-.44 1.52-1.46 3.01-.89 1.29-1.81 2.57-3.26 2.6-1.43.03-1.89-.84-3.53-.84-1.63 0-2.14.81-3.5.87-1.4.05-2.47-1.4-3.37-2.68C2.93 17.16 1.52 12.38 3.4 9.1c.94-1.63 2.62-2.66 4.45-2.68 1.39-.03 2.7.93 3.54.93.85 0 2.44-1.15 4.12-.98.71.03 2.71.29 4 2.18-.1.06-2.49 1.45-2.46 3.99ZM14.36 4.63c.75-.91 1.26-2.17 1.12-3.43-1.08.04-2.39.72-3.17 1.63-.69.8-1.3 2.08-1.14 3.31 1.2.09 2.43-.61 3.19-1.51Z"/></svg>
    <span class="store-badge__copy"><span>Descárgalo en la</span><strong>App Store</strong></span>
  </a>
  <div class="store-badge store-badge--soon" role="img" aria-label="Google Play para Android: próximamente">
    <svg class="store-badge__icon" viewBox="0 0 32 36" aria-hidden="true" fill="currentColor"><path d="M2 2.3v31.4L18 18 2 2.3Zm2-1.2 17 10-3 4.7L4 1.1Zm17.5 12L30 18l-8.5 4.9-3.1-4.9 3.1-4.9ZM18 20.2l3 4.7-17 10 14-14.7Z"/></svg>
    <span class="store-badge__copy"><span>Próximamente en</span><strong>Google Play</strong></span>
  </div>
</div>
<style>
  .app-downloads { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; width:100%; max-width:360px; }
  .store-badge { display:flex; align-items:center; justify-content:center; gap:11px; min-height:62px; padding:10px 12px; border:2px solid #e5e5e5; border-radius:13px; background:#fff; color:#505050; box-shadow:0 3px 0 #e5e5e5; text-decoration:none; }
  a.store-badge { transition:background .15s,transform .15s,box-shadow .15s; }
  a.store-badge:hover { background:#f8f7fb; transform:translateY(-1px); box-shadow:0 4px 0 #dedce5; }
  a.store-badge:active { transform:translateY(2px); box-shadow:0 1px 0 #e5e5e5; }
  a.store-badge:focus-visible { outline:3px solid #2b2c64; outline-offset:5px; }
  .store-badge__icon { width:28px; height:32px; flex:none; }
  .store-badge__copy { display:flex; flex-direction:column; gap:2px; text-align:left; white-space:nowrap; line-height:1.15; }
  .store-badge__copy>span { font-size:11px; font-weight:700; }
  .store-badge__copy strong { font-family:var(--font-heading); font-size:18px; font-weight:700; }
  .store-badge--soon { cursor:default; }
  @media(max-width:360px) { .app-downloads { gap:10px; } .store-badge { padding:10px 8px; gap:8px; } .store-badge__icon { width:24px; } .store-badge__copy strong { font-size:16px; } .store-badge__copy>span { font-size:10px; } }
  @media(prefers-reduced-motion:reduce) { a.store-badge { transition:none; } }
</style>
