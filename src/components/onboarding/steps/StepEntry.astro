<!-- Bienvenida. Pablo NO vive aquí: vive en PabloActor.astro, montado una sola
     vez fuera de los steps. Esta pantalla solo declara DÓNDE va (el anclaje),
     QUÉ pose adopta y QUÉ dice. Así entry → fiesta → step-2 → step-3 son el
     mismo Pablo moviéndose, no cuatro imágenes que se reemplazan. -->
<section
  class="step !pb-0"
  data-step="entry"
  aria-label="Bienvenida"
  aria-hidden="true"
  data-pablo-dice='["¡Hola! Soy Pablo.","Voy a ser tu asistente financiero, aquí en WhatsApp."]'
  data-pablo-auto="true"
>
  <div class="duo-stage flex-1 flex flex-col items-center justify-center relative w-full px-6">
    <div class="speech-bubble" data-pablo-burbuja aria-live="polite">¡Hola! Soy Pablo.</div>
    <div class="duo-stage__pablo" data-pablo-anclaje data-pose="saludando"></div>
  </div>

  <footer class="duo-footer cta-footer">
    <button class="btn-primary btn-continue" onclick="pabloNext()" aria-label="Continuar">
      Continuar
    </button>
  </footer>
</section>
