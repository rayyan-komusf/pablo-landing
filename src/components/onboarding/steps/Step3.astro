<!-- Mensaje intro 2: WhatsApp. Cierra con pregunta, así que aquí NO hay
     auto-avance: la pregunta "¿Quieres ver cómo?" pide una respuesta, y el
     CONTINUAR es esa respuesta. Auto-avanzar se comería el único momento de
     complicidad del tramo. -->
<section
  class="step !pb-0"
  data-step="step-3"
  aria-label="Paso 3"
  aria-hidden="true"
  data-pablo-dice='["Todo esto lo haces desde WhatsApp. Sin apps nuevas, sin planillas.","¿Te muestro cómo?"]'
>
  <div class="duo-stage flex-1 flex flex-col items-center justify-center relative w-full px-6">
    <div class="speech-bubble" data-pablo-burbuja aria-live="polite">
      Todo esto lo haces desde WhatsApp. Sin apps nuevas, sin planillas.
    </div>
    <div class="duo-stage__pablo" data-pablo-anclaje data-pose="explicando"></div>
  </div>

  <footer class="duo-footer cta-footer">
    <button
      class="duo-footer__link"
      onclick="pabloGoApp('step-3')"
      aria-label="Iniciar sesión si ya eres miembro"
    >
      ¿Ya eres miembro?
    </button>
    <button class="btn-primary btn-continue" onclick="pabloNext()" aria-label="Continuar">
      Sí, muéstrame
    </button>
  </footer>
</section>
