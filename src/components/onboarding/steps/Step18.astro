<script is:inline type="module">
  // Página 1 del paywall: la nota. Los planes, el calendario y el modal viven
  // en step-18b (Rodrigo, 24-ago: una pantalla = un trabajo).

  // Oferta Millonaria (ventana 23-29 jul, hora Perú): fuera de la ventana este
  // bloque no puede aparecer ni por link viejo. Si la oferta revive, revisar
  // también step-18b (mostraría planes normales tras la oferta).
  const enPromoMillonaria = (() => {
    const ahora = Date.now();
    return (
      ahora >= Date.parse("2026-07-23T20:40:00-05:00") &&
      ahora < Date.parse("2026-07-30T00:00:00-05:00")
    );
  })();

  const llegoDesdeLaOferta = (() => {
    try {
      if (new URLSearchParams(location.search).get("oferta") === "millonaria") return true;
      return sessionStorage.getItem("pablo_oferta_millonaria") === "1";
    } catch {
      return false;
    }
  })();

  if (enPromoMillonaria) {
    const bloqueOferta = document.querySelector("[data-om-oferta]");
    const bloqueDefault = document.querySelector('[data-step="step-18"] [data-om-default]');
    if (bloqueOferta && bloqueDefault) {
      bloqueOferta.hidden = false;
      bloqueDefault.hidden = true;
      window.pabloTrack?.("onboarding_paywall_millonaria_visto", {
        desde_landing: llegoDesdeLaOferta,
      });
    }
  }

  /* La nota se teclea en vivo al entrar. */
  function tecleaNota() {
    var lineas = [].slice.call(document.querySelectorAll("[data-pw-teclea]"));
    var firma = document.querySelector("[data-pw-firma]");
    if (!lineas.length) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      lineas.forEach(function (el) { el.textContent = el.dataset.pwTeclea; });
      if (firma) firma.classList.add("pw-nota__firma--lista");
      return;
    }
    lineas.forEach(function (el) { el.textContent = ""; el.classList.remove("pw-nota__p--activa"); });
    if (firma) firma.classList.remove("pw-nota__firma--lista");

    var li = 0, ci = 0;
    (function paso() {
      if (li >= lineas.length) {
        if (firma) firma.classList.add("pw-nota__firma--lista");
        return;
      }
      var el = lineas[li], txt = el.dataset.pwTeclea;
      el.classList.add("pw-nota__p--activa");
      el.textContent = txt.slice(0, ++ci);
      if (ci >= txt.length) {
        el.classList.remove("pw-nota__p--activa");
        li++; ci = 0;
        setTimeout(paso, 240);              // respiro entre frases
      } else {
        // Ritmo irregular: constante se lee como máquina (~11ms deja ~4s).
        setTimeout(paso, 6 + Math.random() * 11);
      }
    })();
  }

  const pantallaPaywall = document.querySelector('[data-step="step-18"]');
  if (pantallaPaywall) {
    new MutationObserver(() => {
      if (pantallaPaywall.classList.contains("active")) tecleaNota();
    }).observe(pantallaPaywall, { attributes: true, attributeFilter: ["class"] });
    if (pantallaPaywall.classList.contains("active")) tecleaNota();
  }
</script>

