---
// Testimonios y menciones. El bloque de testimonios ES el carrusel de la
// landing (Rodrigo, r7: "que acá entre el carrusel de testimonios que
// tenemos en la landing page") — misma fuente de datos (data/testimonios.ts)
// y mismo foco central, en vez de tres tarjetas fijas duplicadas a mano.
import TestimonialsCarousel from '../../sections/TestimonialsCarousel.astro';
---

<section class="step !pb-0 relative" data-step="step-17" aria-label="Testimonios y menciones" aria-hidden="true">
  <div class="flex flex-col flex-1 gap-5 w-full max-w-[560px] mx-auto px-5 pt-4 pb-24 md:pb-8 overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden vcenter">
    <!-- Título -->
    <h2 class="text-center font-display font-bold text-2xl max-md:text-xl tracking-tight text-navy">
      Preferido por <span class="text-amber">cientos</span>
    </h2>
    <!-- Logos -->
    <div class="flex flex-col items-center gap-3">
      <p class="text-[11px] font-display font-bold tracking-widest uppercase text-amber">
        MENCIONADO EN:
      </p>
      <div class="grid grid-cols-3 gap-2 w-full">
        <div class="patro-chip">
          <img src="/onboarding/images/logos/rankia.png" alt="Rankia Markets" class="max-h-14 max-w-full object-contain" />
        </div>
        <div class="patro-chip">
          <img src="/onboarding/images/logos/epg.png" alt="Univ. Continental" class="max-h-14 max-w-full object-contain" />
        </div>
        <div class="patro-chip">
          <img src="/onboarding/images/logos/startup-peru.png" alt="Startup Perú" class="max-h-14 max-w-full object-contain" />
        </div>
        <div class="patro-chip">
          <img src="/onboarding/images/logos/founders-live.png" alt="Founders Live" class="max-h-14 max-w-full object-contain" />
        </div>
        <div class="patro-chip">
          <img src="/onboarding/images/logos/mas-cuentas.png" alt="+Cuentas" class="max-h-14 max-w-full object-contain" />
        </div>
        <div class="patro-chip">
          <img src="/onboarding/images/logos/ymca.png" alt="YMCA" class="max-h-14 max-w-full object-contain" />
        </div>
      </div>
    </div>
    <!-- Stat -->
    <p class="text-center text-sm font-semibold font-body text-amber">
      Más de 200 peruanos ya usan y aman a Pablo
    </p>
    <!-- Testimonios: el carrusel de la landing, a sangre completa (se sale
         del padding lateral a propósito para que se vea el desfile). -->
    <div class="onb-testi-carrusel">
      <TestimonialsCarousel />
    </div>
  </div>

  <footer class="duo-footer cta-footer">
    <button class="btn-primary btn-continue" onclick="pabloNext()" aria-label="Continuar">
      Continuar
    </button>
  </footer>
</section>

<style>
  /* El carrusel mide su centro contra el ancho de la VENTANA, así que tiene
     que ocupar todo el ancho: se escapa del padding del step con márgenes
     negativos desde el centro. Sin esto la tarjeta "en foco" queda
     descentrada respecto a la pista. */
  .onb-testi-carrusel {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  /* En el onboarding el carrusel vive en una pantalla corta: menos aire que
     en la landing, para no forzar scroll. */
  .onb-testi-carrusel :global(.carrusel__track) {
    padding: 14px 0 22px;
  }
</style>
