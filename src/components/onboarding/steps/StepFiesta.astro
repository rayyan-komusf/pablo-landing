<!-- Celebración tras elegir objetivo: confetti + "¡Que empiece la fiesta!".
     Comparte el Pablo persistente con entry/step-2/step-3: aquí solo cambia de
     pose (a emocionado) sin moverse de sitio, así que se ve al mismo Pablo
     reaccionando a lo que el usuario acaba de elegir. Avanza solo: es una
     celebración, no una pregunta. -->
<section
  class="step !pb-0"
  data-step="step-fiesta"
  aria-label="Celebración"
  aria-hidden="true"
  data-pablo-dice='["¡Excelente elección!","Vamos a lograrlo juntos."]'
  data-pablo-auto="true"
>
  <div class="duo-stage flex-1 flex flex-col items-center justify-center relative w-full px-6">
    <!-- Escenario del confetti (las piezas las inyecta onboarding.js) -->
    <div class="fiesta-confetti" aria-hidden="true"></div>

    <div class="speech-bubble" data-pablo-burbuja aria-live="polite">¡Excelente elección!</div>

    <div class="duo-stage__pablo" data-pablo-anclaje data-pose="emocionado"></div>
  </div>

  <footer class="duo-footer cta-footer">
    <button class="btn-primary btn-continue" onclick="pabloNext()" aria-label="Continuar">
      Continuar
    </button>
  </footer>
</section>
