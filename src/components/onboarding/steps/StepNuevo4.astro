---
// Meta de ahorro: escena animada única — Pablo abrazando su alcancía (pose
// oficial FB28) con monedas cayendo. Reemplaza la card estática, con la
// calidad de la landing (Rodrigo, 20-ago, item 16).
---

<section class="step !pb-0" data-step="step-nuevo-4" aria-label="Meta de ahorro" aria-hidden="true">
  <div class="fuente-body flex-1 flex flex-col w-full mx-auto px-5 max-md:px-4 overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden vcenter">
    <div class="onb-escena-zona">
      <h2 class="onb-escena-titulo">
        Tu meta empieza a crecer <span class="text-amber">hoy</span>
      </h2>
      <p class="onb-escena-sub">
        Ver tu progreso aumenta hasta 52% la probabilidad de lograrlo. Yo te lo muestro a diario.
      </p>

      <div class="onb-escena" data-onb-escena>
        <img src="/onboarding/images/pablo/2d/pablo-emocionado.webp" alt="" width="444" height="420" loading="lazy" />
        <video data-src="/onboarding/images/pablo/2d/escena-onb-ahorro.webm" muted loop playsinline preload="none"></video>
      </div>
    </div>
  </div>

  <footer class="duo-footer cta-footer">
    <button class="btn-primary btn-continue" onclick="pabloNext()" aria-label="Continuar">
      Continuar
    </button>
  </footer>
</section>

<script is:inline>
  (function () {
    var paso = document.querySelector('[data-step="step-nuevo-4"]');
    if (!paso) return;
    var caja = paso.querySelector("[data-onb-escena]");
    var v = caja && caja.querySelector("video");
    if (!v) return;
    var probe = document.createElement("video");
    var puede = !!probe.canPlayType && probe.canPlayType('video/webm; codecs="vp9"') !== "";
    var suave = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!puede || suave) return;
    new MutationObserver(function () {
      var activo = paso.classList.contains("active");
      if (activo) {
        if (!v.src) {
          v.src = v.dataset.src;
          v.addEventListener("loadeddata", function () {
            caja.classList.add("onb-escena--video");
            v.play().catch(function () {});
          }, { once: true });
          v.load();
        } else {
          v.play().catch(function () {});
        }
      } else {
        v.pause();
      }
    }).observe(paso, { attributes: true, attributeFilter: ["class"] });
  })();
</script>
