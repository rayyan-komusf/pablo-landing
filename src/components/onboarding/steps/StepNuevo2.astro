---
// Rama con deuda: escena animada única — Pablo con la tarjeta de crédito del
// diseño ACTUAL de la app (cerámica lila #dbcff7 con canto #9f7eed, chip y
// barra de uso), reemplazando la réplica vieja del gradient púrpura.
// Rediseñada el 20-ago por pedido de Rodrigo (items 16 y 17).
---

<section class="step !pb-0" data-step="step-nuevo-2" aria-label="Deudas" aria-hidden="true">
  <div class="fuente-body flex-1 flex flex-col w-full mx-auto px-5 max-md:px-4 overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden vcenter">
    <div class="onb-escena-zona">
      <h2 class="onb-escena-titulo">
        Te ayudo a pagar tus <span class="text-amber">deudas</span>
      </h2>
      <p class="onb-escena-sub">
        Vemos tu tarjeta juntos y armamos el plan, mientras tu ahorro sigue creciendo.
      </p>

      <div class="onb-escena" data-onb-escena>
        <img src="/onboarding/images/pablo/2d/pablo-explicando.webp" alt="" width="316" height="420" loading="lazy" />
        <video data-src="/onboarding/images/pablo/2d/escena-onb-deuda.webm" muted loop playsinline preload="none"></video>
      </div>
    </div>
  </div>

  <footer class="duo-footer cta-footer">
    <button class="btn-primary btn-continue" onclick="pabloNext()" aria-label="Continuar">
      Continuar
    </button>
  </footer>
</section>

<script is:inline>
  (function () {
    var paso = document.querySelector('[data-step="step-nuevo-2"]');
    if (!paso) return;
    var caja = paso.querySelector("[data-onb-escena]");
    var v = caja && caja.querySelector("video");
    if (!v) return;
    var suave = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (suave) return;
    new MutationObserver(function () {
      var activo = paso.classList.contains("active");
      if (activo) {
        if (!v.childElementCount) {
          // Doble formato: Safari decodifica WebM VP9 pero pinta el alfa
          // NEGRO (visto en iPhone, ago-2026). Primero HEVC con alfa (.mov
          // hvc1) para Safari; Chrome no reproduce QuickTime y cae al WebM.
          var mov = document.createElement("source");
          mov.src = v.dataset.src.replace(/\.webm$/, ".mov");
          mov.type = 'video/quicktime; codecs="hvc1"';
          var wm = document.createElement("source");
          wm.src = v.dataset.src;
          wm.type = "video/webm";
          v.appendChild(mov);
          v.appendChild(wm);
          v.addEventListener("loadeddata", function () {
            caja.classList.add("onb-escena--video");
            v.play().catch(function () {});
          }, { once: true });
          v.load();
        } else {
          v.play().catch(function () {});
        }
      } else {
        v.pause();
      }
    }).observe(paso, { attributes: true, attributeFilter: ["class"] });
  })();
</script>
