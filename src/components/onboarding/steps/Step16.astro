<!-- Funciones para ti: checkboxes que se marcan solos según las respuestas -->
<section class="step !pb-0" data-step="step-16" aria-label="Funciones personalizadas" aria-hidden="true">
  <div class="fuente-header">
    <div class="fuente-header__inner">
      <div class="fuente-pablo" data-pablo-anclaje data-pose="saludando"></div>
      <div class="speech-bubble speech-bubble--side">Según lo que me contaste, esto es lo que más te va a ayudar</div>
    </div>
  </div>

  <div class="fuente-body flex-1 flex flex-col w-full mx-auto px-5 max-md:px-4 overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden vcenter">
    <div class="fuente-grid fn-lista" role="list" aria-label="Funciones elegidas para ti" >
      <div class="option-card option-card--pill checkbox" data-fn="whatsapp" role="listitem">
        <span class="option-icon"><img src="/onboarding/images/iconos/t07_whatsapp.png" alt="" width="30" height="30" loading="lazy" /></span>
        <span class="option-label text-left">Registro por WhatsApp</span>
        <span class="fn-parati">Para ti</span>
      </div>
      <div class="option-card option-card--pill checkbox" data-fn="presupuesto" role="listitem">
        <span class="option-icon"><img src="/onboarding/images/iconos/t04_presupuesto_piechart.png" alt="" width="30" height="30" loading="lazy" /></span>
        <span class="option-label text-left">Presupuesto mensual</span>
        <span class="fn-parati">Para ti</span>
      </div>
      <div class="option-card option-card--pill checkbox" data-fn="deuda" role="listitem">
        <span class="option-icon"><img src="/onboarding/images/iconos/ac03_tarjeta_credito.png" alt="" width="30" height="30" loading="lazy" /></span>
        <span class="option-label text-left">Gestión de deuda</span>
        <span class="fn-parati">Para ti</span>
      </div>
      <div class="option-card option-card--pill checkbox" data-fn="categorias" role="listitem">
        <span class="option-icon"><img src="/onboarding/images/iconos/t01_panel_gauge.png" alt="" width="30" height="30" loading="lazy" /></span>
        <span class="option-label text-left">Límite de categorías</span>
        <span class="fn-parati">Para ti</span>
      </div>
      <div class="option-card option-card--pill checkbox" data-fn="resumen" role="listitem">
        <span class="option-icon"><img src="/onboarding/images/iconos/ui15_barras.png" alt="" width="30" height="30" loading="lazy" /></span>
        <span class="option-label text-left">Resumen financiero visual</span>
        <span class="fn-parati">Para ti</span>
      </div>
      <div class="option-card option-card--pill checkbox" data-fn="metas" role="listitem">
        <span class="option-icon"><img src="/onboarding/images/iconos/t03_metas_bullseye.png" alt="" width="30" height="30" loading="lazy" /></span>
        <span class="option-label text-left">Trackeo de metas</span>
        <span class="fn-parati">Para ti</span>
      </div>
    </div>
  </div>

  <footer class="duo-footer cta-footer">
    <button class="btn-primary btn-continue" onclick="pabloNext()" aria-label="Continuar">
      Continuar
    </button>
  </footer>
</section>
