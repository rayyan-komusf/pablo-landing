<!-- Registro paso a paso (5/5): pago embebido con el widget oficial de Flow
     (elements), SIN salir del onboarding. Con la sesión ya asegurada por el
     step del código: flow-suscripcion "checkout" da el token del registro de
     tarjeta, el widget se monta aquí y "confirmar" crea la suscripción (con
     el trial de la promo si aplica). Al pagar → puente de sesión a la app
     (/auth/sesion → dashboard, ya premium). Sin sesión, el JS cae a
     pabloCuentaIrAlPago() (pagar en la app); ya no hay botón visible. -->
<section class="step !pb-0" data-step="step-cuenta-pago" aria-label="Pago seguro con Flow" aria-hidden="true">
  <!-- Arriba SOLO la cara de Pablo (Rodrigo, 25-ago): fuera la ilustración
       grande y fuera la burbuja — ya no hay verificación previa que anunciar
       y esta pantalla es para pagar, no para conversar. -->
  <div class="pago-header">
    <img
      class="pago-cara"
      src="/onboarding/images/pablo/pablo-logo.png"
      alt=""
      width="64"
      height="64"
      loading="lazy"
    />
  </div>

  <div class="fuente-body flex-1 flex flex-col w-full mx-auto px-5 max-md:px-4 overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <div class="pago-card">
      <p class="pago-resumen" id="pago-resumen">Preparando tu plan…</p>
      <!-- Éxito: check verde animado (estilo iOS) antes de entrar a la app. -->
      <div class="pago-exito" id="pago-exito" hidden>
        <svg viewBox="0 0 56 56" class="pago-exito-check" role="img" aria-label="Pago exitoso">
          <circle cx="28" cy="28" r="26" class="pago-exito-circulo" transform="rotate(-90 28 28)"></circle>
          <path d="M16.5 29.5l8 8 15-16" class="pago-exito-palomita"></path>
        </svg>
        <p class="pago-exito-texto">¡Pago exitoso!</p>
        <p class="pago-estado">Entrando a tu cuenta…</p>
      </div>
      <!-- Fallo: Pablito triste acompaña el mensaje de error. -->
      <img
        id="pago-triste"
        class="pago-triste"
        src="/onboarding/images/pablo/emotions/pablo-triste.png"
        alt=""
        width="96"
        height="96"
        loading="lazy"
        hidden
      />
      <p class="pago-estado" id="pago-estado">Preparando el pago seguro…</p>
      <!-- Pablito "cargando": sprite sheet animado mientras el widget/iframe
           de Flow termina de cargar (mismo truco steps() del 404). -->
      <div class="pago-cargando" id="pago-cargando" hidden>
        <div class="pago-cargando-sprite" aria-hidden="true"></div>
      </div>
      <div id="pago-widget"></div>
      <!-- Cupones (Rodrigo, 25-ago): el código viaja en el checkout de
           flow-suscripcion como `cupon`. El backend decide si es válido. -->
      <div class="pago-cupon">
        <button type="button" class="pago-cupon-toggle" id="pago-cupon-toggle" onclick="pabloPagoCuponToggle()">
          ¿Tienes un cupón de descuento?
        </button>
        <div class="pago-cupon-fila" id="pago-cupon-fila" hidden>
          <input
            id="pago-cupon-input"
            class="pago-cupon-input"
            type="text"
            placeholder="Escribe tu cupón"
            maxlength="40"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
          />
          <button type="button" class="pago-cupon-aplicar" id="pago-cupon-aplicar" onclick="pabloPagoCuponAplicar()">
            Aplicar
          </button>
        </div>
        <p class="pago-cupon-msg" id="pago-cupon-msg" hidden></p>
      </div>
      <button type="button" class="btn-primary btn-continue" id="pago-reintentar" hidden onclick="pabloPagoReintentar()">
        Reintentar
      </button>
      <p class="pago-nota">🔒 Pago procesado por Flow. Pablo nunca ve tu tarjeta.</p>
    </div>
  </div>

  <style>
    .pago-header {
      display: flex;
      justify-content: center;
      padding: 18px 0 4px;
    }
    .pago-cara {
      width: 64px;
      height: 64px;
      border-radius: 18px;
    }

    .pago-cupon {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 2px;
    }
    .pago-cupon-toggle {
      background: none;
      border: none;
      cursor: pointer;
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 700;
      color: #56578f;
      text-decoration: underline;
      padding: 2px;
      align-self: center;
    }
    .pago-cupon-fila {
      display: flex;
      gap: 8px;
    }
    .pago-cupon-fila[hidden] { display: none; }
    .pago-cupon-input {
      flex: 1;
      min-width: 0;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 700;
      color: #2b2c64;
      text-transform: uppercase;
      background: #fff;
      border: 2px solid #e5e0f5;
      border-radius: 12px;
      padding: 10px 12px;
      outline: none;
    }
    .pago-cupon-input:focus {
      border-color: #f5a623;
      box-shadow: 0 0 0 3px rgba(245, 166, 35, 0.18);
    }
    .pago-cupon-aplicar {
      border: none;
      cursor: pointer;
      border-radius: 12px;
      padding: 10px 16px;
      font-family: var(--font-body);
      font-weight: 800;
      font-size: 13px;
      color: #2b2c64;
      background: #ffd66e;
      box-shadow: 0 3px 0 0 #d9a53a;
    }
    .pago-cupon-aplicar:active { transform: translateY(2px); box-shadow: 0 1px 0 0 #d9a53a; }
    .pago-cupon-aplicar:disabled { opacity: 0.6; cursor: wait; }
    .pago-cupon-msg {
      margin: 0;
      font-size: 12.5px;
      font-weight: 600;
      text-align: center;
      color: #2c7a4b;
    }
    .pago-cupon-msg--error { color: #d64545; }
  </style>

  <script is:inline>
    (function () {
      var SUPABASE_URL = "https://mezpfnagkubumzbromsh.supabase.co";
      var SUPABASE_ANON_KEY =
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1lenBmbmFna3VidW16YnJvbXNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjM0NDM3NDMsImV4cCI6MjA3OTAxOTc0M30.HsTSJqkzslq4HWxLlIvuFwudrFzkemHELgsi54vIJDw";
      var FLOW_SCRIPTS = {
        sandbox: "https://sandbox.flow.cl/app/elements/flow-1.1.0.min.js?20241202",
        production: "https://www.flow.cl/app/elements/flow-1.1.0.min.js?20241202",
      };
      var NOMBRE_PLAN = { semanal: "Plan Semanal", mensual: "Plan Mensual", anual: "Plan Anual" };
      // Anual 3→0 días (18-ago-2026, pedido de Sandra): cobro directo.
      // Mismo valor que FLOW_PLANES en el backend.
      var PLANES = {
        semanal: { texto: "Plan Semanal — S/.7 a la semana", trial: 0, monto: 7 },
        mensual: { texto: "Plan Mensual — S/.20 al mes", trial: 3, monto: 20 },
        anual: { texto: "Plan Anual — S/.200 al año", trial: 0, monto: 200 },
      };
      // Oferta Millonaria (misma ventana que Step18 y el backend): mensual 14
      // días, anual cobro directo. Fuera de la ventana no cambia nada.
      (function () {
        var ahora = Date.now();
        if (
          ahora >= Date.parse("2026-07-23T20:40:00-05:00") &&
          ahora < Date.parse("2026-07-30T00:00:00-05:00")
        ) {
          PLANES.mensual.trial = 14;
          PLANES.anual.trial = 0;
        }
      })();

      var flowScriptPromise = null;
      var enCurso = false;
      // Cupón aplicado (Rodrigo, 25-ago). Viaja como `cupon` en el checkout;
      // CONTRATO para el backend (Ryan): si flow-suscripcion lo procesa,
      // que responda `cupon: { valido: boolean, mensaje?: string }` — acá se
      // pinta tal cual. Sin ese campo en la respuesta se muestra el neutro
      // "se validará al procesar el pago".
      var cuponAplicado = null;

      function planSlug() {
        return sessionStorage.getItem("pablo_plan_elegido") || "anual";
      }
      function setEstado(msg, esError) {
        var el = document.getElementById("pago-estado");
        if (!el) return;
        el.textContent = msg || "";
        el.hidden = !msg;
        el.classList.toggle("pago-estado--error", Boolean(esError));
        // Pablito triste acompaña los errores.
        var triste = document.getElementById("pago-triste");
        if (triste) triste.hidden = !esError;
      }
      function mostrarExito() {
        var widget = document.getElementById("pago-widget");
        if (widget) widget.innerHTML = "";
        setEstado("");
        setCargando(false);
        setReintentar(false);
        var exito = document.getElementById("pago-exito");
        if (exito) exito.hidden = false;
      }
      function setReintentar(visible) {
        var btn = document.getElementById("pago-reintentar");
        if (btn) btn.hidden = !visible;
      }
      function setCargando(visible) {
        var el = document.getElementById("pago-cargando");
        if (el) el.hidden = !visible;
      }
      /* El mount de Flow inyecta un iframe que tarda en pintar: el Pablito
         cargando se queda hasta el load del iframe (con tope por si el
         widget no usa iframe o el load ya pasó). */
      function ocultarCargandoConElWidget(contenedor) {
        var intentos = 0;
        (function esperar() {
          var iframe = contenedor && contenedor.querySelector("iframe");
          if (iframe) {
            iframe.addEventListener("load", function () {
              setCargando(false);
            }, { once: true });
            setTimeout(function () {
              setCargando(false);
            }, 5000);
          } else if (++intentos < 40) {
            setTimeout(esperar, 150);
          } else {
            setCargando(false);
          }
        })();
      }
      function pintarResumen() {
        var slug = planSlug();
        var p = PLANES[slug] || PLANES.anual;
        var el = document.getElementById("pago-resumen");
        if (el) {
          el.textContent =
            p.texto +
            (p.trial > 0
              ? " · " + p.trial + " días gratis. Registras tu tarjeta y no se cobra hasta el día " +
                (p.trial + 1) + ". Cancelas cuando quieras."
              : " · se cobra hoy, cancela cuando quieras.") +
            // Garantía SOLO del anual; sin trial (18-ago-2026) el ancla es
            // la compra — anclarla a una prueba que ya no existe es reclamable.
            (slug === "anual"
              ? " Garantía de satisfacción de 14 días desde tu compra: te devolvemos el 100%, sin preguntas."
              : "");
        }
      }

      function cargarFlowScript(entorno) {
        if (window.Flow) return Promise.resolve();
        if (!flowScriptPromise) {
          flowScriptPromise = new Promise(function (resolve, reject) {
            var s = document.createElement("script");
            s.src = FLOW_SCRIPTS[entorno] || FLOW_SCRIPTS.sandbox;
            s.async = true;
            s.onload = resolve;
            s.onerror = function () {
              flowScriptPromise = null;
              reject(new Error("No se pudo cargar el widget de Flow"));
            };
            document.head.appendChild(s);
          });
        }
        return flowScriptPromise;
      }

      async function flowSuscripcion(body, accessToken) {
        var res = await fetch(SUPABASE_URL + "/functions/v1/flow-suscripcion", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            apikey: SUPABASE_ANON_KEY,
            Authorization: "Bearer " + accessToken,
          },
          body: JSON.stringify(body),
        });
        var data = {};
        try {
          data = await res.json();
        } catch (e) {
          /* respuesta sin body */
        }
        data.__status = res.status;
        return data;
      }

      /* Éxito (pago confirmado o suscripción ya activa): a la app logueado. */
      function irALaAppPagado() {
        var tokens = window.pabloCuentaTokens ? window.pabloCuentaTokens() : {};
        var base = window.pabloCuentaConPhDid(window.pabloCuentaAppBase() + "/auth/sesion");
        if (tokens.access_token && tokens.refresh_token) {
          window.location.href =
            base +
            "#access_token=" +
            encodeURIComponent(tokens.access_token) +
            "&refresh_token=" +
            encodeURIComponent(tokens.refresh_token);
        } else {
          window.location.href = window.pabloCuentaConPhDid(window.pabloCuentaAppBase());
        }
      }

      window.pabloPagoArrancar = async function () {
        if (enCurso) return;
        enCurso = true;
        setReintentar(false);
        var exito = document.getElementById("pago-exito");
        if (exito) exito.hidden = true;
        pintarResumen();
        setCargando(true);
        setEstado("Preparando el pago seguro…");

        try {
          var sesion = await window.pabloCuentaAsegurarSesion();
          if (!sesion) {
            window.pabloCuentaIrAlPago();
            return;
          }

          // Huella del clic del anuncio: el pago ocurre en usapablo.com, donde
          // la cookie _fbc SÍ existe. Es la única oportunidad de capturarla —
          // el webhook del cobro llega días después y sin navegador. Para
          // TikTok igual, pero el ttclid va CRUDO (sin envoltorio fb.1.<ts>).
          var fb = window.pabloFbCookies ? window.pabloFbCookies() : {};
          var tt = window.pabloTtClic ? window.pabloTtClic() : {};
          var registro = await flowSuscripcion(
            {
              accion: "checkout",
              plan: NOMBRE_PLAN[planSlug()] || NOMBRE_PLAN.anual,
              cupon: cuponAplicado || undefined,
              fbc: fb.fbc || undefined,
              fbp: fb.fbp || undefined,
              ttclid: tt.ttclid || undefined,
              ttp: tt.ttp || undefined,
            },
            sesion.access_token
          );
          if (cuponAplicado) pintarCupon(registro.cupon);
          if (registro.__status === 409) {
            // Ya tiene una suscripción activa: nada que cobrar.
            irALaAppPagado();
            return;
          }
          if (!registro.token || !registro.entorno) {
            throw new Error(registro.error || "No pudimos iniciar el pago");
          }

          await cargarFlowScript(registro.entorno);
          if (typeof window.Flow !== "function") throw new Error("Widget de Flow no disponible");

          var contenedor = document.getElementById("pago-widget");
          if (contenedor) contenedor.innerHTML = "";
          setEstado("");

          var flow = window.Flow();
          var subscribe = flow.elements().create("subscribe", {
            style: { backgroundColor: "transparent" },
          });
          subscribe.mount("#pago-widget", registro.token);
          // InitiateCheckout en el momento exacto en que se abre el widget:
          // sin él, el tramo "vio los planes → registró tarjeta" es caja negra.
          try {
            var pIC = PLANES[planSlug()] || PLANES.anual;
            if (window.fbq) {
              window.fbq("track", "InitiateCheckout", {
                value: pIC.monto,
                currency: "PEN",
                content_name: NOMBRE_PLAN[planSlug()] || NOMBRE_PLAN.anual,
              });
            }
            if (window.ttq) {
              window.ttq.track("InitiateCheckout", {
                value: pIC.monto,
                currency: "PEN",
                content_name: NOMBRE_PLAN[planSlug()] || NOMBRE_PLAN.anual,
              });
            }
          } catch (eIC) { /* medir nunca bloquea el pago */ }
          ocultarCargandoConElWidget(contenedor);
          // El widget de Flow devuelve un "thenable" propio, no una Promise
          // real (su .then no encadena .catch): Promise.resolve lo asimila.
          Promise.resolve(flow.handleCardSubscribed(subscribe))
            .then(async function () {
              setEstado("Confirmando tu suscripción…");
              var res = await flowSuscripcion({ accion: "confirmar", token: registro.token }, sesion.access_token);
              if (res && res.ok) {
                window.pabloTrack?.("onboarding_pago_flow_exitoso", { plan: planSlug() });
                if (window.fbq) window.fbq("trackCustom", "PagoFlowExitoso", { plan: planSlug() });
                // Check animado un instante antes de entrar a la app.
                mostrarExito();
                setTimeout(irALaAppPagado, 1600);
              } else {
                setEstado((res && res.error) || "El pago no se completó, intenta de nuevo.", true);
                setCargando(false);
                setReintentar(true);
                enCurso = false;
              }
            })
            .catch(function (e) {
              console.error("[Pablo] Widget de Flow:", e);
              setEstado("El pago no se completó, intenta de nuevo.", true);
              setCargando(false);
              setReintentar(true);
              enCurso = false;
            });
        } catch (e) {
          console.error("[Pablo] Pago embebido falló:", e);
          setEstado(e && e.message ? e.message : "No pudimos iniciar el pago", true);
          setCargando(false);
          setReintentar(true);
          enCurso = false;
        }
      };

      window.pabloPagoReintentar = function () {
        window.pabloTrack?.("onboarding_pago_flow_reintento", { plan: planSlug() });
        window.pabloPagoArrancar();
      };

      /* ─── Cupones ─── */
      function pintarCupon(info) {
        var msg = document.getElementById("pago-cupon-msg");
        if (!msg) return;
        msg.hidden = false;
        if (info && typeof info.valido === "boolean") {
          msg.textContent = info.mensaje || (info.valido ? "¡Cupón aplicado!" : "Ese cupón no es válido.");
          msg.classList.toggle("pago-cupon-msg--error", !info.valido);
          if (!info.valido) cuponAplicado = null;
        } else {
          // El backend todavía no responde por el cupón: se informa sin
          // prometer un descuento que no podemos confirmar.
          msg.textContent = "Cupón guardado: se validará al procesar el pago.";
          msg.classList.remove("pago-cupon-msg--error");
        }
      }
      window.pabloPagoCuponToggle = function () {
        var fila = document.getElementById("pago-cupon-fila");
        var toggle = document.getElementById("pago-cupon-toggle");
        if (!fila) return;
        fila.hidden = !fila.hidden;
        if (!fila.hidden) {
          if (toggle) toggle.hidden = true;
          var input = document.getElementById("pago-cupon-input");
          if (input) input.focus();
        }
      };
      window.pabloPagoCuponAplicar = function () {
        var input = document.getElementById("pago-cupon-input");
        var btn = document.getElementById("pago-cupon-aplicar");
        var codigo = ((input && input.value) || "").trim().toUpperCase();
        if (!codigo) return;
        cuponAplicado = codigo;
        window.pabloTrack?.("onboarding_pago_cupon_aplicado", { plan: planSlug(), cupon: codigo });
        if (btn) btn.disabled = true;
        // El checkout se rehace con el cupón puesto: el widget se vuelve a
        // montar con el token nuevo (mismo camino que Reintentar).
        enCurso = false;
        Promise.resolve(window.pabloPagoArrancar()).finally(function () {
          if (btn) btn.disabled = false;
        });
      };
    })();
  </script>
</section>
