<!-- Registro paso a paso (5/5): pago embebido con el widget oficial de Flow
     (elements), SIN salir del onboarding. Con la sesión ya asegurada por el
     step del código: flow-suscripcion "checkout" da el token del registro de
     tarjeta, el widget se monta aquí y "confirmar" crea la suscripción (con
     el trial de la promo si aplica). Al pagar → puente de sesión a la app
     (/auth/sesion → dashboard, ya premium). Fallback: pagar en la app. -->
<section class="step !pb-0" data-step="step-cuenta-pago" aria-label="Pago seguro con Flow" aria-hidden="true">
  <div class="fuente-header">
    <div class="fuente-header__inner">
      <div class="fuente-pablo" data-pablo-anclaje data-pose="anotando"></div>
      <div class="speech-bubble speech-bubble--side">
        ¡Correo verificado! Ahora sí, activemos tu plan
      </div>
    </div>
  </div>

  <div class="fuente-body flex-1 flex flex-col w-full mx-auto px-5 max-md:px-4 overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <div class="pago-card">
      <p class="pago-resumen" id="pago-resumen" hidden></p>
      <!-- Éxito: check verde animado (estilo iOS) antes de entrar a la app. -->
      <div class="pago-exito" id="pago-exito" hidden>
        <svg viewBox="0 0 56 56" class="pago-exito-check" role="img" aria-label="Pago exitoso">
          <circle cx="28" cy="28" r="26" class="pago-exito-circulo" transform="rotate(-90 28 28)"></circle>
          <path d="M16.5 29.5l8 8 15-16" class="pago-exito-palomita"></path>
        </svg>
        <p class="pago-exito-texto">¡Pago exitoso!</p>
        <p class="pago-estado">Entrando a tu cuenta…</p>
      </div>
      <!-- Fallo: Pablito triste acompaña el mensaje de error. -->
      <img
        id="pago-triste"
        class="pago-triste"
        src="/onboarding/images/pablo/emotions/pablo-triste.png"
        alt=""
        width="96"
        height="96"
        loading="lazy"
        hidden
      />
      <!-- ══ Preparando ══
           Este es el punto más caro del embudo: la persona ya decidió y solo
           falta que no se le enfríe mientras Flow responde. En vez de un texto
           quieto, Pablo baja al centro a revisar su moneda y debajo se pinta el
           esqueleto del checkout real. Cuando el widget monta, ocupa
           exactamente ese hueco: el cerebro ya estaba ahí. -->
      <div class="pago-prep" id="pago-prep">
        <!-- Pose anotando, ya no "buscando" (FB27): Rodrigo la vetó el 19-ago por
             la regla de ojos — nada de pestañas ni brillos blancos. -->
        <div class="pago-prep__pablo" data-pablo-anclaje data-pose="anotando"></div>

        <!-- Una frase a la vez, cambiando cada ~1.9s. Nunca una lista: en una
             pantalla de carga, ver varias frases juntas se lee como demora. -->
        <p class="pago-prep__frase" id="pago-prep-frase" aria-live="polite">
          <span data-prep-texto>Preparando tu plan</span><span class="pago-puntos" aria-hidden="true"><i></i><i></i><i></i></span>
        </p>

        <!-- Vista previa del checkout: mismas cajas, mismo orden y mismo alto
             que el widget de Flow, en gris. No es decoración — evita el salto
             de layout cuando el widget aparece. -->
        <div class="pago-prev" aria-hidden="true">
          <span class="pago-prev__label"></span>
          <div class="pago-prev__campo pago-prev__campo--tarjeta"></div>
          <div class="pago-prev__fila">
            <div class="pago-prev__campo"></div>
            <div class="pago-prev__campo"></div>
          </div>
          <div class="pago-prev__boton"></div>
        </div>
      </div>

      <p class="pago-estado" id="pago-estado" hidden></p>
      <div id="pago-widget"></div>
      <button type="button" class="btn-primary btn-continue" id="pago-reintentar" hidden onclick="pabloPagoReintentar()">
        Reintentar
      </button>
      <p class="pago-nota"><img src="/onboarding/images/iconos/fi06_escudo.png" alt="" width="18" height="18" loading="lazy" class="pab-icono" /> Pago procesado por Flow. Pablo nunca ve tu tarjeta.</p>
    </div>
  </div>

  <script is:inline>
    (function () {
      var SUPABASE_URL = "https://mezpfnagkubumzbromsh.supabase.co";
      var SUPABASE_ANON_KEY =
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1lenBmbmFna3VidW16YnJvbXNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjM0NDM3NDMsImV4cCI6MjA3OTAxOTc0M30.HsTSJqkzslq4HWxLlIvuFwudrFzkemHELgsi54vIJDw";
      var FLOW_SCRIPTS = {
        sandbox: "https://sandbox.flow.cl/app/elements/flow-1.1.0.min.js?20241202",
        production: "https://www.flow.cl/app/elements/flow-1.1.0.min.js?20241202",
      };
      var NOMBRE_PLAN = { semanal: "Plan Semanal", mensual: "Plan Mensual", anual: "Plan Anual" };
      var PLANES = {
        semanal: { texto: "Plan Semanal — S/.7 a la semana", trial: 0 },
        mensual: { texto: "Plan Mensual — S/.20 al mes", trial: 3 },
        anual: { texto: "Plan Anual — S/.200 al año", trial: 7 },
      };
      // Oferta Millonaria (misma ventana que Step18 y el backend): mensual 14
      // días, anual cobro directo. Fuera de la ventana no cambia nada.
      (function () {
        var ahora = Date.now();
        if (
          ahora >= Date.parse("2026-07-23T20:40:00-05:00") &&
          ahora < Date.parse("2026-07-30T00:00:00-05:00")
        ) {
          PLANES.mensual.trial = 14;
          PLANES.anual.trial = 0;
        }
      })();

      var flowScriptPromise = null;
      var enCurso = false;

      function planSlug() {
        return sessionStorage.getItem("pablo_plan_elegido") || "anual";
      }
      /* Frases de la espera. Cortas, concretas y en el orden real de lo que
         está pasando: cada una mata una objeción distinta (¿me cobran ya?,
         ¿es seguro?, ¿puedo salirme?). Se muestra UNA a la vez. */
      var FRASES_PREP = [
        "Preparando tu plan",
        "Abriendo tu prueba gratis",
        "Nadie te cobra hoy",
        "Cifrando la conexión",
        "Cancelas cuando quieras",
        "Ya casi",
      ];
      var prepTimer = null;

      function prepArrancar() {
        var caja = document.getElementById("pago-prep");
        var span = document.querySelector("[data-prep-texto]");
        if (!caja || !span) return;
        caja.hidden = false;
        // Pablo baja al centro a acompañar la espera.
        window.pabloActorRevisar && window.pabloActorRevisar();
        var i = 0;
        span.textContent = FRASES_PREP[0];
        clearInterval(prepTimer);
        prepTimer = setInterval(function () {
          i = (i + 1) % FRASES_PREP.length;
          // Se desvanece, cambia y vuelve: sin el fundido el texto "salta".
          span.parentElement.classList.add("pago-prep__frase--sale");
          setTimeout(function () {
            span.textContent = FRASES_PREP[i];
            span.parentElement.classList.remove("pago-prep__frase--sale");
          }, 220);
        }, 1900);
      }

      function prepParar() {
        clearInterval(prepTimer);
        prepTimer = null;
        var caja = document.getElementById("pago-prep");
        if (caja) caja.hidden = true;
        // …y vuelve a la esquina para dejarle la pantalla al checkout.
        window.pabloActorRevisar && window.pabloActorRevisar();
      }

      function setEstado(msg, esError) {
        var el = document.getElementById("pago-estado");
        if (!el) return;
        el.textContent = msg || "";
        el.hidden = !msg;
        if (esError) prepParar();
        el.classList.toggle("pago-estado--error", Boolean(esError));
        // Pablito triste acompaña los errores.
        var triste = document.getElementById("pago-triste");
        if (triste) triste.hidden = !esError;
      }
      function mostrarExito() {
        prepParar();
        var widget = document.getElementById("pago-widget");
        if (widget) widget.innerHTML = "";
        setEstado("");
        setReintentar(false);
        var exito = document.getElementById("pago-exito");
        if (exito) exito.hidden = false;
      }
      function setReintentar(visible) {
        var btn = document.getElementById("pago-reintentar");
        if (btn) btn.hidden = !visible;
      }
      function pintarResumen() {
        var p = PLANES[planSlug()] || PLANES.anual;
        var el = document.getElementById("pago-resumen");
        if (el) {
          el.hidden = false;
          el.textContent =
            p.texto +
            (p.trial > 0
              ? " · " + p.trial + " días gratis, cancela cuando quieras"
              : " · se cobra hoy, cancela cuando quieras");
        }
      }

      function cargarFlowScript(entorno) {
        if (window.Flow) return Promise.resolve();
        if (!flowScriptPromise) {
          flowScriptPromise = new Promise(function (resolve, reject) {
            var s = document.createElement("script");
            s.src = FLOW_SCRIPTS[entorno] || FLOW_SCRIPTS.sandbox;
            s.async = true;
            s.onload = resolve;
            s.onerror = function () {
              flowScriptPromise = null;
              reject(new Error("No se pudo cargar el widget de Flow"));
            };
            document.head.appendChild(s);
          });
        }
        return flowScriptPromise;
      }

      async function flowSuscripcion(body, accessToken) {
        var res = await fetch(SUPABASE_URL + "/functions/v1/flow-suscripcion", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            apikey: SUPABASE_ANON_KEY,
            Authorization: "Bearer " + accessToken,
          },
          body: JSON.stringify(body),
        });
        var data = {};
        try {
          data = await res.json();
        } catch (e) {
          /* respuesta sin body */
        }
        data.__status = res.status;
        return data;
      }

      /* Éxito (pago confirmado o suscripción ya activa): a la app logueado. */
      function irALaAppPagado() {
        var tokens = window.pabloCuentaTokens ? window.pabloCuentaTokens() : {};
        var base = window.pabloCuentaConPhDid(window.pabloCuentaAppBase() + "/auth/sesion");
        if (tokens.access_token && tokens.refresh_token) {
          window.location.href =
            base +
            "#access_token=" +
            encodeURIComponent(tokens.access_token) +
            "&refresh_token=" +
            encodeURIComponent(tokens.refresh_token);
        } else {
          window.location.href = window.pabloCuentaConPhDid(window.pabloCuentaAppBase());
        }
      }

      /* El rotador se ata a que la PANTALLA se muestre, no al flujo de pago.
         Antes solo arrancaba dentro de pabloPagoArrancar: si el checkout
         fallaba antes de llegar ahí (sin sesión, red caída), el bloque quedaba
         visible con la primera frase congelada para siempre — justo la
         sensación de "se colgó" que esta pantalla tiene que evitar. */
      var pantallaPago = document.querySelector('[data-step="step-cuenta-pago"]');
      if (pantallaPago) {
        new MutationObserver(function () {
          if (pantallaPago.classList.contains("active")) {
            var caja = document.getElementById("pago-prep");
            if (caja && !caja.hidden) prepArrancar();
          } else {
            prepParar();
          }
        }).observe(pantallaPago, { attributes: true, attributeFilter: ["class"] });
        if (pantallaPago.classList.contains("active")) prepArrancar();
      }

      window.pabloPagoArrancar = async function () {
        if (enCurso) return;
        enCurso = true;
        setReintentar(false);
        var exito = document.getElementById("pago-exito");
        if (exito) exito.hidden = true;
        pintarResumen();
        prepArrancar();
        setEstado("");

        try {
          var sesion = await window.pabloCuentaAsegurarSesion();
          if (!sesion) {
            window.pabloCuentaIrAlPago();
            return;
          }

          var registro = await flowSuscripcion(
            { accion: "checkout", plan: NOMBRE_PLAN[planSlug()] || NOMBRE_PLAN.anual },
            sesion.access_token
          );
          if (registro.__status === 409) {
            // Ya tiene una suscripción activa: nada que cobrar.
            irALaAppPagado();
            return;
          }
          if (!registro.token || !registro.entorno) {
            throw new Error(registro.error || "No pudimos iniciar el pago");
          }

          await cargarFlowScript(registro.entorno);
          if (typeof window.Flow !== "function") throw new Error("Widget de Flow no disponible");

          var contenedor = document.getElementById("pago-widget");
          if (contenedor) contenedor.innerHTML = "";
          prepParar();
          setEstado("");

          var flow = window.Flow();
          var subscribe = flow.elements().create("subscribe", {
            style: { backgroundColor: "transparent" },
          });
          subscribe.mount("#pago-widget", registro.token);
          // El widget de Flow devuelve un "thenable" propio, no una Promise
          // real (su .then no encadena .catch): Promise.resolve lo asimila.
          Promise.resolve(flow.handleCardSubscribed(subscribe))
            .then(async function () {
              setEstado("Confirmando tu suscripción…");
              var res = await flowSuscripcion({ accion: "confirmar", token: registro.token }, sesion.access_token);
              if (res && res.ok) {
                window.pabloTrack?.("onboarding_pago_flow_exitoso", { plan: planSlug() });
                if (window.fbq) window.fbq("trackCustom", "PagoFlowExitoso", { plan: planSlug() });
                // Check animado un instante antes de entrar a la app.
                mostrarExito();
                setTimeout(irALaAppPagado, 1600);
              } else {
                setEstado((res && res.error) || "El pago no se completó, intenta de nuevo.", true);
                setReintentar(true);
                enCurso = false;
              }
            })
            .catch(function (e) {
              console.error("[Pablo] Widget de Flow:", e);
              setEstado("El pago no se completó, intenta de nuevo.", true);
              setReintentar(true);
              enCurso = false;
            });
        } catch (e) {
          console.error("[Pablo] Pago embebido falló:", e);
          setEstado(e && e.message ? e.message : "No pudimos iniciar el pago", true);
          setReintentar(true);
          enCurso = false;
        }
      };

      window.pabloPagoReintentar = function () {
        window.pabloTrack?.("onboarding_pago_flow_reintento", { plan: planSlug() });
        window.pabloPagoArrancar();
      };
    })();
  </script>
</section>
