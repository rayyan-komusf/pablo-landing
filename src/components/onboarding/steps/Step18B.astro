<!-- Paywall 2/2 (Rodrigo, 24-ago): el calendario honesto del cobro y los
     planes. Separado de la nota para que TODO entre en una pantalla de móvil.
     La lógica de planes vive acá (el CTA de la página 1 solo hace next). -->
<section class="step !pb-0" data-step="step-18b" aria-label="Elige tu plan Premium" aria-hidden="true">
  <div class="pw">
    <div class="pw__scroll">
      <div class="pw-head">
        <h2 class="pw-head__titulo" data-pw-titulo>
          Elige tu plan Premium
        </h2>
        <p class="pw-head__sub" data-pw-sub>
          El primer cobro se realiza al confirmar en WHOP.
        </p>
      </div>

      <!-- Calendario honesto: la objeción real acá no es el precio, es
           "¿me van a cobrar sin avisarme?". -->
      <ol class="pw-linea" data-pw-linea>
        <li class="pw-linea__hito pw-linea__hito--hoy">
          <span class="pw-linea__punto" aria-hidden="true"><img src="/onboarding/images/iconos/pablo/regalo.webp" alt="" width="22" height="22" loading="lazy" /></span>
          <span class="pw-linea__cuando">Hoy</span>
          <span class="pw-linea__que" data-pw-hoy-que>Elige tu plan y confirma el pago para activar Premium.</span>
        </li>


      </ol>

      <p class="pw-legal">
        <a href="/terminos">Términos</a> · <a href="/privacidad">Privacidad</a>
      </p>
    </div>

    <!-- Zona de decisión. Revisada 19-ago contra 8 paywalls reales de Mobbin
         (Beside, Fixtured, Hatch, Calm Sleep, Tide Guide, Yubo, BitePal, KOHO),
         la misma fuente del video que pasó Rodrigo. Tres patrones que se
         repetían y acá faltaban:

         1. 6 de los 8 muestran los planes EN la pantalla, no detrás de un
            link. El "Ver todos los planes" escondía la decisión y obligaba a
            abrir un modal para comparar.
         2. Casi todos matan la objeción del cobro con una línea explícita —
            "Due today $0.00" (Beside), "No payment now" (BitePal). Decir
            "cancela cuando quieras" no es lo mismo que decir que hoy no se
            cobra nada.
         3. El precio se enmarca por día o por semana, no solo por mes.

         El mensual sigue siendo el héroe (preseleccionado); el anual queda
         visible como upgrade, con su ahorro real. -->
    <div class="pw-cierre">
      <div class="pw-planes-fila" role="radiogroup" aria-label="Elige tu plan">
        <button
          type="button"
          class="pw-plan pw-plan--activo"
          data-pw-plan="mensual"
          role="radio"
          aria-checked="true"
          onclick="pabloElegirPlanPaywall(this, 'mensual')"
        >
          <span class="pw-plan__nombre">1 mes</span>
          <span class="pw-plan__precio">S/.20</span>
          <span class="pw-plan__unidad">S/.5 por semana</span>
          <span class="pw-plan__gratis">Cobro al confirmar</span>
        </button>
        <button
          type="button"
          class="pw-plan"
          data-pw-plan="anual"
          role="radio"
          aria-checked="false"
          onclick="pabloElegirPlanPaywall(this, 'anual')"
        >
          <span class="pw-plan__ahorro">Ahorra 45%</span>
          <span class="pw-plan__nombre">12 meses</span>
          <span class="pw-plan__precio">S/.200</span>
          <span class="pw-plan__unidad">S/.3.84 por semana</span>
          <!-- El anual perdió su trial el 18-ago-2026 (cobro directo): acá va
               la garantía, que es lo que reemplaza a la prueba. -->
          <span class="pw-plan__gratis">Garantía 14 días</span>
        </button>
      </div>

      <button class="btn-primary pw-cta" onclick="pabloStartTrial()">
        <span data-pw-cta-label>Continuar al pago</span>
        <span class="arrow" aria-hidden="true">→</span>
      </button>

      <p class="pw-hoy" data-pw-hoy>
        <strong>Primer cobro al confirmar.</strong> Luego S/.20 al mes, y cancelas cuando quieras.
      </p>
      <button class="pw-planes" onclick="pabloOpenPlans()">Ver todos los planes</button>
    </div>
  </div>

  <!-- Modal: todos los planes -->
  <div
    id="plansModal"
    class="fixed inset-0 z-[100] hidden items-end justify-center min-[480px]:items-center"
    role="dialog"
    aria-modal="true"
    aria-label="Todos los planes"
  >
    <!-- Backdrop -->
    <div class="plans-backdrop absolute inset-0 bg-[rgba(43,44,100,0.55)]" onclick="pabloClosePlans()"></div>
    <!-- Sheet -->
    <div class="plans-sheet relative w-full max-w-[420px] bg-lila rounded-t-[28px] min-[480px]:rounded-[28px] min-[480px]:mx-4 px-5 pt-5 pb-7 flex flex-col gap-4">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <h3 class="font-display font-bold text-[20px] text-navy">Elige tu plan</h3>
        <button
          class="w-9 h-9 rounded-full bg-white flex items-center justify-center text-navy text-[16px] leading-none shadow-soft"
          onclick="pabloClosePlans()"
          aria-label="Cerrar"
        >
          ✕
        </button>
      </div>
      <!-- Cards de planes -->
      <div class="grid grid-cols-3 gap-2 pt-3">
        <!-- 1 semana -->
        <button
          type="button"
          class="plan-card relative flex flex-col items-center rounded-[18px] px-2 pt-5 pb-4 bg-white"
          data-plan="semanal"
          onclick="pabloSelectPlan(this, 'semanal')"
          aria-pressed="false"
        >
          <span class="font-display font-bold text-[26px] text-navy leading-none">1</span>
          <span class="text-[10px] font-body uppercase tracking-widest text-navy-soft mt-1">semana</span>
          <span class="font-display font-bold text-[18px] text-navy mt-2">S/. 7</span>
          <span class="text-[10px] font-body text-navy-soft leading-tight">S/. 1 /día</span>
          <span class="text-[10px] font-body font-bold text-amber mt-1">Cobro al confirmar</span>
        </button>
        <!-- 1 mes -->
        <button
          type="button"
          class="plan-card selected relative flex flex-col items-center rounded-[18px] px-2 pt-5 pb-4 bg-white"
          data-plan="mensual"
          onclick="pabloSelectPlan(this, 'mensual')"
          aria-pressed="true"
        >
          <span class="plan-badge absolute -top-[10px] left-1/2 -translate-x-1/2 whitespace-nowrap text-[9px] font-display font-bold tracking-wide text-navy px-2 py-[3px]">EL MÁS ELEGIDO</span>
          <span class="font-display font-bold text-[26px] text-navy leading-none">1</span>
          <span class="text-[10px] font-body uppercase tracking-widest text-navy-soft mt-1">mes</span>
          <span class="font-display font-bold text-[18px] text-navy mt-2">S/. 20</span>
          <span class="text-[10px] font-body text-navy-soft leading-tight">S/. 5 /semana</span>
          <span class="text-[10px] font-body font-bold text-amber mt-1" data-pm-swap="Cobro al confirmar">Cobro al confirmar</span>
        </button>
        <!-- 12 meses -->
        <button
          type="button"
          class="plan-card relative flex flex-col items-center rounded-[18px] px-2 pt-5 pb-4 bg-white"
          data-plan="anual"
          onclick="pabloSelectPlan(this, 'anual')"
          aria-pressed="false"
        >
          <span class="plan-badge absolute -top-[10px] left-1/2 -translate-x-1/2 whitespace-nowrap text-[9px] font-display font-bold tracking-wide text-navy px-2 py-[3px]">AHORRA 45%</span>
          <span class="font-display font-bold text-[26px] text-navy leading-none">12</span>
          <span class="text-[10px] font-body uppercase tracking-widest text-navy-soft mt-1">meses</span>
          <span class="font-display font-bold text-[18px] text-navy mt-2">S/. 200</span>
          <span class="text-[10px] font-body text-navy-soft leading-tight">S/. 3.84 /sem</span>
          <span class="text-[10px] font-body font-bold text-amber mt-1">Garantía 14 días</span>
        </button>
      </div>
      <!-- CTA del modal -->
      <button class="btn-primary w-full text-[16px] py-[14px] mt-1" onclick="pabloStartTrial()">
        <span id="plansCtaLabel">Continuar al pago</span>
        <span class="arrow" aria-hidden="true">→</span>
      </button>
      <p class="text-[12px] text-center font-body text-navy-soft -mt-2">Cancela en cualquier momento</p>
    </div>
  </div>
  <div style="padding: 8px 24px 20px; text-align: center;">
    <button type="button" class="btn-secondary" style="min-height:44px;width:100%;max-width:360px" onclick="pabloSeguirGratis()">Seguir con Gratis</button>
    <p style="font-size:12px;margin-top:8px">Sin tarjeta · 5 mensajes diarios · 3 cuentas</p>
  </div>
</section>

<script is:inline type="module">
  // Elegir plan no redirige: sigue al registro paso a paso (steps cuenta-*).
  const planes = {
    semanal: { nombre: "Plan Semanal", precio: "S/7", dias: 7, ctaLabel: "Elegir Plan Semanal" },
    mensual: { nombre: "Plan Mensual", precio: "S/20", dias: 30, ctaLabel: "Elegir Plan Mensual" },
    anual: { nombre: "Plan Anual", precio: "S/200", dias: 365, ctaLabel: "Elegir Plan Anual" },
  };
  let planSeleccionado = "mensual";

  function abrirPlanes() {
    const modal = document.getElementById("plansModal");
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    window.pabloTrack?.("onboarding_plans_opened", {});
  }

  function cerrarPlanes() {
    const modal = document.getElementById("plansModal");
    modal?.classList.add("hidden");
    modal?.classList.remove("flex");
  }

  function seleccionarPlan(el, plan) {
    planSeleccionado = plan;
    document.querySelectorAll("#plansModal .plan-card").forEach((card) => {
      card.classList.remove("selected");
      card.setAttribute("aria-pressed", "false");
    });
    el.classList.add("selected");
    el.setAttribute("aria-pressed", "true");
    const label = document.getElementById("plansCtaLabel");
    if (label) label.textContent = planes[plan].ctaLabel;
    window.pabloTrack?.("onboarding_plan_selected", { plan });
  }

  function iniciarPrueba(plan = planSeleccionado) {
    if (!planes[plan]) return;
    sessionStorage.setItem("pablo_plan_elegido", plan);
    window.pabloTrack?.("onboarding_plan_selected_for_signup", { plan });
    cerrarPlanes();
    window.pabloNext();
  }

  function pintarLinea(plan) {
    const p = planes[plan] || planes.mensual;
    document.querySelector("[data-pw-titulo]").textContent = "Empieza con el " + p.nombre;
    document.querySelector("[data-pw-sub]").textContent = "Pago seguro con WHOP. Cancela la renovación desde Facturación.";
    document.querySelector("[data-pw-hoy-que]").textContent = "Pagas " + p.precio + " al confirmar y accedes a Premium por " + p.dias + " días.";
    document.querySelector("[data-pw-hoy]").textContent = p.precio + " cada " + p.dias + " días. El primer cobro se realiza al confirmar.";
    document.querySelectorAll("[data-pw-hito-aviso], [data-pw-hito-cobro]").forEach(el => el.hidden = true);
  }

  const pantalla18b = document.querySelector('[data-step="step-18b"]');
  if (pantalla18b) {
    new MutationObserver(() => {
      if (pantalla18b.classList.contains("active")) pintarLinea(planSeleccionado);
    }).observe(pantalla18b, { attributes: true, attributeFilter: ["class"] });
    if (pantalla18b.classList.contains("active")) pintarLinea(planSeleccionado);
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") cerrarPlanes();
  });

  /* Selector inline del paywall: escribe el MISMO planSeleccionado que el
     modal (una sola fuente de verdad). */
  function elegirPlanPaywall(el, plan) {
    if (!planes[plan]) return;
    planSeleccionado = plan;
    document.querySelectorAll("[data-pw-plan]").forEach(function (b) {
      var activo = b === el;
      b.classList.toggle("pw-plan--activo", activo);
      b.setAttribute("aria-checked", String(activo));
    });
    var cta = document.querySelector("[data-pw-cta-label]");
    if (cta) cta.textContent = planes[plan].ctaLabel;
    pintarLinea(plan);
    window.pabloTrack?.("onboarding_plan_selected", { plan: plan, origen: "paywall" });
  }
  window.pabloElegirPlanPaywall = elegirPlanPaywall;

  window.pabloOpenPlans = abrirPlanes;
  window.pabloClosePlans = cerrarPlanes;
  window.pabloSelectPlan = seleccionarPlan;
  window.pabloStartTrial = iniciarPrueba;
</script>
