<!-- Registro en UNA pantalla: nombre, correo y contraseña juntos.
       Antes eran tres steps seguidos (nombre → correo → contraseña); se
       fusionaron porque pedir tres datos triviales en tres pantallas alarga
       el paso más caro del embudo, justo antes de crear la cuenta.
     Crea la cuenta directo contra Supabase Auth (anon key pública), envía el
     código de verificación de correo (edge function verificar-correo) y pasa
     al step del código. Recién al verificar, el código entrega la sesión a la
     app por el FRAGMENT de la URL (no viaja a servidores):
     usapablo.app/auth/sesion?plan=X#access_token=…&refresh_token=…
     La app instala la sesión y sigue al checkout de la pasarela WHOP. -->
<section class="step !pb-0" data-step="step-cuenta-password" aria-label="Crea tu cuenta" aria-hidden="true">
  <div class="fuente-header">
    <div class="fuente-header__inner">
      <div class="fuente-pablo" data-pablo-anclaje data-pose="anotando"></div>
      <div class="speech-bubble speech-bubble--side">¡Genial! Solo 3 datos y listo.</div>
    </div>
  </div>

  <div class="fuente-body flex-1 flex flex-col w-full mx-auto px-5 max-md:px-4 overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden vcenter">
    <div class="cuenta-form">

      <label class="v2-etiqueta" for="cuenta-nombre">Tu nombre</label>
      <div class="cuenta-campo">
        <img data-icons-test class="cuenta-campo__icono" src="/onboarding/images/iconos/pablo/avatar.webp" alt="" aria-hidden="true" width="22" height="22" />
        <input
          id="cuenta-nombre"
          class="cuenta-input"
          type="text"
          inputmode="text"
          placeholder="¿Cómo te llamas?"
          autocomplete="name"
          maxlength="60"
          oninput="pabloCuentaRevisar()"
          onkeydown="if(event.key==='Enter')pabloCuentaCrear()"
        />
      </div>
      <label class="v2-etiqueta" for="cuenta-correo">Correo</label>
      <div class="cuenta-campo">
        <img data-icons-test class="cuenta-campo__icono" src="/onboarding/images/iconos/pablo/sobre.webp" alt="" aria-hidden="true" width="22" height="22" />
        <input
          id="cuenta-correo"
          class="cuenta-input"
          type="email"
          inputmode="email"
          placeholder="tucorreo@gmail.com"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          maxlength="120"
          oninput="pabloCuentaRevisar()"
          onkeydown="if(event.key==='Enter')pabloCuentaCrear()"
        />
      </div>
      <p class="cuenta-hint v2-hint">Con este correo entrarás a Pablo.</p>
      <label class="v2-etiqueta" for="cuenta-password">Contraseña</label>
      <div class="cuenta-campo">
        <img data-icons-test class="cuenta-campo__icono" src="/onboarding/images/iconos/pablo/candado.webp" alt="" aria-hidden="true" width="26" height="26" />
        <input
          id="cuenta-password"
          class="cuenta-input"
          type="password"
          placeholder="••••••"
          autocomplete="new-password"
          maxlength="72"
          oninput="pabloCuentaRevisar()"
          onkeydown="if(event.key==='Enter')pabloCuentaCrear()"
        />
      </div>

      <p class="cuenta-hint v2-hint">Mínimo 6 caracteres.</p>

      <p class="cuenta-error" id="cuenta-error" role="alert"></p>
    </div>
  </div>

  <footer class="duo-footer cta-footer">
    <button
      id="cuenta-crear-btn"
      class="btn-primary btn-continue disabled"
      disabled
      onclick="pabloCuentaCrear()"
      aria-label="Crear mi cuenta gratis"
    >
      Crear mi cuenta gratis
    </button>
  </footer>

  <script is:inline>
    (function () {
      var SUPABASE_URL = "https://mezpfnagkubumzbromsh.supabase.co";
      /* Correo + contraseña recién escritos: SOLO en esta closure, nunca en
       * window (ahí los leería cualquier script de terceros de la página:
       * pixels, PostHog). */
      var pendiente = null;
      // Anon key pública de Supabase (la misma que usa la app en el navegador).
      var SUPABASE_ANON_KEY =
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1lenBmbmFna3VidW16YnJvbXNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjM0NDM3NDMsImV4cCI6MjA3OTAxOTc0M30.HsTSJqkzslq4HWxLlIvuFwudrFzkemHELgsi54vIJDw";

      /* Helpers compartidos por los steps de cuenta (también los usa el
       * "¿Ya tienes cuenta?" del step del nombre). En local (localhost/LAN)
       * el destino es la app local para poder testear. */
      window.pabloCuentaAppBase = function () {
        return /^(localhost|127\.0\.0\.1|192\.168\.)/.test(location.hostname)
          ? "http://localhost:8080"
          : "https://usapablo.app";
      };
      window.pabloCuentaConPhDid = function (url) {
        try {
          var did = window.posthog?.get_distinct_id?.();
          var salida = url;
          if (did) {
            var u = new URL(url);
            u.searchParams.set("ph_did", did);
            salida = u.toString();
          }
          // Huella del clic de Meta: usapablo.app no ve nuestras cookies.
          if (window.pabloConFbc) salida = window.pabloConFbc(salida);
          // Afiliado de Whop (?a=): la app lo manda al checkout.
          return window.pabloConAfiliado ? window.pabloConAfiliado(salida) : salida;
        } catch (e) {
          return url;
        }
      };

      /* Tokens de la sesión recién creada (los usa también el step del código). */
      window.pabloCuentaTokens = function () {
        try {
          return JSON.parse(sessionStorage.getItem("pablo_sesion_tokens") || "{}");
        } catch (e) {
          return {};
        }
      };

      /* Llama a la edge function verificar-correo. Trabaja POR EMAIL, sin
       * sesión: con la confirmación de correo de Supabase activada el signup
       * no entrega tokens, así que el código ES la prueba de identidad.
       * body: { accion: "enviar", email } | { accion: "verificar", email, codigo } */
      window.pabloCuentaVerificarCorreo = async function (body) {
        try {
          var res = await fetch(SUPABASE_URL + "/functions/v1/verificar-correo", {
            method: "POST",
            headers: { "Content-Type": "application/json", apikey: SUPABASE_ANON_KEY },
            body: JSON.stringify(body),
          });
          var data = {};
          try {
            data = await res.json();
          } catch (e) {
            /* respuesta sin body */
          }
          return data || {};
        } catch (e) {
          console.error("[Pablo] verificar-correo falló:", e);
          return { error: "No pudimos conectar con el servidor" };
        }
      };

      /* ¿El access token ya venció (o está por vencer)? Se decodifica el exp
       * del JWT; ante cualquier rareza se asume vigente y que el backend
       * responda. */
      function tokenPorVencer(jwt) {
        try {
          var p = JSON.parse(atob(jwt.split(".")[1].replace(/-/g, "+").replace(/_/g, "/")));
          return !p.exp || p.exp * 1000 - Date.now() < 60 * 1000;
        } catch (e) {
          return false;
        }
      }

      /* Sesión para el pago: la guardada (refrescándola si el access token
       * venció — p. ej. recarga de la página horas después), o login con las
       * credenciales que el usuario acaba de escribir (quedan SOLO en memoria
       * de la página; necesario cuando Supabase exige confirmar el correo
       * antes de dar tokens: recién tras verificar el código el login
       * funciona). */
      window.pabloCuentaAsegurarSesion = async function () {
        var t = window.pabloCuentaTokens();
        if (t.access_token && t.refresh_token) {
          if (!tokenPorVencer(t.access_token)) return t;
          var rr = await authFetch("/auth/v1/token?grant_type=refresh_token", {
            refresh_token: t.refresh_token,
          });
          if (rr.ok && rr.data.access_token) {
            var nuevos = {
              access_token: rr.data.access_token,
              refresh_token: rr.data.refresh_token || t.refresh_token,
            };
            try {
              sessionStorage.setItem("pablo_sesion_tokens", JSON.stringify(nuevos));
            } catch (e) {
              /* modo privado */
            }
            return nuevos;
          }
          /* refresh falló: se intenta el login con las credenciales pendientes */
        }
        var p = pendiente;
        if (!p || !p.email || !p.pass) return null;
        var r = await authFetch("/auth/v1/token?grant_type=password", {
          email: p.email,
          password: p.pass,
        });
        if (!r.ok || !r.data.access_token) return null;
        var tokens = { access_token: r.data.access_token, refresh_token: r.data.refresh_token };
        try {
          sessionStorage.setItem("pablo_sesion_tokens", JSON.stringify(tokens));
        } catch (e) {
          /* modo privado: los steps siguientes re-loguean con pendiente */
        }
        return tokens;
      };

      /* Al pago: puente de sesión a la app, que decide la pasarela (hoy el
       * checkout de WHOP en /pricing). Sin tokens (modo privado),
       * flujo clásico: /pricing pide login y retoma solo. */
      window.pabloCuentaIrAlPago = function () {
        var plan = sessionStorage.getItem("pablo_plan_elegido") || "mensual";
        var codigo = sessionStorage.getItem("pablo_codigo_descuento") || "";
        var extra = codigo && plan !== "free" ? "&codigo=" + encodeURIComponent(codigo) : "";
        var tokens = window.pabloCuentaTokens();
        /* Oferta por tiempo limitado (step-oferta): ese camino cobra la
         * OFERTA de la app (anual S/120), así que no lleva precio=lista. */
        var conPrecio = function (u) {
          if (sessionStorage.getItem("pablo_precio_oferta") !== "1" || plan === "free") return u;
          try {
            var x = new URL(u);
            x.searchParams.delete("precio");
            return x.toString();
          } catch (e) {
            return u;
          }
        };
        if (tokens.access_token && tokens.refresh_token) {
          window.location.href =
            conPrecio(window.pabloCuentaConPhDid(window.pabloCuentaAppBase() + "/auth/sesion?plan=" + plan + extra)) +
            "#access_token=" +
            encodeURIComponent(tokens.access_token) +
            "&refresh_token=" +
            encodeURIComponent(tokens.refresh_token);
        } else {
          window.location.href = conPrecio(window.pabloCuentaConPhDid(
            window.pabloCuentaAppBase() + (plan === "free" ? "/auth?gratis=1" : "/pricing?plan=" + plan + extra)
          ));
        }
      };

      var creando = false;

      function planElegido() {
        return sessionStorage.getItem("pablo_plan_elegido") || "anual";
      }
      function mostrarError(msg) {
        var el = document.getElementById("cuenta-error");
        if (el) {
          el.textContent = msg;
          el.classList.add("visible");
        }
      }
      function limpiarError() {
        document.getElementById("cuenta-error")?.classList.remove("visible");
      }
      function setBoton(texto, deshabilitado) {
        var btn = document.getElementById("cuenta-crear-btn");
        if (!btn) return;
        btn.textContent = texto;
        btn.classList.toggle("disabled", deshabilitado);
        if (deshabilitado) btn.setAttribute("disabled", "");
        else btn.removeAttribute("disabled");
      }

      /* CompleteRegistration (Sandra, 07-oct-2026): navegador + servidor con el
       * MISMO event_id para que Meta lo cuente una vez. El servidor
       * (meta-registro) agrega IP/user agent y une con la compra por
       * external_id. Solo MEDICIÓN: no usarlo como objetivo de campaña. */
      function registroMeta(data) {
        try {
          var userId = data && data.user && data.user.id;
          var token = data && data.access_token;
          if (!userId || !token) return;
          var plan = planElegido();
          var contenido = plan === "free" ? "gratis" : plan;
          if (window.fbq) {
            window.fbq("track", "CompleteRegistration", { content_name: contenido }, { eventID: "registro_" + userId });
          }
          var huella = window.pabloFbCookies ? window.pabloFbCookies() : {};
          fetch(SUPABASE_URL + "/functions/v1/meta-registro", {
            method: "POST",
            keepalive: true,
            headers: { "Content-Type": "application/json", apikey: SUPABASE_ANON_KEY, Authorization: "Bearer " + token },
            body: JSON.stringify({
              plan: plan,
              fbc: huella.fbc || null,
              fbp: huella.fbp || null,
              source_url: location.origin + location.pathname,
            }),
          }).catch(function () {});
        } catch (e) {
          /* la medición nunca bloquea el registro */
        }
      }

      async function authFetch(path, body) {
        var res = await fetch(SUPABASE_URL + path, {
          method: "POST",
          headers: { "Content-Type": "application/json", apikey: SUPABASE_ANON_KEY },
          body: JSON.stringify(body),
        });
        var data = {};
        try {
          data = await res.json();
        } catch (e) {
          /* respuesta sin body */
        }
        return { ok: res.ok, data: data };
      }

      var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

      /* Los tres campos viven en la misma pantalla (antes eran tres steps).
       * Se leen del DOM, no de sessionStorage: aquí son la fuente de verdad. */
      function datosCuenta() {
        return {
          nombre: (document.getElementById("cuenta-nombre")?.value || "").trim(),
          correo: (document.getElementById("cuenta-correo")?.value || "").trim().toLowerCase(),
          pass: document.getElementById("cuenta-password")?.value || "",
        };
      }

      window.pabloCuentaRevisar = function () {
        limpiarError();
        var d = datosCuenta();
        window.onboarding?.gateCta(
          "step-cuenta-password",
          d.nombre.length >= 2 && EMAIL_RE.test(d.correo) && d.pass.length >= 6
        );
      };

      /* Escape para quien ya tiene cuenta: flujo clásico por la app. */
      window.pabloCuentaYaTengo = function () {
        window.pabloTrack?.("onboarding_cuenta_ya_tenia", {});
        var plan = sessionStorage.getItem("pablo_plan_elegido") || "anual";
        window.location.href = window.pabloCuentaConPhDid(
          window.pabloCuentaAppBase() + (plan === "free" ? "/auth?gratis=1" : "/pricing?plan=" + plan)
        );
      };

      window.pabloCuentaCrear = async function () {
        if (creando) return;

        var d = datosCuenta();
        var nombre = d.nombre;
        var correo = d.correo;
        var pass = d.pass;
        if (nombre.length < 2) {
          mostrarError("Escribe tu nombre y apellido.");
          return;
        }
        if (!EMAIL_RE.test(correo)) {
          mostrarError("Revisa tu correo: parece que falta algo.");
          return;
        }
        if (pass.length < 6) {
          mostrarError("La contraseña debe tener al menos 6 caracteres.");
          return;
        }
        /* Se siguen guardando: los leen el step del código y el del pago. */
        sessionStorage.setItem("pablo_cuenta_nombre", nombre);
        sessionStorage.setItem("pablo_cuenta_correo", correo);

        creando = true;
        limpiarError();
        setBoton("Creando tu cuenta…", true);

        try {
          // El registro desde la landing crea la cuenta como free; el plan se
          // activa después de verificar el pago con WHOP en la app.
          // registro_origen + atribucion → users_app (handle_new_user los
          // whitelistea) para que el admin sepa de dónde vino la cuenta.
          var atrib = null;
          try {
            atrib = JSON.parse(localStorage.getItem("pablo_atrib_v1") || "null");
          } catch (e) {
            atrib = null;
          }
          // Experimento A/B de Gratis: la variante que vio ("onboarding-gratis:control"
          // o "onboarding-gratis:sin_gratis"). La base la guarda en
          // registro_atribucion.ab para contar pagos por variante aunque PostHog
          // pierda gente por bloqueadores. Sin experimento (pauta, afiliado,
          // PostHog bloqueado) no va nada.
          try {
            var ab = window.pabloAB && window.pabloAB.abDelRegistro ? window.pabloAB.abDelRegistro() : null;
            if (ab) atrib = Object.assign({}, atrib || {}, { ab: ab });
          } catch (e) {
            /* sin experimento */
          }
          var r = await authFetch("/auth/v1/signup", {
            email: correo,
            password: pass,
            data: { nombre: nombre, apellido: "", registro_origen: "onboarding", atribucion: atrib || undefined },
          });

          var yaExiste =
            !r.ok &&
            (r.data.error_code === "user_already_exists" ||
              /already|registrado/i.test(r.data.msg || r.data.message || r.data.error_description || ""));
          if (yaExiste) {
            // Ese correo ya tiene cuenta: probamos iniciar sesión con la
            // contraseña que acaba de escribir.
            r = await authFetch("/auth/v1/token?grant_type=password", {
              email: correo,
              password: pass,
            });
            var noConfirmado =
              !r.ok &&
              (r.data.error_code === "email_not_confirmed" ||
                /not confirmed/i.test(r.data.msg || r.data.message || r.data.error_description || ""));
            if (!r.ok && !noConfirmado) {
              mostrarError(
                "Ese correo ya tiene una cuenta y la contraseña no coincide. Usa “¿Ya tienes cuenta?” para iniciar sesión en la app."
              );
              creando = false;
              setBoton("Crear mi cuenta gratis", false);
              return;
            }
            // Cuenta existente sin confirmar (de cuando el onboarding pedía
            // código): sigue al pago; si el login aún no funciona, degrada
            // al flujo clásico de pagar en la app.
          } else if (!r.ok) {
            mostrarError(
              r.data.msg || r.data.message || r.data.error_description || "No pudimos crear tu cuenta, intenta de nuevo."
            );
            creando = false;
            setBoton("Crear mi cuenta gratis", false);
            return;
          }

          window.pabloTrack?.("onboarding_cuenta_creada", {
            plan: planElegido(),
            ya_existia: Boolean(yaExiste),
          });
          if (window.fbq) window.fbq("trackCustom", "CuentaCreada", { plan: planElegido() });
          if (window.ttq) window.ttq.track("CompleteRegistration");
          if (!yaExiste) registroMeta(r.data);

          // Credenciales SOLO en memoria de la página: si Supabase exige
          // confirmar el correo, el signup no da tokens y el login recién
          // funciona después de verificar el código.
          pendiente = { email: correo, pass: pass };

          var accessToken = r.data && r.data.access_token;
          var refreshToken = r.data && r.data.refresh_token;
          if (accessToken && refreshToken) {
            try {
              sessionStorage.setItem(
                "pablo_sesion_tokens",
                JSON.stringify({ access_token: accessToken, refresh_token: refreshToken })
              );
            } catch (e) {
              /* modo privado: pabloCuentaAsegurarSesion re-loguea en memoria */
            }
          }

          // SIN verificación de correo antes del pago (Rodrigo, 25-ago): el
          // código se movió a la app (botón "Verificar correo" en el perfil).
          // ⚠️ Esto asume que "Confirm email" está DESACTIVADO en Supabase
          // Auth (dashboard) — con él activado el signup no entrega tokens y
          // este login fallaría con email_not_confirmed. Ryan debe apagarlo
          // al publicar. Mientras tanto el degradado es el flujo clásico:
          // pagar logueándose en la app.
          // Cuenta primero: tras crearla sigue el onboarding (preguntas,
          // diagnóstico y planes). La sesión se asegura ahora para que el
          // pago del final ya tenga tokens.
          setBoton("¡Cuenta lista!", true);
          await window.pabloCuentaAsegurarSesion();
          creando = false;
          setBoton("Crear mi cuenta gratis", false);
          window.pabloNext?.();
        } catch (e) {
          console.error("[Pablo] Registro falló:", e);
          mostrarError("No pudimos conectar con el servidor. Revisa tu internet e intenta de nuevo.");
          creando = false;
          setBoton("Crear mi cuenta gratis", false);
        }
      };

      /* ── Continuar con Google (onboarding v2) ─────────────────────────
       * OAuth de Supabase en flujo implícito: /auth/v1/authorize redirige a
       * Google y vuelve a /onboarding con la sesión en el FRAGMENT
       * (#access_token=…&refresh_token=…), que nunca viaja a servidores.
       * Requiere (equipo): proveedor Google activo en Supabase y
       * usapablo.com/onboarding en Auth → URL Configuration → Redirect URLs.
       * Sin proveedor activo, tocarlo muestra un aviso (pabloGoogleDisponible). */
      var googleDisponible = null;
      window.pabloGoogleDisponible = function () {
        if (!googleDisponible) {
          googleDisponible = fetch(SUPABASE_URL + "/auth/v1/settings", { headers: { apikey: SUPABASE_ANON_KEY } })
            .then(function (r) { return r.ok ? r.json() : {}; })
            .then(function (s) { return Boolean(s && s.external && s.external.google); })
            .catch(function () { return false; });
        }
        return googleDisponible;
      };

      window.pabloCuentaGoogle = async function () {
        window.pabloTrack?.("onboarding_cuenta_metodo", { metodo: "google" });
        var ok = await window.pabloGoogleDisponible();
        if (!ok) {
          // Proveedor aún apagado en Supabase: aviso amable, no página de error.
          var el = document.getElementById("v2-google-error");
          if (el) {
            el.textContent = "Entrar con Google estará listo muy pronto. Por ahora continúa con tu correo.";
            el.classList.add("visible");
          }
          window.pabloTrack?.("onboarding_google_no_disponible", {});
          return;
        }
        try {
          sessionStorage.setItem("pablo_google_pendiente", "1");
        } catch (e) {
          /* modo privado: igual se intenta */
        }
        var vuelta = location.origin + location.pathname;
        window.location.href =
          SUPABASE_URL + "/auth/v1/authorize?provider=google&redirect_to=" + encodeURIComponent(vuelta);
      };

      /* Vuelta de Google: se lee el fragment ANTES de que arranque el motor
       * (este script es inline; onboarding.js es un módulo diferido). */
      (function leerVueltaDeGoogle() {
        if (!location.hash || sessionStorage.getItem("pablo_google_pendiente") !== "1") return;
        var h = new URLSearchParams(location.hash.slice(1));
        sessionStorage.removeItem("pablo_google_pendiente");
        history.replaceState(null, "", location.pathname + location.search);
        var access = h.get("access_token");
        var refresh = h.get("refresh_token");
        if (!access || !refresh) {
          sessionStorage.setItem("pablo_google_volvio", "error");
          var msg = h.get("error_description") || "No pudimos entrar con Google. Prueba con tu correo.";
          document.addEventListener("DOMContentLoaded", function () {
            var el = document.getElementById("v2-google-error");
            if (el) {
              el.textContent = msg.replace(/\+/g, " ");
              el.classList.add("visible");
            }
          });
          window.pabloTrack?.("onboarding_google_error", { error: h.get("error") || "sin_tokens" });
          return;
        }
        try {
          sessionStorage.setItem("pablo_sesion_tokens", JSON.stringify({ access_token: access, refresh_token: refresh }));
        } catch (e) {
          /* modo privado: el pago degrada al flujo clásico en la app */
        }
        sessionStorage.setItem("pablo_google_volvio", "1");
        fetch(SUPABASE_URL + "/auth/v1/user", { headers: { apikey: SUPABASE_ANON_KEY, Authorization: "Bearer " + access } })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (u) {
            if (!u) return;
            var meta = u.user_metadata || {};
            var nombre = meta.full_name || meta.name || "";
            if (nombre) sessionStorage.setItem("pablo_cuenta_nombre", nombre);
            if (u.email) sessionStorage.setItem("pablo_cuenta_correo", u.email);
            // Cuenta nueva (no un login de alguien que ya existía): se mide el
            // registro igual que con correo (CompleteRegistration navegador +
            // servidor con el mismo event_id).
            var nueva = u.created_at && Date.now() - new Date(u.created_at).getTime() < 10 * 60 * 1000;
            window.pabloTrack?.("onboarding_cuenta_creada", { plan: planElegido(), metodo: "google", ya_existia: !nueva });
            if (nueva) {
              if (window.fbq) window.fbq("trackCustom", "CuentaCreada", { plan: planElegido() });
              if (window.ttq) window.ttq.track("CompleteRegistration");
              registroMeta({ user: u, access_token: access });
            }
          })
          .catch(function () {});
      })();
    })();
  </script>
</section>
