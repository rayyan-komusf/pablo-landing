<!-- ¿Cómo supiste de Pablo? (estilo Duolingo: mascota anotando + pills 2 col)
     La imagen es placeholder PNG; se reemplaza por el GIF pablo-anotando
     cuando esté generado. El CTA se habilita al elegir (initFuente). -->
<section class="step !pb-0" data-step="step-fuente" aria-label="¿Cómo supiste de Pablo?" aria-hidden="true">
  <!-- Mascota + burbuja: fuera de la zona de scroll, con línea límite
       de borde a borde (las opciones scrollean por debajo) -->
  <div class="fuente-header">
    <div class="fuente-header__inner">
      <div class="fuente-pablo" data-pablo-anclaje data-pose="anotando"></div>
      <div class="speech-bubble speech-bubble--side">¿Cómo supiste de Pablo?</div>
    </div>
  </div>

  <div class="fuente-body flex-1 flex flex-col w-full mx-auto px-5 max-md:px-4 overflow-y-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden vcenter">
    <!-- Opciones (sin auto-avance: se confirma con Continuar) -->
    <div class="fuente-grid" role="radiogroup" aria-label="Selecciona cómo conociste a Pablo">
      <button class="option-card option-card--pill" role="radio" aria-checked="false"
        onclick="pabloSelect(this, 'referralSource', 'google')">
        <span class="option-icon"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="#4285F4" d="M23.5 12.27c0-.85-.08-1.66-.22-2.45H12v4.64h6.46a5.53 5.53 0 0 1-2.4 3.62v3h3.88c2.27-2.1 3.56-5.17 3.56-8.81z"/><path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.94-2.91l-3.88-3.01c-1.07.72-2.45 1.15-4.06 1.15-3.12 0-5.77-2.11-6.71-4.95H1.28v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.29 14.28a7.2 7.2 0 0 1 0-4.56v-3.1H1.28a12 12 0 0 0 0 10.76l4.01-3.1z"/><path fill="#EA4335" d="M12 4.77c1.76 0 3.34.6 4.58 1.79l3.44-3.44C17.95 1.19 15.23 0 12 0A12 12 0 0 0 1.28 6.62l4.01 3.1C6.23 6.88 8.88 4.77 12 4.77z"/></svg></span>
        <span class="option-label text-left">Búsqueda en Google</span>
      </button>
      <button class="option-card option-card--pill" role="radio" aria-checked="false"
        onclick="pabloSelect(this, 'referralSource', 'amigos-familia')">
        <span class="option-icon"><img src="/onboarding/images/iconos/ui03_perfil.png" alt="" width="30" height="30" loading="lazy" /></span>
        <span class="option-label text-left">Amigos/familia</span>
      </button>
      <button class="option-card option-card--pill" role="radio" aria-checked="false"
        onclick="pabloSelect(this, 'referralSource', 'tiktok')">
        <span class="option-icon"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="#010101" d="M19.32 5.56a4.79 4.79 0 0 1-3.32-4.4H12.6v14.1a2.9 2.9 0 1 1-2.9-2.9c.3 0 .58.05.85.13V9.03a6.33 6.33 0 0 0-.85-.06 6.34 6.34 0 1 0 6.34 6.34V8.66a8.16 8.16 0 0 0 4.66 1.46V6.7a4.83 4.83 0 0 1-1.38-1.14z"/><path fill="#EE1D52" d="M13.6 14.26V1.16h1.06a4.8 4.8 0 0 0 .11 1h-1.17v13.1a2.9 2.9 0 0 1-4.24 2.57 2.9 2.9 0 0 0 4.24-2.57z" opacity=".7"/><path fill="#69C9D0" d="M18.94 7.1a8.1 8.1 0 0 0 1.76.62v-.6a4.8 4.8 0 0 1-1.76-.65v.63z" opacity=".7"/></svg></span>
        <span class="option-label text-left">TikTok</span>
      </button>
      <button class="option-card option-card--pill" role="radio" aria-checked="false"
        onclick="pabloSelect(this, 'referralSource', 'youtube')">
        <span class="option-icon"><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="#FF0000" d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.2 31.6 31.6 0 0 0 0 12a31.6 31.6 0 0 0 .5 5.81 3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14A31.6 31.6 0 0 0 24 12a31.6 31.6 0 0 0-.5-5.81z"/><path fill="#fff" d="M9.6 15.6V8.4L15.8 12l-6.2 3.6z"/></svg></span>
        <span class="option-label text-left">YouTube</span>
      </button>
      <button class="option-card option-card--pill" role="radio" aria-checked="false"
        onclick="pabloSelect(this, 'referralSource', 'facebook-instagram')">
        <span class="option-icon"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><defs><radialGradient id="igg" cx="30%" cy="107%" r="150%"><stop offset="0%" stop-color="#fdf497"/><stop offset="5%" stop-color="#fdf497"/><stop offset="45%" stop-color="#fd5949"/><stop offset="60%" stop-color="#d6249f"/><stop offset="90%" stop-color="#285AEB"/></radialGradient></defs><rect x="1.5" y="1.5" width="21" height="21" rx="5.5" fill="url(#igg)"/><circle cx="12" cy="12" r="4.6" fill="none" stroke="#fff" stroke-width="1.9"/><circle cx="17.6" cy="6.5" r="1.35" fill="#fff"/></svg></span>
        <span class="option-label text-left">Facebook/Instagram</span>
      </button>
      <button class="option-card option-card--pill" role="radio" aria-checked="false"
        onclick="pabloSelect(this, 'referralSource', 'whatsapp')">
        <span class="option-icon"><svg viewBox="0 0 24 24" width="27" height="27" aria-hidden="true"><path fill="#25D366" d="M12 0A12 12 0 0 0 1.64 18L .1 24l6.15-1.6A12 12 0 1 0 12 0z"/><path fill="#fff" d="M18.3 14.44c-.27-.14-1.6-.79-1.85-.88-.25-.09-.43-.14-.61.14-.18.27-.7.88-.86 1.06-.16.18-.32.2-.59.07a7.4 7.4 0 0 1-2.18-1.35 8.2 8.2 0 0 1-1.51-1.88c-.16-.27-.02-.42.12-.55.12-.12.27-.32.4-.48.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.53-.44-.46-.61-.47h-.52c-.18 0-.48.07-.73.34-.25.27-.95.93-.95 2.26 0 1.33.97 2.62 1.11 2.8.14.18 1.91 2.92 4.63 4.09.65.28 1.15.45 1.55.57.65.21 1.24.18 1.7.11.52-.08 1.6-.65 1.83-1.29.23-.63.23-1.17.16-1.29-.07-.11-.25-.18-.52-.32z"/></svg></span>
        <span class="option-label text-left">WhatsApp</span>
      </button>
      <button class="option-card option-card--pill" role="radio" aria-checked="false"
        onclick="pabloSelect(this, 'referralSource', 'noticias-blog')">
        <span class="option-icon"><img src="/onboarding/images/iconos/en04_libro.png" alt="" width="30" height="30" loading="lazy" /></span>
        <span class="option-label text-left">Noticias/artículos/blog</span>
      </button>
      <button class="option-card option-card--pill" role="radio" aria-checked="false"
        onclick="pabloSelect(this, 'referralSource', 'otra')">
        <span class="option-icon"><img src="/onboarding/images/iconos/ui14_destellos.png" alt="" width="30" height="30" loading="lazy" /></span>
        <span class="option-label text-left">Otra</span>
      </button>
    </div>
  </div>

  <footer class="duo-footer cta-footer">
    <button class="btn-primary btn-continue disabled" disabled onclick="pabloNext()" aria-label="Continuar">
      Continuar
    </button>
  </footer>
</section>
