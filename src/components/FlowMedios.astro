---
const { id } = Astro.props;
---
<div id={id} class="flow-medios" hidden>
  <button type="button" data-flow-yape>
    <img src="/payments/yape.svg" alt="" width="36" height="36" />
    <span>Pagar con Yape recurrente</span><span aria-hidden="true">↗</span>
  </button>
  <p class="flow-medios-error" data-flow-error role="alert" hidden></p>
</div>
<style>
  .flow-medios[hidden], .flow-medios-error[hidden] { display: none; }
  .flow-medios { margin: 16px 0; color: #2b2c64; }
  .flow-medios button { display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%; padding: 12px 16px; font: inherit; font-size: 14px; font-weight: 700; color: inherit; background: #fff; border: 2px solid #dedbec; border-radius: 16px; cursor: pointer; }
  .flow-medios img { object-fit: contain; flex-shrink: 0; }
  .flow-medios button:hover { background: #f4f1fb; border-color: #2b2c64; }
  .flow-medios button:focus-visible { outline: 3px solid #2b2c64; outline-offset: 3px; }
  .flow-medios-error { font-size: 13px; color: #b42318; }
</style>
<script is:inline>
  // Configura la alternativa sin bloquear el montaje automático de la tarjeta.
  window.pabloPrepararYapeFlow = function (id, registro, sesion) {
    var el = document.getElementById(id);
    var error = el.querySelector("[data-flow-error]");
    error.hidden = true;
    var url;
    try {
      url = new URL(registro.url);
      if (url.protocol !== "https:" || !["www.flow.cl", "sandbox.flow.cl"].includes(url.hostname) ||
          url.searchParams.get("token") !== registro.token) throw new Error("URL de registro inválida");
    } catch (e) { throw new Error("Flow no devolvió una página de registro válida."); }
    el.hidden = false;
    el.querySelector("[data-flow-yape]").onclick = function () {
      try {
        // Mismo token de checkout. La sesión nunca se envía a Flow.
        if (!sesion.access_token || !sesion.refresh_token) throw new Error("Falta la sesión para volver de Flow.");
        sessionStorage.setItem("pablo_sesion_tokens", JSON.stringify(sesion));
        if (!sessionStorage.getItem("pablo_sesion_tokens")) throw new Error("No pudimos conservar tu sesión.");
        window.location.assign(url.href);
      } catch (e) {
        error.textContent = e.message || "No pudimos abrir Yape. Inténtalo de nuevo.";
        error.hidden = false;
      }
    };
  };
</script>
