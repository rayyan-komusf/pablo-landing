---
// Meta Pixel (Facebook/Instagram Ads) — usado por Layout.astro y por
// OnboardingLayout.astro.
//
// El ID NO va hardcodeado: viene de PUBLIC_META_PIXEL_ID, que solo está
// definida en producción (build arg del Dockerfile → EasyPanel). Sin variable
// no se emite el snippet, así que local, staging y los previews no ensucian la
// medición con eventos falsos. Esto reemplaza al `if (hostname !== 'localhost')`
// que no cubría esos otros entornos.
//
// Antecedente: el 28-jul-2026 llegaron 12 `Purchase` desde http://localhost/,
// el 75% de las compras que Meta vio ese día.
const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
---

{
  pixelId && (
    <Fragment>
      <script is:inline define:vars={{ pixelId }}>
        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod
              ? n.callMethod.apply(n, arguments)
              : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = "2.0";
          n.queue = [];
          t = b.createElement(e);
          t.async = !0;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(
          window,
          document,
          "script",
          "https://connect.facebook.net/en_US/fbevents.js",
        );
        fbq("init", pixelId);
        fbq("track", "PageView", { page_location: location.origin + location.pathname, page_path: location.pathname });
      </script>
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
        />
      </noscript>

      <script is:inline>
        // Cross-domain: la app (usapablo.app) es OTRO dominio y no comparte
        // cookies con este, así que ahí el `_fbc` no existe. Como TODOS los
        // botones de compra llevan a usapablo.app/pricing, sin esto la venta
        // llega a Meta sin saber de qué anuncio vino — por más que el Purchase
        // del webhook funcione perfecto. Mismo mecanismo que ya usa ?ph_did=
        // para PostHog (ver PostHogSnippet.astro).
        (function () {
          function leerCookie(nombre) {
            try {
              var m = document.cookie.match(
                "(^|;)\\s*" + nombre + "\\s*=\\s*([^;]+)",
              );
              return m ? decodeURIComponent(m[2]) : null;
            } catch (e) {
              return null;
            }
          }

          /** Cookies de Meta de ESTE dominio, ya escritas por el pixel. */
          window.pabloFbCookies = function () {
            var valida = function (v) { return typeof v === "string" && /^fb\.\d+\.\d{13}\.[A-Za-z0-9._-]{1,450}$/.test(v); };
            var previo = {};
            try {
              var raw = JSON.parse(localStorage.getItem("pablo_fb_atribucion_v1") || "null");
              if (raw && Number.isFinite(raw.ts) && raw.ts > 0 && raw.ts <= Date.now() && Date.now() - raw.ts < 7 * 86400000) previo = raw;
            } catch (e) {}
            var fbc = leerCookie("_fbc"), fbp = leerCookie("_fbp");
            // Capture even if the third-party pixel is slow or blocked. Preserve
            // the original click timestamp when navigating before checkout.
            var fbclid = new URLSearchParams(location.search).get("fbclid");
            if (fbclid && /^[A-Za-z0-9._-]{1,450}$/.test(fbclid) &&
                (!valida(fbc) || fbc.split(".").slice(3).join(".") !== fbclid)) {
              fbc = valida(previo.fbc) && previo.fbc.split(".").slice(3).join(".") === fbclid
                ? previo.fbc : "fb.1." + Date.now() + "." + fbclid;
            }
            var result = { fbc: valida(fbc) ? fbc : (valida(previo.fbc) ? previo.fbc : null),
              fbp: valida(fbp) ? fbp : (valida(previo.fbp) ? previo.fbp : null) };
            try {
              if (result.fbc || result.fbp) localStorage.setItem("pablo_fb_atribucion_v1", JSON.stringify({ ...result, ts: previo.fbc === result.fbc && previo.ts ? previo.ts : Date.now() }));
            } catch (e) {}
            return result;
          };

          window.pabloFbCookies();

          /**
           * Agrega la huella del clic a una URL de usapablo.app. Se manda el
           * valor COMPLETO de la cookie (fb.1.<ts>.<fbclid>), no el fbclid
           * pelado: conserva el timestamp real del clic, que es lo que Meta
           * cruza. La app lo reenvía al backend en el checkout.
           *
           * Encadena con la huella de TikTok (ttclid/_ttp, ver
           * TikTokPixel.astro): todos los saltos a la app llevan ambas en la
           * misma pasada, incluidos los que llaman pabloConFbc a mano en
           * navegaciones por JS.
           */
          window.pabloConFbc = function (url) {
            try {
              var target = new URL(url, location.href);
              if (target.protocol !== "https:" || target.hostname !== "usapablo.app" || target.username || target.password || target.port) return url;
              var salida = url;
              var c = window.pabloFbCookies();
              if (c.fbc || c.fbp) {
                var u = new URL(url, location.href);
                if (c.fbc) u.searchParams.set("fbc", c.fbc);
                if (c.fbp) u.searchParams.set("fbp", c.fbp);
                salida = u.toString();
              }
              return window.pabloConTtclid ? window.pabloConTtclid(salida) : salida;
            } catch (e) {
              return url;
            }
          };

          // Enlaces normales: se decoran al hacer clic (en ese momento la
          // cookie ya está escrita, aunque el pixel haya cargado tarde).
          document.addEventListener(
            "click",
            function (e) {
              try {
                var a =
                  e.target &&
                  e.target.closest &&
                  e.target.closest('a[href^="https://usapablo.app"]');
                if (!a) return;
                a.href = window.pabloConFbc(a.href);
              } catch (err) {
                /* noop: nunca bloquear la navegación */
              }
            },
            true,
          );
        })();
      </script>
    </Fragment>
  )
}
