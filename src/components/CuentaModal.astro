---
// Modal reutilizable de "crear cuenta y pagar" (Pricing del home y oferta).
// TODO ocurre acá, sin salir de la página (pedido de Rodrigo 29-jul):
//   1. cuenta contra Supabase Auth (anon key)
//   2. código de 6 dígitos (edge function verificar-correo — con la
//      confirmación de Supabase activada el signup no da tokens y el código
//      es lo que desbloquea el login)
//   3. PAGO embebido con el widget de Flow (elements), mismo patrón que
//      StepCuentaPago del onboarding: flow-suscripcion "checkout" da el token
//      del registro de tarjeta y "confirmar" crea la suscripción.
//   4. pagado → /gracias?plan=X (su botón entra a la app ya logueado).
// El puente a la app (usapablo.app/auth/sesion#tokens) quedó SOLO como
// respaldo: si el widget no puede montarse o la persona elige "pagar dentro
// de la app". Los días de prueba salen de TRIAL, con la misma ventana de la
// promo que usan Step18, StepCuentaPago y el backend.
// Abrir con: window.abrirCuentaPablo('semanal'|'mensual'|'anual').
---

<div
  id="cuenta-modal"
  class="cuenta-overlay"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Crea tu cuenta"
>
  <div class="cuenta-card">
    <button class="cuenta-close" id="cuenta-close" aria-label="Cerrar">✕</button>
    <img class="cuenta-mascota" src="/onboarding/images/pablo/pablo-wave.png" alt="" width="80" height="80" loading="lazy" />
    <h3 class="cuenta-titulo" id="cuenta-titulo">Crea tu cuenta</h3>
    <p class="cuenta-sub" id="cuenta-sub">Creas tu cuenta y continúas al pago de forma 100% segura.</p>
    <form id="cuenta-form" novalidate>
      <input id="cuenta-nombre" class="cuenta-input" type="text" placeholder="Tu nombre" autocomplete="name" maxlength="80" required />
      <input id="cuenta-correo" class="cuenta-input" type="email" placeholder="Tu correo" autocomplete="email" maxlength="120" required />
      <input id="cuenta-password" class="cuenta-input" type="password" placeholder="Crea una contraseña (mín. 6)" autocomplete="new-password" maxlength="72" required />
      <p class="cuenta-error" id="cuenta-error" hidden></p>
      <button class="cuenta-btn" id="cuenta-enviar" type="submit">Crear cuenta y continuar</button>
    </form>
    <!-- Fase 2: código de verificación del correo (antes del pago). -->
    <form id="cuenta-codigo-form" hidden novalidate>
      <p class="cuenta-codigo-hint" id="cuenta-codigo-hint">Te enviamos un código a tu correo.</p>
      <input
        id="cuenta-codigo"
        class="cuenta-input cuenta-input-codigo"
        type="text"
        inputmode="numeric"
        autocomplete="one-time-code"
        placeholder="······"
        maxlength="6"
      />
      <p class="cuenta-error" id="cuenta-codigo-error" hidden></p>
      <button class="cuenta-btn" id="cuenta-verificar" type="submit">Verificar y continuar</button>
      <button type="button" class="cuenta-reenviar" id="cuenta-reenviar">¿No te llegó? Reenviar código</button>
    </form>
    <!-- Fase 3: pago EN ESTA MISMA PÁGINA (pedido de Rodrigo 29-jul). Mismo
         patrón del widget embebido de Flow que StepCuentaPago del onboarding:
         flow-suscripcion "checkout" da el token del registro de tarjeta, el
         widget se monta acá y "confirmar" crea la suscripción. Ya no se
         bridgea a la app para cobrar; el fallback sí sigue existiendo. -->
    <div id="cuenta-pago" hidden>
      <p class="cuenta-pago-resumen" id="cuenta-pago-resumen">Preparando tu plan…</p>
      <div class="cuenta-pago-exito" id="cuenta-pago-exito" hidden>
        <svg viewBox="0 0 56 56" class="cuenta-exito-check" role="img" aria-label="Pago exitoso">
          <circle cx="28" cy="28" r="26" class="cuenta-exito-circulo" transform="rotate(-90 28 28)"></circle>
          <path d="M16.5 29.5l8 8 15-16" class="cuenta-exito-palomita"></path>
        </svg>
        <p class="cuenta-exito-texto">¡Pago exitoso!</p>
      </div>
      <p class="cuenta-pago-estado" id="cuenta-pago-estado">Preparando el pago seguro…</p>
      <div id="cuenta-pago-widget"></div>
      <button type="button" class="cuenta-btn" id="cuenta-pago-reintentar" hidden>Reintentar</button>
      <button type="button" class="cuenta-reenviar" id="cuenta-pago-enapp">Prefiero pagar dentro de la app</button>
    </div>
    <p class="cuenta-legal">
      Al crear tu cuenta aceptas los
      <a href="/terminos" target="_blank" rel="noopener">Términos</a> y la
      <a href="/privacidad" target="_blank" rel="noopener">Privacidad</a>.
      Pago 100% seguro; Pablo nunca ve tu tarjeta.
    </p>
    <p class="cuenta-legal">
      ¿Ya tienes cuenta?
      <a id="cuenta-login" href="https://usapablo.app/pricing?plan=anual">Inicia sesión</a>.
    </p>
  </div>
</div>

<script is:inline>
  (function () {
    var SUPA = "https://mezpfnagkubumzbromsh.supabase.co";
    var ANON = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1lenBmbmFna3VidW16YnJvbXNoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjM0NDM3NDMsImV4cCI6MjA3OTAxOTc0M30.HsTSJqkzslq4HWxLlIvuFwudrFzkemHELgsi54vIJDw";
    var APP = "https://usapablo.app";
    var COOLDOWN_S = 60;
    var FLOW_SCRIPTS = {
      sandbox: "https://sandbox.flow.cl/app/elements/flow-1.1.0.min.js?20241202",
      production: "https://www.flow.cl/app/elements/flow-1.1.0.min.js?20241202",
    };
    // Días de prueba por plan. La ventana de la Oferta Millonaria es la MISMA
    // que usan Step18, StepCuentaPago y el backend: mensual 14 días, anual
    // cobro directo. Fuera de la ventana no cambia nada.
    var TRIAL = { semanal: 0, mensual: 3, anual: 7 };
    (function () {
      var ahora = Date.now();
      if (
        ahora >= Date.parse("2026-07-23T20:40:00-05:00") &&
        ahora < Date.parse("2026-07-30T00:00:00-05:00")
      ) {
        TRIAL.mensual = 14;
        TRIAL.anual = 0;
      }
    })();

    var overlay = document.getElementById("cuenta-modal");
    if (!overlay) return;
    var form = document.getElementById("cuenta-form");
    var formCodigo = document.getElementById("cuenta-codigo-form");
    var btn = document.getElementById("cuenta-enviar");
    var btnVerificar = document.getElementById("cuenta-verificar");
    var reenviarEl = document.getElementById("cuenta-reenviar");
    var errorEl = document.getElementById("cuenta-error");
    var errorCodigoEl = document.getElementById("cuenta-codigo-error");
    var tituloEl = document.getElementById("cuenta-titulo");
    var subEl = document.getElementById("cuenta-sub");
    var loginEl = document.getElementById("cuenta-login");
    var pagoEl = document.getElementById("cuenta-pago");
    var pagoResumenEl = document.getElementById("cuenta-pago-resumen");
    var pagoEstadoEl = document.getElementById("cuenta-pago-estado");
    var pagoExitoEl = document.getElementById("cuenta-pago-exito");
    var pagoReintentarEl = document.getElementById("cuenta-pago-reintentar");
    var pagoEnAppEl = document.getElementById("cuenta-pago-enapp");

    var PLANES = {
      semanal: {
        nombre: "Plan Semanal", slug: "semanal",
        resumen: "Plan Semanal — S/.7 a la semana",
        titulo: "Crea tu cuenta y empieza",
        sub: "Creas tu cuenta y continúas al pago del Plan Semanal (S/.7/semana) de forma 100% segura.",
        label: "Crear cuenta y continuar",
      },
      mensual: {
        nombre: "Plan Mensual", slug: "mensual",
        resumen: "Plan Mensual — S/.20 al mes",
        titulo: "Crea tu cuenta y empieza gratis",
        sub: "Creas tu cuenta y empiezas tu prueba gratis del Plan Mensual (S/.20/mes). No pagas nada hoy.",
        label: "Crear cuenta y empezar prueba gratis",
      },
      anual: {
        nombre: "Plan Anual", slug: "anual",
        resumen: "Plan Anual — S/.200 al año",
        titulo: "Crea tu cuenta y activa tu plan",
        sub: "Creas tu cuenta y continúas al pago del Plan Anual (S/.200/año) de forma 100% segura.",
        label: "Crear cuenta y continuar al pago",
      },
    };
    var planActual = "anual";
    // Credenciales SOLO en memoria: con la confirmación de correo de Supabase
    // activada, el login recién funciona después de verificar el código.
    var pendiente = null;
    var tokens = null;
    var cooldownHasta = 0;
    var cooldownTimer = null;
    var flowScriptPromise = null;
    var pagoEnCurso = false;

    function abrir(plan) {
      planActual = PLANES[plan] ? plan : "anual";
      var cfg = PLANES[planActual];
      if (tituloEl) tituloEl.textContent = cfg.titulo;
      if (subEl) subEl.textContent = cfg.sub;
      if (btn) btn.textContent = cfg.label;
      if (loginEl) loginEl.href = APP + "/pricing?plan=" + cfg.slug;
      form.hidden = false;
      formCodigo.hidden = true;
      // Si cerraron el modal a media compra y vuelven a abrirlo, la fase de
      // pago arranca limpia (widget desmontado, sin estado viejo).
      if (pagoEl) pagoEl.hidden = true;
      if (pagoExitoEl) pagoExitoEl.hidden = true;
      var widgetViejo = document.getElementById("cuenta-pago-widget");
      if (widgetViejo) widgetViejo.innerHTML = "";
      pagoEnCurso = false;
      overlay.classList.add("is-open");
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      setTimeout(function () { var n = document.getElementById("cuenta-nombre"); if (n) n.focus(); }, 60);
      try { window.posthog && window.posthog.capture("cuenta_modal_abierta", { plan: planActual }); } catch (e) {}
    }
    function cerrar() {
      overlay.classList.remove("is-open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    }
    window.abrirCuentaPablo = abrir;
    // Compatibilidad con la oferta millonaria (nombre anterior).
    window.abrirCuentaMillonaria = abrir;

    document.getElementById("cuenta-close").addEventListener("click", cerrar);
    overlay.addEventListener("click", function (e) { if (e.target === overlay) cerrar(); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape") cerrar(); });

    function phDid(url) {
      try {
        var did = window.posthog && window.posthog.get_distinct_id && window.posthog.get_distinct_id();
        if (!did) return url;
        var u = new URL(url); u.searchParams.set("ph_did", did); return u.toString();
      } catch (e) { return url; }
    }
    function mostrarError(el, msg) { if (el) { el.textContent = msg; el.hidden = false; } }
    async function authFetch(path, body) {
      var res = await fetch(SUPA + path, {
        method: "POST",
        headers: { "Content-Type": "application/json", apikey: ANON },
        body: JSON.stringify(body),
      });
      var data = {}; try { data = await res.json(); } catch (e) {}
      return { ok: res.ok, data: data };
    }
    async function verificarCorreo(body) {
      try {
        var res = await fetch(SUPA + "/functions/v1/verificar-correo", {
          method: "POST",
          headers: { "Content-Type": "application/json", apikey: ANON },
          body: JSON.stringify(body),
        });
        var data = {}; try { data = await res.json(); } catch (e) {}
        return data || {};
      } catch (e) {
        return { error: "No pudimos conectar con el servidor" };
      }
    }

    function guardarTokens(t) {
      tokens = t;
      try { sessionStorage.setItem("pablo_sesion_tokens", JSON.stringify(t)); } catch (e) {}
    }
    /* Sesión para el pago: la que dio el signup, o login con las credenciales
     * en memoria (posible recién tras verificar el código). */
    async function asegurarSesion() {
      if (tokens && tokens.access_token) return tokens;
      if (!pendiente) return null;
      var r = await authFetch("/auth/v1/token?grant_type=password", {
        email: pendiente.email,
        password: pendiente.pass,
      });
      if (!r.ok || !r.data.access_token) return null;
      guardarTokens({ access_token: r.data.access_token, refresh_token: r.data.refresh_token || "" });
      return tokens;
    }
    /* RESPALDO: pagar dentro de la app (la pasarela cobra allá). Se usa solo
     * si el widget embebido no puede montarse o si la persona lo elige. */
    async function irAlPago() {
      var cfg = PLANES[planActual];
      var s = await asegurarSesion();
      if (s) {
        window.location.href =
          phDid(APP + "/auth/sesion?plan=" + cfg.slug) +
          "#access_token=" + encodeURIComponent(s.access_token) +
          "&refresh_token=" + encodeURIComponent(s.refresh_token || "");
      } else {
        window.location.href = phDid(APP + "/pricing?plan=" + cfg.slug);
      }
    }

    /* ─── Pago embebido con el widget de Flow, en esta misma página ─── */
    function pagoEstado(msg, esError) {
      if (!pagoEstadoEl) return;
      pagoEstadoEl.textContent = msg || "";
      pagoEstadoEl.hidden = !msg;
      pagoEstadoEl.classList.toggle("cuenta-pago-estado--error", Boolean(esError));
    }
    function pagoReintentar(visible) {
      if (pagoReintentarEl) pagoReintentarEl.hidden = !visible;
    }
    function pintarResumen() {
      if (!pagoResumenEl) return;
      var cfg = PLANES[planActual];
      var dias = TRIAL[planActual] || 0;
      pagoResumenEl.textContent =
        cfg.resumen + (dias > 0
          ? " · " + dias + " días gratis, cancela cuando quieras"
          : " · se cobra hoy, cancela cuando quieras");
    }
    function cargarFlowScript(entorno) {
      if (window.Flow) return Promise.resolve();
      if (!flowScriptPromise) {
        flowScriptPromise = new Promise(function (resolve, reject) {
          var s = document.createElement("script");
          s.src = FLOW_SCRIPTS[entorno] || FLOW_SCRIPTS.sandbox;
          s.async = true;
          s.onload = resolve;
          s.onerror = function () {
            flowScriptPromise = null;
            reject(new Error("No se pudo cargar el pago seguro"));
          };
          document.head.appendChild(s);
        });
      }
      return flowScriptPromise;
    }
    async function flowSuscripcion(body, accessToken) {
      var res = await fetch(SUPA + "/functions/v1/flow-suscripcion", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          apikey: ANON,
          Authorization: "Bearer " + accessToken,
        },
        body: JSON.stringify(body),
      });
      var data = {};
      try { data = await res.json(); } catch (e) {}
      data.__status = res.status;
      return data;
    }
    /* Ya pagó: a /gracias (el botón de allá entra a la app logueado con los
     * tokens que dejamos en sessionStorage). */
    function alGracias() {
      window.location.href = "/gracias?plan=" + encodeURIComponent(PLANES[planActual].slug);
    }
    /* Ya tenía suscripción activa: no hay nada que cobrar, directo a la app
     * (y al dashboard, sin onboarding — ya es cliente). */
    async function irALaAppLogueado() {
      var s = await asegurarSesion();
      if (s) {
        window.location.href =
          phDid(APP + "/auth/sesion?destino=dashboard") +
          "#access_token=" + encodeURIComponent(s.access_token) +
          "&refresh_token=" + encodeURIComponent(s.refresh_token || "");
      } else {
        window.location.href = phDid(APP + "/dashboard");
      }
    }

    function mostrarFasePago() {
      var cfg = PLANES[planActual];
      if (tituloEl) tituloEl.textContent = "Activa tu " + cfg.nombre;
      if (subEl) subEl.textContent = "Último paso: tus datos de pago. Nunca salimos de esta página.";
      form.hidden = true;
      formCodigo.hidden = true;
      if (pagoEl) pagoEl.hidden = false;
      arrancarPago();
    }

    async function arrancarPago() {
      if (pagoEnCurso) return;
      pagoEnCurso = true;
      pagoReintentar(false);
      if (pagoExitoEl) pagoExitoEl.hidden = true;
      pintarResumen();
      pagoEstado("Preparando el pago seguro…");

      try {
        var sesion = await asegurarSesion();
        if (!sesion) { await irAlPago(); return; }

        var registro = await flowSuscripcion(
          { accion: "checkout", plan: PLANES[planActual].nombre },
          sesion.access_token
        );
        if (registro.__status === 409) { await irALaAppLogueado(); return; }
        if (!registro.token || !registro.entorno) {
          throw new Error(registro.error || "No pudimos iniciar el pago");
        }

        await cargarFlowScript(registro.entorno);
        if (typeof window.Flow !== "function") throw new Error("El pago seguro no está disponible");

        var contenedor = document.getElementById("cuenta-pago-widget");
        if (contenedor) contenedor.innerHTML = "";
        pagoEstado("");

        var flow = window.Flow();
        var subscribe = flow.elements().create("subscribe", {
          style: { backgroundColor: "transparent" },
        });
        subscribe.mount("#cuenta-pago-widget", registro.token);
        // El widget devuelve un "thenable" propio, no una Promise real (su
        // .then no encadena .catch): Promise.resolve lo asimila.
        Promise.resolve(flow.handleCardSubscribed(subscribe))
          .then(async function () {
            pagoEstado("Confirmando tu suscripción…");
            var res = await flowSuscripcion({ accion: "confirmar", token: registro.token }, sesion.access_token);
            if (res && res.ok) {
              try { window.posthog && window.posthog.capture("cuenta_modal_pago_exitoso", { plan: planActual }); } catch (e) {}
              if (window.fbq) fbq("trackCustom", "PagoFlowExitoso", { plan: planActual });
              if (contenedor) contenedor.innerHTML = "";
              pagoEstado("");
              if (pagoEnAppEl) pagoEnAppEl.hidden = true;
              if (pagoExitoEl) pagoExitoEl.hidden = false;
              setTimeout(alGracias, 1500);
            } else {
              pagoEstado((res && res.error) || "El pago no se completó, intenta de nuevo.", true);
              pagoReintentar(true);
              pagoEnCurso = false;
            }
          })
          .catch(function (e) {
            console.error("[Pablo] Widget de Flow:", e);
            pagoEstado("El pago no se completó, intenta de nuevo.", true);
            pagoReintentar(true);
            pagoEnCurso = false;
          });
      } catch (e) {
        console.error("[Pablo] Pago embebido falló:", e);
        pagoEstado(e && e.message ? e.message : "No pudimos iniciar el pago", true);
        pagoReintentar(true);
        pagoEnCurso = false;
      }
    }

    if (pagoReintentarEl) {
      pagoReintentarEl.addEventListener("click", function () {
        try { window.posthog && window.posthog.capture("cuenta_modal_pago_reintento", { plan: planActual }); } catch (e) {}
        arrancarPago();
      });
    }
    if (pagoEnAppEl) {
      pagoEnAppEl.addEventListener("click", function () { irAlPago(); });
    }

    function pintarCooldown() {
      if (!reenviarEl) return;
      var falta = Math.ceil((cooldownHasta - Date.now()) / 1000);
      if (falta > 0) {
        reenviarEl.setAttribute("disabled", "");
        reenviarEl.textContent = "Reenviar código en " + falta + "s";
      } else {
        reenviarEl.removeAttribute("disabled");
        reenviarEl.textContent = "¿No te llegó? Reenviar código";
        if (cooldownTimer) { clearInterval(cooldownTimer); cooldownTimer = null; }
      }
    }
    function arrancarCooldown() {
      cooldownHasta = Date.now() + COOLDOWN_S * 1000;
      if (!cooldownTimer) cooldownTimer = setInterval(pintarCooldown, 1000);
      pintarCooldown();
    }
    function mostrarFaseCodigo() {
      if (tituloEl) tituloEl.textContent = "Revisa tu correo 📬";
      if (subEl && pendiente) subEl.textContent = "Escribe el código de 6 dígitos que enviamos a " + pendiente.email + " (mira también el spam).";
      form.hidden = true;
      formCodigo.hidden = false;
      if (errorCodigoEl) errorCodigoEl.hidden = true;
      setTimeout(function () { var c = document.getElementById("cuenta-codigo"); if (c) c.focus(); }, 60);
    }

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      if (errorEl) errorEl.hidden = true;
      var cfg = PLANES[planActual];
      var nombre = (document.getElementById("cuenta-nombre").value || "").trim();
      var correo = (document.getElementById("cuenta-correo").value || "").trim();
      var pass = document.getElementById("cuenta-password").value || "";
      if (!nombre) return mostrarError(errorEl, "Escribe tu nombre.");
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(correo)) return mostrarError(errorEl, "Ese correo no se ve bien, ¿lo revisas?");
      if (pass.length < 6) return mostrarError(errorEl, "La contraseña necesita al menos 6 caracteres.");

      btn.disabled = true; btn.textContent = "Creando tu cuenta…";
      try {
        var r = await authFetch("/auth/v1/signup", { email: correo, password: pass, data: { nombre: nombre, apellido: "" } });
        var yaExiste = !r.ok && (r.data.error_code === "user_already_exists" ||
          /already|registrad/i.test(r.data.msg || r.data.message || r.data.error_description || ""));
        if (yaExiste) {
          r = await authFetch("/auth/v1/token?grant_type=password", { email: correo, password: pass });
          var noConfirmado = !r.ok && (r.data.error_code === "email_not_confirmed" ||
            /not confirmed/i.test(r.data.msg || r.data.message || r.data.error_description || ""));
          if (!r.ok && !noConfirmado) {
            mostrarError(errorEl, "Ese correo ya tiene una cuenta y la contraseña no coincide. Usa “Inicia sesión”.");
            btn.disabled = false; btn.textContent = cfg.label; return;
          }
          // Cuenta sin confirmar de un intento anterior: sigue al código.
        } else if (!r.ok) {
          mostrarError(errorEl, r.data.msg || r.data.message || r.data.error_description || "No pudimos crear tu cuenta, intenta de nuevo.");
          btn.disabled = false; btn.textContent = cfg.label; return;
        }
        try { window.posthog && window.posthog.capture("cuenta_creada", { ya_existia: !!yaExiste, plan: planActual }); } catch (e2) {}
        if (window.fbq) fbq("trackCustom", "CuentaCreada", { plan: planActual });

        pendiente = { email: correo, pass: pass };
        if (r.data && r.data.access_token) {
          guardarTokens({ access_token: r.data.access_token, refresh_token: r.data.refresh_token || "" });
        }

        // Verificación del correo por código ANTES del pago.
        btn.textContent = "Enviándote un código a tu correo…";
        var envio = await verificarCorreo({ accion: "enviar", email: correo });
        if (envio && envio.ya_verificado) {
          btn.textContent = "¡Listo! Un momento…";
          mostrarFasePago();
          return;
        }
        try { window.posthog && window.posthog.capture("cuenta_modal_codigo_enviado", { plan: planActual, ok: !!(envio && envio.ok) }); } catch (e3) {}
        btn.disabled = false; btn.textContent = cfg.label;
        if (envio && envio.error) mostrarError(errorCodigoEl, envio.error);
        arrancarCooldown();
        mostrarFaseCodigo();
      } catch (err) {
        mostrarError(errorEl, "No pudimos conectar con el servidor. Revisa tu internet e intenta de nuevo.");
        btn.disabled = false; btn.textContent = cfg.label;
      }
    });

    formCodigo.addEventListener("submit", async function (e) {
      e.preventDefault();
      if (errorCodigoEl) errorCodigoEl.hidden = true;
      var input = document.getElementById("cuenta-codigo");
      var codigo = ((input && input.value) || "").replace(/\D/g, "");
      if (!/^\d{6}$/.test(codigo)) return mostrarError(errorCodigoEl, "El código son los 6 dígitos del correo.");

      btnVerificar.disabled = true; btnVerificar.textContent = "Verificando…";
      var res = await verificarCorreo({ accion: "verificar", email: pendiente ? pendiente.email : "", codigo: codigo });
      if (res && (res.ok || res.ya_verificado)) {
        try { window.posthog && window.posthog.capture("cuenta_modal_correo_verificado", { plan: planActual }); } catch (e4) {}
        if (window.fbq) fbq("trackCustom", "CorreoVerificado", { plan: planActual });
        btnVerificar.textContent = "¡Verificado! Un momento…";
        mostrarFasePago();
        return;
      }
      mostrarError(errorCodigoEl, (res && res.error) || "No pudimos verificar el código, intenta de nuevo.");
      btnVerificar.disabled = false; btnVerificar.textContent = "Verificar y continuar";
    });

    document.getElementById("cuenta-codigo").addEventListener("input", function () {
      this.value = this.value.replace(/\D/g, "").slice(0, 6);
      if (errorCodigoEl) errorCodigoEl.hidden = true;
    });

    reenviarEl.addEventListener("click", async function () {
      if (Date.now() < cooldownHasta) return;
      if (errorCodigoEl) errorCodigoEl.hidden = true;
      arrancarCooldown();
      var res = await verificarCorreo({ accion: "enviar", email: pendiente ? pendiente.email : "" });
      if (res && res.ya_verificado) { mostrarFasePago(); return; }
      if (res && res.error) mostrarError(errorCodigoEl, res.error);
      try { window.posthog && window.posthog.capture("cuenta_modal_codigo_reenviado", { plan: planActual, ok: !!(res && res.ok) }); } catch (e5) {}
    });
  })();
</script>

