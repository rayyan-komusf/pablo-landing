    z-index: 0;
  }

  .om-hero__blob--1 {
    width: 420px;
    height: 420px;
    background: rgba(246, 183, 43, 0.14);
    top: -100px;
    right: -80px;
  }

  .om-hero__blob--2 {
    width: 340px;
    height: 340px;
    background: rgba(86, 87, 143, 0.1);
    bottom: -60px;
    left: -60px;
  }

  .om-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    max-width: 720px;
    margin: 0 auto;
  }

  .om-hero__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 40px;
    line-height: 1.12;
    color: var(--color-heading);
  }

  .om-gratis {
    color: var(--color-green);
  }

  .om-hero__sub {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 540px;
  }

  .om-hero__trust {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--color-secondary);
    font-weight: 500;
  }

  /* ════════════════ EL PROBLEMA ════════════════
     Fondo blanco para cortar con el lila del hero. Las citas NO se ven como
     tarjetas de testimonio: van con una raya dorada al costado y en cursiva,
     para que se lean como voces y no como resultados. El dolor va sobrio: la
     idea es que la persona piense "a mí también", no asustarla. */
  .om-dolor {
    background: #ffffff;
    padding: var(--section-py) 0;
  }

  .om-dolor__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .om-dolor__eyebrow {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .om-dolor__title {
    max-width: 20ch;
  }

  .om-dolor__sub {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-body);
  }

  .om-dolor__grid {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 26px;
    width: 100%;
    max-width: 880px;
    text-align: left;
  }

  .om-dolor__card {
    border-left: 3px solid #f0d9a8;
    padding: 2px 0 2px 18px;
  }

  .om-dolor__cita {
    font-size: 16px;
    line-height: 1.55;
    font-style: italic;
    color: var(--color-heading);
  }

  .om-dolor__autor {
    margin-top: 7px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-heading);
  }

  .om-dolor__autor span {
    font-weight: 500;
    color: var(--color-secondary);
  }

  .om-dolor__cierre {
    margin-top: 22px;
    max-width: 620px;
  }

  .om-dolor__cierre-cita {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(19px, 2.4vw, 25px);
    line-height: 1.35;
    color: var(--color-heading);
  }

  .om-dolor__cierre .om-dolor__autor {
    margin-top: 10px;
  }

  @media (max-width: 768px) {
    .om-dolor__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .om-dolor__title {
      max-width: none;
    }

    .om-dolor__sub {
      font-size: 15.5px;
    }

    .om-dolor__cita {
      font-size: 15px;
    }
  }

  /* ════════════════ QUÉ ES PABLO ════════════════
     El puente para quien llega del correo sin saber qué es Pablo. El teléfono
     es el mock de HeroPhone (HTML/CSS), así que se ve nítido en cualquier
     pantalla y muestra el producto funcionando en vez de una ilustración. */
  .om-quees {
    background: var(--bg-how);
    /* Menos aire abajo: la sección que sigue (om-incluye) trae su propio
       padding arriba y entre las dos quedaba un hueco vacío de ~200px. */
    padding: var(--section-py) 0 34px;
  }

  .om-quees__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 52px;
  }

  .om-quees__texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .om-quees__title {
    text-align: left;
    max-width: 22ch;
  }

  .om-nowrap {
    white-space: nowrap;
  }

  .om-quees__sub {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--color-body);
    max-width: 46ch;
  }

  .om-quees__bullets {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .om-quees__bullets li {
    position: relative;
    padding-left: 26px;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--color-heading);
  }

  /* Check dibujado en CSS: el mismo lenguaje de los bullets de los bonos */
  .om-quees__bullets li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 6px;
    width: 6px;
    height: 11px;
    border-right: 2.5px solid var(--color-green);
    border-bottom: 2.5px solid var(--color-green);
    transform: rotate(45deg);
  }

  .om-quees__quote {
    margin: 10px 0 0;
    border-left: 3px solid #f0d9a8;
    padding-left: 18px;
  }

  .om-quees__quote p {
    font-size: 15.5px;
    line-height: 1.55;
    font-style: italic;
    color: var(--color-heading);
  }

  .om-quees__quote cite {
    display: block;
    margin-top: 7px;
    font-size: 13px;
    font-weight: 700;
    font-style: normal;
    color: var(--color-heading);
  }

  .om-quees__quote cite span {
    font-weight: 500;
    color: var(--color-secondary);
  }

  .om-quees__phone {
    display: flex;
    justify-content: center;
  }

  /* Misma fórmula de escalado que usa el hero del home: el interior del
     teléfono se dimensiona con em sobre este font-size. */
  .om-quees__phone :global(.hphone) {
    --w: clamp(240px, 26vw, 320px);
    font-size: calc(var(--w) * 0.0412);
  }

  @media (max-width: 900px) {
    .om-quees__inner {
      grid-template-columns: 1fr;
      gap: 26px;
      justify-items: center;
    }

    /* El teléfono va DESPUÉS del texto en móvil a propósito: HeroPhone llena
       el chat por JS con retardos (el primer mensaje a los 900 ms y la
       conversación completa recién a los ~20 s). Si fuera lo primero que se
       ve, el primer golpe de vista sería un WhatsApp vacío. Leyendo el titular
       y los bullets pasa el tiempo suficiente para que ya haya conversación. */
    .om-quees__texto {
      order: 1;
      align-items: center;
      text-align: center;
    }

    .om-quees__phone {
      order: 2;
    }

    .om-quees__title {
      text-align: center;
      max-width: none;
    }

    .om-quees__bullets li,
    .om-quees__quote {
      text-align: left;
    }

    .om-quees__phone :global(.hphone) {
      --w: clamp(230px, 62vw, 300px);
    }
  }

  /* ════════════════ 2. EL PACTO ════════════════ */
  .om-reto {
    background: #ffffff;
    padding: var(--section-py) 0;
  }

  .om-reto__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .om-reto__pasos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    width: 100%;
    max-width: 760px;
    counter-reset: paso;
  }

  .om-paso {
    display: flex;
    gap: 16px;
    align-items: center;
    background: var(--bg-hero);
    border-radius: var(--radius-md);
    padding: 22px;
  }

  .om-paso__num {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--gradient-cta);
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 10px rgba(245, 166, 35, 0.35);
  }

  .om-paso__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.35;
    color: var(--color-heading);
  }

  .om-reto__cierre {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 560px;
  }

  .om-reto__cierre p {
    font-size: 16px;
    color: var(--color-body);
  }

  .om-reto__frase {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px !important;
    color: var(--color-heading) !important;
  }

  .om-reto__ventana {
    font-size: 14px !important;
    line-height: 1.6;
    color: #875a00 !important;
    background: #fef3da;
    border: 1px solid #f5c970;
    border-radius: var(--radius-md);
    padding: 12px 20px;
  }

  /* Mini-testimonios en pills pegados al pacto */
  .om-pacto__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    width: 100%;
    max-width: 760px;
  }

  .om-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    background: white;
    border: 1.5px solid #e5e3f0;
    border-radius: 18px;
    padding: 14px 24px;
    box-shadow: var(--card-shadow);
    text-align: center;
    max-width: 340px;
  }

  .om-pill__quote {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-heading);
  }

  .om-pill__autor {
    font-size: 12px;
    color: var(--color-secondary);
  }

  /* ════════════════ 3. VALUE STACK ════════════════ */
  .om-stack {
    background: var(--bg-how);
    padding: var(--section-py) 0;
  }

  .om-stack__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .om-stack__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    max-width: 760px;
  }

  .om-item {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    background: white;
    border: 1.5px solid #e5e3f0;
    border-radius: var(--radius-lg);
    padding: 28px;
    box-shadow: var(--card-shadow);
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .om-item:hover {
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-3px);
  }

  .om-item__media {
    flex-shrink: 0;
    width: 110px;
    height: 110px;
    background: #ffffff;
    border: 1.5px solid #e5e3f0;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .om-item__media img {
    width: 90px;
    height: 90px;
    object-fit: contain;
  }

  .om-item__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .om-item__tag {
    align-self: flex-start;
    background: #eeedf5;
    color: var(--color-heading);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .om-item__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    color: var(--color-heading);
  }

  .om-item__valor {
    align-self: flex-start;
    background: #fef3da;
    color: #875a00;
    border: 1px solid #f5c970;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .om-item__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-body);
  }

  .om-item__bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }

  .om-item__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-body);
  }

  .om-check {
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ════════════════ PRUEBA SOCIAL (banda navy) ════════════════ */
  .om-social {
    background: #2B2C64;
    padding: 40px 0;
  }

  .om-social__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }

  .om-social__lead {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(18px, 3.5vw, 24px);
    color: #fff;
  }

  .om-social__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .om-social__chip {
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-pill);
    padding: 8px 16px;
    font-size: 13px;
    color: #fff;
    line-height: 1.4;
  }

  .om-social__stars {
    color: var(--color-amber);
    margin-right: 6px;
    letter-spacing: 1px;
  }

  /* ════════════════ MÓDULOS-PILAR: alternan lado e claro/navy ════════════════ */
  .om-item--dark {
    background: #2B2C64;
    border-color: #2B2C64;
    flex-direction: row-reverse;
  }

  .om-item--dark .om-item__title { color: #fff; }

  .om-item--dark .om-item__desc,
  .om-item--dark .om-item__bullets li {
    color: rgba(255, 255, 255, 0.82);
  }

  .om-item--dark .om-item__tag {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .om-item--dark .om-item__media {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .om-item--dark .om-check { stroke: #7BE495; }

  /* Bloque de prueba dentro de un módulo ("Proof This Works") */
  .om-item__proof {
    margin-top: 8px;
    padding: 14px 16px;
    border-left: 3px solid var(--color-amber);
    background: #faf7ff;
    border-radius: 0 12px 12px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .om-item__proof-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-green);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .om-item__proof-quote {
    font-size: 14px;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-heading);
  }

  .om-item__proof-autor {
    font-size: 12px;
    color: var(--color-secondary);
  }

  .om-item--dark .om-item__proof {
    background: rgba(255, 255, 255, 0.07);
  }

  .om-item--dark .om-item__proof-quote { color: #fff; }
  .om-item--dark .om-item__proof-autor { color: rgba(255, 255, 255, 0.6); }

  /* Módulos un poco más anchos para que respiren */
  .om-stack__list { max-width: 860px; }

  @media (max-width: 700px) {
    .om-item,
    .om-item--dark { flex-direction: column; }
  }

  /* Recap */
  .om-recap {
    width: 100%;
    max-width: 640px;
    background: white;
    border: 2px solid var(--color-amber);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: 0 8px 40px rgba(245, 166, 35, 0.2);
  }

  .om-recap__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 24px;
    color: var(--color-heading);
    text-align: center;
  }

  .om-recap__list {
    display: flex;
    flex-direction: column;
  }

  .om-recap__list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px dashed rgba(43, 44, 100, 0.15);
    font-size: 14px;
    color: var(--color-heading);
    font-weight: 500;
  }

  .om-recap__val {
    color: var(--color-secondary);
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
    font-size: 13px;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .om-recap__val s {
    color: var(--color-secondary);
    opacity: 0.7;
  }

  .om-recap__val strong {
    color: var(--color-green);
    font-weight: 700;
  }

  .om-recap__nombre {
    font-weight: 600;
  }

  /* Etiqueta de precio, como un cartel de tienda: el precio de antes chiquito
   * y tachado, el de hoy grande, y debajo la nota. Reemplazó al comparativo de
   * tres columnas (527 → 200 → 0), que se leía como una hoja de cálculo. */
  .om-precio {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
  }

  .om-precio__antes {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    line-height: 1;
    color: var(--color-secondary);
    text-decoration-thickness: 2px;
  }

  .om-precio__ahora {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(46px, 11vw, 64px);
    line-height: 1;
    color: var(--color-heading);
    letter-spacing: -0.02em;
  }

  .om-precio__nota {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-amber);
    text-transform: uppercase;
  }

  /* Comparación: S/.240 → hoy S/.200 → S/.0 */
  .om-recap__compare {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    text-align: center;
    padding: 6px 0;
  }

  .om-comp {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .om-comp__precio {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
    color: var(--color-secondary);
  }

  .om-comp--hoy .om-comp__precio {
    font-size: 34px;
    color: var(--color-heading);
  }

  .om-comp--gratis .om-comp__precio {
    font-size: 34px;
    color: var(--color-green);
  }

  .om-comp__label {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-secondary);
  }

  .om-comp__flecha {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    color: var(--color-amber);
  }

  /* ════════════════ 4. CARTA ════════════════ */
  .om-carta-sec {
    background: #ffffff;
    padding: var(--section-py) 0;
  }

  .om-carta {
    position: relative;
    max-width: 640px;
    margin: 0 auto;
    background: var(--om-cream, #fffaf0);
    border: 1px solid rgba(43, 44, 100, 0.1);
    border-radius: 6px;
    padding: 48px 40px 40px;
    box-shadow: 0 2px 6px rgba(43, 44, 100, 0.06), 0 16px 40px rgba(43, 44, 100, 0.1);
    transform: rotate(-0.4deg);
    background-image: repeating-linear-gradient(
      transparent,
      transparent 31px,
      rgba(43, 44, 100, 0.05) 31px,
      rgba(43, 44, 100, 0.05) 32px
    );
  }

  /* "Cinta" que sostiene la carta */
  .om-carta__pin {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%) rotate(1.5deg);
    width: 110px;
    height: 26px;
    background: rgba(245, 166, 35, 0.35);
    border-left: 1px dashed rgba(43, 44, 100, 0.15);
    border-right: 1px dashed rgba(43, 44, 100, 0.15);
  }

  .om-carta__p {
    font-size: 16px;
    line-height: 2;
    color: var(--color-heading);
    margin-bottom: 18px;
  }

  .om-carta__firma {
    font-family: 'Caveat', cursive;
    font-weight: 600;
    font-size: 30px;
    color: var(--color-heading);
    margin-top: 28px;
    transform: rotate(-1.2deg);
  }

  /* ════════════════ 5. TESTIMONIOS ════════════════ */
  .om-testimonios {
    background: var(--bg-testimonials);
    padding: var(--section-py) 0;
  }

  .om-testimonios__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .om-test__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    width: 100%;
    max-width: 860px;
  }

  .om-test-card {
    background: white;
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--card-shadow);
  }

  .om-test-card:last-child {
    grid-column: 1 / -1;
    max-width: 420px;
    justify-self: center;
    width: 100%;
  }

  .om-test-card__quote {
    opacity: 0.6;
  }

  .om-test-card__text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-heading);
    flex: 1;
  }

  .om-test-card__ctx {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-green);
  }

  .om-test-card__author {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .om-test-card__name {
    font-weight: 700;
    font-size: 14px;
    color: var(--color-heading);
  }

  .om-test-card__detail {
    font-size: 12px;
    color: var(--color-secondary);
  }

  /* ════════════════ 6. GARANTÍA ════════════════ */
  .om-garantia {
    background: #ffffff;
    padding: var(--section-py) 0;
  }

  .om-garantia__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .om-garantia__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    width: 100%;
    max-width: 760px;
  }

  .om-g-card {
    background: #fafafe;
    border: 2px solid #c8c5d6;
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .om-g-card--amber {
    background: linear-gradient(135deg, #f7ecd4 0%, #f3f3f6 100%);
    border-color: var(--color-amber);
  }

  .om-g-card__icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--card-shadow);
  }

  .om-g-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.3;
    color: var(--color-heading);
  }

  .om-g-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-body);
  }

  /* ════════════════ 7. URGENCIA ════════════════ */
  .om-urgencia {
    background: var(--bg-hero);
    padding: var(--section-py) 0;
  }

  .om-urgencia__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    max-width: 640px;
    margin: 0 auto;
  }

  .om-urgencia__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.2;
    color: var(--color-heading);
  }

  .om-urgencia__sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-body);
  }

  /* ════════════════ 8. FAQ ════════════════ */
  .om-faq {
    background: var(--bg-faq);
    padding: var(--section-py) 0;
  }

  .om-faq__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .om-faq__list {
    width: 100%;
    max-width: 760px;
    display: flex;
    flex-direction: column;
  }

  .om-faq-item {
    border-bottom: 1px solid rgba(43, 44, 100, 0.1);
  }

  .om-faq-q {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 4px;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-heading);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: color 0.15s;
  }

  .om-faq-q:hover {
    color: var(--color-purple);
  }

  .om-faq-chevron {
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: var(--color-heading);
  }

  .om-faq-q[aria-expanded='true'] {
    color: var(--color-purple);
  }

  .om-faq-q[aria-expanded='true'] .om-faq-chevron {
    transform: rotate(180deg);
  }

  .om-faq-a p {
    padding: 0 4px 20px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-body);
  }

  /* ════════════════ 9. CTA FINAL ════════════════ */
  .om-final {
    background: var(--bg-footer);
    padding: var(--section-py) 0;
  }

  .om-final__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    max-width: 640px;
    margin: 0 auto;
  }

  .om-final__mascot {
    width: 110px;
    height: 110px;
    object-fit: contain;
  }

  .om-final__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.15;
    color: white;
  }

  .om-final__sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-footer-text);
  }

  .om-final__cierre {
    font-size: 14px;
    line-height: 1.6;
    font-weight: 600;
    color: var(--color-footer-text);
  }

  .om-final__trust {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--color-footer-text);
    font-weight: 500;
  }

  /* ════════════════ RESPONSIVE ════════════════ */
  @media (max-width: 768px) {
    .om-sec-title {
      font-size: 26px;
    }

    .om-hero {
      padding: 32px 0 48px;
    }

    .om-hero__title {
      font-size: 28px;
    }

    .om-hero__sub {
      font-size: 15px;
    }

    .om-reto__pasos {
      grid-template-columns: 1fr;
    }

    .om-carta {
      padding: 40px 24px 32px;
    }

    .om-carta__p {
      font-size: 15px;
    }

    .om-item {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 24px 20px;
    }

    .om-item__body {
      align-items: center;
    }

    .om-item__tag,
    .om-item__valor {
      align-self: center;
    }

    .om-item__bullets li {
      text-align: left;
    }

    .om-recap {
      padding: 28px 20px;
    }

    .om-recap__list li {
      flex-direction: column;
      gap: 2px;
      align-items: flex-start;
    }

    .om-recap__val {
      white-space: normal;
      text-align: left;
    }

    .om-recap__compare {
      flex-direction: column;
      gap: 8px;
    }

    .om-comp__flecha {
      transform: rotate(90deg);
    }

    .om-test__grid {
      grid-template-columns: 1fr;
      max-width: 480px;
    }

    .om-test-card:last-child {
      grid-column: auto;
      max-width: none;
    }

    .om-garantia__cards {
      grid-template-columns: 1fr;
      max-width: 480px;
    }

    .om-urgencia__title {
      font-size: 24px;
    }

    .om-countdown--big .om-cd__unit {
      min-width: 58px;
      padding: 8px 10px;
    }

    .om-countdown--big .om-cd__num {
      font-size: 24px;
    }

    .om-final__title {
      font-size: 26px;
    }
  }

  @media (max-width: 390px) {
    .om-hero__title {
      font-size: 25px;
    }

    .om-cd__unit {
      min-width: 50px;
      padding: 6px 8px;
    }
  }

  /* ══════════════════════════════════════════════════════════════
     TEMA OSCURO + ESTRUCTURA $100M (rediseño jul-2026)
     Va al final para ganarle a las reglas de arriba.
     ══════════════════════════════════════════════════════════════ */
  .om { background: #16173a; }

  /* ── HERO oscuro, 2 columnas (teléfono + contenido) ── */
  /* ── HERO claro (nada de azul aquí), 2 columnas ── */
  .om-hero { padding: 56px 0 64px; }
  .om-hero__inner {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) 1.1fr;
    gap: 56px;
    align-items: center;
    text-align: left;
    max-width: 1060px;
  }
  /* El teléfono es decorativo (loop automático de chat). pointer-events:none
     evita que su chat interno atrape el scroll táctil en móvil: así el dedo
     scrollea la página, no el mock. El auto-scroll del chat (por JS) sigue. */
  .om-hero__phone { display: flex; justify-content: center; pointer-events: none; }

  /* Grabación del webinar (reemplaza el teléfono en /fiestas-patrias) */
  .om-hero__video {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 520px;
    pointer-events: auto;
  }
  .om-hero__video-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1.5px solid rgba(43, 44, 100, 0.12);
    border-radius: var(--radius-pill);
    padding: 6px 15px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-heading);
    box-shadow: 0 2px 12px rgba(43, 44, 100, 0.08);
  }
  .om-hero__video-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e04545;
    box-shadow: 0 0 0 3px rgba(224, 69, 69, 0.2);
    animation: om-pulse 1.8s ease-in-out infinite;
  }
  .om-hero__video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    border: 3px solid #fff;
  }
  .om-hero__video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .om-hero__video-nota {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-secondary);
    text-align: center;
  }

  /* ════════════════ HERO DE LA PABLO PROMO ════════════════
     Dos columnas: el loop de Pablo rotando entre las 6 cosas que entran, y al
     costado la oferta (titular · lista · precio · CTA · reloj). El ítem del
     stack que está en pantalla se enciende en dorado: el dorado se usa SOLO
     para eso, el precio y el botón, así dirige el ojo en vez de decorar. */
  .om-hero--promo {
    padding: 26px 0 30px;
  }

  /* Reparto del boceto de Rodrigo (27-jul): cabecera centrada a lo ancho,
     debajo el carrusel a la izquierda con la lista + precio a la derecha, y
     el CTA con el countdown centrados al final. */
  .om-hero__promo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .om-hero__cabecera {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .om-hero__split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    align-items: center;
    gap: 44px;
    width: 100%;
    max-width: 980px;
  }

  .om-hero__derecha {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  /* Pill dorado (pedido de Rodrigo 27-jul): el nombre de la campaña dentro de
     un contenedor amarillo con letras blancas, para que se lea como sello de
     evento y no como una línea más. */
  .om-hero__eyebrow {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffffff;
    background: linear-gradient(135deg, #f2b84b, #e59b23);
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    box-shadow: 0 2px 8px rgba(229, 155, 35, 0.35);
  }

  /* El headline del 28-jul es largo a propósito (los números en palabras). El
     max-width lo parte en dos líneas parejas en vez de dejarlo llegar al borde
     de la pantalla, que se lee como un párrafo y no como un titular.
     Va anidado bajo .om-hero--promo porque más abajo hay un `.om-hero__title`
     suelto (el del hero viejo) que si no le gana por orden de documento. */
  .om-hero--promo .om-hero__title--promo {
    font-size: clamp(26px, 3.2vw, 40px);
    line-height: 1.12;
    text-align: center;
    max-width: 24ch;
    margin-inline: auto;
  }

  .om-hero--promo .om-hero__kicker {
    text-align: center;
    max-width: 52ch;
  }

  /* ── El carrusel vertical ── */
  .om-loop {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* La ventana es una tarjeta: los visuales de los bonos traen su propio fondo
     lila y los de Pablo son transparentes; el degradado de la tarjeta (del
     mismo tono que ese fondo) hace que los 7 se lean como una sola pieza. */
  .om-loop__ventana {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 26px;
    background: linear-gradient(165deg, #f6f3fd 0%, #eae5f8 100%);
    border: 1px solid rgba(122, 79, 171, 0.12);
    box-shadow: 0 18px 40px -18px rgba(76, 46, 133, 0.28);
  }

  .om-loop__track {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* La curva frena suave al llegar: se siente carrusel, no salto. */
    transition: transform 0.55s cubic-bezier(0.32, 0, 0.15, 1);
    will-change: transform;
  }

  .om-loop__slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .om-loop__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Pablo solo (primer slide, transparente) respira mejor con un poco de aire. */
  .om-loop__slide:first-child .om-loop__img {
    padding: 26px;
  }

  /* Chip dorado con el nombre del beneficio, dentro del slide: viaja pegado a
     su imagen, así nunca se ve la foto de una cosa con el nombre de otra. */
  .om-loop__chip {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    line-height: 1.3;
    text-align: center;
    white-space: nowrap;
    color: #7a4f00;
    background: rgba(253, 241, 216, 0.94);
    border: 1px solid #f5d99a;
    border-radius: var(--radius-pill);
    padding: 7px 16px;
    max-width: calc(100% - 28px);
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 4px 12px rgba(76, 46, 133, 0.12);
  }

  /* Puntitos de progreso del carrusel, en columna sobre el borde derecho. */
  .om-loop__dots {
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .om-loop__dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: rgba(122, 79, 171, 0.22);
    transition: height 0.3s ease, background 0.3s ease;
  }

  .om-loop__dot.is-active {
    height: 20px;
    background: linear-gradient(180deg, #f2b84b, #e59b23);
  }

  /* ── El stack: las 6 cosas que entran, cada una en su caja dorada ── */
  .om-hero__stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .om-hero__stack-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    line-height: 1.35;
    color: var(--color-heading);
    background: #ffffff;
    border: 1.5px solid #f0d9a8;
    border-radius: 12px;
    padding: 9px 14px;
    transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
  }

  .om-hero__stack-item::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e8d5a8;
    flex-shrink: 0;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .om-hero__stack-item.is-active {
    font-weight: 700;
    border-color: var(--color-amber);
    background: #fdf6e7;
    box-shadow: 0 2px 10px rgba(229, 155, 35, 0.18);
  }

  .om-hero__stack-item.is-active::before {
    background: var(--color-amber);
    transform: scale(1.5);
  }

  /* Escudo de la garantía (pedido de Rodrigo 27-jul) */
  .om-escudo {
    flex-shrink: 0;
    color: #b98a1e;
    margin-right: -4px;
  }

  /* Precio al pie de la columna derecha, centrado bajo la lista */
  .om-precio--hero {
    margin-top: 6px;
  }

  .om-precio--hero .om-precio__ahora {
    font-size: clamp(44px, 5.6vw, 60px);
  }

  .om-hero--promo .om-hero__cta {
    width: 100%;
    max-width: 380px;
  }

  .om-hero--promo .om-hero__cierre {
    align-items: center;
    width: 100%;
  }

  .om-hero--promo .om-hero__deadline,
  .om-hero--promo .om-hero__trust-row {
    text-align: center;
    justify-content: center;
  }

  /* ── Móvil (<760px; de ahí para arriba ya entra el reparto en dos
     columnas): una columna, el carrusel arriba y todo centrado ── */
  @media (max-width: 760px) {
    .om-hero--promo {
      padding: 14px 0 24px;
    }

    .om-hero__promo {
      gap: 12px;
    }

    .om-hero__cabecera {
      gap: 8px;
    }

    /* El reparto vuelve a una sola columna: carrusel arriba, lista debajo. */
    .om-hero__split {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 12px;
    }

    .om-hero__derecha {
      align-items: center;
      gap: 8px;
    }

    .om-loop__ventana {
      max-width: min(150px, 40vw);
      border-radius: 18px;
    }

    /* El chip y los puntitos salen en móvil: en 150px no se leen, y el ítem
       encendido de la lista ya dice qué está en pantalla. */
    .om-loop__chip,
    .om-loop__dots {
      display: none;
    }

    .om-loop__slide:first-child .om-loop__img {
      padding: 12px;
    }

    /* Sin tope de caracteres en móvil (el ancho de pantalla ya lo parte) y un
       punto más chico: el headline largo del 28-jul ocupaba 4 líneas y empujaba
       el botón bajo el pliegue. */
    .om-hero--promo .om-hero__title--promo {
      font-size: clamp(21px, 5.6vw, 27px);
      max-width: none;
    }

    /* El kicker se queda en móvil aunque apriete: es lo único arriba del
       pliegue que dice que Pablo vive en WhatsApp, y la mitad de la gente que
       llega del correo no sabe qué es Pablo. */
    .om-hero--promo .om-hero__kicker {
      font-size: 13.5px;
    }

    /* En móvil las cajas doradas van en 2 columnas compactas: 6 cajas en
       columna empujaban el botón bajo el pliegue. */
    .om-hero__stack {
      display: grid;
      grid-template-columns: 1fr 1fr;
      max-width: 360px;
      gap: 5px;
    }

    .om-hero__stack-item {
      font-size: 11.5px;
      line-height: 1.3;
      text-align: left;
      padding: 7px 9px;
      border-radius: 10px;
      gap: 7px;
    }

    .om-hero__stack-item::before {
      width: 6px;
      height: 6px;
    }

    .om-precio--hero .om-precio__ahora {
      font-size: 48px;
    }

    .om-precio--hero .om-precio__antes {
      font-size: 17px;
    }

  }

  /* Pantallas cortas de verdad (iPhone SE y similares): acá sí sobra el kicker,
     porque si no el botón cae bajo el pliegue. */
  @media (max-width: 760px) and (max-height: 700px) {
    .om-hero--promo .om-hero__kicker {
      display: none;
    }

    .om-loop__ventana {
      max-width: min(120px, 34vw);
    }

    .om-precio--hero .om-precio__ahora {
      font-size: 42px;
    }
  }

  /* ════════════════ HERO VSL: TODO EN LA PRIMERA PANTALLA ════════════════
     Orden fijo: título del taller → video → CTA → countdown/cierre. La altura
     del video se calcula contra el viewport (svh) para que el CTA y el
     countdown NUNCA queden bajo el pliegue, en desktop y en móvil. */
  .om-hero--vsl {
    /* El bloque ocupa EXACTAMENTE lo que queda de la primera pantalla después
       del banner y el header (--om-chrome lo mide el JS al cargar y al
       redimensionar; 118px = 46 + 72 es el valor de arranque). El video absorbe
       el espacio libre, así el CTA y el countdown nunca caen bajo el pliegue. */
    height: calc(100svh - var(--om-chrome, 118px));
    min-height: 520px;
    display: flex;
    align-items: stretch;
    padding: 14px 0 18px;
  }

  .om-hero__vsl {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: clamp(10px, 1.9svh, 20px);
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
    min-height: 0;
  }

  .om-hero__titulo-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Nombre del taller: el título más grande de la página, arriba del video. */
  .om-hero__title--taller {
    font-size: clamp(28px, 5.2vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-align: center;
  }

  .om-hero__kicker {
    font-size: clamp(14px, 1.6vw, 18px);
    line-height: 1.45;
    color: var(--color-body);
    font-weight: 500;
    max-width: 560px;
    margin: 0 auto;
  }

  /* El video es el elemento elástico: se queda con el espacio que sobra
     después del título, el CTA y el countdown. Su ancho se deriva de esa
     altura (16:9), así que crece en pantallas altas y encoge en las bajitas
     sin empujar nada fuera del pliegue. */
  .om-hero__vsl .om-hero__video {
    flex: 1 1 auto;
    min-height: 140px;
    max-width: none;
    width: 100%;
    gap: 0;
    justify-content: center;
  }

  .om-hero__vsl .om-hero__video-frame {
    height: 100%;
    width: auto;
    max-width: min(100%, 720px);
    aspect-ratio: 16 / 9;
    margin: 0 auto;
  }

  /* Móvil vertical: ahí el ancho es el límite, no la altura. El video pasa a
     ocupar todo el ancho (un 16:9 así es bajito y entra de sobra). */
  @media (max-aspect-ratio: 4 / 5) {
    .om-hero__vsl .om-hero__video { flex: 0 0 auto; }
    .om-hero__vsl .om-hero__video-frame {
      width: 100%;
      height: auto;
    }
  }

  /* 480px = el copy del CTA entra en una sola línea */
  .om-hero__cta {
    max-width: 480px;
    padding: 14px 24px;
  }

  .om-hero__cierre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .om-countdown--hero .om-cd__unit {
    min-width: 50px;
    padding: 5px 10px;
  }
  .om-countdown--hero .om-cd__num { font-size: 19px; }

  .om-hero__deadline {
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-secondary);
    /* Ancho suficiente para que quepa en una línea en desktop y no deje
       "meses." solo en la segunda. */
    max-width: 560px;
  }

  /* Tres micro-pruebas de riesgo cero, en una línea */
  .om-hero__trust-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 14px;
    list-style: none;
  }
  .om-hero__trust-row li {
    position: relative;
    padding-left: 15px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-heading);
    opacity: 0.72;
    white-space: nowrap;
  }
  .om-hero__trust-row li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 8px;
    height: 4px;
    border-left: 2px solid var(--color-green);
    border-bottom: 2px solid var(--color-green);
    transform: translateY(-70%) rotate(-45deg);
  }

  /* El resaltador del hero: en un título de 52px el trazo por defecto (40%)
     queda como una banda gruesa. Se sube y se adelgaza para que se lea como
     un plumón sobre la línea base, no como un bloque detrás del texto. */
  .om-hero__title--taller .highlight::after {
    bottom: 5px;
    height: 26%;
  }

  .om-hero__scroll {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    opacity: 0.75;
    animation: om-bob 2.4s ease-in-out infinite;
  }

  @keyframes om-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  /* Pantallas bajitas (laptops 13"): recorta lo opcional, nunca el CTA. */
  @media (max-height: 700px) {
    .om-hero__title--taller { font-size: clamp(24px, 4vw, 34px); }
    .om-hero__kicker { font-size: 13px; }
    .om-hero__scroll { display: none; }
    .om-countdown--hero .om-cd__unit { min-width: 44px; padding: 4px 8px; }
    .om-countdown--hero .om-cd__num { font-size: 17px; }
  }

  /* Móviles chicos (360×640 y parecidos): el video puede encoger más y el
     texto de apoyo baja un punto, para que la fila de garantías siga entrando
     en la primera pantalla. */
  @media (max-height: 680px) {
    .om-hero--vsl { min-height: 0; padding: 10px 0 14px; }
    .om-hero__vsl { gap: 8px; }
    .om-hero__vsl .om-hero__video { min-height: 104px; }
    .om-hero__kicker { font-size: 12.5px; }
    .om-hero__deadline { font-size: 11.5px; }
    .om-hero__trust-row { gap: 4px 10px; }
    .om-hero__trust-row li { font-size: 10.5px; }
    .om-hero__cta { padding: 12px 20px; font-size: 14px; }
  }
  .om-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 560px;
  }
  .om-hero__title {
    text-align: left;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.14;
  }

  /* Cajita resumen del hero (clara) */
  .om-hero__resumen {
    width: 100%;
    background: #fff;
    border: 1.5px solid #e6e3f2;
    border-radius: var(--radius-md);
    padding: 18px 20px;
    box-shadow: var(--card-shadow);
  }
  .om-hero__resumen-title {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-heading);
    font-size: 14px;
    margin-bottom: 10px;
  }
  .om-hero__resumen-list { display: flex; flex-direction: column; gap: 8px; }
  .om-hero__resumen-list li {
    position: relative;
    padding-left: 24px;
    font-size: 14px;
    color: var(--color-body);
    line-height: 1.4;
  }
  .om-hero__resumen-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-green);
    font-weight: 800;
  }
  .om-hero__resumen-list li[data-noche] { color: #875a00; font-weight: 600; }
  .om-hero__resumen-list li[data-noche]::before { content: "★"; color: var(--color-amber); }

  /* ── Banda de prueba social (navy, entre el precio y los bonos) ── */
  .om-social { background: #20214a; padding: 56px 0 64px; }
  .om-social__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }
  .om-social__label {
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #7BE495;
  }
  .om-social__pills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    width: 100%;
    max-width: 1040px;
  }
  .om-social__pill {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 20px 22px;
  }
  .om-social__quote {
    font-size: 14.5px;
    line-height: 1.6;
    color: #fff;
    font-style: italic;
    flex: 1;
  }
  .om-social__autor {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-amber);
  }
  .om-social__autor span { font-weight: 500; color: rgba(255, 255, 255, 0.6); }

  /* ════════════════ SEGUNDA PANTALLA: TODO LO QUE INCLUYE ════════════════
     Un inventario donde cada bono es visiblemente SU bono: tarjeta propia,
     número grande, tag "Bono N de 5" y su precio real → precio de hoy. */
  .om-incluye {
    background: var(--bg-how);
    padding: clamp(48px, 7vh, 80px) 0;
  }

  .om-incluye__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .om-incluye__eyebrow {
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-amber);
  }

  .om-incluye__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(272px, 1fr));
    gap: 18px;
    width: 100%;
    max-width: 1080px;
  }

  .om-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fff;
    border: 1.5px solid #e5e3f0;
    border-radius: var(--radius-lg);
    padding: 20px 22px 22px;
    box-shadow: var(--card-shadow);
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .om-card:hover {
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-3px);
  }

  /* El principal (Plan Anual) manda: borde ámbar y una franja arriba. */
  .om-card--principal {
    border-color: var(--color-amber);
    box-shadow: 0 10px 32px rgba(245, 166, 35, 0.16);
  }
  .om-card--principal::before,
  .om-card--noche::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-cta);
  }
  .om-card--noche { border-color: #f5c970; background: #fffdf7; }

  .om-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .om-card__tag {
    background: #eeedf5;
    color: var(--color-heading);
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
  }
  .om-card__tag--principal { background: var(--gradient-cta); color: #2b2c64; }
  .om-card__tag--fire { background: #fde9c4; color: #875a00; }

  /* Número grande: marca que cada tarjeta es un bono distinto. */
  .om-card__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
    color: rgba(43, 44, 100, 0.12);
    flex-shrink: 0;
  }

  .om-card__media {
    display: flex;
    justify-content: center;
    padding: 4px 0;
  }
  .om-card__media img {
    width: 88px;
    height: 88px;
    object-fit: contain;
    filter: drop-shadow(0 10px 22px rgba(43, 44, 100, 0.18));
  }

  .om-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.25;
    color: var(--color-heading);
  }

  .om-card__desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-body);
    flex: 1;
  }

  /* Precio: valor real tachado → lo que pagas hoy */
  .om-card__precio {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
    padding-top: 14px;
    border-top: 1.5px dashed #e5e3f0;
  }

  .om-card__real,
  .om-card__hoy {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .om-card__real-label,
  .om-card__hoy-label {
    font-size: 9.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
  }

  .om-card__real s {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-secondary);
  }
  .om-card__real--vacio { text-decoration: none !important; }

  .om-card__hoy strong {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
    color: #2a7a52;
  }

  .om-card__flecha {
    color: var(--color-amber);
    font-weight: 800;
    font-size: 16px;
  }

  .om-incluye__total {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    width: 100%;
    max-width: 780px;
    background: #fff;
    border: 1.5px solid #e5e3f0;
    border-radius: var(--radius-lg);
    padding: 22px 24px;
    box-shadow: var(--card-shadow);
  }

  @media (max-width: 560px) {
    .om-card__media img { width: 68px; height: 68px; }
    .om-incluye__grid { gap: 14px; }
  }

  /* ════════════════ BARRA FIJA DE CTA ════════════════ */
  .om-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: rgba(27, 28, 64, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.22);
    padding: 10px 0 calc(10px + env(safe-area-inset-bottom));
    transform: translateY(110%);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .om-sticky.is-visible { transform: none; }

  .om-sticky__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }
  .om-sticky__precio { display: flex; flex-direction: column; gap: 1px; }
  .om-sticky__tachado {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: line-through;
    white-space: nowrap;
  }
  .om-sticky__monto {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.1;
    color: #fff;
    white-space: nowrap;
  }
  .om-sticky__monto span {
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
  }
  .om-sticky__cd { margin-right: auto; }
  .om-sticky__cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    border-radius: 14px;
    background: var(--gradient-cta);
    color: #2b2c64;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 3px 0 0 #c9820a;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .om-sticky__cta:hover { transform: translateY(-1px); box-shadow: 0 4px 0 0 #c9820a; }
  .om-sticky__cta:active { transform: translateY(2px); box-shadow: 0 1px 0 0 #c9820a; }

  @media (max-width: 560px) {
    .om-sticky__inner { gap: 12px; }
    .om-sticky__cd { display: none; }
    .om-sticky__precio { margin-right: auto; }
    .om-sticky__cta { padding: 12px 18px; font-size: 13px; }
  }

  /* ── BONOS: cada uno a pantalla completa; ALTERNAN blanco / navy ── */
  .om-bono {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: center;
    padding: 72px 0;
    background: #fff;               /* claro por defecto */
    overflow: hidden;
  }

  /* Número gigante de fondo: refuerza que estás en el bono N, no en un bloque
     más de texto corrido. */
  .om-bono__watermark {
    position: absolute;
    top: 50%;
    right: 3vw;
    transform: translateY(-50%);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(180px, 34vw, 420px);
    line-height: 0.8;
    color: rgba(43, 44, 100, 0.045);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .om-bono--flip .om-bono__watermark,
  .om-bono--noche .om-bono__watermark {
    color: rgba(255, 255, 255, 0.055);
    right: auto;
    left: 3vw;
  }
  .om-bono--flip { background: #1b1c40; }   /* oscuro */
  .om-bono--noche {
    background: linear-gradient(135deg, #3a2c0e 0%, #20214a 65%);
  }
  .om-bono__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: center;
    max-width: 1080px;
  }
  .om-bono--flip .om-bono__media { order: 2; }
  .om-bono__media { display: flex; justify-content: center; }
  .om-bono__media img {
    width: min(320px, 72vw);
    height: auto;
    filter: drop-shadow(0 20px 44px rgba(43, 44, 100, 0.25));
  }
  .om-bono--flip .om-bono__media img,
  .om-bono--noche .om-bono__media img {
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.45));
  }
  .om-bono__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 560px;
  }
  /* Tag: claro por defecto, blanco translúcido en secciones oscuras */
  .om-bono__tag {
    background: #eeedf5;
    color: var(--color-heading);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
  }
  .om-bono--flip .om-bono__tag,
  .om-bono--noche .om-bono__tag {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .om-bono__tag--fire { background: var(--gradient-cta); color: #2b2c64; }
  .om-bono__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.15;
    color: var(--color-heading);
  }
  .om-bono--flip .om-bono__title,
  .om-bono--noche .om-bono__title { color: #fff; }
  /* Valor del bono en tarjeta: "Valor real S/.X → Hoy: gratis". Cada bono
     lleva su propio precio, así se lee como un producto aparte. */
  .om-bono__valor {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    background: #f7f5fd;
    border: 1.5px solid #e5e3f0;
    border-radius: var(--radius-md);
    padding: 12px 18px;
  }
  .om-bono--flip .om-bono__valor,
  .om-bono--noche .om-bono__valor {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.14);
  }
  .om-bono__valor-col { display: flex; flex-direction: column; gap: 2px; }
  .om-bono__valor-label {
    font-size: 9.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
  }
  .om-bono--flip .om-bono__valor-label,
  .om-bono--noche .om-bono__valor-label { color: rgba(255, 255, 255, 0.55); }
  .om-bono__valor-flecha {
    color: var(--color-amber);
    font-weight: 800;
    font-size: 18px;
  }
  .om-bono__tachado {
    color: var(--color-secondary);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    text-decoration: line-through;
  }
  .om-bono--flip .om-bono__tachado,
  .om-bono--noche .om-bono__tachado { color: rgba(255, 255, 255, 0.5); }
  .om-bono__incluido {
    background: #e7f7ea;
    color: #2a7a52;
    border: 1px solid #bfe6c9;
    font-weight: 700;
    font-size: 13px;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .om-bono__desc {
    font-size: clamp(15px, 2vw, 18px);
    line-height: 1.6;
    color: var(--color-body);
  }
  .om-bono--flip .om-bono__desc,
  .om-bono--noche .om-bono__desc { color: rgba(255, 255, 255, 0.85); }
  .om-bono__bullets { display: flex; flex-direction: column; gap: 10px; }
  .om-bono__bullets li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 15px;
    color: var(--color-body);
    line-height: 1.5;
  }
  .om-bono--flip .om-bono__bullets li,
  .om-bono--noche .om-bono__bullets li { color: rgba(255, 255, 255, 0.85); }
  .om-bono--flip .om-bono__bullets .om-check,
  .om-bono--noche .om-bono__bullets .om-check { stroke: #7BE495; }
  .om-bono__proof {
    border-left: 3px solid var(--color-amber);
    background: #faf7ff;
    border-radius: 0 12px 12px 0;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .om-bono--flip .om-bono__proof,
  .om-bono--noche .om-bono__proof { background: rgba(255, 255, 255, 0.06); }
  .om-bono__proof-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-green);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .om-bono--flip .om-bono__proof-label,
  .om-bono--noche .om-bono__proof-label { color: #7BE495; }
  .om-bono__proof-quote { font-size: 14px; font-style: italic; color: var(--color-heading); line-height: 1.5; }
  .om-bono--flip .om-bono__proof-quote,
  .om-bono--noche .om-bono__proof-quote { color: #fff; }
  .om-bono__proof-autor { font-size: 12px; color: var(--color-secondary); }
