  <!-- Los CTA ya NO abren el modal de "crea tu cuenta": son links directos al
       onboarding (/onboarding?plan=anual&oferta=millonaria). El usuario nuevo
       hace el flujo y la oferta se le vuelve a presentar en el paywall final. -->

<style>
  /* Bonus 1-a-1: nace oculto y se revela solo la noche del webinar. El
     !important gana al display de .om-item / .om-recap li. */
  [data-noche][hidden] { display: none !important; }

  /* ════════════════ BANNER SUPERIOR (~½ pulgada) ════════════════
     46px ≈ media pulgada a 96dpi. Texto en 13px/600: a propósito por debajo
     del wordmark "Pablo" del header (20px/700) para no competir con la marca. */
  .om-topbar {
    background: #2b2c64;
    color: #fff;
    min-height: 46px;
    display: flex;
    align-items: center;
  }

  .om-topbar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 12px;
    padding-top: 7px;
    padding-bottom: 7px;
  }

  .om-topbar__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff6b6b;
    box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.22);
    animation: om-pulse-claro 1.8s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes om-pulse-claro {
    0%, 100% { box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.22); }
    50% { box-shadow: 0 0 0 6px rgba(255, 107, 107, 0.08); }
  }

  .om-topbar__texto {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.3;
  }

  /* Countdown chiquito del banner: inline, sin cajitas */
  .om-countdown--mini {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .om-cd__mini {
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .om-cd__mini b {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    color: var(--color-amber);
    margin-right: 1px;
  }

  /* Móvil: texto corto para que el banner siga siendo UNA línea (~46px). */
  .om-topbar__corta { display: none; }

  @media (max-width: 620px) {
    .om-topbar__larga { display: none; }
    .om-topbar__corta { display: inline; }
    .om-topbar__texto { font-size: 12px; }
    .om-cd__mini--seg { display: none; }
    .om-topbar__inner { gap: 8px; }
  }

  @media (max-width: 380px) {
    .om-topbar__texto { font-size: 11px; }
    .om-cd__mini { font-size: 11px; }
  }

  /* ════════════════ HEADER MÍNIMO ════════════════ */
  /* Header 28-jul: sin barra — el logotipo flota chiquito en la esquina
     superior izquierda, encima del hero. */
  .om-header--flotante {
    position: absolute;
    top: 14px;
    left: 18px;
    z-index: 30;
    pointer-events: none;
  }

  .om-header__logo {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    cursor: default;
  }

  .om-header__img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    border-radius: 7px;
  }

  .om-header__text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 16px;
    color: var(--color-heading);
    opacity: 0.85;
  }

  /* ════════════════ BASE ════════════════ */
  .om {
    --om-cream: #fffaf0;
    --om-navy: var(--color-navy);
  }

  .om-sec-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .om-sec-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.15;
    color: var(--color-heading);
    max-width: 640px;
  }

  .om-sec-sub {
    font-size: 16px;
    color: var(--color-body);
    max-width: 480px;
  }

  /* CTA estilo Duolingo (reborde 3D como el hero del index) */
  .om-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 380px;
    padding: 16px 24px;
    border-radius: 16px;
    background: var(--gradient-cta);
    color: #2b2c64;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-align: center;
    box-shadow: 0 4px 0 0 #c9820a;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
    cursor: pointer;
  }

  .om-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 0 0 #c9820a;
  }

  .om-cta:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 0 #c9820a;
  }

  .om-cta--full {
    max-width: none;
  }

  .om-cta--xl {
    max-width: 440px;
    padding: 18px 28px;
    font-size: 16px;
  }

  /* Badge deadline */
  .om-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: white;
    border: 1.5px solid rgba(43, 44, 100, 0.12);
    border-radius: var(--radius-pill);
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-heading);
    letter-spacing: 0.02em;
    box-shadow: 0 2px 12px rgba(43, 44, 100, 0.06);
  }

  .om-badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e04545;
    box-shadow: 0 0 0 3px rgba(224, 69, 69, 0.2);
    animation: om-pulse 1.8s ease-in-out infinite;
  }

  @keyframes om-pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(224, 69, 69, 0.2); }
    50% { box-shadow: 0 0 0 6px rgba(224, 69, 69, 0.08); }
  }

  /* Countdown (mismo lenguaje visual que el webinar) */
  .om-countdown {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .om-cd__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: white;
    border-radius: var(--radius-md);
    padding: 7px 12px;
    min-width: 56px;
    box-shadow: var(--card-shadow);
  }

  .om-cd__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 21px;
    line-height: 1.1;
    color: var(--color-heading);
    font-variant-numeric: tabular-nums;
  }

  .om-cd__label {
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-secondary);
  }

  .om-cd__sep {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-amber);
  }

  .om-countdown--big .om-cd__unit {
    min-width: 68px;
    padding: 10px 14px;
  }

  .om-countdown--big .om-cd__num {
    font-size: 30px;
  }

  /* ════════════════ 1. HERO ════════════════ */
  .om-hero {
    background: var(--bg-hero);
    padding: 48px 0 64px;
    position: relative;
    overflow: hidden;
  }

  .om-hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .om-hero__blob--1 {
    width: 420px;
    height: 420px;
    background: rgba(246, 183, 43, 0.14);
    top: -100px;
    right: -80px;
  }

  .om-hero__blob--2 {
    width: 340px;
    height: 340px;
    background: rgba(86, 87, 143, 0.1);
    bottom: -60px;
    left: -60px;
  }

  .om-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    max-width: 720px;
    margin: 0 auto;
  }

  .om-hero__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 40px;
    line-height: 1.12;
    color: var(--color-heading);
  }

  .om-gratis {
    color: var(--color-green);
  }

  .om-hero__sub {
    font-size: 17px;
    line-height: 1.55;
    color: var(--color-body);
    max-width: 540px;
  }

  .om-hero__trust {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--color-secondary);
    font-weight: 500;
  }

  /* ════════════════ VISTO EN ════════════════
     Rediseño 28-jul (2da ronda): fondo blanco (nada de franja oscura), los 7
     logos repartidos de extremo a extremo en celdas del MISMO ancho, flotando
     con baja opacidad y en escala de grises; el color vuelve al hover. Los
     PNG traen fondo blanco propio — sobre blanco desaparece y solo se ve el
     logo. */
  /* Bordes difusos (pedido 28-jul): la franja blanca entra y sale en
     degradado, sin cortes duros contra el lila del hero. */
  .om-visto {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0%,
      #ffffff 42%,
      #ffffff 100%
    );
    padding: 44px 0 26px;
  }

  .om-visto__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .om-visto__label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-secondary);
    opacity: 0.75;
    margin: 0;
  }

  .om-visto__logos {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    align-items: center;
  }

  .om-visto__logos li {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
  }

  .om-visto__logos img {
    height: 32px;
    width: auto;
    max-width: 82%;
    object-fit: contain;
    opacity: 0.45;
    filter: grayscale(1);
    transition: opacity 0.3s ease, filter 0.3s ease, transform 0.3s ease;
  }

  .om-visto__logos li:hover img {
    opacity: 1;
    filter: none;
    transform: translateY(-2px);
  }

  /* ════════════════ EL PROBLEMA ════════════════
     Fondo blanco para cortar con el lila del hero. Las citas NO se ven como
     tarjetas de testimonio: van con una raya dorada al costado y en cursiva,
     para que se lean como voces y no como resultados. El dolor va sobrio: la
     idea es que la persona piense "a mí también", no asustarla. */
  .om-dolor {
    background: #ffffff;
    padding: var(--section-py) 0;
  }

  .om-dolor__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    text-align: center;
  }

  .om-dolor__eyebrow {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  /* El <br> del markup reparte una oración por fila (28-jul): sin tope de
     ancho para que cada oración quede entera en su línea en desktop. */
  .om-dolor__title {
    max-width: none;
  }

  .om-dolor__sub {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-body);
  }

  /* ════════════════ EL TRATO ════════════════
     (28-jul, copy verbatim de Rodrigo) El reto contado como un trato entre
     dos personas, en UNA tarjeta tipo contrato: el apretón de manos a la
     izquierda, las 4 cosas numeradas a la derecha y la promesa separada por
     una línea punteada, como la firma de un acuerdo. */
  .om-trato {
    background: #ffffff;
    padding: 10px 0 var(--section-py);
  }

  .om-trato__card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    background: linear-gradient(150deg, #fffdf8, #fdf4e0);
    border: 1.5px solid #f0d9a8;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: 0 24px 50px -28px rgba(76, 46, 133, 0.25);
    max-width: 1040px;
    margin: 0 auto;
  }

  .om-trato__media {
    position: relative;
  }

  .om-trato__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .om-trato__body {
    padding: 38px 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .om-trato__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(23px, 2.5vw, 31px);
    line-height: 1.18;
    color: var(--color-heading);
    margin: 0;
  }

  .om-trato__lead {
    font-size: 15.5px;
    font-weight: 600;
    color: var(--color-body);
    margin: 0;
  }

  .om-trato__pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .om-trato__paso {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #ffffff;
    border: 1px solid #f0e2c0;
    border-radius: 14px;
    padding: 11px 14px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-heading);
  }

  .om-trato__num {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13.5px;
    color: #7a4f00;
    background: linear-gradient(135deg, #fbe3ac, #f2c063);
  }

  .om-trato__remate {
    border-top: 1.5px dashed #ecd9ac;
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .om-trato__promesa {
    font-size: 16.5px;
    line-height: 1.45;
    font-weight: 600;
    color: var(--color-heading);
    margin: 0;
  }

  .om-trato__promesa strong {
    color: #b98a1e;
  }

  .om-trato__ganas {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--color-body);
    margin: 0;
  }

  /* El trato en una columna cuando aprieta: la ilustración arriba, recortada
     a franja, y las 4 cosas debajo. */
  /* El trato aguanta el side-by-side hasta tablet (pedido 28-jul: que el
     iPad ya lo vea a dos columnas); solo compacta paddings en el tramo
     intermedio. Recién en móvil pasa a una columna. */
  @media (max-width: 880px) and (min-width: 641px) {
    .om-trato__body {
      padding: 26px 24px;
      gap: 12px;
    }

    .om-trato__paso {
      font-size: 13.5px;
      padding: 10px 12px;
    }
  }

  @media (max-width: 640px) {
    .om-trato__card {
      grid-template-columns: 1fr;
    }

    .om-trato__media {
      max-height: 250px;
      overflow: hidden;
    }

    .om-trato__body {
      padding: 24px 20px 28px;
    }

    .om-trato__paso {
      font-size: 13.5px;
      padding: 10px 12px;
    }

    .om-visto__logos {
      grid-template-columns: repeat(4, 1fr);
      gap: 4px 0;
    }

    .om-visto__logos li {
      min-height: 42px;
    }

    .om-visto__logos img {
      height: 22px;
      max-width: 78%;
    }
  }

  .om-dolor__grid {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 26px;
    width: 100%;
    max-width: 880px;
    text-align: left;
  }

  .om-dolor__card {
    border-left: 3px solid #f0d9a8;
    padding: 2px 0 2px 18px;
  }

  .om-dolor__cita {
    font-size: 16px;
    line-height: 1.55;
    font-style: italic;
    color: var(--color-heading);
  }

  .om-dolor__autor {
    margin-top: 7px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-heading);
  }

  .om-dolor__autor span {
    font-weight: 500;
    color: var(--color-secondary);
  }

  .om-dolor__cierre {
    margin-top: 22px;
    max-width: 620px;
  }

  .om-dolor__cierre-cita {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(19px, 2.4vw, 25px);
    line-height: 1.35;
    color: var(--color-heading);
  }

  .om-dolor__cierre .om-dolor__autor {
    margin-top: 10px;
  }

  @media (max-width: 768px) {
    .om-dolor__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .om-dolor__title {
      max-width: none;
    }

    .om-dolor__sub {
      font-size: 15.5px;
    }

    .om-dolor__cita {
      font-size: 15px;
    }
  }

  /* ════════════════ QUÉ ES PABLO ════════════════
     El puente para quien llega del correo sin saber qué es Pablo. El teléfono
     es el mock de HeroPhone (HTML/CSS), así que se ve nítido en cualquier
     pantalla y muestra el producto funcionando en vez de una ilustración. */
  .om-quees {
    background: var(--bg-how);
    /* Menos aire abajo: la sección que sigue (om-incluye) trae su propio
       padding arriba y entre las dos quedaba un hueco vacío de ~200px. */
    padding: var(--section-py) 0 34px;
  }

  .om-quees__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    align-items: center;
    gap: 52px;
  }

  .om-quees__texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .om-quees__title {
    text-align: left;
    max-width: 22ch;
  }

  .om-nowrap {
    white-space: nowrap;
  }

  .om-quees__sub {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--color-body);
    max-width: 46ch;
  }

  .om-quees__bullets {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .om-quees__bullets li {
    position: relative;
    padding-left: 26px;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--color-heading);
  }

  /* Check dibujado en CSS: el mismo lenguaje de los bullets de los bonos */
  .om-quees__bullets li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 6px;
    width: 6px;
    height: 11px;
    border-right: 2.5px solid var(--color-green);
    border-bottom: 2.5px solid var(--color-green);
    transform: rotate(45deg);
  }

  .om-quees__quote {
    margin: 10px 0 0;
    border-left: 3px solid #f0d9a8;
    padding-left: 18px;
  }

  .om-quees__quote p {
    font-size: 15.5px;
    line-height: 1.55;
    font-style: italic;
    color: var(--color-heading);
  }

  .om-quees__quote cite {
    display: block;
    margin-top: 7px;
    font-size: 13px;
    font-weight: 700;
    font-style: normal;
    color: var(--color-heading);
  }

  .om-quees__quote cite span {
    font-weight: 500;
    color: var(--color-secondary);
  }

  .om-quees__phone {
    display: flex;
    justify-content: center;
  }

  /* Misma fórmula de escalado que usa el hero del home: el interior del
     teléfono se dimensiona con em sobre este font-size. */
  .om-quees__phone :global(.hphone) {
    --w: clamp(240px, 26vw, 320px);
    font-size: calc(var(--w) * 0.0412);
  }

  @media (max-width: 900px) {
    .om-quees__inner {
      grid-template-columns: 1fr;
      gap: 26px;
      justify-items: center;
    }

    /* El teléfono va DESPUÉS del texto en móvil a propósito: HeroPhone llena
       el chat por JS con retardos (el primer mensaje a los 900 ms y la
       conversación completa recién a los ~20 s). Si fuera lo primero que se
       ve, el primer golpe de vista sería un WhatsApp vacío. Leyendo el titular
       y los bullets pasa el tiempo suficiente para que ya haya conversación. */
    .om-quees__texto {
      order: 1;
      align-items: center;
      text-align: center;
    }

    .om-quees__phone {
      order: 2;
    }

    .om-quees__title {
      text-align: center;
      max-width: none;
    }

    .om-quees__bullets li,
    .om-quees__quote {
      text-align: left;
    }

    .om-quees__phone :global(.hphone) {
      --w: clamp(230px, 62vw, 300px);
    }
  }

  /* ════════════════ 2. EL PACTO ════════════════ */
  .om-reto {
    background: #ffffff;
    padding: var(--section-py) 0;
  }

  .om-reto__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .om-reto__pasos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    width: 100%;
    max-width: 760px;
    counter-reset: paso;
  }

  .om-paso {
    display: flex;
    gap: 16px;
    align-items: center;
    background: var(--bg-hero);
    border-radius: var(--radius-md);
    padding: 22px;
  }

  .om-paso__num {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--gradient-cta);
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 10px rgba(245, 166, 35, 0.35);
  }

  .om-paso__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.35;
    color: var(--color-heading);
  }

  .om-reto__cierre {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    max-width: 560px;
  }

  .om-reto__cierre p {
    font-size: 16px;
    color: var(--color-body);
  }

  .om-reto__frase {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px !important;
    color: var(--color-heading) !important;
  }

  .om-reto__ventana {
    font-size: 14px !important;
    line-height: 1.6;
    color: #875a00 !important;
    background: #fef3da;
    border: 1px solid #f5c970;
    border-radius: var(--radius-md);
    padding: 12px 20px;
  }

  /* Mini-testimonios en pills pegados al pacto */
  .om-pacto__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    width: 100%;
    max-width: 760px;
  }

  .om-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    background: white;
    border: 1.5px solid #e5e3f0;
    border-radius: 18px;
    padding: 14px 24px;
    box-shadow: var(--card-shadow);
    text-align: center;
    max-width: 340px;
  }

  .om-pill__quote {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-heading);
  }

  .om-pill__autor {
    font-size: 12px;
    color: var(--color-secondary);
  }

  /* ════════════════ 3. VALUE STACK ════════════════ */
  .om-stack {
    background: var(--bg-how);
    padding: var(--section-py) 0;
  }

  .om-stack__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .om-stack__list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    max-width: 760px;
  }

  .om-item {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    background: white;
    border: 1.5px solid #e5e3f0;
    border-radius: var(--radius-lg);
    padding: 28px;
    box-shadow: var(--card-shadow);
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .om-item:hover {
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-3px);
  }

  .om-item__media {
    flex-shrink: 0;
    width: 110px;
    height: 110px;
    background: #ffffff;
    border: 1.5px solid #e5e3f0;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .om-item__media img {
    width: 90px;
    height: 90px;
    object-fit: contain;
  }

  .om-item__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .om-item__tag {
    align-self: flex-start;
    background: #eeedf5;
    color: var(--color-heading);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .om-item__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    color: var(--color-heading);
  }

  .om-item__valor {
    align-self: flex-start;
    background: #fef3da;
    color: #875a00;
    border: 1px solid #f5c970;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .om-item__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-body);
  }

  .om-item__bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }

  .om-item__bullets li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-body);
  }

  .om-check {
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* ════════════════ PRUEBA SOCIAL (banda navy) ════════════════ */
  .om-social {
    background: #2B2C64;
    padding: 40px 0;
  }

  .om-social__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }

  .om-social__lead {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(18px, 3.5vw, 24px);
    color: #fff;
  }

  .om-social__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .om-social__chip {
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-pill);
    padding: 8px 16px;
    font-size: 13px;
    color: #fff;
    line-height: 1.4;
  }

  .om-social__stars {
    color: var(--color-amber);
    margin-right: 6px;
    letter-spacing: 1px;
  }

  /* ════════════════ MÓDULOS-PILAR: alternan lado e claro/navy ════════════════ */
  .om-item--dark {
    background: #2B2C64;
    border-color: #2B2C64;
    flex-direction: row-reverse;
  }

  .om-item--dark .om-item__title { color: #fff; }

  .om-item--dark .om-item__desc,
  .om-item--dark .om-item__bullets li {
    color: rgba(255, 255, 255, 0.82);
  }

  .om-item--dark .om-item__tag {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .om-item--dark .om-item__media {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.14);
  }

  .om-item--dark .om-check { stroke: #7BE495; }

  /* Bloque de prueba dentro de un módulo ("Proof This Works") */
  .om-item__proof {
    margin-top: 8px;
    padding: 14px 16px;
    border-left: 3px solid var(--color-amber);
    background: #faf7ff;
    border-radius: 0 12px 12px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .om-item__proof-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-green);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .om-item__proof-quote {
    font-size: 14px;
    font-style: italic;
    line-height: 1.5;
    color: var(--color-heading);
  }

  .om-item__proof-autor {
    font-size: 12px;
    color: var(--color-secondary);
  }

  .om-item--dark .om-item__proof {
    background: rgba(255, 255, 255, 0.07);
  }

  .om-item--dark .om-item__proof-quote { color: #fff; }
  .om-item--dark .om-item__proof-autor { color: rgba(255, 255, 255, 0.6); }

  /* Módulos un poco más anchos para que respiren */
  .om-stack__list { max-width: 860px; }

  @media (max-width: 700px) {
    .om-item,
    .om-item--dark { flex-direction: column; }
  }

  /* Recap */
  .om-recap {
    width: 100%;
    max-width: 640px;
    background: white;
    border: 2px solid var(--color-amber);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: 0 8px 40px rgba(245, 166, 35, 0.2);
  }

  .om-recap__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 24px;
    color: var(--color-heading);
    text-align: center;
  }

  .om-recap__list {
    display: flex;
    flex-direction: column;
  }

  .om-recap__list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px dashed rgba(43, 44, 100, 0.15);
    font-size: 14px;
    color: var(--color-heading);
    font-weight: 500;
  }

  .om-recap__val {
    color: var(--color-secondary);
    font-weight: 600;
    text-align: right;
    white-space: nowrap;
    font-size: 13px;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .om-recap__val s {
    color: var(--color-secondary);
    opacity: 0.7;
  }

  .om-recap__val strong {
    color: var(--color-green);
    font-weight: 700;
  }

  .om-recap__nombre {
    font-weight: 600;
  }

  /* Etiqueta de precio, como un cartel de tienda: el precio de antes chiquito
   * y tachado, el de hoy grande, y debajo la nota. Reemplazó al comparativo de
   * tres columnas (527 → 200 → 0), que se leía como una hoja de cálculo. */
  .om-precio {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
  }

  .om-precio__antes {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    line-height: 1;
    color: var(--color-secondary);
    text-decoration-thickness: 2px;
  }

  .om-precio__ahora {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(46px, 11vw, 64px);
    line-height: 1;
    color: var(--color-heading);
    letter-spacing: -0.02em;
  }

  .om-precio__nota {
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-amber);
    text-transform: uppercase;
  }

  /* Comparación: S/.240 → hoy S/.200 → S/.0 */
  .om-recap__compare {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
    text-align: center;
    padding: 6px 0;
  }

  .om-comp {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .om-comp__precio {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.1;
    color: var(--color-secondary);
  }

  .om-comp--hoy .om-comp__precio {
    font-size: 34px;
    color: var(--color-heading);
  }

  .om-comp--gratis .om-comp__precio {
    font-size: 34px;
    color: var(--color-green);
  }

  .om-comp__label {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-secondary);
  }

  .om-comp__flecha {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    color: var(--color-amber);
  }

  /* ════════════════ 4. CARTA ════════════════ */
  .om-carta-sec {
    background: #ffffff;
    padding: var(--section-py) 0;
  }

  .om-carta {
    position: relative;
    max-width: 640px;
    margin: 0 auto;
    background: var(--om-cream, #fffaf0);
    border: 1px solid rgba(43, 44, 100, 0.1);
    border-radius: 6px;
    padding: 48px 40px 40px;
    box-shadow: 0 2px 6px rgba(43, 44, 100, 0.06), 0 16px 40px rgba(43, 44, 100, 0.1);
    transform: rotate(-0.4deg);
    background-image: repeating-linear-gradient(
      transparent,
      transparent 31px,
      rgba(43, 44, 100, 0.05) 31px,
      rgba(43, 44, 100, 0.05) 32px
    );
  }

  /* "Cinta" que sostiene la carta */
  .om-carta__pin {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%) rotate(1.5deg);
    width: 110px;
    height: 26px;
    background: rgba(245, 166, 35, 0.35);
    border-left: 1px dashed rgba(43, 44, 100, 0.15);
    border-right: 1px dashed rgba(43, 44, 100, 0.15);
  }

  .om-carta__p {
    font-size: 16px;
    line-height: 2;
    color: var(--color-heading);
    margin-bottom: 18px;
  }

  .om-carta__firma {
    font-family: 'Caveat', cursive;
    font-weight: 600;
    font-size: 30px;
    color: var(--color-heading);
    margin-top: 28px;
    transform: rotate(-1.2deg);
  }

  /* ════════════════ 5. TESTIMONIOS ════════════════ */
  .om-testimonios {
    background: var(--bg-testimonials);
    padding: var(--section-py) 0;
  }

  .om-testimonios__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .om-test__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    width: 100%;
    max-width: 860px;
  }

  .om-test-card {
    background: white;
    border-radius: var(--radius-lg);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--card-shadow);
  }

  .om-test-card:last-child {
    grid-column: 1 / -1;
    max-width: 420px;
    justify-self: center;
    width: 100%;
  }

  .om-test-card__quote {
    opacity: 0.6;
  }

  .om-test-card__text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-heading);
    flex: 1;
  }

  .om-test-card__ctx {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-green);
  }

  .om-test-card__author {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }

  .om-test-card__name {
    font-weight: 700;
    font-size: 14px;
    color: var(--color-heading);
  }

  .om-test-card__detail {
    font-size: 12px;
    color: var(--color-secondary);
  }

  /* ════════════════ 6. GARANTÍA ════════════════ */
  .om-garantia {
    background: #ffffff;
    padding: var(--section-py) 0;
  }

  .om-garantia__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .om-garantia__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    width: 100%;
    max-width: 760px;
  }

  .om-g-card {
    background: #fafafe;
    border: 2px solid #c8c5d6;
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .om-g-card--amber {
    background: linear-gradient(135deg, #f7ecd4 0%, #f3f3f6 100%);
    border-color: var(--color-amber);
  }

  .om-g-card__icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: white;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--card-shadow);
  }

  .om-g-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    line-height: 1.3;
    color: var(--color-heading);
  }

  .om-g-card__desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-body);
  }

  /* ════════════════ 7. URGENCIA ════════════════ */
  .om-urgencia {
    background: var(--bg-hero);
    padding: var(--section-py) 0;
  }

  .om-urgencia__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 22px;
    max-width: 640px;
    margin: 0 auto;
  }

  .om-urgencia__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.2;
    color: var(--color-heading);
  }

  .om-urgencia__sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-body);
  }

  /* ════════════════ 8. FAQ ════════════════ */
  .om-faq {
    background: var(--bg-faq);
    padding: var(--section-py) 0;
  }

  .om-faq__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .om-faq__list {
    width: 100%;
    max-width: 760px;
    display: flex;
    flex-direction: column;
  }

  .om-faq-item {
    border-bottom: 1px solid rgba(43, 44, 100, 0.1);
  }

  .om-faq-q {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 4px;
    font-size: 16px;
    font-weight: 600;
    color: var(--color-heading);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: color 0.15s;
  }

  .om-faq-q:hover {
    color: var(--color-purple);
  }

  .om-faq-chevron {
    flex-shrink: 0;
    transition: transform 0.3s ease;
    color: var(--color-heading);
  }

  .om-faq-q[aria-expanded='true'] {
    color: var(--color-purple);
  }

  .om-faq-q[aria-expanded='true'] .om-faq-chevron {
    transform: rotate(180deg);
  }

  .om-faq-a p {
    padding: 0 4px 20px;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-body);
  }

  /* ════════════════ 9. CTA FINAL ════════════════ */
  .om-final {
    background: var(--bg-footer);
    padding: var(--section-py) 0;
  }

  .om-final__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    max-width: 640px;
    margin: 0 auto;
  }

  .om-final__mascot {
    width: 110px;
    height: 110px;
    object-fit: contain;
  }

  .om-final__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 34px;
    line-height: 1.15;
    color: white;
  }

  .om-final__sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-footer-text);
  }

  .om-final__cierre {
    font-size: 14px;
    line-height: 1.6;
    font-weight: 600;
    color: var(--color-footer-text);
  }

  .om-final__trust {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--color-footer-text);
    font-weight: 500;
  }

  /* ════════════════ RESPONSIVE ════════════════ */
  @media (max-width: 768px) {
    .om-sec-title {
      font-size: 26px;
    }

    .om-hero {
      padding: 32px 0 48px;
    }

    .om-hero__title {
      font-size: 28px;
    }

    .om-hero__sub {
      font-size: 15px;
    }

    .om-reto__pasos {
      grid-template-columns: 1fr;
    }

    .om-carta {
      padding: 40px 24px 32px;
    }

    .om-carta__p {
      font-size: 15px;
    }

    .om-item {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 24px 20px;
    }

    .om-item__body {
      align-items: center;
    }

    .om-item__tag,
    .om-item__valor {
      align-self: center;
    }

    .om-item__bullets li {
      text-align: left;
    }

    .om-recap {
      padding: 28px 20px;
    }

    .om-recap__list li {
      flex-direction: column;
      gap: 2px;
      align-items: flex-start;
    }

    .om-recap__val {
      white-space: normal;
      text-align: left;
    }

    .om-recap__compare {
      flex-direction: column;
      gap: 8px;
    }

    .om-comp__flecha {
      transform: rotate(90deg);
    }

    .om-test__grid {
      grid-template-columns: 1fr;
      max-width: 480px;
    }

    .om-test-card:last-child {
      grid-column: auto;
      max-width: none;
    }

    .om-garantia__cards {
      grid-template-columns: 1fr;
      max-width: 480px;
    }

    .om-urgencia__title {
      font-size: 24px;
    }

    .om-countdown--big .om-cd__unit {
      min-width: 58px;
      padding: 8px 10px;
    }

    .om-countdown--big .om-cd__num {
      font-size: 24px;
    }

    .om-final__title {
      font-size: 26px;
    }
  }

  @media (max-width: 390px) {
    .om-hero__title {
      font-size: 25px;
    }

    .om-cd__unit {
      min-width: 50px;
      padding: 6px 8px;
    }
  }

  /* ══════════════════════════════════════════════════════════════
     TEMA OSCURO + ESTRUCTURA $100M (rediseño jul-2026)
     Va al final para ganarle a las reglas de arriba.
     ══════════════════════════════════════════════════════════════ */
  .om { background: #16173a; }

  /* ── HERO oscuro, 2 columnas (teléfono + contenido) ── */
  /* ── HERO claro (nada de azul aquí), 2 columnas ── */
  .om-hero { padding: 56px 0 64px; }
  .om-hero__inner {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) 1.1fr;
    gap: 56px;
    align-items: center;
    text-align: left;
    max-width: 1060px;
  }
  /* El teléfono es decorativo (loop automático de chat). pointer-events:none
     evita que su chat interno atrape el scroll táctil en móvil: así el dedo
     scrollea la página, no el mock. El auto-scroll del chat (por JS) sigue. */
  .om-hero__phone { display: flex; justify-content: center; pointer-events: none; }

  /* Grabación del webinar (reemplaza el teléfono en /fiestas-patrias) */
  .om-hero__video {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
    max-width: 520px;
    pointer-events: auto;
  }
  .om-hero__video-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1.5px solid rgba(43, 44, 100, 0.12);
    border-radius: var(--radius-pill);
    padding: 6px 15px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-heading);
    box-shadow: 0 2px 12px rgba(43, 44, 100, 0.08);
  }
  .om-hero__video-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e04545;
    box-shadow: 0 0 0 3px rgba(224, 69, 69, 0.2);
    animation: om-pulse 1.8s ease-in-out infinite;
  }
  .om-hero__video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    border: 3px solid #fff;
  }
  .om-hero__video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .om-hero__video-nota {
    font-size: 12.5px;
    font-weight: 500;
    color: var(--color-secondary);
    text-align: center;
  }

  /* ════════════════ HERO DE LA PABLO PROMO ════════════════
     Dos columnas: el loop de Pablo rotando entre las 6 cosas que entran, y al
     costado la oferta (titular · lista · precio · CTA · reloj). El ítem del
     stack que está en pantalla se enciende en dorado: el dorado se usa SOLO
     para eso, el precio y el botón, así dirige el ojo en vez de decorar. */
  .om-hero--promo {
    padding: 26px 0 30px;
  }

  /* Reparto del boceto de Rodrigo (27-jul): cabecera centrada a lo ancho,
     debajo el carrusel a la izquierda con la lista + precio a la derecha, y
     el CTA con el countdown centrados al final. */
  .om-hero__promo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .om-hero__cabecera {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }

  .om-hero__split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    align-items: center;
    gap: 44px;
    width: 100%;
    max-width: 980px;
  }

  .om-hero__derecha {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  /* Pill dorado (pedido de Rodrigo 27-jul): el nombre de la campaña dentro de
     un contenedor amarillo con letras blancas, para que se lea como sello de
     evento y no como una línea más. */
  .om-hero__eyebrow {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffffff;
    background: linear-gradient(135deg, #f2b84b, #e59b23);
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    box-shadow: 0 2px 8px rgba(229, 155, 35, 0.35);
  }

  /* Titular ancho (pedido 28-jul): el reparto de líneas en desktop lo fija el
     <br class="om-salto-desktop"> del markup — fila 1 hasta "WhatsApp.", fila
     2 la oración entera — así que el tope de fuente está calibrado para que
     la fila 2 (la más larga) entre sin partirse. Va anidado bajo
     .om-hero--promo porque más abajo hay un `.om-hero__title` suelto (el del
     hero viejo) que si no le gana por orden de documento. */
  .om-hero--promo .om-hero__title--promo {
    font-size: clamp(26px, 3.1vw, 38px);
    line-height: 1.14;
    text-align: center;
    max-width: none;
    margin-inline: auto;
    text-wrap: balance;
  }

  /* El resaltador global es beige tímido; acá el "30 días" y el "gratis" van
     en el amarillo de la campaña (pedido 28-jul). */
  .om-hero__title--promo .highlight::after {
    background: rgba(242, 184, 75, 0.45);
    height: 44%;
  }

  .om-hero--promo .om-hero__kicker {
    text-align: center;
    max-width: none;
    font-size: clamp(14.5px, 1.3vw, 18.5px);
    line-height: 1.55;
    text-wrap: balance;
  }

  /* ── El carrusel vertical ── */
  .om-loop {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  /* La ventana es una tarjeta: los visuales de los bonos traen su propio fondo
     lila y los de Pablo son transparentes; el degradado de la tarjeta (del
     mismo tono que ese fondo) hace que los 7 se lean como una sola pieza. */
  .om-loop__ventana {
    position: relative;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 26px;
    background: linear-gradient(165deg, #f6f3fd 0%, #eae5f8 100%);
    border: 1px solid rgba(122, 79, 171, 0.12);
    box-shadow: 0 18px 40px -18px rgba(76, 46, 133, 0.28);
  }

  .om-loop__track {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* La curva frena suave al llegar: se siente carrusel, no salto. */
    transition: transform 0.55s cubic-bezier(0.32, 0, 0.15, 1);
    will-change: transform;
  }

  .om-loop__slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .om-loop__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Pablo solo (primer slide, transparente) respira mejor con un poco de aire. */
  .om-loop__slide:first-child .om-loop__img {
    padding: 26px;
  }

  /* Chip dorado con el nombre del beneficio, dentro del slide: viaja pegado a
     su imagen, así nunca se ve la foto de una cosa con el nombre de otra. */
  .om-loop__chip {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    line-height: 1.3;
    text-align: center;
    white-space: nowrap;
    color: #7a4f00;
    background: rgba(253, 241, 216, 0.94);
    border: 1px solid #f5d99a;
    border-radius: var(--radius-pill);
    padding: 7px 16px;
    max-width: calc(100% - 28px);
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 4px 12px rgba(76, 46, 133, 0.12);
  }

  /* Puntitos de progreso del carrusel, en columna sobre el borde derecho. */
  .om-loop__dots {
    position: absolute;
    top: 50%;
    right: 12px;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .om-loop__dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: rgba(122, 79, 171, 0.22);
    transition: height 0.3s ease, background 0.3s ease;
  }

  .om-loop__dot.is-active {
    height: 20px;
    background: linear-gradient(180deg, #f2b84b, #e59b23);
  }

  /* ── El paquete: las 6 cosas en UNA sola tarjeta (pedido de Rodrigo 28-jul),
     con el Plan Anual resaltado y su precio al lado; los bonos dicen Gratis.
     La fila que está en el carrusel se enciende en dorado. ── */
  .om-paquete {
    width: 100%;
    background: #ffffff;
    border: 1.5px solid #f0d9a8;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 24px -12px rgba(76, 46, 133, 0.18);
  }

  /* Cada fila entra en UNA sola línea (pedido 28-jul): nombres cortos en los
     datos + nowrap acá + tamaños fluidos para los anchos apretados. Es un
     <a> que baja a la sección de ese bono, con su hover propio. */
  .om-paquete__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 16px;
    font-size: clamp(12.5px, 0.35vw + 10px, 14px);
    line-height: 1.35;
    color: var(--color-heading);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.3s ease;
  }

  .om-paquete__fila:hover {
    background: #fdf6e7;
  }

  .om-paquete__fila:hover .om-paquete__nombre {
    transform: translateX(3px);
  }

  .om-paquete__fila:hover .om-paquete__icono {
    transform: scale(1.15);
  }

  .om-paquete__fila + .om-paquete__fila {
    border-top: 1px solid #f6ecd4;
  }

  .om-paquete__fila.is-active {
    background: #fdf6e7;
  }

  /* El Plan Anual es lo que se compra: fila más alta, en negrita y con fondo
     dorado suave permanente. */
  .om-paquete__fila--principal {
    padding: 14px 16px;
    font-size: clamp(13.5px, 0.4vw + 10.5px, 15.5px);
    font-weight: 700;
    background: linear-gradient(135deg, #fdf3dd, #fbeecd);
  }

  .om-paquete__fila--principal.is-active,
  .om-paquete__fila--principal:hover {
    background: linear-gradient(135deg, #fdf0d2, #fae7ba);
  }

  .om-paquete__nombre {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    transition: transform 0.2s ease;
  }

  .om-paquete__icono {
    flex-shrink: 0;
    color: #b98a1e;
    transition: transform 0.2s ease;
  }

  .om-paquete__valor {
    display: flex;
    align-items: baseline;
    gap: 7px;
    flex-shrink: 0;
  }

  .om-paquete__antes {
    font-size: clamp(10.5px, 0.25vw + 9px, 12px);
    font-weight: 600;
    color: var(--color-secondary);
    text-decoration-thickness: 1.5px;
  }

  .om-paquete__ahora {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(16px, 0.5vw + 13px, 19px);
    color: var(--color-heading);
  }

  .om-paquete__ahora--bono {
    font-size: clamp(11px, 0.3vw + 9px, 13px);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #1f9d55;
  }

  /* Escudo de la garantía (pedido de Rodrigo 27-jul) */
  .om-escudo {
    flex-shrink: 0;
    color: #b98a1e;
    margin-right: -4px;
  }

  /* CTA pegado al paquete, a todo el ancho de la columna y en UNA sola fila:
     tamaño fluido y tracking más corto para que el texto nunca se parta. La
     flecha se desliza un poco al pasar el mouse. */
  .om-hero--promo .om-hero__cta {
    width: 100%;
    max-width: none;
    white-space: nowrap;
    font-size: clamp(11px, 1.05vw, 14px);
    letter-spacing: 0.04em;
    padding: 15px 14px;
  }

  .om-cta__flecha {
    display: inline-block;
    margin-left: 8px;
    transition: transform 0.25s ease;
  }

  .om-hero__cta:hover .om-cta__flecha {
    transform: translateX(5px);
  }

  .om-hero--promo .om-hero__cierre {
    align-items: center;
    width: 100%;
  }

  .om-hero--promo .om-hero__deadline {
    text-align: center;
  }

  /* Los destinos de las anclas del paquete respiran al llegar por scroll. */
  .om-quees,
  .om-bono2 {
    scroll-margin-top: 28px;
  }

  /* Frasecita chica con escudo bajo el countdown */
  .om-hero__garantia-mini {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-body);
    margin: 0;
  }

  .om-hero__garantia-mini .om-escudo {
    margin-right: 0;
  }

  /* ── Móvil (<760px; de ahí para arriba ya entra el reparto en dos
     columnas): una columna, el carrusel arriba y todo centrado ── */
  @media (max-width: 760px) {
    .om-hero--promo {
      padding: 14px 0 24px;
    }

    .om-hero__promo {
      gap: 12px;
    }

    .om-hero__cabecera {
      gap: 8px;
    }

    /* El reparto vuelve a una sola columna: carrusel arriba, lista debajo. */
    .om-hero__split {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 12px;
    }

    .om-hero__derecha {
      align-items: center;
      gap: 8px;
    }

    .om-loop__ventana {
      max-width: min(150px, 40vw);
      border-radius: 18px;
    }

    /* El chip y los puntitos salen en móvil: en 150px no se leen, y el ítem
       encendido de la lista ya dice qué está en pantalla. */
    .om-loop__chip,
    .om-loop__dots {
      display: none;
    }

    .om-loop__slide:first-child .om-loop__img {
      padding: 12px;
    }

    /* Sin tope de caracteres en móvil (el ancho de pantalla ya lo parte) y un
       punto más chico: el headline largo del 28-jul ocupaba 4 líneas y empujaba
       el botón bajo el pliegue. El salto fijo de desktop desaparece: acá el
       texto fluye solo. */
    .om-hero--promo .om-hero__title--promo {
      font-size: clamp(21px, 5.6vw, 27px);
      max-width: none;
    }

    .om-salto-desktop {
      display: none;
    }

    /* El kicker se queda en móvil aunque apriete: es lo único arriba del
       pliegue que dice que Pablo vive en WhatsApp, y la mitad de la gente que
       llega del correo no sabe qué es Pablo. */
    .om-hero--promo .om-hero__kicker {
      font-size: 13.5px;
    }

    /* El paquete se aprieta en móvil: filas más bajas y letra más chica, para
       que las 6 quepan EN UNA LÍNEA y el botón no caiga bajo el pliegue. El
       "— 12 meses" del título se esconde: es lo único que no entra. */
    .om-hero__derecha {
      width: 100%;
    }

    .om-paquete__fila {
      padding: 8px 12px;
      font-size: 12.5px;
      gap: 8px;
    }

    .om-paquete__fila--principal {
      padding: 11px 12px;
      font-size: 13.5px;
    }

    .om-paquete__sufijo {
      display: none;
    }

    .om-paquete__nombre {
      gap: 6px;
    }

    .om-paquete__icono {
      width: 13px;
      height: 13px;
    }

    .om-paquete__ahora {
      font-size: 16px;
    }

    .om-paquete__ahora--bono {
      font-size: 11px;
    }

    .om-paquete__antes {
      font-size: 11px;
    }

    /* El CTA también en una sola fila en móvil. */
    .om-hero--promo .om-hero__cta {
      font-size: clamp(10px, 3.1vw, 12.5px);
      letter-spacing: 0.02em;
      padding: 13px 10px;
    }

    .om-cta__flecha {
      margin-left: 6px;
    }
  }

  /* Pantallas cortas de verdad (iPhone SE y similares): acá sí sobra el kicker,
     porque si no el botón cae bajo el pliegue. */
  @media (max-width: 760px) and (max-height: 700px) {
    .om-hero--promo .om-hero__kicker {
      display: none;
    }

    .om-loop__ventana {
      max-width: min(120px, 34vw);
    }
  }

  /* ════════════════ HERO VSL: TODO EN LA PRIMERA PANTALLA ════════════════
     Orden fijo: título del taller → video → CTA → countdown/cierre. La altura
     del video se calcula contra el viewport (svh) para que el CTA y el
     countdown NUNCA queden bajo el pliegue, en desktop y en móvil. */
  .om-hero--vsl {
    /* El bloque ocupa EXACTAMENTE lo que queda de la primera pantalla después
       del banner y el header (--om-chrome lo mide el JS al cargar y al
       redimensionar; 118px = 46 + 72 es el valor de arranque). El video absorbe
       el espacio libre, así el CTA y el countdown nunca caen bajo el pliegue. */
    height: calc(100svh - var(--om-chrome, 118px));
    min-height: 520px;
    display: flex;
    align-items: stretch;
    padding: 14px 0 18px;
  }

  .om-hero__vsl {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: clamp(10px, 1.9svh, 20px);
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
    min-height: 0;
  }

  .om-hero__titulo-wrap {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* Nombre del taller: el título más grande de la página, arriba del video. */
  .om-hero__title--taller {
    font-size: clamp(28px, 5.2vw, 52px);
    line-height: 1.06;
    letter-spacing: -0.015em;
    text-align: center;
  }

  .om-hero__kicker {
    font-size: clamp(14px, 1.6vw, 18px);
    line-height: 1.45;
    color: var(--color-body);
    font-weight: 500;
    max-width: 560px;
    margin: 0 auto;
  }

  /* El video es el elemento elástico: se queda con el espacio que sobra
     después del título, el CTA y el countdown. Su ancho se deriva de esa
     altura (16:9), así que crece en pantallas altas y encoge en las bajitas
     sin empujar nada fuera del pliegue. */
  .om-hero__vsl .om-hero__video {
    flex: 1 1 auto;
    min-height: 140px;
    max-width: none;
    width: 100%;
    gap: 0;
    justify-content: center;
  }

  .om-hero__vsl .om-hero__video-frame {
    height: 100%;
    width: auto;
    max-width: min(100%, 720px);
    aspect-ratio: 16 / 9;
    margin: 0 auto;
  }

  /* Móvil vertical: ahí el ancho es el límite, no la altura. El video pasa a
     ocupar todo el ancho (un 16:9 así es bajito y entra de sobra). */
  @media (max-aspect-ratio: 4 / 5) {
    .om-hero__vsl .om-hero__video { flex: 0 0 auto; }
    .om-hero__vsl .om-hero__video-frame {
      width: 100%;
      height: auto;
    }
  }

  /* 480px = el copy del CTA entra en una sola línea */
  .om-hero__cta {
    max-width: 480px;
    padding: 14px 24px;
  }

  .om-hero__cierre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .om-countdown--hero .om-cd__unit {
    min-width: 50px;
    padding: 5px 10px;
  }
  .om-countdown--hero .om-cd__num { font-size: 19px; }

  .om-hero__deadline {
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.45;
    color: var(--color-secondary);
    /* Ancho suficiente para que quepa en una línea en desktop y no deje
       "meses." solo en la segunda. */
    max-width: 560px;
  }

  /* Tres micro-pruebas de riesgo cero, en una línea */
  .om-hero__trust-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px 14px;
    list-style: none;
  }
  .om-hero__trust-row li {
    position: relative;
    padding-left: 15px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-heading);
    opacity: 0.72;
    white-space: nowrap;
  }
  .om-hero__trust-row li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 8px;
    height: 4px;
    border-left: 2px solid var(--color-green);
    border-bottom: 2px solid var(--color-green);
    transform: translateY(-70%) rotate(-45deg);
  }

  /* El resaltador del hero: en un título de 52px el trazo por defecto (40%)
     queda como una banda gruesa. Se sube y se adelgaza para que se lea como
     un plumón sobre la línea base, no como un bloque detrás del texto. */
  .om-hero__title--taller .highlight::after {
    bottom: 5px;
    height: 26%;
  }

  .om-hero__scroll {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
    opacity: 0.75;
    animation: om-bob 2.4s ease-in-out infinite;
  }

  @keyframes om-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  /* Pantallas bajitas (laptops 13"): recorta lo opcional, nunca el CTA. */
  @media (max-height: 700px) {
    .om-hero__title--taller { font-size: clamp(24px, 4vw, 34px); }
    .om-hero__kicker { font-size: 13px; }
    .om-hero__scroll { display: none; }
    .om-countdown--hero .om-cd__unit { min-width: 44px; padding: 4px 8px; }
    .om-countdown--hero .om-cd__num { font-size: 17px; }
  }

  /* Móviles chicos (360×640 y parecidos): el video puede encoger más y el
     texto de apoyo baja un punto, para que la fila de garantías siga entrando
     en la primera pantalla. */
  @media (max-height: 680px) {
    .om-hero--vsl { min-height: 0; padding: 10px 0 14px; }
    .om-hero__vsl { gap: 8px; }
    .om-hero__vsl .om-hero__video { min-height: 104px; }
    .om-hero__kicker { font-size: 12.5px; }
    .om-hero__deadline { font-size: 11.5px; }
    .om-hero__trust-row { gap: 4px 10px; }
    .om-hero__trust-row li { font-size: 10.5px; }
    .om-hero__cta { padding: 12px 20px; font-size: 14px; }
  }
  .om-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 560px;
  }
  .om-hero__title {
    text-align: left;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.14;
  }

  /* Cajita resumen del hero (clara) */
  .om-hero__resumen {
    width: 100%;
    background: #fff;
    border: 1.5px solid #e6e3f2;
    border-radius: var(--radius-md);
    padding: 18px 20px;
    box-shadow: var(--card-shadow);
  }
  .om-hero__resumen-title {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-heading);
    font-size: 14px;
    margin-bottom: 10px;
  }
  .om-hero__resumen-list { display: flex; flex-direction: column; gap: 8px; }
  .om-hero__resumen-list li {
    position: relative;
    padding-left: 24px;
    font-size: 14px;
    color: var(--color-body);
    line-height: 1.4;
  }
  .om-hero__resumen-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-green);
    font-weight: 800;
  }
  .om-hero__resumen-list li[data-noche] { color: #875a00; font-weight: 600; }
  .om-hero__resumen-list li[data-noche]::before { content: "★"; color: var(--color-amber); }

  /* ── Banda de prueba social (navy, entre el precio y los bonos) ── */
  .om-social { background: #20214a; padding: 56px 0 64px; }
  .om-social__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }
  .om-social__label {
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #7BE495;
  }
  .om-social__pills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    width: 100%;
    max-width: 1040px;
  }
  .om-social__pill {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 20px 22px;
  }
  .om-social__quote {
    font-size: 14.5px;
    line-height: 1.6;
    color: #fff;
    font-style: italic;
    flex: 1;
  }
  .om-social__autor {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-amber);
  }
  .om-social__autor span { font-weight: 500; color: rgba(255, 255, 255, 0.6); }

  /* ════════════════ SEGUNDA PANTALLA: TODO LO QUE INCLUYE ════════════════
     Un inventario donde cada bono es visiblemente SU bono: tarjeta propia,
     número grande, tag "Bono N de 5" y su precio real → precio de hoy. */
  .om-incluye {
    background: var(--bg-how);
    padding: clamp(48px, 7vh, 80px) 0;
  }

  .om-incluye__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .om-incluye__eyebrow {
    font-size: 11.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-amber);
  }

  .om-incluye__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(272px, 1fr));
    gap: 18px;
    width: 100%;
    max-width: 1080px;
  }

  .om-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fff;
    border: 1.5px solid #e5e3f0;
    border-radius: var(--radius-lg);
    padding: 20px 22px 22px;
    box-shadow: var(--card-shadow);
    overflow: hidden;
    transition: box-shadow 0.25s, transform 0.25s;
  }

  .om-card:hover {
    box-shadow: var(--card-shadow-hover);
    transform: translateY(-3px);
  }

  /* El principal (Plan Anual) manda: borde ámbar y una franja arriba. */
  .om-card--principal {
    border-color: var(--color-amber);
    box-shadow: 0 10px 32px rgba(245, 166, 35, 0.16);
  }
  .om-card--principal::before,
  .om-card--noche::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--gradient-cta);
  }
  .om-card--noche { border-color: #f5c970; background: #fffdf7; }

  .om-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .om-card__tag {
    background: #eeedf5;
    color: var(--color-heading);
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
  }
  .om-card__tag--principal { background: var(--gradient-cta); color: #2b2c64; }
  .om-card__tag--fire { background: #fde9c4; color: #875a00; }

  /* Número grande: marca que cada tarjeta es un bono distinto. */
  .om-card__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 34px;
    line-height: 1;
    color: rgba(43, 44, 100, 0.12);
    flex-shrink: 0;
  }

  .om-card__media {
    display: flex;
    justify-content: center;
    padding: 4px 0;
  }
  .om-card__media img {
    width: 88px;
    height: 88px;
    object-fit: contain;
    filter: drop-shadow(0 10px 22px rgba(43, 44, 100, 0.18));
  }

  .om-card__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.25;
    color: var(--color-heading);
  }

  .om-card__desc {
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--color-body);
    flex: 1;
  }

  /* Precio: valor real tachado → lo que pagas hoy */
  .om-card__precio {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
    padding-top: 14px;
    border-top: 1.5px dashed #e5e3f0;
  }

  .om-card__real,
  .om-card__hoy {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .om-card__real-label,
  .om-card__hoy-label {
    font-size: 9.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
  }

  .om-card__real s {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 18px;
    color: var(--color-secondary);
  }
  .om-card__real--vacio { text-decoration: none !important; }

  .om-card__hoy strong {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
    color: #2a7a52;
  }

  .om-card__flecha {
    color: var(--color-amber);
    font-weight: 800;
    font-size: 16px;
  }

  .om-incluye__total {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    width: 100%;
    max-width: 780px;
    background: #fff;
    border: 1.5px solid #e5e3f0;
    border-radius: var(--radius-lg);
    padding: 22px 24px;
    box-shadow: var(--card-shadow);
  }

  @media (max-width: 560px) {
    .om-card__media img { width: 68px; height: 68px; }
    .om-incluye__grid { gap: 14px; }
  }

  /* ════════════════ BARRA FIJA DE CTA ════════════════ */
  .om-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: rgba(27, 28, 64, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.22);
    padding: 10px 0 calc(10px + env(safe-area-inset-bottom));
    transform: translateY(110%);
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .om-sticky.is-visible { transform: none; }

  .om-sticky__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
  }
  .om-sticky__precio { display: flex; flex-direction: column; gap: 1px; }
  .om-sticky__tachado {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: line-through;
    white-space: nowrap;
  }
  .om-sticky__monto {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.1;
    color: #fff;
    white-space: nowrap;
  }
  .om-sticky__monto span {
    font-family: var(--font-body);
    font-size: 11.5px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.6);
  }
  .om-sticky__cd { margin-right: auto; }
  .om-sticky__cta {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 26px;
    border-radius: 14px;
    background: var(--gradient-cta);
    color: #2b2c64;
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    box-shadow: 0 3px 0 0 #c9820a;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .om-sticky__cta:hover { transform: translateY(-1px); box-shadow: 0 4px 0 0 #c9820a; }
  .om-sticky__cta:active { transform: translateY(2px); box-shadow: 0 1px 0 0 #c9820a; }

  @media (max-width: 560px) {
    .om-sticky__inner { gap: 12px; }
    .om-sticky__cd { display: none; }
    .om-sticky__precio { margin-right: auto; }
    .om-sticky__cta { padding: 12px 18px; font-size: 13px; }
  }

  /* ── BONOS: cada uno a pantalla completa; ALTERNAN blanco / navy ── */
  .om-bono {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: center;
    padding: 72px 0;
    background: #fff;               /* claro por defecto */
    overflow: hidden;
  }

  /* Número gigante de fondo: refuerza que estás en el bono N, no en un bloque
     más de texto corrido. */
  .om-bono__watermark {
    position: absolute;
    top: 50%;
    right: 3vw;
    transform: translateY(-50%);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(180px, 34vw, 420px);
    line-height: 0.8;
    color: rgba(43, 44, 100, 0.045);
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .om-bono--flip .om-bono__watermark,
  .om-bono--noche .om-bono__watermark {
    color: rgba(255, 255, 255, 0.055);
    right: auto;
    left: 3vw;
  }
  .om-bono--flip { background: #1b1c40; }   /* oscuro */
  .om-bono--noche {
    background: linear-gradient(135deg, #3a2c0e 0%, #20214a 65%);
  }
  .om-bono__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: center;
    max-width: 1080px;
  }
  .om-bono--flip .om-bono__media { order: 2; }
  .om-bono__media { display: flex; justify-content: center; }
  .om-bono__media img {
    width: min(320px, 72vw);
    height: auto;
    filter: drop-shadow(0 20px 44px rgba(43, 44, 100, 0.25));
  }
  .om-bono--flip .om-bono__media img,
  .om-bono--noche .om-bono__media img {
    filter: drop-shadow(0 24px 48px rgba(0, 0, 0, 0.45));
  }
  .om-bono__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 560px;
  }
  /* Tag: claro por defecto, blanco translúcido en secciones oscuras */
  .om-bono__tag {
    background: #eeedf5;
    color: var(--color-heading);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
  }
  .om-bono--flip .om-bono__tag,
  .om-bono--noche .om-bono__tag {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .om-bono__tag--fire { background: var(--gradient-cta); color: #2b2c64; }
  .om-bono__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.15;
    color: var(--color-heading);
  }
  .om-bono--flip .om-bono__title,
  .om-bono--noche .om-bono__title { color: #fff; }
  /* Valor del bono en tarjeta: "Valor real S/.X → Hoy: gratis". Cada bono
     lleva su propio precio, así se lee como un producto aparte. */
  .om-bono__valor {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    background: #f7f5fd;
    border: 1.5px solid #e5e3f0;
    border-radius: var(--radius-md);
    padding: 12px 18px;
  }
  .om-bono--flip .om-bono__valor,
  .om-bono--noche .om-bono__valor {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.14);
  }
  .om-bono__valor-col { display: flex; flex-direction: column; gap: 2px; }
  .om-bono__valor-label {
    font-size: 9.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary);
  }
  .om-bono--flip .om-bono__valor-label,
  .om-bono--noche .om-bono__valor-label { color: rgba(255, 255, 255, 0.55); }
  .om-bono__valor-flecha {
    color: var(--color-amber);
    font-weight: 800;
    font-size: 18px;
  }
  .om-bono__tachado {
    color: var(--color-secondary);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    text-decoration: line-through;
  }
  .om-bono--flip .om-bono__tachado,
  .om-bono--noche .om-bono__tachado { color: rgba(255, 255, 255, 0.5); }
  .om-bono__incluido {
    background: #e7f7ea;
    color: #2a7a52;
    border: 1px solid #bfe6c9;
    font-weight: 700;
    font-size: 13px;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .om-bono__desc {
    font-size: clamp(15px, 2vw, 18px);
    line-height: 1.6;
    color: var(--color-body);
  }
  .om-bono--flip .om-bono__desc,
  .om-bono--noche .om-bono__desc { color: rgba(255, 255, 255, 0.85); }
  .om-bono__bullets { display: flex; flex-direction: column; gap: 10px; }
  .om-bono__bullets li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 15px;
    color: var(--color-body);
    line-height: 1.5;
  }
  .om-bono--flip .om-bono__bullets li,
  .om-bono--noche .om-bono__bullets li { color: rgba(255, 255, 255, 0.85); }
  .om-bono--flip .om-bono__bullets .om-check,
  .om-bono--noche .om-bono__bullets .om-check { stroke: #7BE495; }
  .om-bono__proof {
    border-left: 3px solid var(--color-amber);
    background: #faf7ff;
    border-radius: 0 12px 12px 0;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .om-bono--flip .om-bono__proof,
  .om-bono--noche .om-bono__proof { background: rgba(255, 255, 255, 0.06); }
  .om-bono__proof-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-green);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .om-bono--flip .om-bono__proof-label,
  .om-bono--noche .om-bono__proof-label { color: #7BE495; }
  .om-bono__proof-quote { font-size: 14px; font-style: italic; color: var(--color-heading); line-height: 1.5; }
  .om-bono--flip .om-bono__proof-quote,
  .om-bono--noche .om-bono__proof-quote { color: #fff; }
  .om-bono__proof-autor { font-size: 12px; color: var(--color-secondary); }
  .om-bono--flip .om-bono__proof-autor,
  .om-bono--noche .om-bono__proof-autor { color: rgba(255, 255, 255, 0.6); }
  .om-bono__cta { align-self: flex-start; margin-top: 6px; }

  /* ── Resumen (claro) ── */
  .om-resumen { background: var(--bg-how); padding: var(--section-py) 0; }
  .om-resumen .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .om-resumen .om-sec-header { margin-bottom: 0; }
  .om-resumen .om-sec-title { color: var(--color-heading); }
  .om-resumen .om-sec-sub { color: var(--color-body); }
  .om-recap { margin: 0 auto; }

  /* ── Testimonios (claro, como en la landing) ── */
  .om-testimonios { background: var(--bg-testimonials); }
  .om-testimonios .om-sec-title { color: var(--color-heading); }
  .om-testimonios .om-sec-sub { color: var(--color-body); }

  /* ── Carta (tarjeta limpia sobre fondo claro) ── */
  .om-carta-sec { background: var(--bg-page); padding: var(--section-py) 0; }
  .om-carta {
    position: relative;
    background: #fff;
    background-image: none;
    border-radius: var(--radius-lg);
    padding: clamp(28px, 5vw, 56px);
    max-width: 720px;
    margin: 0 auto;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }
  .om-carta__quote {
    position: absolute;
    top: 20px;
    right: 28px;
    font-family: var(--font-heading);
    font-size: 88px;
    line-height: 0.6;
    color: #F1EEE4;
    pointer-events: none;
    z-index: 0;
  }
  .om-carta__titulo {
    position: relative;
    z-index: 1;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(26px, 4vw, 40px);
    color: var(--color-heading);
    line-height: 1.12;
    margin-bottom: 22px;
    max-width: 82%;
  }
  .om-carta__p {
    font-size: 16px;
    line-height: 1.75;
    color: #3a3a5c;
    margin-bottom: 16px;
  }
  .om-carta__firma {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 26px;
    color: var(--color-amber);
    margin-top: 24px;
  }
  .om-carta__firma-sub {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-heading);
  }

  /* ── Transiciones de color SUAVES entre secciones: cada sección sube un poco
     y se redondea arriba, así el corte no es una línea recta sino un borde
     redondeado sobre la sección anterior. ── */
  .om-social,
  .om-bono,
  .om-resumen,
  .om-testimonios,
  .om-carta-sec,
  .om-final {
    position: relative;
    border-top-left-radius: 44px;
    border-top-right-radius: 44px;
    margin-top: -40px;
  }

  @media (max-width: 820px) {
    .om-hero__inner,
    .om-bono__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 32px;
    }
    .om-hero__content,
    .om-bono__body {
      align-items: center;
      text-align: center;
      max-width: 100%;
    }
    /* Móvil: la OFERTA primero (contenido), el teléfono debajo y más chico —
       así la oferta se ve sin tener que scrollear. */
    .om-hero__content { order: 1; }
    .om-hero__phone { order: 2; }
    .om-hero__phone .hphone { --w: 280px; }
    .om-hero { padding: 32px 0 48px; }
    .om-bono { min-height: 0; padding: 56px 0; }
    .om-bono--flip .om-bono__media { order: 0; }
    .om-hero__content .om-cta,
    .om-bono__cta { align-self: center; }
    .om-hero__resumen-list li,
    .om-bono__bullets li { text-align: left; }
    .om-carta__titulo { max-width: 100%; }
    .om-carta__quote { font-size: 60px; top: 10px; right: 16px; }
    /* En móvil las secciones suben menos para no comerse contenido */
    .om-social,
    .om-bono,
    .om-resumen,
    .om-testimonios,
    .om-carta-sec,
    .om-final {
      border-top-left-radius: 32px;
      border-top-right-radius: 32px;
      margin-top: -28px;
    }
  }


  /* ── Downsell mensual (secundario, no compite con el anual) ── */
  .om-downsell { background: var(--bg-page); padding: 44px 0 72px; }
  .om-downsell__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .om-downsell__lead {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-secondary);
    text-align: center;
  }
  .om-downsell__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    max-width: 720px;
    background: #fff;
    border: 1.5px solid #e6e3f2;
    border-radius: var(--radius-lg);
    padding: 22px 26px;
    box-shadow: var(--card-shadow);
  }
  .om-downsell__texto { display: flex; flex-direction: column; gap: 4px; }
  .om-downsell__titulo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 17px;
    color: var(--color-heading);
  }
  .om-downsell__precio { font-size: 14px; font-weight: 600; color: var(--color-heading); }
  .om-downsell__nota { font-size: 13px; color: var(--color-secondary); line-height: 1.5; }
  .om-downsell__nota strong { color: var(--color-body); }
  .om-downsell__btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-heading);
    color: var(--color-heading);
    font-weight: 700;
    font-size: 14px;
    background: transparent;
    transition: background 0.15s, color 0.15s;
    white-space: nowrap;
  }
  .om-downsell__btn:hover { background: var(--color-heading); color: #fff; }

  @media (max-width: 640px) {
    .om-downsell__card {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      padding: 22px 20px;
    }
    .om-downsell__texto { align-items: center; }
    .om-downsell__btn { width: 100%; }
  }
  /* ════════════════ UI v2 (27-jul, pedido de Rodrigo) ════════════════
     Va al final del <style> a propósito: a igual especificidad, la última
     regla gana, así este bloque re-pinta secciones ya definidas arriba sin
     tocar sus reglas base. Tres ideas: (1) transiciones de color en degradé
     entre secciones, nada de cortes; (2) bonos en hojas claras alternadas con
     fichas numeradas, no checks; (3) el carrusel de testimonios sube. */

  /* ── Línea que presenta el stack del hero ── */
  .om-hero__stack-lead {
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-body);
    max-width: 46ch;
  }

  .om-hero__stack-lead strong {
    color: #b98a1e;
  }

  @media (max-width: 900px) {
    .om-hero__stack-lead {
      font-size: 12.5px;
      text-align: center;
    }
  }

  /* ── Firma del cierre (la de todos sus correos) ── */
  .om-final__firma {
    margin-top: 14px;
    font-family: 'Caveat', cursive;
    font-size: 22px;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ── Carrusel arriba ── */
  .om-carrusel {
    padding: 34px 0 6px;
  }

  .om-carrusel__label {
    text-align: center;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: 4px;
  }

  /* ── Fichas de bono (reemplazan la lista de checks) ── */
  .om-bono__fichas {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .om-bono__ficha {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: #ffffff;
    border: 1px solid #e9e4f6;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-heading);
    box-shadow: 0 1px 4px rgba(43, 44, 100, 0.05);
  }

  .om-bono__ficha-num {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fdf1d8;
    border: 1px solid #f0d9a8;
    color: #7a4f00;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 12px;
  }

  @media (max-width: 620px) {
    .om-bono__fichas {
      grid-template-columns: 1fr;
      gap: 7px;
    }
  }

  /* ── Bonos: hojas claras alternadas (adiós al bloque navy con checks) ── */
  .om-bono {
    min-height: 0;
    padding: clamp(56px, 9vh, 88px) 0;
  }

  .om-bono--alt {
    background: var(--bg-hero);
  }

  .om-bono--alt .om-bono__media {
    order: 2;
  }

  .om-bono__media video,
  .om-bono__media img {
    width: 100%;
    max-width: 480px;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 10px 34px rgba(43, 44, 100, 0.12);
  }

  /* ── CTA después de la carta ── */
  .om-carta__cta-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 34px;
  }

  .om-carta__cta-trust {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-secondary);
  }

  /* ════════════════ UI v3 (27-jul, segunda ronda de Rodrigo) ════════════════ */

  /* ── Bonos v2: tarjetas rectangulares verticales, visual arriba ── */
  .om-bono2 {
    padding: clamp(48px, 8vh, 80px) 0;
  }

  .om-bono2__inner {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 460px);
    justify-content: center;
    align-items: stretch;
    gap: 26px;
  }

  .om-bono2__card {
    background: #ffffff;
    border: 1px solid #e9e4f6;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 8px 28px rgba(43, 44, 100, 0.08);
    display: flex;
    flex-direction: column;
  }

  .om-bono2__media {
    background: #f3f1fa;
  }

  /* contain (no cover): el arte trae su propio fondo lavanda #f3f1fa igual al
     de la caja, así que el letterbox es invisible y ningún Pablo sale cortado
     (el del toolkit salió vertical). */
  .om-bono2__media img,
  .om-bono2__media video {
    display: block;
    width: 100%;
    height: 240px;
    object-fit: contain;
  }

  .om-bono2__body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    flex: 1;
  }

  .om-bono2__tag {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #7a4f00;
    background: #fdf1d8;
    border: 1px solid #f0d9a8;
    border-radius: var(--radius-pill);
    padding: 5px 12px;
  }

  .om-bono2__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 25px);
    line-height: 1.22;
    color: var(--color-heading);
  }

  .om-bono2__p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-body);
  }

  .om-bono2__mini {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .om-bono__fichas--v {
    grid-template-columns: 1fr;
    gap: 8px;
    width: 100%;
  }

  .om-bono2__remate {
    font-size: 14px;
    line-height: 1.55;
    font-weight: 600;
    color: var(--color-heading);
  }

  .om-bono2__valor {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .om-bono2__tachado {
    font-size: 15px;
    color: var(--color-secondary);
  }

  .om-bono2__incluido {
    font-family: var(--font-heading);
    font-size: 19px;
    color: #1d7a3f;
  }

  .om-bono2__cta {
    width: 100%;
    margin-top: auto;
  }

  @media (max-width: 900px) {
    .om-bono2__inner {
      grid-template-columns: minmax(0, 480px);
    }

    .om-bono2__media img,
    .om-bono2__media video {
      height: 200px;
    }
  }

  /* ── La carta como nota de cuaderno ── */
  .om-carta--papel {
    position: relative;
    background:
      repeating-linear-gradient(
        180deg,
        transparent 0,
        transparent 31px,
        #e4ddf0 31px,
        #e4ddf0 32px
      ),
      #fffdf6;
    border: 1px solid #efe8d8;
    border-radius: 6px;
    box-shadow: 0 14px 34px rgba(43, 44, 100, 0.12);
    transform: rotate(-0.6deg);
    padding: 40px 44px 36px;
  }

  /* La línea roja de margen del cuaderno */
  .om-carta--papel::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 26px;
    width: 1.5px;
    background: rgba(224, 106, 106, 0.35);
  }

  /* Cinta adhesiva arriba */
  .om-carta__tape {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%) rotate(1.6deg);
    width: 132px;
    height: 30px;
    background: rgba(240, 217, 168, 0.65);
    border-left: 1px dashed rgba(185, 138, 30, 0.35);
    border-right: 1px dashed rgba(185, 138, 30, 0.35);
    box-shadow: 0 2px 5px rgba(43, 44, 100, 0.08);
  }

  .om-carta__eyebrow {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: 8px;
  }

  /* El texto de la nota cae sobre las líneas del cuaderno */
  .om-carta--papel .om-carta__p {
    line-height: 32px;
    margin: 0;
  }

  @media (max-width: 620px) {
    .om-carta--papel {
      padding: 32px 22px 28px 34px;
      transform: rotate(-0.35deg);
    }

    .om-carta--papel::before {
      left: 18px;
    }
  }

  /* ── Qué es Pablo: subtexto en 2 filas y fichas más angostas ── */
  .om-quees__sub {
    font-size: 14px;
    line-height: 1.55;
    max-width: 52ch;
  }

  .om-quees__bullets {
    max-width: 500px;
    gap: 8px;
  }

  .om-quees__bullets li {
    font-size: 13px;
    padding: 11px 13px 11px 38px;
  }

  .om-quees__bullets li::before {
    left: 13px;
    top: 13px;
    width: 5px;
    height: 10px;
  }

  /* ── Urgencia: la fecha como ceja, el reloj manda ── */
  .om-urgencia__eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #7a4f00;
    background: #fdf1d8;
    border: 1px solid #f0d9a8;
    border-radius: var(--radius-pill);
    padding: 7px 16px;
  }

  /* ── Transiciones de color entre secciones ──
     Cada sección arranca con el color de la anterior y funde hacia el suyo en
     los primeros ~170px. El orden real de la página vive en el HTML; si una
     sección se mueve, hay que actualizar su "from" acá. Orden actual:
     hero #EEEAFA → carrusel #F2EFFF → dolor #fff → quees #F8F7F9 →
     incluye #F8F7F9 → carta #fff → bono1 #fff→ bono2(alt) #EEEAFA → bono3 #fff
     → resumen #F8F7F9 → garantía #fff → urgencia #EEEAFA → faq #F9F9FB →
     final #2B2C64. */
  .om-dolor { background: linear-gradient(180deg, #eeeafa 0, #ffffff 170px) #ffffff; }
  .om-quees { background: linear-gradient(180deg, #ffffff 0, #f8f7f9 170px) #f8f7f9; }
  .om-carta-sec { background: linear-gradient(180deg, #f8f7f9 0, #f2efff 170px) #f2efff; }
  .om-bono2 { background: linear-gradient(180deg, #f2efff 0, #ffffff 170px) #ffffff; }
  .om-bono2--alt { background: linear-gradient(180deg, #ffffff 0, #eeeafa 170px) #eeeafa; }
  .om-bono2 + .om-bono2:not(.om-bono2--alt) {
    background: linear-gradient(180deg, #eeeafa 0, #ffffff 170px) #ffffff;
  }
  .om-resumen { background: linear-gradient(180deg, #ffffff 0, #f8f7f9 170px) #f8f7f9; }
  .om-garantia { background: linear-gradient(180deg, #f8f7f9 0, #ffffff 170px) #ffffff; }
  .om-urgencia { background: linear-gradient(180deg, #ffffff 0, #eeeafa 170px) #eeeafa; }
  .om-faq { background: linear-gradient(180deg, #eeeafa 0, #f9f9fb 170px) #f9f9fb; }
  .om-final { background: linear-gradient(180deg, #f9f9fb 0, #2b2c64 220px) #2b2c64; }

  /* ── Qué es Pablo v2: los bullets pasan de checks a fichas con icono ── */
  .om-quees__bullets {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .om-quees__bullets li {
    padding: 14px 16px 14px 46px;
    background: #ffffff;
    border: 1px solid #e9e4f6;
    border-radius: 14px;
    font-size: 14px;
    box-shadow: 0 1px 4px rgba(43, 44, 100, 0.05);
  }

  .om-quees__bullets li::before {
    left: 16px;
    top: 16px;
  }

  @media (max-width: 620px) {
    .om-quees__bullets {
      grid-template-columns: 1fr;
    }
  }

  /* ══════════════════════════════════════════════════════════════════
     OVERHAUL 28-jul — todo lo nuevo va junto y AL FINAL del <style> a
     propósito: a igual especificidad, gana sobre lo anterior.
     ══════════════════════════════════════════════════════════════════ */

  /* El atributo hidden pierde contra cualquier display de clase: este
     refuerzo lo hace ganar siempre (cierre del hero según plan elegido). */
  [data-vista][hidden] {
    display: none !important;
  }

  /* ─── Selector de plan del hero (estilo panel del Book Bundle):
         dos tarjetas-radio, la elegida se expande, la otra queda como fila
         delgada. Un solo botón debajo. ─── */
  .om-planes {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .om-plan {
    position: relative;
    background: #ffffff;
    border: 1.5px solid #e2ddf3;
    border-radius: 18px;
    cursor: pointer;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }

  .om-plan:hover:not(.is-active) {
    border-color: #c9c1ea;
  }

  .om-plan.is-active {
    cursor: default;
    border-color: #eec26e;
    background: linear-gradient(165deg, #fffdf6, #fdf6e4);
    box-shadow: 0 0 0 1px rgba(238, 194, 110, 0.35), 0 18px 38px -22px rgba(154, 106, 0, 0.45);
  }

  .om-plan__badge {
    position: absolute;
    top: -11px;
    left: 50%;
    transform: translateX(-50%) scale(0.9);
    background: linear-gradient(135deg, #f6c454, #eb9d2a);
    color: #4a3000;
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 4px 14px;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }

  .om-plan.is-active .om-plan__badge {
    opacity: 1;
    transform: translateX(-50%) scale(1);
  }

  .om-plan__head {
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 13px 16px;
  }

  .om-plan__radio {
    flex-shrink: 0;
    width: 19px;
    height: 19px;
    border-radius: 50%;
    border: 2px solid #cfc8ec;
    background: #ffffff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .om-plan.is-active .om-plan__radio {
    border-color: #e0a63c;
    box-shadow: inset 0 0 0 4.5px #ffffff, inset 0 0 0 12px #e0a63c;
  }

  .om-plan__nombre {
    flex: 1;
    min-width: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 15px;
    color: var(--color-heading);
    display: flex;
    align-items: baseline;
    gap: 7px;
    flex-wrap: wrap;
  }

  .om-plan__nombre strong {
    font-weight: 700;
  }

  .om-plan__nota {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    color: #6f63d8;
    background: rgba(125, 110, 224, 0.12);
    border-radius: 999px;
    padding: 2px 9px;
    white-space: nowrap;
  }

  .om-plan__precio {
    flex-shrink: 0;
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-variant-numeric: tabular-nums;
  }

  .om-plan__precio s {
    font-size: 12.5px;
    color: var(--color-body);
    opacity: 0.65;
  }

  .om-plan__precio strong {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    color: var(--color-heading);
  }

  .om-plan__precio em {
    font-style: normal;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-body);
  }

  /* El cuerpo se expande/colapsa con el efecto toggle (grid-rows) */
  .om-plan__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.38s cubic-bezier(0.3, 0.9, 0.35, 1);
  }

  .om-plan.is-active .om-plan__body {
    grid-template-rows: 1fr;
  }

  .om-plan__contenido {
    overflow: hidden;
    min-height: 0;
  }

  .om-plan__contenido .om-paquete {
    margin: 0 10px 10px;
  }

  .om-paquete__fila--quieta {
    cursor: default;
  }

  .om-paquete__fila--quieta:hover .om-paquete__nombre,
  .om-paquete__fila--quieta:hover .om-paquete__icono {
    transform: none;
  }

  .om-paquete__fila--apagada {
    opacity: 0.62;
  }

  .om-paquete__mes {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-body);
  }

  .om-paquete__solo-anual {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-body);
    background: rgba(43, 44, 100, 0.07);
    border-radius: 999px;
    padding: 3px 9px;
    white-space: nowrap;
  }

  /* CTA del mensual: mismo cuerpo, color propio (lila Pablo) para que el
     cambio de oferta se sienta también en el botón. */
  .om-cta--mensual {
    background: linear-gradient(135deg, #7d6ee0, #4b3fb5);
    box-shadow: 0 14px 30px -12px rgba(75, 63, 181, 0.55);
  }

  .om-cta--mensual:hover {
    background: linear-gradient(135deg, #8a7ce6, #5548c2);
    box-shadow: 0 16px 34px -12px rgba(75, 63, 181, 0.65);
  }

  /* ─── Secciones oscuras (om-noche): transiciones suaves, sin bordes
         rasgados — la banda navy entra y sale con curvas grandes. ─── */
  .om-noche {
    background: #16173a;
    border-radius: 44px;
    margin: 26px 14px;
    padding: 58px 0 62px;
    position: relative;
    overflow: hidden;
  }

  .om-noche::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(520px 260px at 12% 0%, rgba(125, 110, 224, 0.16), transparent 70%),
      radial-gradient(460px 240px at 88% 100%, rgba(242, 192, 99, 0.1), transparent 70%);
    pointer-events: none;
  }

  .om-noche__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .om-noche__ceja {
    display: inline-block;
    background: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 8px 18px;
  }

  .om-noche__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(24px, 3vw, 36px);
    line-height: 1.2;
    color: #ffffff;
    max-width: 21ch;
    margin: 0;
    text-wrap: balance;
  }

  .om-noche__glow {
    color: #f8c465;
    text-shadow: 0 0 22px rgba(248, 196, 101, 0.45);
  }

  .om-noche__sub {
    font-size: 16.5px;
    line-height: 1.55;
    color: rgba(236, 233, 250, 0.82);
    max-width: 56ch;
    margin: 0;
  }

  .om-noche__sub strong {
    color: #f8c465;
    font-weight: 700;
  }

  .om-noche__cta {
    margin-top: 10px;
  }

  /* El titular del buildup respira más ancho que los de hábito */
  .om-noche--intro .om-noche__title {
    max-width: 26ch;
  }

  /* Los 4 tiles de hábito del buildup */
  .om-habitos-tiles {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    width: 100%;
    max-width: 760px;
  }

  .om-habitos-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 18px 10px 14px;
    text-decoration: none;
    transition: transform 0.22s ease, background 0.22s ease, border-color 0.22s ease;
  }

  .om-habitos-tile:hover {
    transform: translateY(-4px);
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(248, 196, 101, 0.5);
  }

  .om-habitos-tile__icono {
    width: 68px;
    height: 68px;
    border-radius: 18px;
    overflow: hidden;
    background: #fdf6e3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .om-habitos-tile__icono img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .om-habitos-tile__nombre {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14.5px;
    color: #ffffff;
  }

  /* Sección oscura de cada hábito: ceja tipo Hormozi + título con ícono */
  .om-noche--habito {
    padding: 48px 0 52px;
  }

  .om-noche__title--habito {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .om-noche__icono {
    width: 56px;
    height: 56px;
    border-radius: 15px;
    background: #fdf6e3;
    object-fit: cover;
    flex-shrink: 0;
  }

  /* ─── El brillo dorado del trato ─── */
  .om-trato__card--glow {
    border: 2px solid #eec26e;
    box-shadow:
      0 0 0 1px rgba(238, 194, 110, 0.35),
      0 0 34px -6px rgba(238, 194, 110, 0.55),
      0 24px 50px -28px rgba(76, 46, 133, 0.25);
  }

  /* ─── Qué es Pablo: eyebrow + pasos con check, pegados al teléfono ─── */
  .om-quees__eyebrow {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .om-quees__pasos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .om-quees__paso {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    background: #ffffff;
    border: 1px solid #e7e3f6;
    border-radius: 13px;
    padding: 11px 14px;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--color-body);
    box-shadow: 0 6px 16px -12px rgba(43, 44, 100, 0.35);
  }

  .om-quees__paso strong {
    color: var(--color-heading);
  }

  .om-quees__check {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7a4f00;
    background: linear-gradient(135deg, #fbe3ac, #f2c063);
  }

  /* ─── Explicación de cada hábito (2 dolores→solución alternados) ─── */
  .om-habito {
    background: #ffffff;
    padding: 54px 0 58px;
  }

  .om-habito__inner {
    display: flex;
    flex-direction: column;
    gap: 44px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .om-habito__fila {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 40px;
    align-items: center;
  }

  .om-habito__fila--flip .om-habito__texto {
    order: 2;
  }

  .om-habito__fila--flip .om-habito__visual {
    order: 1;
  }

  .om-habito__texto {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .om-habito__kicker {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--color-heading);
    width: fit-content;
    border-bottom: 3px solid #f2c063;
    padding-bottom: 3px;
  }

  .om-habito__titulo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(20px, 2.2vw, 26px);
    line-height: 1.25;
    color: var(--color-heading);
    margin: 0;
  }

  .om-habito__p {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-body);
    margin: 0;
  }

  .om-habito__bullets {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .om-habito__bullets li {
    position: relative;
    padding-left: 24px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--color-body);
  }

  .om-habito__bullets li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #fbe3ac, #f2c063);
  }

  .om-habito__bullets strong {
    color: var(--color-heading);
  }

  .om-habito__visual {
    display: flex;
    justify-content: center;
  }

  .om-habito__visual > img {
    width: 100%;
    max-width: 420px;
    height: auto;
    border-radius: 22px;
    box-shadow: 0 24px 48px -26px rgba(43, 44, 100, 0.4);
  }

  .om-habito__sesion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-heading);
    background: #f6f1e2;
    border: 1px solid #eadfc0;
    border-radius: 999px;
    padding: 10px 20px;
    margin: -6px auto 0;
    max-width: fit-content;
  }

  .om-habito__sesion svg {
    flex-shrink: 0;
    color: #9a6a00;
  }

  .om-habito__proof {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .om-habito__proof-label {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .om-habito__proof-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
    width: 100%;
    max-width: 860px;
  }

  .om-habito__quote {
    margin: 0;
    background: #faf9ff;
    border: 1px solid #e7e3f6;
    border-left: 4px solid #f2c063;
    border-radius: 14px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .om-habito__quote blockquote {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    font-style: italic;
    color: var(--color-heading);
  }

  .om-habito__quote figcaption {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-body);
  }

  .om-habito__quote figcaption span {
    font-weight: 500;
    opacity: 0.8;
  }

  /* ─── Mini-mockups de producto (HTML puro, nítidos) ─── */
  .om-mini {
    width: 100%;
    max-width: 340px;
    background: #ffffff;
    border: 1px solid #e7e3f6;
    border-radius: 20px;
    box-shadow: 0 24px 48px -26px rgba(43, 44, 100, 0.42);
    overflow: hidden;
  }

  .om-mini--chat {
    background: #efe9e2;
  }

  .om-mini__top {
    display: flex;
    align-items: center;
    gap: 9px;
    background: #f8f6f1;
    border-bottom: 1px solid #e5dfd3;
    padding: 10px 14px;
  }

  .om-mini__avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fdf6e3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .om-mini__avatar img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .om-mini__quien {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-heading);
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .om-mini__quien em {
    font-style: normal;
    font-size: 10.5px;
    font-weight: 500;
    color: #3aa15f;
  }

  .om-mini__chat {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 13px 12px 15px;
  }

  .om-mini__msg {
    position: relative;
    max-width: 86%;
    background: #ffffff;
    border-radius: 11px;
    border-top-left-radius: 3px;
    padding: 8px 11px 14px;
    margin: 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--color-heading);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }

  .om-mini__msg--mio {
    align-self: flex-end;
    background: #dcf3c8;
    border-radius: 11px;
    border-top-right-radius: 3px;
  }

  /* Solo el timestamp (último span directo): un selector más ancho se
     comía el voucher de Yape y las ondas del audio (bug 28-jul). */
  .om-mini__msg > span:last-child {
    position: absolute;
    right: 9px;
    bottom: 3px;
    font-size: 9px;
    color: rgba(43, 44, 100, 0.45);
  }

  .om-mini--panel {
    padding: 18px 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .om-mini__titulo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14.5px;
    color: var(--color-heading);
    margin: 0;
  }

  .om-mini__cat {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3px 8px;
    font-size: 12.5px;
  }

  .om-mini__cat-nombre {
    font-weight: 700;
    color: var(--color-heading);
  }

  .om-mini__cat-monto {
    font-weight: 600;
    color: var(--color-body);
    font-variant-numeric: tabular-nums;
  }

  .om-mini__barra {
    grid-column: 1 / -1;
    display: block;
    height: 8px;
    border-radius: 999px;
    background: #eeeaf9;
    overflow: hidden;
  }

  .om-mini__barra i {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, #fbe3ac, #f2b64e);
  }

  .om-mini__barra .om-mini__ok {
    background: linear-gradient(90deg, #bfe8c8, #58bd77);
  }

  .om-mini__barra--meta {
    height: 10px;
  }

  .om-mini__grande {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 26px;
    color: var(--color-heading);
    margin: 0;
  }

  .om-mini__grande span {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-body);
  }

  .om-mini__pie {
    font-size: 12px;
    font-weight: 600;
    color: var(--color-body);
    margin: 0;
  }

  .om-mini__sesiones {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .om-mini__sesiones li {
    position: relative;
    padding: 8px 10px 8px 32px;
    background: #faf9ff;
    border: 1px solid #e7e3f6;
    border-radius: 10px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-heading);
  }

  .om-mini__sesiones li::before {
    content: "";
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid #cfc8ec;
    background: #fff;
  }

  .om-mini__sesiones li.is-done::before {
    border-color: #58bd77;
    background: #58bd77;
    box-shadow: inset 0 0 0 3px #eaf7ee;
  }

  /* ─── La IA: laptop + celular en HTML ─── */
  .om-ia__devices {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 26px;
    width: 100%;
    margin-top: 14px;
  }

  .om-laptop {
    width: min(520px, 100%);
    flex-shrink: 1;
  }

  .om-laptop__pantalla {
    background: #0e0f28;
    border: 3px solid #2e2f5e;
    border-bottom: 0;
    border-radius: 18px 18px 0 0;
    padding: 12px;
  }

  .om-laptop__base {
    height: 14px;
    background: linear-gradient(180deg, #3a3b6e, #23244c);
    border-radius: 0 0 16px 16px;
    box-shadow: 0 22px 40px -18px rgba(0, 0, 0, 0.6);
  }

  .om-panel {
    display: grid;
    grid-template-columns: 44px 1fr;
    background: #f4f2fb;
    border-radius: 10px;
    overflow: hidden;
    min-height: 240px;
  }

  .om-panel__sidebar {
    background: #ffffff;
    border-right: 1px solid #e7e3f6;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
  }

  .om-panel__logo {
    width: 26px;
    height: 26px;
    border-radius: 8px;
    background: #fdf6e3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 4px;
  }

  .om-panel__logo img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .om-panel__dot {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    background: #eeeaf9;
  }

  .om-panel__dot.is-active {
    background: linear-gradient(135deg, #fbe3ac, #f2c063);
  }

  .om-panel__main {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }

  .om-panel__hola {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    color: var(--color-heading);
    margin: 0;
  }

  .om-panel__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .om-panel__card {
    background: #ffffff;
    border: 1px solid #e7e3f6;
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .om-panel__label {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-body);
    opacity: 0.8;
  }

  .om-panel__num {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    color: var(--color-heading);
  }

  .om-panel__chart {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 52px;
  }

  .om-panel__chart i {
    flex: 1;
    border-radius: 4px 4px 0 0;
    background: #e3ddf6;
  }

  .om-panel__chart i.is-hoy {
    background: linear-gradient(180deg, #fbe3ac, #f2b64e);
  }

  .om-fono {
    width: 250px;
    flex-shrink: 0;
    border: 3px solid #2e2f5e;
    border-radius: 26px;
    padding: 7px;
    background: #0e0f28;
    box-shadow: 0 22px 40px -18px rgba(0, 0, 0, 0.6);
  }

  .om-mini--enfono {
    max-width: none;
    border: 0;
    border-radius: 19px;
    box-shadow: none;
  }

  .om-ia__bullets {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 22px;
    max-width: 720px;
    text-align: left;
  }

  .om-ia__bullets li {
    position: relative;
    padding-left: 24px;
    font-size: 14.5px;
    line-height: 1.55;
    color: rgba(236, 233, 250, 0.85);
  }

  .om-ia__bullets li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: linear-gradient(135deg, #fbe3ac, #f2c063);
  }

  .om-ia__bullets strong {
    color: #ffffff;
  }

  /* ─── La Komunidad ─── */
  .om-komu {
    background: #ffffff;
    padding: var(--section-py) 0;
  }

  .om-komu__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
  }

  .om-komu__eyebrow {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9a6a00;
    background: #fdf3dd;
    border-radius: 999px;
    padding: 7px 16px;
  }

  .om-komu__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 36px;
    align-items: center;
    width: 100%;
    max-width: 940px;
  }

  .om-komu__media img {
    width: 100%;
    height: auto;
    border-radius: 22px;
    box-shadow: 0 24px 48px -26px rgba(43, 44, 100, 0.4);
  }

  .om-komu__puntos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .om-komu__puntos li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-body);
  }

  .om-komu__puntos strong {
    color: var(--color-heading);
  }

  .om-komu__proof {
    width: 100%;
  }

  /* ─── Offer stack vertical del final ─── */
  .om-stackf__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  .om-stackf__lista {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 680px;
  }

  .om-stackf__mas {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 22px;
    color: #f8c465;
    line-height: 1;
  }

  .om-stackf__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    padding: 14px 18px;
    text-align: left;
  }

  .om-stackf__media {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.09);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .om-stackf__media img {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }

  .om-stackf__titulo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15.5px;
    color: #ffffff;
    margin: 0 0 3px;
  }

  .om-stackf__desc {
    font-size: 12.5px;
    line-height: 1.45;
    color: rgba(236, 233, 250, 0.7);
    margin: 0;
  }

  .om-stackf__valor {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    flex-shrink: 0;
  }

  .om-stackf__valor s {
    font-size: 12px;
    color: rgba(236, 233, 250, 0.5);
  }

  .om-stackf__valor strong {
    font-size: 13px;
    font-weight: 700;
    color: #7ee2a0;
    white-space: nowrap;
  }

  .om-stackf__cierre {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .om-precio--noche .om-precio__antes {
    color: rgba(236, 233, 250, 0.55);
  }

  .om-precio--noche .om-precio__ahora {
    color: #ffffff;
  }

  .om-precio--noche .om-precio__nota {
    color: rgba(236, 233, 250, 0.7);
  }

  .om-stackf__trust {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: rgba(236, 233, 250, 0.8);
    margin: 0;
  }

  .om-stackf__mensual {
    font-size: 13px;
    color: rgba(236, 233, 250, 0.65);
    margin: 0;
  }

  .om-stackf__mensual a {
    color: #b9aef2;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ─── Responsive del overhaul ─── */
  @media (max-width: 980px) {
    .om-ia__devices {
      flex-direction: column;
      align-items: center;
      gap: 22px;
    }

    .om-fono {
      width: min(300px, 100%);
    }
  }

  /* En tablet las filas siguen side-by-side (pedido 28-jul), solo con
     menos aire; recién bajo 700px se apilan. */
  @media (max-width: 900px) and (min-width: 701px) {
    .om-habito__fila {
      gap: 24px;
    }

    .om-komu__grid {
      gap: 24px;
    }
  }

  @media (max-width: 700px) {
    .om-habito__fila {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .om-habito__fila--flip .om-habito__texto {
      order: 1;
    }

    .om-habito__fila--flip .om-habito__visual {
      order: 2;
    }

    .om-komu__grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .om-komu__media {
      max-width: 420px;
      margin: 0 auto;
    }
  }

  @media (max-width: 760px) {
    /* En móvil el logo de la esquina pisa la ceja — y la ceja ya dice
       "Pablo Promo", así que el logo descansa. */
    .om-header--flotante {
      display: none;
    }

    /* La ceja del hero, más pequeña en móvil (pedido 28-jul) */
    .om-hero__eyebrow {
      font-size: 9.5px;
      padding: 5px 11px;
      letter-spacing: 0.12em;
    }

    /* Hero compacto: que la primera pantalla entre en un iPhone.
       Cada pixel cuenta: paddings cortos, tipografía un punto abajo y
       filas del paquete más delgadas. */
    .om-hero--promo {
      padding: 14px 0 18px;
    }

    .om-hero__promo {
      gap: 10px;
    }

    .om-hero__cabecera {
      gap: 8px;
    }

    .om-hero__title--promo {
      font-size: 24px;
    }

    .om-hero__kicker {
      font-size: 13px;
      line-height: 1.45;
    }

    .om-hero__split {
      gap: 10px;
    }

    .om-plan__head {
      padding: 11px 13px;
    }

    .om-plan__nombre {
      font-size: 14px;
    }

    .om-plan__precio strong {
      font-size: 17px;
    }

    .om-paquete__fila {
      padding-top: 8px;
      padding-bottom: 8px;
    }

    .om-hero__cierre {
      gap: 5px;
    }

    .om-countdown--hero {
      transform: scale(0.92);
      transform-origin: top center;
    }

    .om-noche {
      border-radius: 28px;
      margin: 18px 8px;
      padding: 40px 0 46px;
    }

    .om-noche__sub {
      font-size: 14.5px;
    }

    .om-habitos-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .om-habitos-tile__icono {
      width: 56px;
      height: 56px;
    }

    .om-noche__icono {
      width: 44px;
      height: 44px;
    }

    .om-habito {
      padding: 40px 0 46px;
    }

    .om-habito__inner {
      gap: 32px;
    }

    .om-habito__sesion {
      font-size: 12.5px;
      padding: 9px 14px;
      text-align: left;
    }

    .om-ia__bullets {
      grid-template-columns: 1fr;
    }

    .om-stackf__item {
      grid-template-columns: auto 1fr;
      row-gap: 8px;
    }

    .om-stackf__valor {
      grid-column: 2;
      flex-direction: row;
      align-items: center;
      gap: 8px;
      justify-self: start;
    }

    .om-stackf__desc {
      font-size: 12px;
