---

  <!-- Fuente manuscrita solo para esta página (firma de la carta) -->
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&display=swap"
  />

  <!-- La barra de "Última grabación disponible hasta el…" salió: el taller
       terminó y a quien no fue le decía nada. El único reloj de la página vive
       ahora en el hero, para que la urgencia se lea una vez y se crea. -->

  <!-- Header: ya no hay barra (pedido 28-jul) — solo el logotipo chiquito
       flotando en la esquina, sobre el hero. Cada link del menú es una fuga. -->
  <header class="om-header om-header--flotante">
    <span class="om-header__logo">
      <Image src={logoImg} alt="Pablo logo" class="om-header__img" width={28} height={28} />
      <span class="om-header__text">Pablo</span>
    </span>
  </header>

  <main class="om">
    <!-- ════════════════ 1. HERO ════════════════ -->
    {promo ? (
      <!-- Hero de la Pablo Promo: carrusel vertical con los visuales de Pablo y
           de las 6 cosas que entran (uno por beneficio) deslizando hacia arriba,
           con el stack al costado y el ítem activo en dorado. Todo lo que
           necesita ver alguien que llega de un correo, en una pantalla:
           qué es, qué se lleva, cuánto cuesta y hasta cuándo. -->
      <section class="om-hero om-hero--promo" data-oferta="anual">
        <div class="om-hero__blob om-hero__blob--1" aria-hidden="true"></div>
        <div class="om-hero__blob om-hero__blob--2" aria-hidden="true"></div>

        <div class="container om-hero__promo">
          <!-- ── Cabecera a lo ancho: sello, headline y kicker centrados ── -->
          <div class="om-hero__cabecera">
            <span class="om-hero__eyebrow">Pablo Promo · Fiestas Patrias</span>

            <!-- Headline del overhaul (Rodrigo 28-jul, 3ra ronda) + ajuste de
                 la IA de Hormozi: el vehículo ("por WhatsApp") entra al H1
                 para bajar el esfuerzo percibido. El kicker nombra los 4
                 hábitos (suena realizable) y cambia "términos ocultos" por
                 "cargos escondidos" — el miedo real de la ICP es el billing. -->
            <h1 class="om-hero__title om-hero__title--promo">
              Ordena tu plata en <span class="highlight">30 días</span> por
              WhatsApp — y si cumples el reto, Pablo te sale
              <span class="highlight">gratis</span>.
            </h1>

            <p class="om-hero__kicker">
              Paga S/.200 una sola vez, usa Pablo 12 meses y, si completas los
              4 hábitos en tus primeros 30 días,<br class="om-salto-desktop" />
              te devolvemos el 100%. Sin letra chica, sin cargos escondidos.
            </p>
          </div>

          <!-- ── El reparto (boceto de Rodrigo 27-jul): carrusel en una caja
               alta a la izquierda; a la derecha la lista de lo que entra con
               el precio debajo. CTA y countdown centrados, a lo ancho. ── -->
          <div class="om-hero__split">
          <!-- ── El carrusel vertical ── -->
          <div class="om-loop" data-loop>
            <!-- aria-hidden: el contenido de las 7 imágenes ya está en texto en
                 la lista de al lado; un lector de pantalla no necesita oírlo
                 siete veces. Solo el primer slide trae src: los demás se
                 cargan cuando el navegador está libre (data-src). El nombre va
                 DENTRO de cada slide: así imagen y etiqueta viajan juntas y no
                 pueden desincronizarse. -->
            <div class="om-loop__ventana" aria-hidden="true">
              <div class="om-loop__track" data-loop-track>
                {LOOP.map((f, i) => (
                  <figure class="om-loop__slide">
                    <img
                      class="om-loop__img"
                      src={i === 0 ? f.img : undefined}
                      data-src={i === 0 ? undefined : f.img}
                      alt=""
                      width="600"
                      height="600"
                      decoding="async"
                    />
                    {i > 0 && <figcaption class="om-loop__chip">{f.nombre}</figcaption>}
                  </figure>
                ))}
              </div>
              <div class="om-loop__dots">
                {LOOP.map((_f, i) => (
                  <span class:list={['om-loop__dot', i === 0 && 'is-active']} data-loop-dot={i}></span>
                ))}
              </div>
            </div>
          </div>

          <!-- ── La oferta: un solo paquete con las 6 cosas y el CTA justo
               debajo (pedido de Rodrigo 28-jul). El Plan Anual va resaltado
               con su precio al lado; los bonos dicen Gratis con el tachado
               donde existe. El que está en el carrusel se enciende. ── -->
          <div class="om-hero__derecha">
            <!-- Selector de plan estilo panel de compra del Book Bundle
                 (referencia de Rodrigo, 28-jul): dos tarjetas-radio. La
                 seleccionada se expande con su contenido; la otra queda como
                 fila delgada. SIEMPRE hay UN solo botón abajo: cambia su
                 texto, color y destino según el plan elegido. -->
            <div class="om-planes" role="radiogroup" aria-label="Elige tu plan" data-planes>
              <div class="om-plan om-plan--anual is-active" data-plan="anual" role="radio" aria-checked="true" tabindex="0">
                <span class="om-plan__badge">Todos los bonos incluidos</span>
                <div class="om-plan__head">
                  <span class="om-plan__radio" aria-hidden="true"></span>
                  <span class="om-plan__nombre">Pablo Promo <strong>Anual</strong> <span class="om-plan__nota om-plan__nota--oro">2 meses de regalo</span></span>
                  <span class="om-plan__precio">
                    <s>S/.240</s>
                    <strong>S/.200</strong><em>/año</em>
                  </span>
                </div>
                <div class="om-plan__body">
                  <div class="om-plan__contenido">
                    <!-- Cada fila es un link que baja a su sección de la
                         página (pedido 28-jul), con hover propio. El Plan
                         Anual ya NO va como fila: el head de la tarjeta lo
                         dice (nombre + precio), así que solo van los bonos. -->
                    <div class="om-paquete">
                      {LOOP.slice(2).map((f, i) => (
                        <a
                          href={f.ancla}
                          class="om-paquete__fila"
                          data-loop-item={i + 2}
                        >
                          <span class="om-paquete__nombre">
                            {f.icono && (
                              <svg class="om-paquete__icono" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={ICONOS[f.icono]} />
                            )}
                            <span class="om-paquete__texto">
                              {f.nombre}{f.sufijo && <span class="om-paquete__sufijo">{f.sufijo}</span>}
                            </span>
