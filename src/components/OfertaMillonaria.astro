// `promo` = modo Pablo Promo (Fiestas Patrias): hero con el loop de Pablo y los
// bonos, barra fija de CTA y sección "todo lo que incluye". Lo usa
// /fiestas-patrias. /webinar lo monta sin la prop y conserva el <HeroPhone />.
// Antes esta prop era `heroVideoId` y metía la grabación del taller en el hero;
// el taller terminó el 23-jul, así que ese embed salió (se llevaba a la gente
// a YouTube, fuera del sitio, con una miniatura ilegible).
interface Props {
  promo?: boolean;
}
const { promo } = Astro.props;

// ============================================================
//  OFERTA MILLONARIA — landing de ventas (framework $100M Offers)
//  Ruta: /millonaria
//  Chrome de página: sin CountdownBanner global, sin MonedaPopup y con
//  header mínimo (solo logo, sin links) — cada link del menú es una fuga.
// ============================================================
// Los CTA del anual entran al ONBOARDING (no al modal de "crea tu cuenta"): el
// usuario nuevo hace el flujo completo y al final, en el paywall (Step18), se
// le vuelve a presentar la Oferta Millonaria con todos sus bonos. El plan y la
// oferta viajan por URL → sessionStorage (ver src/scripts/onboarding.js).
const CHECKOUT_URL = "/onboarding?plan=anual&oferta=millonaria";
const CHECKOUT_URL_MENSUAL = "/onboarding?plan=mensual&oferta=millonaria";

