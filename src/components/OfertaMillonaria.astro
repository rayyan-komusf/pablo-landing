// /fiestas-patrias. /webinar lo monta sin la prop y conserva el <HeroPhone />.
// Antes esta prop era `heroVideoId` y metía la grabación del taller en el hero;
// el taller terminó el 23-jul, así que ese embed salió (se llevaba a la gente
// a YouTube, fuera del sitio, con una miniatura ilegible).
interface Props {
  promo?: boolean;
}
