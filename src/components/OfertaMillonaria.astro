<script>
  // ── Selector de plan del hero (Anual ↔ Mensual, 28-jul) ──
  // Tarjetas-radio estilo panel del Book Bundle: la elegida se expande y el
  // ÚNICO botón cambia de texto, color y destino. El cierre (countdown vs
  // línea de prueba gratis) también sigue al plan elegido.
  const heroPromo = document.querySelector<HTMLElement>('.om-hero--promo');
  const planes = Array.from(document.querySelectorAll<HTMLElement>('.om-plan[data-plan]'));
  const ctaHero = document.getElementById('om-cta-hero') as HTMLAnchorElement | null;

  const CTA_TEXTOS: Record<string, string> = {
    anual: 'Quiero ordenar mi plata y empezar el reto',
    mensual: 'Prueba a Pablo por 14 días gratis',
  };

  function elegirPlan(plan: string) {
    if (!heroPromo) return;
    heroPromo.dataset.oferta = plan;

    planes.forEach((p) => {
      const activo = p.dataset.plan === plan;
      p.classList.toggle('is-active', activo);
      p.setAttribute('aria-checked', String(activo));
    });

    if (ctaHero) {
      const href = plan === 'mensual' ? ctaHero.dataset.hrefMensual : ctaHero.dataset.hrefAnual;
      if (href) ctaHero.href = href;
      const texto = ctaHero.querySelector('[data-cta-texto]');
      if (texto) texto.textContent = CTA_TEXTOS[plan] ?? CTA_TEXTOS.anual;
      ctaHero.classList.toggle('om-cta--mensual', plan === 'mensual');
    }

    heroPromo.querySelectorAll<HTMLElement>('.om-hero__cierre[data-vista]').forEach((el) => {
      el.hidden = el.dataset.vista !== plan;
    });

    // La barra sticky sigue al plan elegido (revisión 28-jul): si el usuario
    // está en Mensual, la barra no le puede vender el anual.
    const stickyCta = document.querySelector<HTMLAnchorElement>('.om-sticky__cta');
    const stickyTachado = document.querySelector<HTMLElement>('.om-sticky__tachado');
    const stickyMonto = document.querySelector<HTMLElement>('.om-sticky__monto');
    if (stickyCta && ctaHero) {
      stickyCta.href = ctaHero.href;
      stickyCta.textContent = plan === 'mensual' ? 'Probar 14 días gratis' : 'Reclamar mi promo';
    }
    if (stickyTachado) stickyTachado.style.visibility = plan === 'mensual' ? 'hidden' : '';
    if (stickyMonto) stickyMonto.innerHTML = plan === 'mensual' ? 'S/.20 <span>al mes</span>' : 'S/.200 <span>el año</span>';

    try {
      (window as any).posthog?.capture('millonaria_plan_elegido', { plan });
    } catch (e) {
      /* posthog opcional */
    }
  }

  planes.forEach((p) => {
    p.addEventListener('click', () => {
      if (!p.classList.contains('is-active')) elegirPlan(p.dataset.plan || 'anual');
    });
    p.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        elegirPlan(p.dataset.plan || 'anual');
      }
    });
  });

  // ── Contadores regresivos (hero + urgencia comparten deadline) ──
  function pad(n: number) {
    return String(n).padStart(2, '0');
  }

  const countdowns = document.querySelectorAll<HTMLElement>('.om-countdown');

  // La promo se apaga sola al vencer (revisión 28-jul): sin esto, el 30-jul
  // la página seguiría vendiendo bonos con el reloj clavado en ceros —
  // exactamente lo contrario de "después el anual vuelve a ser solo el
  // anual" que prometimos por correo.
  let promoCerrada = false;
  function cerrarPromo() {
    if (promoCerrada) return;
    promoCerrada = true;
    countdowns.forEach((cd) => {
      cd.style.display = 'none';
    });
    const eyebrow = document.querySelector<HTMLElement>('.om-hero__eyebrow');
    if (eyebrow) eyebrow.textContent = 'La Pablo Promo cerró';
    const deadlineTxt = document.querySelector<HTMLElement>('.om-hero__cierre[data-vista="anual"] .om-hero__deadline');
    if (deadlineTxt) deadlineTxt.textContent = 'La promo cerró: el anual vuelve a ser solo el anual.';
    document.getElementById('om-sticky')?.remove();
  }

  function tick() {
    let vencido = false;
    countdowns.forEach((cd) => {
      const deadline = cd.dataset.deadline ? new Date(cd.dataset.deadline).getTime() : 0;
      const resta = deadline - Date.now();
      if (resta <= 0) vencido = true;
      const s = Math.max(0, Math.floor(resta / 1000));

      const setVal = (key: string, val: number) => {
        const el = cd.querySelector<HTMLElement>(`[data-cd="${key}"]`);
        if (el) el.textContent = pad(val);
      };

      setVal('d', Math.floor(s / 86400));
      setVal('h', Math.floor((s % 86400) / 3600));
      setVal('m', Math.floor((s % 3600) / 60));
      setVal('s', s % 60);
    });
    if (vencido && heroPromo) cerrarPromo();
  }

  if (countdowns.length) {
    tick();
    setInterval(tick, 1000);
  }

  // ── Carrusel vertical del hero de la promo ──
  // Desliza hacia arriba entre Pablo y las 6 cosas que entran en la oferta,
  // encendiendo en dorado el ítem del stack y el puntito que corresponden.
  // 2,6 s por slide: el deslizamiento come ~0,5 s, y con menos no se alcanza
  // a leer el chip; con más no se nota que hay 7 cosas.
  const loop = document.querySelector<HTMLElement>('[data-loop]');
  if (loop) {
    const track = loop.querySelector<HTMLElement>('[data-loop-track]');
    const total = track ? track.children.length : 0;
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-loop-item]'));
    const dots = Array.from(loop.querySelectorAll<HTMLElement>('[data-loop-dot]'));
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const pintar = (n: number) => {
      items.forEach((li) =>
        li.classList.toggle('is-active', Number(li.dataset.loopItem) === n),
      );
      dots.forEach((d) =>
        d.classList.toggle('is-active', Number(d.dataset.loopDot) === n),
      );
    };

    // Los slides 1..6 nacen sin src para no competir con el primero: se piden
    // cuando el navegador ya terminó lo urgente.
    const cargarResto = () => {
      loop.querySelectorAll<HTMLImageElement>('.om-loop__img').forEach((f) => {
        if (!f.getAttribute('src') && f.dataset.src) f.src = f.dataset.src;
      });
    };

    if (track && total > 1 && !quieto) {
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(cargarResto, { timeout: 1500 });
      } else {
        window.setTimeout(cargarResto, 500);
      }

      // Para que la vuelta (garantía → Pablo) también deslice hacia arriba en
      // vez de rebobinar las 7, al final va una copia del primer slide: se
      // desliza hacia ella y, ya quieta, se salta sin transición al de verdad.
      const clon = track.children[0].cloneNode(true) as HTMLElement;
      track.appendChild(clon);

      // Sin gastar batería cuando el hero no está a la vista.
      let aLaVista = true;
      new IntersectionObserver(([e]) => {
        aLaVista = e.isIntersecting;
      }).observe(loop);

      let n = 0;
      window.setInterval(() => {
        if (!aLaVista) return;
        n += 1;
        track.style.transition = '';
        track.style.transform = `translateY(-${n * 100}%)`;
        pintar(n % total);
        if (n === total) {
          // 0,55 s dura el deslizamiento; a los 0,65 s ya está quieto.
          window.setTimeout(() => {
            track.style.transition = 'none';
            track.style.transform = 'translateY(0)';
            void track.offsetHeight;
            track.style.transition = '';
            n = 0;
          }, 650);
        }
      }, 2600);
    }
  }

  // ── Barra fija de CTA ──
  // Aparece cuando el hero sale de vista y se esconde cuando el CTA final ya
  // está en pantalla: dos botones grandes compitiendo confunden más que ayudan.
  const sticky = document.getElementById('om-sticky');
  const heroSection = document.querySelector<HTMLElement>('.om-hero--promo');
  // El cierre = CTA final. Con él en pantalla la barra se esconde: dos botones
  // grandes compitiendo confunden más que ayudan.
  const cierres = document.querySelectorAll<HTMLElement>('.om-final');
  if (sticky && heroSection) {
    let heroFuera = false;
    const cierresALaVista = new Set<Element>();

    const pintar = () => {
      const mostrar = heroFuera && cierresALaVista.size === 0;
      sticky.classList.toggle('is-visible', mostrar);
      sticky.setAttribute('aria-hidden', mostrar ? 'false' : 'true');
    };

    new IntersectionObserver(
      ([e]) => {
        heroFuera = !e.isIntersecting;
        pintar();
      },
      { rootMargin: '-80px 0px 0px 0px' },
    ).observe(heroSection);

    const observadorCierre = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((e) => {
          if (e.isIntersecting) cierresALaVista.add(e.target);
          else cierresALaVista.delete(e.target);
        });
        pintar();
      },
      { threshold: 0.12 },
    );
    cierres.forEach((c) => observadorCierre.observe(c));
  }

  // ── FAQ acordeón (mismo patrón que FAQ.astro) ──
  document.querySelectorAll('.om-faq-q').forEach((button) => {
    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      document.querySelectorAll('.om-faq-q').forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        const id = b.getAttribute('aria-controls')!;
        const a = document.getElementById(id);
        if (a) a.hidden = true;
      });

      if (!isExpanded) {
        button.setAttribute('aria-expanded', 'true');
        const answer = document.getElementById(button.getAttribute('aria-controls')!);
        if (answer) answer.hidden = false;
      }
    });
  });
</script>

<script is:inline define:vars={{ nocheInicio: PROMO_MILLONARIA.nocheInicioISO, nocheFin: PROMO_MILLONARIA.nocheFinISO }}>
  // El bonus 1-a-1 con Rodrigo solo existe la NOCHE del webinar (8:40-11:59
  // del 23). Dentro de esa ventana se revelan los [data-noche]; fuera, quedan
  // ocultos — así la misma página queda SIN 1-1 después de medianoche.
  // Preview: agregar ?noche=1 a la URL fuerza a mostrarlo para revisarlo antes
  // de las 8:40 (solo para el equipo).
  (function () {
    var ahora = Date.now();
    var forzar = new URLSearchParams(location.search).get('noche') === '1';
    var enVentana = ahora >= Date.parse(nocheInicio) && ahora < Date.parse(nocheFin);
    if (!forzar && !enVentana) return;
    document.querySelectorAll('[data-noche]').forEach(function (el) {
      el.hidden = false;
    });
  })();
</script>
