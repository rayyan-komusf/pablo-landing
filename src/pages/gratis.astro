---
// /gratis — landing de la campaña de registros al plan Gratis (nov-2026).
//
// Es la MISMA página que la home: las mismas secciones, en el mismo orden y
// con el mismo diseño. Lo único que cambia son las palabras que no puede
// decirle a este tráfico, vía `modo="free"` en tres componentes:
//
//   Hero       titular fuera del A/B `landing-hero-copy` + CTA fijo
//              «Empieza gratis», y el teléfono sin nota de voz ni recibo
//   Funciones  la bajada deja de listar WhatsApp como canal
//   FAQ        «cómo empiezo» ya no dice que el primer gasto va por WhatsApp
//
// Por qué una página aparte y no un modo de la home: la campaña compra
// CompleteRegistration, no ventas, y la home rota entre tres variantes del
// experimento 463183 — un tercio del presupuesto aterrizaría en la oferta de
// pago. Una URL propia es un destino determinista por construcción y deja la
// home intacta para el orgánico.
//
// ⚠️ Esta página no puede prometer WhatsApp, notas de voz, fotos de recibos ni
// lectura del correo: todo eso es Premium (decisión del 28-oct — el costo por
// conversación de la API de WhatsApp escalaría con cada usuario gratuito).
// Features y FinalCTA se quedan como están porque ya lo dicen bien: «WhatsApp
// con Premium».
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/sections/Hero.astro';
import Features from '../components/sections/Features.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import FAQ from '../components/sections/FAQ.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import LeadMagnets from '../components/sections/LeadMagnets.astro';
import Funciones from '../components/sections/Funciones.astro';
import BannerSticky from '../components/BannerSticky.astro';
import Footer from '../components/Footer.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
---

<Layout
  title="Pablo gratis — cuéntale tus gastos y él los ordena"
  description="Registra tus gastos hablándole a Pablo en lenguaje normal y él los ordena por ti. Sin planillas y sin límite de registros. Empieza gratis."
  ctaAlRegistroGratis
>
  <Navbar />
  <BannerSticky />
  <main>
    <Hero modo="free" />
    <Features />
    <Funciones modo="free" />
    <Testimonials modo="free" />
    <FinalCTA />
    <LeadMagnets />
    <FAQ modo="free" />
  </main>
  <Footer />
  <WaitlistModal />
</Layout>

{/* El «modo pauta» del Layout se enciende con utm_medium=paid y oculta todo lo
    marcado .solo-organico — fue hecho para NO ofrecerle el plan Gratis al
    tráfico pagado. Esta campaña compra justamente registros al plan Gratis y
    sus UTMs llevan utm_medium=paid, así que ahí juega en contra: sin esto los
    CTA dirían «Empieza ahora» en una página cuyo único objetivo es «Empieza
    gratis». Se neutraliza SOLO aquí (estos estilos no se cargan en ninguna
    otra página) y con un selector más específico que el del Layout, para no
    depender del orden en que se junten las hojas. */}
<style is:global>
  html.pauta body .solo-organico { display: revert !important; }
  html.pauta body .solo-pauta { display: none !important; }
</style>

{/* Las UTMs del anuncio tienen que sobrevivir el salto a /onboarding (y de ahí
    a la app y a Whop): sin utm_content no se sabe qué reel trajo cada registro.
    Se reenvía la query entera en vez de fijarla, porque utm_content cambia por
    creativo. Alcanza a TODOS los caminos al registro —hero, banner pegajoso,
    cierre, pie— y no sólo al botón principal. En línea y sin defer: el usuario
    puede pulsar enseguida. */}
<script is:inline>
  (function () {
    try {
      var q = window.location.search;
      if (!q || q.length < 2) return;
      var extra = q.slice(1);
      document.querySelectorAll('a[href^="/onboarding"]').forEach(function (a) {
        var href = a.getAttribute('href');
        if (!href || href.indexOf('utm_') !== -1) return;
        a.setAttribute('href', href + (href.indexOf('?') === -1 ? '?' : '&') + extra);
      });
    } catch (e) {
      /* si falla, los enlaces siguen funcionando sin UTMs */
    }
  })();
</script>
