---
// /planes — la página de precios.
//
// Antes esta ruta era un redirect hacia /#planes, porque el pricing vivía en el
// home. Se invirtió (19-ago, decisión de Rodrigo): la página principal NO
// muestra precio. Quien llega a usapablo.com tiene que poder entender qué hace
// Pablo antes de que le pongan una cifra delante; el precio se busca, no se
// impone. El acceso queda en el footer y en el menú, no en el recorrido
// principal.
//
// La ruta se mantiene igual a propósito: ya estaba en los CTA de campañas de
// Brevo enviadas (#87 y #80, 3.677 entregados), así que esos links siguen
// funcionando — ahora aterrizan en la página de verdad en vez de rebotar.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Pricing from '../components/sections/Pricing.astro';
import FAQ from '../components/sections/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Planes de Pablo"
  description="Elige tu plan de Pablo, tu asistente financiero en WhatsApp. Cancela cuando quieras."
>
  <Navbar />
  <main>
    <Pricing />
    <FAQ />
  </main>
  <Footer />
</Layout>
