---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ThankYou from '../../components/ThankYou.astro';
// src/pages/gracias/index.astro
---

<Layout
  title="¡Gracias por tu suscripción! — Pablo"
  description="Tu suscripción a Pablo Premium está activa. Disfruta de acceso ilimitado para llevar tus finanzas al siguiente nivel."
>
  <Navbar />
  <main>
    <ThankYou />
  </main>
  <Footer />

  <script is:inline>
    // Puente de sesión (28-jul): si venimos del pago con tokens guardados
    // (los deja el flujo de /pago en sessionStorage), "Abrir la app" entra
    // ya logueado en usapablo.app.
    (function () {
      var btn = document.getElementById("gracias-app-btn");
      if (!btn) return;
      var t = null;
      try {
        t = JSON.parse(sessionStorage.getItem("pablo_sesion_tokens") || "null");
      } catch (e) {
        /* sin storage */
      }
      if (!t || !t.access_token || !t.refresh_token) return;
      var base = /^(localhost|127\.0\.0\.1|192\.168\.)/.test(location.hostname)
        ? "http://localhost:8080"
        : "https://usapablo.app";
      // destino=dashboard: quien ya pagó NO debe pasar por el onboarding de
      // la app — entra directo al dashboard. La app tiene que respetar este
      // parámetro en /auth/sesion (pedido a Rayyan 29-jul); si lo ignora,
      // instala la sesión igual y el único costo es ver el onboarding.
      btn.href =
        base +
        "/auth/sesion?destino=dashboard#access_token=" +
        encodeURIComponent(t.access_token) +
        "&refresh_token=" +
        encodeURIComponent(t.refresh_token);
      btn.addEventListener("click", function () {
        sessionStorage.removeItem("pablo_sesion_tokens");
      });
    })();
  </script>
</Layout>
