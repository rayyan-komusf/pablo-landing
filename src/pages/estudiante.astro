---
// /estudiante — Pablo Pro para universitarios con la beca komunitaria
// (pedido de Rodrigo, 10 y 11-oct-2026).
//
// Arriba el headline «Pablo Pro» con Pablo estudiando (escena generada con
// las láminas de 03_Character_Pablo; original en
// 01_Pablo/04_Contenido/marketing/_diseno/escenas/pablo-estudiando.png).
// Abajo el paso a paso para redimirlo, con las palabras de Rodrigo:
//   1. registrarse gratis con el correo .edu (o saltar si ya tiene cuenta),
//   2. aplicar a la beca komunitaria con el formulario de abajo,
//   3. en 48 horas tiene Pablo Pro desbloqueado por 30 días.
//
// El formulario pide solo lo que dijo Rodrigo: el correo con el que se
// registró, su correo educativo y la foto de su carné vigente (más la casilla
// de consentimiento de datos). Manda multipart a la edge function
// solicitud-estudiante (pablo-finance-pal): la foto queda en un bucket
// privado y al equipo le llega un correo con la solicitud. Las reglas del
// correo .edu y de la foto viven en src/lib/estudiante.ts.
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const REGISTRO = "/onboarding?utm_source=estudiante&utm_medium=landing&utm_campaign=beca_komunitaria";
---

<Layout
  title="Pablo Pro gratis para universitarios — Beca komunitaria"
  description="Regístrate gratis en Pablo con tu correo .edu, aplica a la beca komunitaria y en las próximas 48 horas tendrás Pablo Pro desbloqueado por 30 días."
>
  <Navbar />
  <main class="pro-page">
    <section class="hero">
      <div class="container hero__grid">
        <div class="hero__texto">
          <p class="eyebrow">beca komunitaria · universitarios</p>
          <h1>Pablo Pro</h1>
          <p class="bajada">30 días gratis para universitarios, con la beca komunitaria.</p>
          <a href="#pasos" class="btn-amber">Cómo redimirlo <span aria-hidden="true">↓</span></a>
        </div>
        <div class="hero__foto">
          <img
            src="/estudiante/pablo-estudiando.webp"
            alt="Pablo estudiando en su escritorio con sus libros y su laptop"
            width="1200"
            height="1200"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section id="pasos" class="pasos-section">
      <div class="container">
        <h2>Cómo redimirlo</h2>
        <ol class="pasos">
          <li class="paso">
            <span class="paso__n" aria-hidden="true">1</span>
            <div class="paso__cuerpo">
              <p class="paso__label">Paso 1</p>
              <p class="paso__titulo">Regístrate gratis a Pablo con tu correo .edu</p>
              <p class="paso__nota">(si ya tienes una cuenta con otro correo, sigue al paso 2)</p>
              <a href={REGISTRO} class="btn-amber btn-amber--chico" id="estudiante-cta-registro">Registrarme gratis</a>
            </div>
          </li>
          <li class="paso">
            <span class="paso__n" aria-hidden="true">2</span>
            <div class="paso__cuerpo">
              <p class="paso__label">Paso 2</p>
              <p class="paso__titulo">Aplica para la beca komunitaria haciendo clic en el formulario de abajo</p>
              <a href="#formulario" class="btn-navy btn-amber--chico" id="estudiante-cta-formulario">Aplicar a la beca</a>
            </div>
          </li>
          <li class="paso">
            <span class="paso__n" aria-hidden="true">3</span>
            <div class="paso__cuerpo">
              <p class="paso__label">Paso 3</p>
              <p class="paso__titulo">Y listo: en las próximas 48 horas tendrás desbloqueado a Pablo Pro por 30 días</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section id="formulario" class="form-section">
      <div class="container">
        <div id="form-wrap" class="tarjeta">
          <h2>Beca komunitaria</h2>
          <p class="tarjeta__bajada">Llénalo cuando ya tengas tu cuenta en Pablo.</p>

          <form id="estudiante-form" novalidate>
            <div class="field-group">
              <label for="correo-registrado">Correo con el que te registraste en Pablo <span class="required">*</span></label>
              <input type="email" id="correo-registrado" name="correo_registrado" required autocomplete="email" inputmode="email" maxlength="120" placeholder="tucorreo@gmail.com" />
              <span class="field-error" data-for="correo_registrado"></span>
            </div>

            <div class="field-group">
              <label for="correo-edu">Tu correo educativo (.edu) <span class="required">*</span></label>
              <input type="email" id="correo-edu" name="correo_edu" required inputmode="email" maxlength="120" placeholder="a20231234@pucp.edu.pe" />
              <span class="field-hint">El de tu universidad, con .edu (por ejemplo, @pucp.edu.pe). Si te registraste con él, repítelo aquí.</span>
              <span class="field-error" data-for="correo_edu"></span>
            </div>

            <div class="field-group">
              <label for="carne">Foto de tu carné universitario vigente <span class="required">*</span></label>
              <div class="file-drop" id="file-drop">
                <input type="file" id="carne" name="carne" accept="image/*" required />
                <div class="file-drop__content">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <circle cx="8.5" cy="11" r="2" />
                    <path d="M13 10h5M13 13h4M6 16h6" />
                  </svg>
                  <p id="file-label">Toca para tomar o subir la foto</p>
                  <span>JPG, PNG, WEBP o HEIC · Máx. 8 MB</span>
                </div>
                <img id="file-preview" class="file-preview" alt="Vista previa de tu carné" hidden />
              </div>
              <span class="field-error" data-for="carne"></span>
            </div>

            <label class="check">
              <input type="checkbox" id="acepto" name="acepto_datos" />
              <span>Acepto que Pablo use estos datos y la foto de mi carné solo para verificar que soy estudiante.</span>
            </label>
            <span class="field-error" data-for="acepto"></span>

            <div class="form-footer">
              <button type="submit" class="btn-submit" id="submit-btn">
                Enviar solicitud <span class="btn-arrow">→</span>
              </button>
            </div>

            <div id="form-error-msg" class="form-error-msg" role="alert" hidden></div>
          </form>
        </div>

        <div id="form-success" class="success-state" hidden>
          <img class="success-icon" src="/landing/iconos/check.webp" alt="" aria-hidden="true" width="240" height="240" />
          <h2>¡Listo!</h2>
          <p>
            En las <strong>próximas 48 horas</strong> tendrás desbloqueado a <strong>Pablo Pro por 30 días</strong>.
            Te avisamos a <strong id="success-correo">tu correo</strong>.
          </p>
          <a href="/" class="btn-back">Volver al inicio</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import { ENDPOINT_ESTUDIANTE, TIPOS_CARNE, errorCarne, esCorreo, esCorreoEdu } from "../lib/estudiante";

  const form = document.getElementById("estudiante-form") as HTMLFormElement | null;
  const formWrap = document.getElementById("form-wrap");
  const successEl = document.getElementById("form-success");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
  const formErrorMsg = document.getElementById("form-error-msg");
  const fileDrop = document.getElementById("file-drop");
  const fileInput = document.getElementById("carne") as HTMLInputElement | null;
  const fileLabel = document.getElementById("file-label");
  const filePreview = document.getElementById("file-preview") as HTMLImageElement | null;

  function mostrarArchivo(f: File | undefined) {
    if (!f || !fileLabel) return;
    fileLabel.textContent = f.name;
    if (filePreview && f.type !== "image/heic" && f.type !== "image/heif") {
      filePreview.src = URL.createObjectURL(f);
      filePreview.hidden = false;
    }
  }

  fileInput?.addEventListener("change", () => mostrarArchivo(fileInput.files?.[0]));
  fileDrop?.addEventListener("dragover", (e) => {
    e.preventDefault();
    fileDrop.classList.add("is-over");
  });
  fileDrop?.addEventListener("dragleave", () => fileDrop.classList.remove("is-over"));
  fileDrop?.addEventListener("drop", (e) => {
    e.preventDefault();
    fileDrop.classList.remove("is-over");
    const f = e.dataTransfer?.files?.[0];
    if (f && fileInput) {
      const dt = new DataTransfer();
      dt.items.add(f);
      fileInput.files = dt.files;
      mostrarArchivo(f);
    }
  });

  function showError(name: string, msg: string) {
    const el = document.querySelector(`[data-for="${name}"]`);
    if (el) el.textContent = msg;
  }
  function clearErrors() {
    document.querySelectorAll(".field-error").forEach((el) => (el.textContent = ""));
  }

  /** Las fotos del celular pesan varios MB: si el navegador puede leerla, se
   *  achica a 2000 px de lado mayor en JPEG antes de subirla. HEIC u otras que
   *  el navegador no lea se mandan tal cual (el servidor acepta hasta 8 MB). */
  async function achicar(f: File): Promise<File> {
    if (f.size < 1_500_000 || !["image/jpeg", "image/png", "image/webp"].includes(f.type)) return f;
    try {
      const bitmap = await createImageBitmap(f);
      const escala = Math.min(1, 2000 / Math.max(bitmap.width, bitmap.height));
      const canvas = document.createElement("canvas");
      canvas.width = Math.round(bitmap.width * escala);
      canvas.height = Math.round(bitmap.height * escala);
      canvas.getContext("2d")?.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((ok) => canvas.toBlob(ok, "image/jpeg", 0.85));
      if (!blob || blob.size >= f.size) return f;
      return new File([blob], f.name.replace(/\.\w+$/, "") + ".jpg", { type: "image/jpeg" });
    } catch {
      return f;
    }
  }

  function origen(): string {
    const datos: Record<string, unknown> = { pagina: "/estudiante" };
    try {
      const params = new URLSearchParams(location.search);
      for (const k of ["utm_source", "utm_medium", "utm_campaign", "utm_content"]) {
        const v = params.get(k);
        if (v) datos[k] = v;
      }
      const atrib = localStorage.getItem("pablo_atrib_v1");
      if (atrib) datos.atribucion = JSON.parse(atrib);
    } catch {
      /* sin atribución */
    }
    return JSON.stringify(datos).slice(0, 1900);
  }

  function restaurarBoton() {
    if (!submitBtn) return;
    submitBtn.disabled = false;
    submitBtn.innerHTML = 'Enviar solicitud <span class="btn-arrow">→</span>';
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearErrors();
    if (formErrorMsg) formErrorMsg.hidden = true;

    const fd = new FormData(form);
    const correoRegistrado = String(fd.get("correo_registrado") ?? "").trim().toLowerCase();
    const correoEdu = String(fd.get("correo_edu") ?? "").trim().toLowerCase();
    const acepto = (document.getElementById("acepto") as HTMLInputElement | null)?.checked === true;
    const original = fileInput?.files?.[0] ?? null;

    let ok = true;
    if (!esCorreo(correoRegistrado)) {
      showError("correo_registrado", "Escribe el correo con el que te registraste en Pablo.");
      ok = false;
    }
    if (!esCorreoEdu(correoEdu)) {
      showError("correo_edu", "Necesitamos tu correo educativo con .edu (por ejemplo, a20231234@pucp.edu.pe).");
      ok = false;
    }
    // El peso se revisa después de achicarla: aquí solo que haya foto y sea imagen.
    const errFoto = !original ? errorCarne(null) : !TIPOS_CARNE.includes(original.type) ? errorCarne(original) : null;
    if (errFoto) {
      showError("carne", errFoto);
      ok = false;
    }
    if (!acepto) {
      showError("acepto", "Marca la casilla para que podamos revisar tu carné.");
      ok = false;
    }
    if (!ok || !original) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Enviando…";
    }

    const carne = await achicar(original);
    const errPeso = errorCarne(carne);
    if (errPeso) {
      showError("carne", errPeso);
      restaurarBoton();
      return;
    }

    const datos = new FormData();
    datos.append("correo_registrado", correoRegistrado);
    datos.append("correo_edu", correoEdu);
    datos.append("acepto_datos", "true");
    datos.append("origen", origen());
    datos.append("carne", carne, carne.name);

    try {
      const res = await fetch(ENDPOINT_ESTUDIANTE, { method: "POST", body: datos });
      const cuerpo = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (formErrorMsg) {
          formErrorMsg.textContent = cuerpo?.error || "No pudimos enviar tu solicitud. Inténtalo de nuevo.";
          formErrorMsg.hidden = false;
        }
        restaurarBoton();
        return;
      }
      try {
        (window as any).posthog?.capture?.("estudiante_beca_solicitada");
      } catch {
        /* analítica opcional */
      }
      const correoEl = document.getElementById("success-correo");
      if (correoEl) correoEl.textContent = correoRegistrado;
      if (formWrap) formWrap.hidden = true;
      if (successEl) successEl.hidden = false;
      successEl?.scrollIntoView({ behavior: "smooth", block: "center" });
    } catch {
      if (formErrorMsg) {
        formErrorMsg.textContent = "No pudimos conectarnos. Revisa tu internet e inténtalo de nuevo.";
        formErrorMsg.hidden = false;
      }
      restaurarBoton();
    }
  });
</script>

<style>
  .pro-page {
    background: var(--bg-page);
    padding-bottom: 110px;
  }

  .container {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  /* Hero */
  .hero {
    padding: 48px 0 24px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
  }

  .eyebrow {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin: 0 0 10px;
  }

  .hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(3.2rem, 9vw, 5.4rem);
    line-height: 1;
    color: var(--color-heading);
    margin: 0 0 18px;
    letter-spacing: -0.02em;
  }

  .bajada {
    font-size: 1.2rem;
    color: var(--color-body);
    line-height: 1.6;
    margin: 0 0 28px;
    max-width: 420px;
  }

  .hero__foto img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 32px;
    box-shadow: 0 18px 50px rgba(43, 44, 100, 0.16);
  }

  /* Botones */
  .btn-amber,
  .btn-navy {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 15px 30px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .btn-amber {
    background: var(--color-amber);
    color: var(--color-heading);
    box-shadow: 0 4px 0 0 #c9820a;
  }

  .btn-navy {
    background: var(--color-heading);
    color: white;
    box-shadow: 0 4px 0 0 #17184a;
  }

  .btn-amber:hover,
  .btn-navy:hover {
    transform: translateY(-2px);
  }

  .btn-amber--chico {
    font-size: 0.95rem;
    padding: 11px 22px;
    margin-top: 14px;
  }

  /* Paso a paso */
  .pasos-section {
    padding: 48px 0 24px;
  }

  .pasos-section h2,
  .tarjeta h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4.5vw, 2.4rem);
    color: var(--color-heading);
    margin: 0 0 24px;
    text-align: center;
  }

  .pasos {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    max-width: 680px;
    display: grid;
    gap: 16px;
  }

  .paso {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: white;
    border-radius: var(--radius-lg);
    padding: 22px 24px;
    box-shadow: var(--card-shadow);
  }

  .paso__n {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-amber);
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.2rem;
  }

  .paso__label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin: 2px 0 4px;
  }

  .paso__titulo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.35;
    color: var(--color-heading);
    margin: 0;
  }

  .paso__nota {
    font-size: 0.92rem;
    color: var(--color-body);
    margin: 6px 0 0;
    line-height: 1.5;
  }

  /* Formulario */
  .form-section {
    padding: 48px 0 0;
    scroll-margin-top: 80px;
  }

  .tarjeta {
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--card-shadow);
    padding: 36px 32px;
    max-width: 640px;
    margin: 0 auto;
  }

  .tarjeta h2 {
    margin-bottom: 8px;
  }

  .tarjeta__bajada {
    text-align: center;
    color: var(--color-body);
    margin: 0 0 24px;
  }

  #estudiante-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .field-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field-group > label {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-heading);
  }

  .required {
    color: #e53e3e;
    margin-left: 2px;
  }

  input[type="email"] {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid rgba(43, 44, 100, 0.2);
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-family: var(--font-body);
    color: var(--color-heading);
    background: white;
    transition: border-color 0.15s;
    outline: none;
    box-sizing: border-box;
  }

  input[type="email"]:focus {
    border-color: var(--color-purple);
  }

  input::placeholder {
    color: rgba(43, 44, 100, 0.35);
  }

  .field-hint {
    font-size: 0.8rem;
    color: var(--color-secondary);
    line-height: 1.45;
  }

  .file-drop {
    position: relative;
    border: 2px dashed rgba(43, 44, 100, 0.25);
    border-radius: var(--radius-md);
    background: rgba(43, 44, 100, 0.02);
    padding: 28px 20px;
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }

  .file-drop:hover,
  .file-drop.is-over {
    border-color: var(--color-purple);
    background: rgba(43, 44, 100, 0.04);
  }

  .file-drop input[type="file"] {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .file-drop__content {
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--color-secondary);
  }

  .file-drop__content p {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-heading);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .file-drop__content span {
    font-size: 0.78rem;
    opacity: 0.7;
  }

  .file-preview {
    display: block;
    max-width: 100%;
    max-height: 220px;
    margin: 16px auto 0;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(43, 44, 100, 0.15);
  }

  .file-preview[hidden] {
    display: none;
  }

  .check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 6px;
    font-size: 0.88rem;
    color: var(--color-body);
    line-height: 1.5;
    cursor: pointer;
  }

  .check input {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    flex-shrink: 0;
    accent-color: var(--color-purple);
  }

  .field-error {
    font-size: 0.8rem;
    color: #e53e3e;
    min-height: 16px;
  }

  .form-footer {
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--color-amber);
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    padding: 15px 34px;
    border-radius: var(--radius-pill);
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 0 0 #c9820a;
    transition: transform 0.2s ease;
  }

  .btn-submit:hover:not(:disabled) {
    transform: translateY(-2px);
  }

  .btn-submit .btn-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .btn-submit:hover:not(:disabled) .btn-arrow {
    transform: translateX(4px);
  }

  .btn-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-error-msg {
    text-align: center;
    font-size: 0.9rem;
    color: #e53e3e;
    background: rgba(229, 62, 62, 0.06);
    border-radius: var(--radius-md);
    padding: 12px 20px;
  }

  /* Éxito */
  .success-state {
    text-align: center;
    padding: 40px 0 24px;
  }

  .success-icon {
    width: 88px;
    height: 88px;
    object-fit: contain;
    display: block;
    margin: 0 auto 20px;
    filter: drop-shadow(0 10px 14px rgba(43, 44, 100, 0.2));
  }

  .success-state h2 {
    font-family: var(--font-heading);
    font-size: 1.9rem;
    color: var(--color-heading);
