---
// /libro-de-reclamaciones — Libro de Reclamaciones virtual de Pablo (código PABLO-001).
// Textos: LIBRO_RECLAMACIONES_TEXTOS_FINALES_v1 (Legal, 19-nov-2026). Los datos viajan a la función libro-reclamaciones
// (pablo-finance-pal), que los guarda en la base del producto y manda las copias por correo. Aquí no se guarda nada.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Libro de Reclamaciones — Pablo"
  description="Libro de Reclamaciones virtual de Pablo (Komu AI E.I.R.L.). Presenta un reclamo o una queja y recibe una copia en tu correo."
>
  <Navbar />

  <main class="legal-page">
    <div class="container legal-page__inner">

      <nav class="legal-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span>›</span>
        <span>Libro de Reclamaciones</span>
      </nav>

      <div class="legal-header">
        <div class="legal-badge">📖 Libro de Reclamaciones</div>
        <h1 class="legal-title">Libro de Reclamaciones</h1>
        <p class="legal-updated">Hoja de reclamación virtual · código PABLO-001</p>
      </div>

      <article class="legal-content">
        <section class="no-imprimir">
          <h2>Datos del proveedor</h2>
          <dl class="libro-datos">
            <dt>Proveedor</dt><dd>KOMU AI SOFTWARE DEVELOPMENT EMPRESA INDIVIDUAL DE RESPONSABILIDAD LIMITADA (KOMU AI E.I.R.L.) · nombre comercial: Pablo</dd>
            <dt>RUC</dt><dd>20616368185</dd>
            <dt>Dirección</dt><dd>Calle Luis Felipe Villarán 120, Urb. Santa Cruz, San Isidro, Lima</dd>
          </dl>
        </section>

        <div id="libro-envio">
        <form class="libro-form" id="libro-form" novalidate>
          <p class="libro-trampa" aria-hidden="true"><label>No llenar este campo <input type="text" name="sitio_web" tabindex="-1" autocomplete="off" /></label></p>

          <fieldset>
            <legend>1. Identificación del consumidor reclamante</legend>
            <label for="nombre">Nombres y apellidos</label>
            <input id="nombre" name="nombre" type="text" autocomplete="name" maxlength="120" required />
            <div class="fila">
              <div>
                <label for="documento_tipo">Tipo de documento</label>
                <select id="documento_tipo" name="documento_tipo"><option value="DNI">DNI</option><option value="CE">Carné de extranjería (CE)</option></select>
              </div>
              <div>
                <label for="documento_numero">Número de documento</label>
                <input id="documento_numero" name="documento_numero" type="text" maxlength="12" required />
              </div>
            </div>
            <label for="domicilio">Domicilio</label>
            <input id="domicilio" name="domicilio" type="text" autocomplete="street-address" maxlength="200" required />
            <div class="fila">
              <div>
                <label for="telefono">Teléfono</label>
                <input id="telefono" name="telefono" type="tel" autocomplete="tel" maxlength="20" required />
              </div>
              <div>
                <label for="correo">Correo electrónico</label>
                <input id="correo" name="correo" type="email" autocomplete="email" maxlength="254" required />
                <p class="ayuda">A este correo llega la copia de tu hoja.</p>
              </div>
            </div>
            <label class="opcion"><input type="checkbox" id="es_menor" name="es_menor" /> Soy menor de edad</label>
            <div id="bloque-menor" hidden>
              <label for="representante_nombre">Nombre de tu padre, madre o representante</label>
              <input id="representante_nombre" name="representante_nombre" type="text" maxlength="120" />
              <div class="fila">
                <div><label for="representante_documento">Su documento</label><input id="representante_documento" name="representante_documento" type="text" maxlength="20" /></div>
                <div><label for="representante_correo">Su correo</label><input id="representante_correo" name="representante_correo" type="email" maxlength="254" /></div>
              </div>
            </div>
          </fieldset>

          <fieldset>
            <legend>2. Identificación del bien contratado</legend>
            <div class="fila">
              <div>
                <label for="bien_tipo">Tipo</label>
                <select id="bien_tipo" name="bien_tipo"><option value="servicio" selected>Servicio</option><option value="producto">Producto</option></select>
              </div>
              <div class="fila fila-monto">
                <div><label for="monto_reclamado">Monto reclamado (opcional)</label><input id="monto_reclamado" name="monto_reclamado" type="number" min="0" step="0.01" inputmode="decimal" /></div>
                <div><label for="moneda">Moneda</label><select id="moneda" name="moneda"><option value="PEN">S/</option><option value="USD">US$</option></select></div>
              </div>
            </div>
            <label for="bien_descripcion">Descripción</label>
            <input id="bien_descripcion" name="bien_descripcion" type="text" maxlength="200" placeholder="Suscripción Pablo mensual" required />
          </fieldset>

          <fieldset>
            <legend>3. Detalle de la reclamación y pedido del consumidor</legend>
            <label class="opcion"><input type="radio" name="tipo" value="reclamo" checked /> <span><strong>Reclamo:</strong> disconformidad relacionada con los productos o servicios.</span></label>
            <label class="opcion"><input type="radio" name="tipo" value="queja" /> <span><strong>Queja:</strong> disconformidad no relacionada con los productos o servicios, o malestar o descontento respecto a la atención al público.</span></label>
            <label for="detalle">Detalle</label>
            <textarea id="detalle" name="detalle" maxlength="3000" required></textarea>
            <label for="pedido">Pedido</label>
            <textarea id="pedido" name="pedido" maxlength="2000" required></textarea>
          </fieldset>

          <label class="opcion">
            <input type="checkbox" id="declaracion_aceptada" name="declaracion_aceptada" />
            <span>Declaro que los datos consignados son verdaderos. Autorizo a KOMU AI E.I.R.L. a usarlos solo para atender este reclamo o queja, según su <a href="/privacidad" target="_blank" rel="noopener">Política de Privacidad</a>.</span>
          </label>

          <p class="ayuda">La formulación del reclamo no impide acudir a otras vías de solución de controversias ni es requisito previo para interponer una denuncia ante el Indecopi.</p>
          <p class="ayuda">El proveedor deberá dar respuesta al reclamo o queja en un plazo no mayor a quince (15) días hábiles.</p>
          <div class="libro-falla" id="libro-falla" role="alert" hidden></div>
          <div class="libro-acciones"><button class="libro-btn" type="submit" id="libro-enviar">Enviar</button></div>
        </form>
        </div>

        <section id="libro-ok" aria-live="polite" hidden>
          <h2>Recibimos tu hoja</h2>
          <p id="libro-ok-texto"></p>
          <div class="libro-hoja" id="libro-ok-hoja"></div>
          <div class="libro-acciones no-imprimir">
            <button class="libro-btn" type="button" id="libro-pdf">Descargar o imprimir mi hoja</button>
            <a class="libro-btn sec" href="/" style="text-decoration:none">Volver al inicio</a>
          </div>
        </section>
      </article>

    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { ENDPOINT_LIBRO, base64ABytes, erroresHoja, mensajeConfirmacion, type HojaForm } from "../lib/libro";

  const f = document.getElementById("libro-form") as HTMLFormElement;
  const $ = (id: string) => document.getElementById(id)!;
  const val = (n: string) => ((f.elements.namedItem(n) as HTMLInputElement | null)?.value ?? "").trim();
  const marca = (n: string, msg: string) => {
    const el = f.elements.namedItem(n);
    if (!(el instanceof HTMLElement)) return;   // «tipo» es un grupo de radios: no tiene error propio
    el.removeAttribute("aria-invalid");
    el.parentElement?.querySelector(`[data-error="${n}"]`)?.remove();
    if (!msg) return;
    el.setAttribute("aria-invalid", "true");
    const p = document.createElement("p");
    p.className = "error"; p.dataset.error = n; p.setAttribute("role", "alert"); p.textContent = msg;
    el.insertAdjacentElement("afterend", p);
  };
  ($("es_menor") as HTMLInputElement).addEventListener("change", (e) => { $("bloque-menor").hidden = !(e.target as HTMLInputElement).checked; });
  let pdfBase64: string | null = null;
  let numero = "";

  function datos(): HojaForm & Record<string, string | boolean> {
    return {
      nombre: val("nombre"), documento_tipo: val("documento_tipo"), documento_numero: val("documento_numero").toUpperCase(), domicilio: val("domicilio"),
      telefono: val("telefono"), correo: val("correo"), es_menor: ($("es_menor") as HTMLInputElement).checked,
      representante_nombre: val("representante_nombre"), representante_documento: val("representante_documento"), representante_correo: val("representante_correo"),
      bien_tipo: val("bien_tipo"), bien_descripcion: val("bien_descripcion"), monto_reclamado: val("monto_reclamado"), moneda: val("moneda"),
      tipo: (f.elements.namedItem("tipo") as RadioNodeList).value, detalle: val("detalle"), pedido: val("pedido"),
      declaracion_aceptada: ($("declaracion_aceptada") as HTMLInputElement).checked, sitio_web: val("sitio_web"),
    };
  }

  f.addEventListener("submit", async (e) => {
    e.preventDefault();
    $("libro-falla").hidden = true;
    const d = datos();
    const errores = erroresHoja(d);
    for (const n of Object.keys(d)) marca(n, errores[n] ?? "");
    const primero = Object.keys(errores)[0];
    if (primero) { (f.elements.namedItem(primero) as HTMLElement | null)?.focus?.(); return; }
    const boton = $("libro-enviar") as HTMLButtonElement;
    boton.disabled = true; boton.textContent = "Enviando…";
    try {
      const res = await fetch(ENDPOINT_LIBRO, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(d), signal: AbortSignal.timeout(45_000) });
      const j = await res.json().catch(() => ({}));
      if (res.status === 400 && j.campos) { for (const [n, m] of Object.entries(j.campos)) marca(n, String(m)); throw new Error("Revisa los campos marcados."); }
      if (!res.ok) throw new Error(j.error || "No pudimos registrar tu hoja. Inténtalo de nuevo o escríbenos a team@usapablo.com.");
      pdfBase64 = j.pdf_base64 ?? null; numero = j.numero;
      $("libro-ok-texto").textContent = mensajeConfirmacion(j);
      $("libro-ok-hoja").textContent = `Hoja de reclamación N.° ${j.numero} · ${j.fecha}\nTipo: ${j.tipo}\nConsumidor: ${d.nombre}\nCorreo: ${d.correo}\nDetalle: ${d.detalle}\nPedido: ${d.pedido}`;
      ($("libro-pdf") as HTMLButtonElement).textContent = pdfBase64 ? "Descargar mi hoja (PDF)" : "Imprimir mi hoja";
      $("libro-envio").hidden = true; $("libro-ok").hidden = false;
      $("libro-ok").scrollIntoView({ behavior: "smooth", block: "start" });
    } catch (err) {
      const falla = $("libro-falla");
      falla.textContent = err instanceof Error ? err.message : "No pudimos registrar tu hoja.";
      falla.hidden = false; boton.disabled = false; boton.textContent = "Enviar";
    }
  });

  $("libro-pdf").addEventListener("click", () => {
    if (!pdfBase64) { window.print(); return; }
    const url = URL.createObjectURL(new Blob([base64ABytes(pdfBase64)], { type: "application/pdf" }));
    const a = document.createElement("a");
    a.href = url; a.download = `hoja-de-reclamacion-${numero}.pdf`; a.click();
    setTimeout(() => URL.revokeObjectURL(url), 10_000);
  });
</script>

<style>
  .legal-page {
    background: var(--bg-body, #F5F4FF);
    min-height: 100vh;
    padding: 60px 0 80px;
  }

  .legal-page__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .legal-breadcrumb {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--color-body, #5C5E84);
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .legal-breadcrumb a {
    color: var(--color-brand, #2B2C64);
    font-weight: 500;
    text-decoration: none;
  }

  .legal-breadcrumb a:hover {
    text-decoration: underline;
  }

  .legal-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .legal-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #EAE8FF;
    color: var(--color-brand, #2B2C64);
    font-size: 12px;
    font-weight: 600;
    padding: 5px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }

  .legal-title {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 700;
    color: var(--color-heading, #1A1B4B);
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .legal-subtitle {
    font-size: 16px;
    color: var(--color-body, #5C5E84);
    margin-bottom: 6px;
  }

  .legal-updated {
    font-size: 13px;
    color: var(--color-body, #5C5E84);
  }

  .legal-summary {
    background: var(--color-heading);
    border-radius: 14px;
    padding: 18px 24px;
    margin-bottom: 48px;
    text-align: center;
  }

  .legal-summary p {
    font-size: 15px;
    color: white;
    line-height: 1.6;
    margin: 0;
  }

  .legal-summary strong {
    color: var(--color-amber);
  }

  .legal-content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .legal-content section h2 {
    font-family: var(--font-heading, 'Outfit', sans-serif);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-heading, #1A1B4B);
    margin-bottom: 14px;
  }

  .legal-content section p {
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-body, #5C5E84);
    margin-bottom: 12px;
  }

  .legal-content section p:last-child {
    margin-bottom: 0;
  }

  .legal-content ul,
  .legal-content ol {
    padding-left: 20px;
    margin-bottom: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .legal-content li {
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-body, #5C5E84);
  }

  .legal-content a {
    color: var(--color-brand, #2B2C64);
    text-decoration: underline;
    font-weight: 500;
  }

  .legal-content a:hover {
    opacity: 0.75;
  }

  .legal-footer-note {
    margin-top: 60px;
    padding: 24px 28px;
    background: white;
    border-radius: 16px;
    border: 1px solid #E5E3F0;
    font-size: 14px;
    color: var(--color-body, #5C5E84);
    text-align: center;
  }

  .legal-footer-note p {
    margin-bottom: 8px;
  }

  .legal-footer-note a {
    color: var(--color-brand, #2B2C64);
    font-weight: 600;
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .legal-page {
      padding: 40px 0 60px;
    }

    .legal-content section h2 {
      font-size: 18px;
    }

    .legal-content section p,
    .legal-content li {
      font-size: 14px;
    }
  }

  .libro-form { background: #fff; border: 1px solid #E5E3F0; border-radius: 16px; padding: 22px 24px; margin: 24px 0; }
  .libro-form fieldset { border: 0; padding: 0; margin: 22px 0 0; min-width: 0; }
  .libro-form legend { font-weight: 700; font-size: 18px; color: var(--color-brand, #2B2C64); margin-bottom: 8px; padding: 0; }
  .libro-form label { display: block; font-weight: 600; font-size: 14px; margin: 14px 0 4px; color: var(--color-brand, #2B2C64); }
  .libro-form input[type=text], .libro-form input[type=email], .libro-form input[type=tel], .libro-form input[type=number], .libro-form select, .libro-form textarea {
    width: 100%; font: inherit; font-size: 16px; padding: 11px 12px; border: 1.5px solid #C9C7E0; border-radius: 12px; background: #fff; color: #2B2C64; }
  .libro-form textarea { min-height: 120px; resize: vertical; }
  .libro-form [aria-invalid="true"] { border-color: #c0392b; }
  .libro-form .fila { display: grid; gap: 0 14px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .libro-form .fila { grid-template-columns: 1fr 1fr; } .libro-form .fila-monto { grid-template-columns: 2fr 1fr; } }
  .libro-form .opcion { display: flex; gap: 10px; align-items: flex-start; font-weight: 400; margin: 10px 0; }
  .libro-form .opcion input { margin-top: 5px; }
  .libro-form .ayuda { color: #6b6c93; font-size: 13px; margin: 4px 0 0; }
  .libro-form .error { color: #c0392b; font-size: 13px; margin: 4px 0 0; }
  .libro-trampa { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .libro-btn { font: inherit; font-weight: 700; font-size: 16px; padding: 14px 26px; border: 0; border-radius: 14px; background: var(--color-amber, #F5A623); color: #2B2C64; cursor: pointer; }
  .libro-btn.sec { background: #fff; border: 1.5px solid #2B2C64; }
  .libro-btn[disabled] { opacity: .6; cursor: progress; }
  .libro-acciones { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 20px; }
  .libro-falla { background: #fdeee8; border: 1.5px solid #c0392b; border-radius: 12px; padding: 12px 14px; margin-top: 16px; color: #2B2C64; }
  .libro-hoja { white-space: pre-wrap; background: #fff; border: 1px solid #E5E3F0; border-radius: 14px; padding: 16px; margin: 16px 0; font-size: 14px; line-height: 1.5; }
  .libro-datos dt { font-weight: 700; margin-top: 8px; color: var(--color-brand, #2B2C64); } .libro-datos dd { margin: 0; }
  @media print { :global(nav), :global(footer), .libro-form, .legal-breadcrumb, .no-imprimir { display: none !important; } }
</style>
