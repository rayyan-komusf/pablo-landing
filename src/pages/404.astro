---
// 404 — pantalla de carga de Pablo. No tiene botón: manda solo al home.
//
// nginx la sirve con status 404 DE VERDAD (`error_page 404 /404.html` en
// nginx.conf), no con un 302. Así Google saca la URL muerta del índice — un
// redirect a 200 sería un soft 404 — y el visitante igual termina en el home.
//
// Página standalone (mismo patrón que /planes): sin Navbar, sin popups y sin
// webfonts, para que cargue instantáneo y el caminado se vea antes del salto.
//
// EL CAMINADO. Pablo camina de PERFIL, en su estilo 2D cartoon kawaii (el set
// `visual assets/pablo_2d_fullbody/`, master M4), sobre un terrón de suelo
// dibujado en SVG acá abajo.
//
// Es un sprite sheet de 4 celdas (61 KB, un archivo) con una animación CSS de
// steps(): sin video y sin JS. Sólo hay 3 dibujos: en un perfil 2D el contacto
// con la otra pierna se ve casi idéntico (las dos piernas son del mismo crema y
// sólo cambia cuál va delante), así que el ciclo honesto es abierta ↔ juntas:
//
//     1 contacto (abierta)  →  2 juntas (arriba)
//     3 empuje  (ancha)     →  2 juntas (arriba)
//
// El rebote está horneado en el sprite en píxeles, no heredado del modelo: el
// sprite es una sola imagen de fondo y el CSS no puede desplazar celdas suelvas.
// Receta, scripts y las poses descartadas: "visual assets/_404_pablo_caminando/".
const DESTINO = '/';
const FRAMES = 4;
const CICLO = '0.7s';
const ESPERA_MS = 2600;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`3; url=${DESTINO}`} />
    <link rel="canonical" href="https://www.usapablo.com/" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" as="image" href="/404/pablo-caminando.webp" />
    <title>Un momento — Pablo</title>

    <script is:inline define:vars={{ DESTINO, ESPERA_MS }}>
      // replace() y no href: así el 404 no queda en el historial y el botón
      // "atrás" del navegador no rebota al usuario de vuelta acá.
      setTimeout(function () {
        window.location.replace(DESTINO);
      }, ESPERA_MS);
    </script>

    <style define:vars={{ frames: FRAMES }}>
      :root {
        --lila: #f5f3ff;
        --navy: #2b2c64;
        --body: #56578f;
        --ambar: #f5a623;
        --tinta: #4a3527;   /* la línea de tinta del Pablo 2D */
        --tierra: #e9dcbe;  /* tono tierra del suelo: más oscuro que su crema */
        --pablo: 190px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        background: var(--lila);
        color: var(--navy);
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        text-align: center;
        padding: 24px;
      }

      .carga { display: flex; flex-direction: column; align-items: center; }

      /* Pablo y su suelo comparten caja, para que las botas caigan encima. */
      .escena {
        position: relative;
        width: var(--pablo);
        height: var(--pablo);
      }

      /* Pablo caminando de perfil. El recorrido va en PÍXELES, no en
         porcentaje: con porcentajes los steps() no caen en el límite de cada
         celda y el sprite se ve cortado a mitad de camino. */
      .pablo {
        position: absolute;
        inset: 0;
        background-image: url('/404/pablo-caminando.webp');
        background-repeat: no-repeat;
        background-size: calc(var(--pablo) * var(--frames)) var(--pablo);
        background-position: 0 0;
        z-index: 2;
      }

      @keyframes caminar {
        to { background-position-x: calc(var(--pablo) * var(--frames) * -1); }
      }

      /* El terrón de suelo: un poquito de piso bajo sus pies, dibujado con la
         misma tinta gruesa y el mismo crema que el Pablo 2D. */
      .suelo {
        position: absolute;
        left: 50%;
        bottom: calc(var(--pablo) * -0.035);
        width: calc(var(--pablo) * 0.62);
        transform: translateX(-50%);
        z-index: 1;
        overflow: visible;
      }

      /* Sombra de contacto sobre el suelo: se aplasta en cada pisada. */
      .sombra {
        position: absolute;
        left: 50%;
        bottom: calc(var(--pablo) * 0.075);
        width: calc(var(--pablo) * 0.42);
        height: calc(var(--pablo) * 0.045);
        margin-left: calc(var(--pablo) * -0.21);
        border-radius: 50%;
        background: radial-gradient(
          ellipse at center,
          rgba(74, 53, 39, 0.22) 0%,
          rgba(74, 53, 39, 0) 72%
        );
        z-index: 2;
        animation: pisar 0.175s ease-in-out infinite alternate;
      }

      @keyframes pisar {
        from { transform: scaleX(1); opacity: 1; }
        to   { transform: scaleX(0.84); opacity: 0.7; }
      }

      /* El círculo cargando, debajo de él. */
      .anillo {
        width: 28px;
        height: 28px;
        margin-top: 24px;
        border-radius: 50%;
        border: 3px solid rgba(43, 44, 100, 0.14);
        border-top-color: var(--ambar);
        animation: girar 0.75s linear infinite;
      }

      @keyframes girar {
        to { transform: rotate(360deg); }
      }

      .titulo {
        margin: 22px 0 0;
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .nota {
        margin: 5px 0 0;
        font-size: 0.85rem;
        color: var(--body);
        opacity: 0.75;
      }

      .escape { margin-top: 18px; font-size: 0.9rem; }
      .escape a { color: var(--navy); font-weight: 700; }

      @media (max-width: 420px) {
        :root { --pablo: 150px; }
      }

      /* Quien pidió menos movimiento ve a Pablo quieto. El salto al home igual
         ocurre: eso no es decoración. */
      @media (prefers-reduced-motion: reduce) {
        .pablo, .sombra { animation: none !important; }
        .anillo { animation: none !important; border-top-color: rgba(43, 44, 100, 0.14); }
      }
    </style>
  </head>

  <body>
    <div class="carga">
      <div class="escena">
        <!-- Un terrón de suelo, no una tabla: tiene cuerpo, va en tono tierra
             (más oscuro que el crema de Pablo, si no se funden) y lleva la
             misma tinta gruesa del dibujo 2D. -->
        <svg class="suelo" viewBox="0 0 170 54" aria-hidden="true">
          <path
            d="M9 24 C9 14 26 10 44 9 C70 6 98 6 126 9 C146 11 161 15 161 25 C161 39 138 47 106 47 L62 47 C31 47 9 38 9 24 Z"
            fill="var(--tierra)"
            stroke="var(--tinta)"
            stroke-width="4.6"
            stroke-linejoin="round"
          />
          <path
            d="M20 23 C40 15 68 13 94 14 C118 15 142 18 152 24"
            fill="none"
            stroke="#fffaf0"
            stroke-opacity="0.6"
            stroke-width="3.4"
            stroke-linecap="round"
          />
          <ellipse cx="56" cy="33" rx="5" ry="2.1" fill="var(--tinta)" opacity="0.2" />
          <ellipse cx="122" cy="36" rx="3.6" ry="1.6" fill="var(--tinta)" opacity="0.16" />
        </svg>
        <div class="sombra" aria-hidden="true"></div>
        <div
          class="pablo"
          role="img"
          aria-label="Pablo caminando"
          style={`animation: caminar ${CICLO} steps(${FRAMES}) infinite;`}
        ></div>
      </div>
      <div class="anillo" aria-hidden="true"></div>
      <p class="titulo">Redirigiéndote a la base</p>
      <p class="nota">Esa página no existe</p>
      <noscript>
        <p class="escape"><a href={DESTINO}>Entra acá</a> si no pasa nada.</p>
      </noscript>
    </div>
  </body>
</html>
