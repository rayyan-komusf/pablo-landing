---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import PlantillaLeadModal from "../../components/PlantillaLeadModal.astro";
import FinalCTA from "../../components/sections/FinalCTA.astro";
import { getPosts, getPostBySlug, renderBlocks } from "../../lib/notion";
import { getBlogOverride } from "../../lib/blogOverrides";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const data = await getPostBySlug(slug!);

if (!data) return Astro.redirect("/blog");

const { meta, blocks } = data;
// Este post trae su cuerpo del repo; los demás siguen saliendo de Notion.
const override = getBlogOverride(slug);
const content = override?.contenido ?? renderBlocks(blocks);
// Lead magnet: si el post enlaza la Plantilla de Presupuesto, el link se
// intercepta con un form (nombre + correo → Brevo) antes de entregarla.
const tienePlantilla = content.includes("1PvzGpNJavzwq0-mDEzKakf6jmJIiCSX6");
const fecha = meta.fecha
  ? new Date(meta.fecha).toLocaleDateString("es-PE", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<Layout title={`${meta.title} — Pablo`} description={meta.descripcion}>
  <Navbar />
  <main class="post-page">
    <article class="container">
      <header class="post-header">
        <h1>{meta.title}</h1>
        {meta.descripcion && <p class="post-lead">{meta.descripcion}</p>}
        <div class="post-meta">
          {fecha && <time class="post-date">{fecha}</time>}
          {meta.autor && (
            <>
              <span class="post-meta-sep">|</span>
              <span class="post-autor">{meta.autor}</span>
            </>
          )}
        </div>
      </header>

      {meta.portada && (
        <div class="post-cover">
          <img
            src={meta.portada}
            alt={meta.title}
            width="720"
            height="405"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}

      <div class="post-content" set:html={content} />

      <div class="post-back">
        <a href="/blog">← Volver al blog</a>
      </div>
    </article>
  </main>
  {override?.ctaFinal && <FinalCTA />}
  {tienePlantilla && <PlantillaLeadModal />}
  <Footer />
</Layout>

<style>
  .post-page {
    min-height: 100vh;
    background: var(--bg-page);
    padding-bottom: 120px;
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .post-header {
    padding: 64px 0 32px;
    text-align: center;
  }

  .post-header h1 {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--color-heading);
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .post-lead {
    font-size: 1.1rem;
    color: var(--color-body);
    line-height: 1.7;
    margin-bottom: 24px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .post-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .post-date {
    font-size: 0.82rem;
    color: var(--color-secondary);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .post-meta-sep {
    color: var(--color-secondary);
    opacity: 0.4;
    font-size: 0.82rem;
  }

  .post-autor {
    font-size: 0.82rem;
    color: var(--color-secondary);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .post-cover {
    margin: 32px 0 48px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-height: 480px;
  }

  .post-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-content {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--color-body);
  }

  .post-content :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    color: var(--color-heading);
    margin: 48px 0 16px;
  }

  .post-content :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--color-heading);
    margin: 36px 0 12px;
  }

  .post-content :global(h4) {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-heading);
    margin: 28px 0 10px;
  }

  .post-content :global(p) {
    margin-bottom: 20px;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 16px 0 24px 24px;
  }

  /* global.css quita los marcadores a toda lista; en el cuerpo del post se
     devuelven, que para eso está la sangría de arriba. */
  .post-content :global(ul) {
    list-style: disc;
  }

  .post-content :global(ol) {
    list-style: decimal;
  }

  .post-content :global(li::marker) {
    color: var(--color-amber);
    font-weight: 700;
  }

  .post-content :global(li) {
    margin-bottom: 8px;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-amber);
    padding: 12px 20px;
    margin: 32px 0;
    background: var(--highlight-bg);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-heading);
    font-style: italic;
  }

  .post-content :global(pre) {
    background: var(--color-heading);
    color: #f5f3ff;
    padding: 20px 24px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 24px 0;
    font-size: 0.9rem;
  }

  .post-content :global(code) {
    font-family: "Courier New", monospace;
    font-size: 0.88em;
    background: rgba(43, 44, 100, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }

  .post-content :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
    margin: 32px auto;
    display: block;
  }

  .post-content :global(figure) {
    margin: 32px 0;
    text-align: center;
  }

  .post-content :global(figcaption) {
    font-size: 0.85rem;
    color: var(--color-secondary);
    margin-top: 10px;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid rgba(43, 44, 100, 0.12);
    margin: 48px 0;
  }

  .post-content :global(a) {
    color: var(--color-amber);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-content :global(.blog-btn-wrap) {
    text-align: center;
    margin: 32px 0;
  }

  .post-content :global(.blog-btn) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-amber);
    color: var(--color-heading);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: transform 0.2s ease;
  }

  .post-content :global(.blog-btn:hover) {
    transform: scale(1.05);
  }

  .post-content :global(.blog-btn:hover span) {
    transform: translateX(4px);
  }

  .post-content :global(.blog-btn span) {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .post-content :global(.callout) {
    background: var(--highlight-bg);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    margin: 24px 0;
    color: var(--color-heading);
    font-weight: 500;
  }

  /* Puntaje con estrellas: --puntaje (0 a 5) pinta las cinco estrellas de
     izquierda a derecha, así 4.4 se ve como 4 llenas y la quinta al 40 %. */
  .post-content :global(.blog-puntaje) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: -4px 0 20px;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-heading);
  }

  .post-content :global(.blog-estrellas) {
    display: inline-block;
    font-size: 1.2rem;
    line-height: 1;
    white-space: nowrap;
    background: linear-gradient(
      90deg,
      var(--color-amber) calc(var(--puntaje, 0) * 20%),
      rgba(43, 44, 100, 0.15) 0
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Tabla comparativa: en escritorio sale del ancho del texto (720px) para
     que quepan sus columnas; en móvil cada fila se vuelve una tarjeta con la
     etiqueta de cada dato (data-label) arriba del valor. */
  .post-content :global(.blog-tabla) {
    width: min(1080px, calc(100vw - 48px));
    margin: 24px 0 16px calc(50% - min(540px, 50vw - 24px));
    overflow-x: auto;
    background: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--card-shadow);
  }

  .post-content :global(.blog-tabla table) {
    width: 100%;
    min-width: 880px;
    border-collapse: collapse;
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .post-content :global(.blog-tabla th) {
    padding: 12px 14px;
    text-align: left;
    vertical-align: bottom;
    background: var(--color-navy);
    color: var(--color-white);
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .post-content :global(.blog-tabla td) {
    padding: 12px 14px;
    vertical-align: top;
    border-top: 1px solid rgba(43, 44, 100, 0.08);
  }

  .post-content :global(.blog-tabla td:first-child) {
    font-weight: 700;
    color: var(--color-heading);
  }

  .post-content :global(.blog-tabla td .blog-estrellas) {
    display: block;
    margin-bottom: 4px;
    font-size: 0.95rem;
  }

  .post-content :global(.blog-tabla__hermana td) {
    background: var(--card-bg);
  }

  .post-content :global(.blog-tabla__hermana td:first-child::before) {
    content: "↳ ";
    color: var(--color-secondary);
  }

  .post-content :global(.blog-nota) {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-secondary);
  }

  @media (max-width: 759px) {
    .post-content :global(.blog-tabla) {
      width: auto;
      margin: 24px 0 16px;
      overflow: visible;
      background: none;
      border-radius: 0;
      box-shadow: none;
    }

    .post-content :global(.blog-tabla table) {
      min-width: 0;
      font-size: 0.92rem;
    }

    .post-content :global(.blog-tabla thead) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .post-content :global(.blog-tabla table),
    .post-content :global(.blog-tabla tbody),
    .post-content :global(.blog-tabla tr),
    .post-content :global(.blog-tabla td) {
      display: block;
    }

    .post-content :global(.blog-tabla tr) {
      margin-bottom: 14px;
      padding: 4px 16px 8px;
      background: var(--color-white);
      border-radius: var(--radius-md);
      box-shadow: var(--card-shadow);
    }

    .post-content :global(.blog-tabla__hermana) {
      margin-top: -6px;
    }

    .post-content :global(.blog-tabla tr.blog-tabla__hermana),
    .post-content :global(.blog-tabla__hermana td) {
      background: var(--card-bg);
    }

    .post-content :global(.blog-tabla td) {
      padding: 8px 0;
    }

    .post-content :global(.blog-tabla td::before) {
      content: attr(data-label);
      display: block;
      margin-bottom: 2px;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-secondary);
    }

    .post-content :global(.blog-tabla td:first-child) {
      padding: 12px 0 6px;
      border-top: 0;
      font-family: var(--font-heading);
      font-size: 1.05rem;
    }

    .post-content :global(.blog-tabla td:first-child::before) {
      content: none;
    }

    .post-content :global(.blog-tabla__hermana td:first-child::before) {
      content: "↳ ";
      display: inline;
      font-size: inherit;
      letter-spacing: 0;
      text-transform: none;
    }

    .post-content :global(.blog-tabla td .blog-estrellas) {
      display: inline-block;
      margin: 0 6px 0 0;
      vertical-align: -1px;
    }
  }

  .post-back {
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid rgba(43, 44, 100, 0.1);
  }

  .post-back a {
    color: var(--color-body);
    font-weight: 500;
    transition: color 0.15s;
  }

  .post-back a:hover {
    color: var(--color-heading);
  }
</style>
