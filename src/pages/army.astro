---
// /army — campaña BTS Lima (9-oct-2026). Es la página del QR del volante que
// se reparte afuera del Estadio San Marcos. La abren desde el celular, en la
// cola o a la salida, a veces con mala señal.
//
// Landing completa con los principios de la home: hero con una sola acción,
// dolor → solución → prueba social → plan → FAQ → cierre, con el sistema
// visual de la home (bloques lila/blanco separados por olas, tarjetas con
// ícono 3D, botón con reborde 3D, carrusel de testimonios, acordeón).
//
// De dónde sale cada texto:
// - Copy del volante (hero, pasos, sorteo, cierre): TAL CUAL de
//   01_Pablo/04_Contenido/02_Campañas/06_Volante_BTS_09-10-26/volante_bts.md.
//   Las bases del sorteo todavía no existen: su link entra cuando existan.
// - Dolor y beneficios: textos nuevos, cortos, en la voz de la campaña. Cada
//   función sale de la home o de marketing/_context/product-offering.md, y
//   solo se nombra lo que incluye el plan gratis (FreePlan.astro).
// - Testimonios: los reales de src/data/testimonios.ts, con el mismo carrusel.
// - Plan gratis y FAQ: textuales de FreePlan.astro y de sections/FAQ.astro.
//
// Liviana: sin JS propio (el acordeón es <details>), CSS en la página e
// imágenes WebP con lazy salvo la del hero. Nada de BTS, BIGHIT MUSIC ni
// HYBE: ni logos, ni fotos de integrantes.
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import TestimonialsCarousel from "../components/sections/TestimonialsCarousel.astro";

// Todos los botones van al onboarding con los UTM del volante, para medir
// cuántas cuentas salen del QR.
const CTA = "/onboarding?utm_source=volante&utm_medium=qr&utm_campaign=bts_lima";

// Ola de la home (Funciones.astro) para pasar de un bloque al siguiente.
const OLA = "M0,46 C240,80 500,16 760,50 C1010,82 1240,26 1440,54 L1440,0 L0,0 Z";

const ICONOS_HOME = "/landing/iconos";
const ICONOS_PABLO = "/onboarding/images/iconos/pablo";

// Dolor: textos nuevos. Sin burlarse de nadie ni de lo que gasta.
const DOLORES = [
  { emoji: "🎟️", titulo: "las entradas volaron", texto: "abrieron la venta y tu ahorro todavía no alcanzaba." },
  { emoji: "💸", titulo: "la plata se te escapa", texto: "llega fin de mes y no sabes en qué se fue." },
  { emoji: "🔁", titulo: "otra vez desde cero", texto: "anuncian el próximo concierto y empiezas a juntar de nuevo." },
];

// Beneficios: textos nuevos, solo con lo que trae el plan gratis.
// Fuentes: FreePlan.astro (una meta, una recurrente, presupuestos
// predeterminados, registros sin límite), Funciones.astro (racha, «sin
// planillas ni cuentas a fin de mes») y product-offering.md (progreso de la
// meta y celebración, «saber cuánto puedes gastar», pagos recurrentes).
const BENEFICIOS = [
  {
    icono: `${ICONOS_HOME}/diana-metas.webp`,
    titulo: "tu meta a la vista",
    texto: "ves cuánto llevas y cuánto falta, y pablo celebra contigo al llegar.",
  },
  {
    icono: `${ICONOS_HOME}/dona.webp`,
    titulo: "sabes cuánto puedes gastar",
    texto: "y cuánto separar para la próxima, sin planillas ni cuentas a fin de mes.",
  },
  {
    icono: `${ICONOS_PABLO}/lapiz.webp`,
    titulo: "anotas en segundos",
    texto: "registros sin límite, y por fin ves a dónde se va tu plata.",
  },
  {
    icono: `${ICONOS_PABLO}/ciclo.webp`,
    titulo: "lo fijo, en automático",
    texto: "configura tu pago fijo una vez y ya no te agarra de sorpresa.",
  },
  {
    icono: `${ICONOS_HOME}/fuego.webp`,
    titulo: "tu racha, día a día",
    texto: "cada registro suma racha y cada sol te acerca a tu meta.",
  },
];

// Plan gratis: textual de FreePlan.astro (/planes).
const PLAN_GRATIS = [
  { icono: `${ICONOS_PABLO}/celular.webp`, html: "<strong>5 mensajes al día</strong> en el chat, entre todos tus dispositivos." },
  { icono: `${ICONOS_PABLO}/tarjeta.webp`, html: "<strong>Hasta 3 cuentas</strong>, incluidas las compartidas." },
  { icono: `${ICONOS_PABLO}/diana.webp`, html: "<strong>Una moneda, una meta y una transacción recurrente.</strong>" },
  { icono: `${ICONOS_PABLO}/dona.webp`, html: "<strong>Presupuestos y categorías predeterminados.</strong>" },
  { icono: `${ICONOS_PABLO}/lapiz.webp`, html: "Registros manuales de ingresos y gastos sin límite." },
];

// FAQ: cuatro preguntas de la home (sections/FAQ.astro), respuestas textuales.
const FAQS = [
  {
    pregunta: "¿Pablo es gratis?",
    respuesta:
      "Sí. Gratis incluye 5 mensajes al día, hasta 3 cuentas, una moneda, una meta, una transacción recurrente y presupuestos y categorías predeterminados. WhatsApp, email, importaciones, exportaciones y personalización son Premium.",
  },
  {
    pregunta: "¿Necesito instalar algo?",
    respuesta:
      "Puedes empezar en la web sin instalar nada o descargar la app para iPhone. Android estará disponible próximamente.",
  },
  {
    pregunta: "¿Cómo empiezo?",
    respuesta:
      "Haz clic en Empieza gratis, crea tu cuenta y elige Seguir con Gratis. No necesitas tarjeta de crédito.",
  },
  {
    pregunta: "¿Cómo protege Pablo mis datos?",
    respuesta:
      "Tus datos están protegidos con encriptación. No compartimos tu información con terceros.",
  },
];
---

<Layout
  title="hola ARMY 💜 — Pablo"
  description="hola ARMY 💜 ¿también te quedaste afuera? 😭 pablo tampoco pudo entrar… así que ya empezó a ahorrar para la próxima vez"
  hideBanner
>
  <Navbar />
  <main class="army">
    <!-- 1. Hero: una sola acción. La foto va arriba del botón y el botón se ve
         sin bajar; en escritorio, dos columnas como la home. -->
    <section class="hero">
      <span class="brillo brillo--1" aria-hidden="true"></span>
      <span class="brillo brillo--2" aria-hidden="true"></span>
      <span class="corazon corazon--1" aria-hidden="true"></span>

      <div class="hero__inner">
        <h1 class="hero__titulo">
          <span class="hola">hola ARMY 💜</span>
          <span class="afuera">¿también te quedaste afuera?&nbsp;😭</span>
        </h1>
        <p class="hero__bajada">
          <span>pablo tampoco pudo entrar…</span>
          <span>así que ya empezó a ahorrar para la próxima vez</span>
        </p>
        <figure class="hero__foto">
          <img
            src="/army/pablo-kpop.webp"
            width="900"
            height="1117"
            alt="pablo vestido de kpopper, con chaqueta lila de lentejuelas, su chanchito en una mano y un volante de concierto en la otra, mirando triste"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
        <a class="boton hero__boton" href={CTA} id="army-cta-arriba">ahorra con él, gratis</a>
      </div>
    </section>

    <div class="ola" style="--arriba:#ffffff;--abajo:#f5f0fc" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={OLA} /></svg>
    </div>

    <!-- 2. Dolor -->
    <section class="bloque bloque--lila" aria-labelledby="army-dolor">
      <h2 class="titulo" id="army-dolor">¿a ti también te pasó?</h2>
      <ul class="dolores">
        {DOLORES.map((d) => (
          <li class="dolor">
            <span class="dolor__emoji" aria-hidden="true">{d.emoji}</span>
            <div>
              <h3 class="dolor__titulo">{d.titulo}</h3>
              <p class="dolor__texto">{d.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <div class="ola" style="--arriba:#f5f0fc;--abajo:#ffffff" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={OLA} /></svg>
    </div>

    <!-- 3. Solución: los beneficios del plan gratis -->
    <section class="bloque" aria-labelledby="army-beneficios">
      <h2 class="titulo" id="army-beneficios">pablo te ayuda a llegar</h2>
      <p class="bajada">empieza gratis en la web o en iOS.</p>
      <ul class="beneficios">
        {BENEFICIOS.map((b) => (
          <li class="beneficio">
            <span class="tile" aria-hidden="true">
              <img src={b.icono} alt="" width="240" height="240" loading="lazy" decoding="async" />
            </span>
            <div>
              <h3 class="beneficio__titulo">{b.titulo}</h3>
              <p class="beneficio__texto">{b.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <div class="ola" style="--arriba:#ffffff;--abajo:#f5f0fc" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={OLA} /></svg>
    </div>

    <!-- 4. Cómo vas a llegar a la próxima (copy del volante) -->
    <section class="bloque bloque--lila" aria-labelledby="army-pasos">
      <div class="tarjeta pasos">
        <span class="brillo brillo--3" aria-hidden="true"></span>
        <h2 id="army-pasos">the best is yet to come ✨</h2>
        <ol class="pasos__lista">
          <li><strong>crea tu meta:</strong> «próximo concierto», con cuánto quieres juntar y para cuándo</li>
          <li><strong>arma tu presupuesto:</strong> pablo te dice cuánto separar cada mes</li>
          <li><strong>anota tus gastos:</strong> en segundos, y ves cuánto te falta</li>
        </ol>
        <p class="pasos__cuenta">
          con <strong>S/ 20 a la semana</strong>, en un año juntas <strong>S/ 1.040</strong> 💜
        </p>
        <a class="boton" href={CTA} id="army-cta-pasos">empieza gratis</a>
      </div>
    </section>

    <div class="ola" style="--arriba:#f5f0fc;--abajo:#ede6fa" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={OLA} /></svg>
    </div>

    <!-- 5. Testimonios reales (mismo carrusel de la home) -->
    <section class="bloque bloque--lavanda testimonios" aria-labelledby="army-testimonios">
      <span class="icono-ancla testimonios__icono" aria-hidden="true">
        <img src={`${ICONOS_HOME}/estrellas.webp`} alt="" width="240" height="240" loading="lazy" decoding="async" />
      </span>
      <h2 class="titulo" id="army-testimonios">gente real, resultados reales</h2>
      <TestimonialsCarousel />
    </section>

    <div class="ola" style="--arriba:#ede6fa;--abajo:#ffffff" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={OLA} /></svg>
    </div>

    <!-- 6. El sorteo (copy del volante) -->
    <section class="bloque" aria-labelledby="army-sorteo">
      <div class="tarjeta sorteo">
        <span class="corazon corazon--2" aria-hidden="true"></span>
        <img
          class="sorteo__foto"
          src="/army/pablo-sorteo.webp"
          width="900"
          height="900"
          alt="pablo feliz, con audífonos blancos, sosteniendo un regalo morado"
          loading="lazy"
          decoding="async"
        />
        <h2 id="army-sorteo">
          🎧 en noviembre, pablo sortea unos <strong>AirPods 5</strong><br />
          entre todos sus amigos
        </h2>
        <p class="sorteo__como">
          <span class="sorteo__pregunta">¿cómo entras?</span>
          crea tu cuenta gratis en usapablo.com y ya eres su amigo
        </p>
      </div>
    </section>

    <div class="ola" style="--arriba:#ffffff;--abajo:#f5f0fc" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={OLA} /></svg>
    </div>

    <!-- 7. El plan gratis (lista textual de FreePlan.astro) -->
    <section class="bloque bloque--lila" aria-labelledby="army-plan">
      <div class="plan">
        <div class="plan__intro">
          <p class="plan__etiqueta">pablo gratis</p>
          <h2 id="army-plan">S/ 0, sin tarjeta, para siempre</h2>
          <a class="boton plan__boton" href={CTA} id="army-cta-plan">empieza gratis</a>
        </div>
        <div class="plan__detalle">
          <ul class="plan__lista">
            {PLAN_GRATIS.map((p) => (
              <li>
                <img src={p.icono} alt="" width="240" height="240" loading="lazy" decoding="async" />
                <span set:html={p.html} />
              </li>
            ))}
          </ul>
          <p class="plan__premium">Con Premium: WhatsApp, email, importaciones, exportaciones en todos los formatos y personalización.</p>
        </div>
      </div>
    </section>

    <div class="ola" style="--arriba:#f5f0fc;--abajo:#ffffff" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={OLA} /></svg>
    </div>

    <!-- 8. FAQ corto (textual de la home), sin JS: <details> -->
    <section class="bloque" aria-labelledby="army-faq">
      <h2 class="titulo" id="army-faq">¿tienes preguntas? tenemos las respuestas</h2>
      <div class="faq">
        {FAQS.map((f) => (
          <details class="faq__item">
            <summary>
              <span>{f.pregunta}</span>
              <svg class="faq__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
            </summary>
            <p>{f.respuesta}</p>
          </details>
        ))}
      </div>
    </section>

    <div class="ola" style="--arriba:#ffffff;--abajo:#2b2c64" aria-hidden="true">
      <svg viewBox="0 0 1440 80" preserveAspectRatio="none"><path d={OLA} /></svg>
    </div>

    <!-- 9. Cierre (copy del volante): la noche del concierto, en navy -->
    <section class="cierre">
      <span class="brillo brillo--4" aria-hidden="true"></span>
      <span class="brillo brillo--5" aria-hidden="true"></span>
      <span class="corazon corazon--3" aria-hidden="true"></span>
      <p class="cierre__firma">borahae 💜<br />— pablo</p>
      <a class="boton boton--claro" href={CTA} id="army-cta-cierre">ahorra con pablo</a>
      <p class="aviso"><em>pablo no está afiliado a BTS, BIGHIT MUSIC ni HYBE.</em></p>
    </section>
  </main>
</Layout>

<style>
  /* Paleta ARMY: morados y lavanda; navy de la marca para el texto. */
  .army {
    --army-morado: #6b3fa0;
    --army-morado-oscuro: #4b2a75;
    --army-lavanda: #9b7bd4;
    --army-lila: #e6dcf7;
    --army-fondo: #f5f0fc;
    --army-navy: #2b2c64;
    --army-suave: #56578f;
    --army-oro: #f5c04a;

    color: var(--army-navy);
    background: #ffffff;
  }

  /* ---------- Brillos y corazones (solo CSS) ---------- */
  .brillo,
  .corazon {
    position: absolute;
    pointer-events: none;
    z-index: 0;
  }

  .brillo {
    width: 18px;
    height: 18px;
    background: var(--army-lavanda);
    clip-path: polygon(50% 0%, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0% 50%, 39% 39%);
    animation: titila 2.6s ease-in-out infinite;
  }

  .corazon {
    width: 12px;
    height: 12px;
    background: var(--army-lavanda);
    transform: rotate(-45deg);
    animation: flota 3.2s ease-in-out infinite;
  }

  .corazon::before,
  .corazon::after {
    content: "";
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: inherit;
  }

  .corazon::before { top: -6px; left: 0; }
  .corazon::after { top: 0; left: 6px; }

  .brillo--1 { top: 14px; right: 18px; width: 22px; height: 22px; }
  .brillo--2 { top: 70px; left: 12px; width: 12px; height: 12px; background: var(--army-oro); animation-delay: 0.8s; }
  .brillo--3 { top: 16px; left: 20px; background: var(--army-oro); animation-delay: 0.4s; }
  .brillo--4 { top: 28px; left: 12%; width: 14px; height: 14px; background: var(--army-oro); }
  .brillo--5 { bottom: 64px; right: 10%; width: 20px; height: 20px; animation-delay: 1.2s; }
  .corazon--1 { top: 22px; left: 18px; opacity: 0.7; }
  .corazon--2 { top: 26px; left: 26px; animation-delay: 0.6s; }
  .corazon--3 { top: 70px; right: 16%; background: var(--army-lavanda); animation-delay: 1s; }

  @keyframes titila {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
    50% { transform: scale(0.6) rotate(20deg); opacity: 0.55; }
  }

  @keyframes flota {
    0%, 100% { transform: translateY(0) rotate(-45deg); }
    50% { transform: translateY(-6px) rotate(-45deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .brillo,
    .corazon {
      animation: none;
    }
  }

  /* ---------- Botón (sistema de la home: radio 16 y reborde 3D) ---------- */
  .boton {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 360px;
    min-height: 56px;
    margin: 0 auto;
    padding: 15px 22px;
    background: var(--army-morado);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    border-radius: 16px;
    box-shadow: 0 4px 0 0 var(--army-morado-oscuro);
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.15s ease;
  }

  /* Brillito en la esquina del botón */
  .boton::after {
    content: "";
    position: absolute;
    top: -8px;
    right: 18px;
    width: 16px;
    height: 16px;
    background: var(--army-oro);
    clip-path: polygon(50% 0%, 61% 39%, 100% 50%, 61% 61%, 50% 100%, 39% 61%, 0% 50%, 39% 39%);
  }

  .boton:hover {
    background: #7a4bb3;
    transform: translateY(-1px);
    box-shadow: 0 5px 0 0 var(--army-morado-oscuro);
  }

  .boton:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 0 var(--army-morado-oscuro);
  }

  .boton:focus-visible {
    outline: 3px solid var(--army-lavanda);
    outline-offset: 4px;
  }

  /* Sobre el navy del cierre, el botón va claro. */
  .boton--claro {
    background: var(--army-fondo);
    color: var(--army-morado);
    box-shadow: 0 4px 0 0 var(--army-lavanda);
  }

  .boton--claro:hover {
    background: #ffffff;
    box-shadow: 0 5px 0 0 var(--army-lavanda);
  }

  .boton--claro:active {
    box-shadow: 0 1px 0 0 var(--army-lavanda);
  }

  /* ---------- 1. Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 4px 20px 30px;
    background: #ffffff;
  }

  /* Móvil: título, bajada, foto y botón, en ese orden. La foto se mide con el
     alto visible real (svh, con las barras de Safari puestas) para que el
     botón siempre quede en la primera pantalla. */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-areas: "titulo" "bajada" "foto" "boton";
    justify-items: center;
    text-align: center;
    max-width: 1080px;
    margin: 0 auto;
  }

  .hero__titulo {
    grid-area: titulo;
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.1;
  }

  .hola {
    display: block;
    font-size: clamp(2rem, 9vw, 3.6rem);
    color: var(--army-navy);
    letter-spacing: -0.01em;
  }

  .afuera {
    display: block;
    margin-top: 2px;
    font-size: clamp(1.4rem, 6vw, 2.4rem);
    color: var(--army-morado);
  }

  .hero__bajada {
    grid-area: bajada;
    margin-top: 8px;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--army-navy);
  }

  /* Cada línea del copy en su renglón, partida pareja. */
  .hero__bajada span {
    display: block;
    text-wrap: balance;
  }

  .hero__foto {
    grid-area: foto;
    --alto: clamp(190px, calc(100svh - 372px), 430px);
    position: relative;
    margin: 14px 0 18px;
    padding: 6px;
    background: #ffffff;
    border-radius: 26px;
    box-shadow: 0 14px 34px rgba(75, 42, 117, 0.22);
    transform: rotate(-1.5deg);
  }

  /* Cinta washi arriba de la foto, como pegada por otro fan */
  .hero__foto::before {
    content: "";
    position: absolute;
    z-index: 1;
    top: -10px;
    left: 50%;
    width: 84px;
    height: 22px;
    background: rgba(155, 123, 212, 0.6);
    border-radius: 4px;
    transform: translateX(-50%) rotate(3deg);
  }

  .hero__foto img {
    display: block;
    height: var(--alto);
    width: auto;
    max-width: 100%;
    aspect-ratio: 900 / 1117;
    object-fit: cover;
    border-radius: 20px;
  }

  .hero__boton {
    grid-area: boton;
  }

  /* ---------- Olas entre bloques (las de la home) ---------- */
  .ola {
    display: block;
    height: 36px;
    background: var(--abajo);
  }

  .ola svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--arriba);
  }

  /* ---------- Bloques ---------- */
  .bloque {
    position: relative;
    padding: 44px 20px 56px;
    background: #ffffff;
    text-align: center;
  }

  .bloque--lila { background: var(--army-fondo); }
  .bloque--lavanda { background: #ede6fa; }

  .titulo {
    max-width: 640px;
    margin: 0 auto;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.65rem, 7vw, 2.5rem);
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--army-morado);
    text-wrap: balance;
  }

