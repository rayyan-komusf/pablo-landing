<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Revisa tu suscripción · Pablo</title>
  </head>
  <body>
    <main aria-live="polite">
      <img src="/onboarding/images/pablo/pablo-logo.png" alt="Pablo" width="64" height="64" />
      <h1>Revisa tu suscripción en Pablo</h1>
      <p>Este enlace pertenece al sistema de pagos anterior. Las nuevas suscripciones se gestionan con WHOP desde la app.</p>
      <a id="flow-continuar" href="https://usapablo.app/auth">Continuar a Pablo</a>
    </main>
    <script>
      import { urlAppTrasFlow } from "../../lib/flowRetorno";
      const continuar = document.getElementById("flow-continuar") as HTMLAnchorElement;
      continuar.href = urlAppTrasFlow();
      history.replaceState(null, "", location.pathname);
    </script>
  </body>
</html>
<style>
  :global(body) { margin: 0; background: #eeebfa; color: #2b2c64; font: 16px/1.5 system-ui, sans-serif; min-height: 100dvh; display: grid; place-items: center; }
  main { box-sizing: border-box; width: min(440px, calc(100% - 32px)); margin: 24px auto; padding: 28px; background: white; border: 2px solid #dedbec; border-radius: 20px; box-shadow: 0 4px 0 #dedbec; text-align: center; }
  h1 { font-size: 24px; }
  button, a { box-sizing: border-box; display: block; width: 100%; padding: 12px; margin-top: 16px; border: 0; border-radius: 12px; background: #2b2c64; color: white; font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
  [hidden] { display: none; }
  button:focus-visible, a:focus-visible { outline: 3px solid #2b2c64; outline-offset: 3px; }
</style>
